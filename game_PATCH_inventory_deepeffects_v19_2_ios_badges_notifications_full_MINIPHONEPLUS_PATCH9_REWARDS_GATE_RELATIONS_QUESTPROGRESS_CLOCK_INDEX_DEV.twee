:: MINIPHONEPLUS_PATCH7_EXTRA_EVENTS [script]
(function () {
  // Requires unified event hook (from previous patches)
  if (typeof setup.emitGameEvent !== "function") return;

  // (Optional) expose type names if your patch keeps a mutable map
  try {
    if (setup.GAME_EVENT_TYPES && !Object.isFrozen(setup.GAME_EVENT_TYPES)) {
      setup.GAME_EVENT_TYPES.orderCreated = "orderCreated";
      setup.GAME_EVENT_TYPES.purchaseInstantToInventory = "purchaseInstantToInventory";
    }
  } catch (e) {}

  // ------------------------------------------------------------
  // Purchase context: distinguish inventory adds that happen inside
  // a purchase (instant delivery), not from deliveries/quests/etc.
  // ------------------------------------------------------------
  if (!setup.__evtPurchaseCtxWrap_v1 && typeof setup.shopPurchaseOffer === "function") {
    setup.__evtPurchaseCtxWrap_v1 = true;

    var _oldPurchaseOffer = setup.shopPurchaseOffer;
    setup.shopPurchaseOffer = function (offerId, qty) {
      var offer = (typeof setup.shopGetOffer === "function") ? setup.shopGetOffer(offerId) : null;

      qty = Number(qty || 1);
      if (!isFinite(qty) || qty < 1) qty = 1;

      setup.__evtPurchaseCtx = {
        offerId: String(offerId || ""),
        qty: qty,
        offer: offer || null,
        ts: Date.now()
      };

      try {
        return _oldPurchaseOffer.apply(this, arguments);
      } finally {
        setup.__evtPurchaseCtx = null;
      }
    };
  }

  // ------------------------------------------------------------
  // orderCreated: emit when a shipping order is created
  // ------------------------------------------------------------
  if (!setup.__evtShopCreateOrderWrap_v1 && typeof setup.shopCreateOrder === "function") {
    setup.__evtShopCreateOrderWrap_v1 = true;

    var _oldCreateOrder = setup.shopCreateOrder;
    setup.shopCreateOrder = function (offer, qty) {
      var ord = _oldCreateOrder.apply(this, arguments);

      try {
        if (ord) {
          setup.emitGameEvent("orderCreated", {
            orderId   : String(ord.id || ""),
            vendorId  : String(ord.vendorId || (offer && offer.vendorId) || ""),
            offerId   : String(ord.offerId  || (offer && offer.id)       || ""),
            itemId    : String(ord.itemId   || (offer && offer.itemId)   || ""),
            qty       : Number(ord.qty || qty || 1),
            placedDay : (typeof ord.placedDay === "number") ? ord.placedDay : null,
            deliverDay: (typeof ord.deliverDay === "number") ? ord.deliverDay : null
          });
        }
      } catch (e) {}

      return ord;
    };
  }

  // ------------------------------------------------------------
  // purchaseInstantToInventory: emit ONLY when inventory add happens
  // inside a purchase context AND the offer is NOT shipping.
  // This prevents firing on deliveries.
  // ------------------------------------------------------------
  if (!setup.__evtShopAddToInventoryWrap_v1 && typeof setup.shopAddToInventory === "function") {
    setup.__evtShopAddToInventoryWrap_v1 = true;

    var _oldAddToInv = setup.shopAddToInventory;
    setup.shopAddToInventory = function (itemId, qty) {
      var res = _oldAddToInv.apply(this, arguments);

      try {
        var ctx = setup.__evtPurchaseCtx;
        if (ctx && ctx.offer && String(ctx.offer.deliveryMode || "") !== "shipping") {
          var q = Number(qty || 1);
          if (!isFinite(q) || q < 1) q = 1;

          setup.emitGameEvent("purchaseInstantToInventory", {
            itemId  : String(itemId || ""),
            qty     : q,
            offerId : String(ctx.offerId || ""),
            vendorId: String(ctx.offer.vendorId || ""),
            price   : (function () {
              var p = Number(ctx.offer.price || 0) * Number(ctx.qty || 1);
              return (isFinite(p) && p >= 0) ? p : 0;
            })()
          });
        }
      } catch (e) {}

      return res;
    };
  }
})();


:: MINIPHONEPLUS_PATCH8_DEVTOOLS_MIGRATE_VALIDATE_GIFTTEST_DYNEVENTS [script]
(function () {
	/* ============================================================
	   PATCH8: Non-phone core helpers
	   1) Save schema + migrations
	   2) Catalog validator + UI
	   3) Gift rules tester (author debug)
	   4) Dynamic Events debug UI (reasons + manual fire)
	   ============================================================ */

	// -----------------------------
	// 1) Save schema + migrations
	// -----------------------------
	setup.SCHEMA_VERSION = Math.max(Number(setup.SCHEMA_VERSION || 0) || 0, 8);

	setup.migrateSaveIfNeeded = setup.migrateSaveIfNeeded || function () {
		var sv = (typeof State !== "undefined" && State.variables) ? State.variables : null;
		if (!sv) return;

		var target = Number(setup.SCHEMA_VERSION || 0) || 0;
		var cur = Number(sv.__schemaVersion || 0);
		if (!isFinite(cur) || cur < 0) cur = 0;

		if (cur >= target) return;

		for (var v = cur + 1; v <= target; v++) {
			try {
				switch (v) {
					case 1: // gift engine state
						if (typeof setup.ensureGiftState === "function") setup.ensureGiftState();
						break;

					case 2: // dynamic events state
						if (typeof setup.ensureDynamicEvents === "function") setup.ensureDynamicEvents();
						if (typeof sv.dynEventsAuto !== "boolean") sv.dynEventsAuto = true;
						break;

					case 3: // notification log
						if (typeof setup.phoneEnsureNotifLog === "function") setup.phoneEnsureNotifLog();
						break;

					case 4: // inventory/shop backbone
						if (typeof setup.ensureShopState === "function") setup.ensureShopState();
						if (!sv.inv || typeof sv.inv !== "object" || Array.isArray(sv.inv)) sv.inv = {};
						break;

					case 5: // quests backbone
						if (typeof setup.ensureQuestSystem === "function") setup.ensureQuestSystem();
						if (typeof setup.initQuests === "function") setup.initQuests();
						break;

					case 6: // messaging/social
						if (typeof setup.ensureMessagesState === "function") setup.ensureMessagesState();
						if (typeof setup.ensureFansState === "function") setup.ensureFansState();
						if (typeof setup.ensureMatchDmState === "function") setup.ensureMatchDmState();
						break;

					case 7: // content settings defaults
						if (typeof sv.contentSettings !== "object" || !sv.contentSettings) sv.contentSettings = {};
						if (setup.contentCatalog && typeof setup.contentCatalog === "object") {
							Object.keys(setup.contentCatalog).forEach(function (k) {
								if (typeof sv.contentSettings[k] !== "boolean") {
									sv.contentSettings[k] = !!(setup.contentCatalog[k] && setup.contentCatalog[k].default);
								}
							});
						}
						break;

					case 8: // cheats/devtools state
						if (!sv.cheatsState || typeof sv.cheatsState !== "object" || Array.isArray(sv.cheatsState)) {
							sv.cheatsState = { tab: "validation", giftNpcId: "", giftItemId: "", giftQty: 1, dynShowLog: true };
						}
						break;
				}
			} catch (e) { /* ignore */ }
		}

		sv.__schemaVersion = target;
	};

	// Wrap initGameState so migrations always run on new versions
	if (!setup.__patch8_wrapInitGameState && typeof setup.initGameState === "function") {
		setup.__patch8_wrapInitGameState = true;
		var _oldInitGameState = setup.initGameState;
		setup.initGameState = function () {
			try { if (typeof setup.migrateSaveIfNeeded === "function") setup.migrateSaveIfNeeded(); } catch (e) {}
			return _oldInitGameState.apply(this, arguments);
		};
	}

	// Try to hook save loads (SugarCube-compatible, but guarded)
	try {
		if (typeof Config === "object" && Config.saves) {
			if (typeof Config.saves.onLoad === "function" && !Config.saves.__patch8Wrapped) {
				var _oldOnLoad = Config.saves.onLoad;
				Config.saves.onLoad = function () {
					try { if (typeof setup.migrateSaveIfNeeded === "function") setup.migrateSaveIfNeeded(); } catch (e) {}
					try { if (typeof setup.initGameState === "function") setup.initGameState(); } catch (e) {}
					return _oldOnLoad.apply(this, arguments);
				};
				Config.saves.__patch8Wrapped = true;
			} else if (typeof Config.saves.onLoad !== "function") {
				Config.saves.onLoad = function () {
					try { if (typeof setup.migrateSaveIfNeeded === "function") setup.migrateSaveIfNeeded(); } catch (e) {}
					try { if (typeof setup.initGameState === "function") setup.initGameState(); } catch (e) {}
				};
			}
		}
	} catch (e) { /* ignore */ }


	// -----------------------------
	// 2) Catalog validator
	// -----------------------------
	setup.validateCatalogs = setup.validateCatalogs || function (opts) {
		opts = (opts && typeof opts === "object") ? opts : {};
		var sv = (typeof State !== "undefined" && State.variables) ? State.variables : {};
		var res = {
			ok: true,
			time: Date.now(),
			errors: [],
			warnings: []
		};

		function push(list, msg, meta) {
			list.push({ msg: String(msg || ""), meta: meta || null });
		}
		function err(msg, meta) { res.ok = false; push(res.errors, msg, meta); }
		function warn(msg, meta) { push(res.warnings, msg, meta); }

		function isObj(x) { return x && typeof x === "object" && !Array.isArray(x); }
		function asArr(x) { return Array.isArray(x) ? x : (x != null ? [x] : []); }

		function uniqIds(arr, label) {
			var seen = {};
			if (!Array.isArray(arr)) { warn(label + " catalog is not an array"); return seen; }
			arr.forEach(function (o, i) {
				if (!isObj(o)) { err(label + "[" + i + "] is not an object"); return; }
				var id = String(o.id || "").trim();
				if (!id) { err(label + "[" + i + "] missing id"); return; }
				if (seen[id]) { err(label + " duplicate id: " + id); }
				seen[id] = true;
			});
			return seen;
		}

		// Items
		var items = Array.isArray(setup.shopItems) ? setup.shopItems : [];
		var itemIds = uniqIds(items, "item");
		items.forEach(function (it) {
			if (!isObj(it)) return;
			if (!String(it.name || "").trim()) warn("item " + it.id + " has empty name");
			if (!String(it.type || "").trim()) warn("item " + it.id + " has empty type");
			if (it.giftable != null && typeof it.giftable !== "boolean") warn("item " + it.id + " giftable should be boolean");
			if (it.stackable != null && typeof it.stackable !== "boolean") warn("item " + it.id + " stackable should be boolean");
		});

		// Offers / listings
		var offers = Array.isArray(setup.shopOffers) ? setup.shopOffers : [];
		var offerIds = uniqIds(offers, "offer");
		offers.forEach(function (of) {
			if (!isObj(of)) return;
			var id = String(of.id || "");
			var itemId = String(of.itemId || "");
			var vendorId = String(of.vendorId || "");
			if (!vendorId) err("offer " + id + " missing vendorId");
			if (!itemId) err("offer " + id + " missing itemId");
			if (itemId && !itemIds[itemId]) err("offer " + id + " itemId not found in items: " + itemId);

			var price = Number(of.price == null ? 0 : of.price);
			if (!isFinite(price) || price < 0) err("offer " + id + " invalid price: " + of.price);

			var sm = String(of.stockMode || "stock");
			if (sm !== "stock" && sm !== "exclusive") warn("offer " + id + " unknown stockMode: " + sm);
			if (sm === "stock") {
				var st = Number(of.initialStock == null ? 0 : of.initialStock);
				if (!isFinite(st) || st < 0) warn("offer " + id + " stockMode=stock but initialStock invalid: " + of.initialStock);
			}

			var dm = String(of.deliveryMode || "instant");
			if (dm !== "instant" && dm !== "shipping") warn("offer " + id + " unknown deliveryMode: " + dm);
			if (dm === "shipping") {
				var eta = Number(of.etaDays == null ? 0 : of.etaDays);
				if (!isFinite(eta) || eta <= 0) warn("offer " + id + " deliveryMode=shipping but etaDays <= 0");
			}

			["requiresFlags", "lacksFlags"].forEach(function (k) {
				if (of[k] != null && !Array.isArray(of[k])) warn("offer " + id + " " + k + " should be array");
			});
		});

		// Gift rules
		var giftRules = Array.isArray(setup.giftRules) ? setup.giftRules : [];
		var seenRule = {};
		giftRules.forEach(function (r, i) {
			if (!isObj(r)) { err("giftRules[" + i + "] is not an object"); return; }
			var rid = String(r.id || "").trim();
			if (!rid) { err("giftRules[" + i + "] missing id"); return; }
			if (seenRule[rid]) err("giftRules duplicate id: " + rid);
			seenRule[rid] = true;

			var ids = asArr(r.itemIds || r.itemId);
			if (ids.length) {
				ids.forEach(function (iid) {
					iid = String(iid || "");
					if (iid && !itemIds[iid]) warn("giftRule " + rid + " references unknown itemId: " + iid);
				});
			} else {
				warn("giftRule " + rid + " has no itemId filter (will match any item)");
			}

			if (r.effects != null && !(Array.isArray(r.effects) || isObj(r.effects))) warn("giftRule " + rid + " effects should be array or object");
			if (r.when && !isObj(r.when)) warn("giftRule " + rid + " when should be object");
		});

		// Item use rules
		var useRules = Array.isArray(setup.itemUseRules) ? setup.itemUseRules : [];
		var seenUse = {};
		useRules.forEach(function (r, i) {
			if (!isObj(r)) { err("itemUseRules[" + i + "] is not an object"); return; }
			var rid = String(r.id || "").trim();
			if (!rid) { err("itemUseRules[" + i + "] missing id"); return; }
			if (seenUse[rid]) err("itemUseRules duplicate id: " + rid);
			seenUse[rid] = true;

			var ids = asArr(r.itemIds || r.itemId);
			if (ids.length) {
				ids.forEach(function (iid) {
					iid = String(iid || "");
					if (iid && !itemIds[iid]) warn("itemUseRule " + rid + " references unknown itemId: " + iid);
				});
			} else {
				warn("itemUseRule " + rid + " has no itemId filter (will match any item)");
			}
		});

		// Dynamic event defs
		var dyn = setup.dynamicEventDefs || {};
		if (!isObj(dyn)) warn("dynamicEventDefs is not an object");
		else {
			Object.keys(dyn).forEach(function (id) {
				var def = dyn[id];
				if (!isObj(def)) { err("dynamicEventDefs[" + id + "] is not an object"); return; }
				if (!String(def.sceneId || "").trim()) err("dynamicEvent " + id + " missing sceneId");
				if (typeof Story !== "undefined" && typeof Story.get === "function" && def.sceneId) {
					if (!Story.get(String(def.sceneId))) warn("dynamicEvent " + id + " sceneId not found in Story: " + def.sceneId);
				}
			});
		}

		// Content flags
		if (setup.contentCatalog && isObj(setup.contentCatalog)) {
			Object.keys(setup.contentCatalog).forEach(function (k) {
				var d = setup.contentCatalog[k];
				if (!isObj(d)) warn("contentCatalog[" + k + "] should be object");
				else if (d.default != null && typeof d.default !== "boolean") warn("contentCatalog[" + k + "].default should be boolean");
			});
		}

		// NPC id sanity (soft): any explicit npcId in rules should exist in $npcs (if present)
		var npcKeys = (sv.npcs && typeof sv.npcs === "object") ? Object.keys(sv.npcs) : [];
		var npcSet = {};
		npcKeys.forEach(function (k) { npcSet[k] = true; });
		giftRules.forEach(function (r) {
			if (!isObj(r)) return;
			var rid = String(r.id || "");
			var nids = asArr(r.npcIds || r.npcId);
			nids.forEach(function (nid) {
				nid = String(nid || "");
				if (!nid || nid === "*") return;
				if (npcKeys.length && !npcSet[nid]) warn("giftRule " + rid + " references unknown npcId (in save): " + nid);
			});
		});

		return res;
	};

	// Pretty format helpers for the cheats screen
	setup._cheatsEscape = setup._cheatsEscape || function (s) { return setup.escapeHtml ? setup.escapeHtml(String(s || "")) : String(s || ""); };

	setup._cheatsEffectLines = setup._cheatsEffectLines || function (effects) {
		var out = [];
		if (!effects) return out;

		function push(s) { if (s) out.push(String(s)); }
		function fmtDelta(d) {
			d = Number(d || 0);
			if (!isFinite(d) || d === 0) return "0";
			return (d > 0 ? "+" : "") + String(d);
		}

		// array-form (preferred)
		if (Array.isArray(effects)) {
			effects.forEach(function (e) {
				if (!e || typeof e !== "object") return;
				var t = String(e.type || "");
				switch (t) {
					case "toast": push('toast "' + (e.text || "") + '"'); break;
					case "npcStat": push("npcStat " + (e.key || "?") + " " + fmtDelta(e.delta)); break;
					case "heroStat": push("heroStat " + (e.key || "?") + " " + fmtDelta(e.delta)); break;
					case "setShopFlag": push("setShopFlag " + (e.flag || "?")); break;
					case "clearShopFlag": push("clearShopFlag " + (e.flag || "?")); break;
					case "unlockScene": push("unlockScene " + (e.id || "?")); break;
					case "queueScene": push("queueScene " + (e.id || "?")); break;
					case "addMoney": push("addMoney " + fmtDelta(e.amount)); break;
					case "spendMoney": push("spendMoney " + fmtDelta(-Math.abs(Number(e.amount || 0)))); break;
					case "addItem": push("addItem " + (e.itemId || "?") + " x" + (e.qty || 1)); break;
					case "removeItem": push("removeItem " + (e.itemId || "?") + " x" + (e.qty || 1)); break;
					case "addFansCoins": push("addFansCoins " + fmtDelta(e.amount)); break;
					case "npcAppFlag": push("npcAppFlag " + (e.flag || "?")); break;
					case "fansUnlockPost": push("fansUnlockPost " + (e.postId || e.id || "?")); break;
					case "fansUnlockPPV": push("fansUnlockPPV " + (e.ppvId || e.id || "?")); break;
					case "addNpcGalleryMedia": push("addNpcGalleryMedia"); break;
					default: push(t || "effect");
				}
			});
			return out;
		}

		// object-form (legacy)
		if (effects && typeof effects === "object") {
			if (effects.toast) push('toast "' + String(effects.toast) + '"');
			if (effects.npcStats) push("npcStats {...}");
			if (effects.heroStats) push("heroStats {...}");
			if (effects.setShopFlag) push("setShopFlag " + effects.setShopFlag);
			if (effects.clearShopFlag) push("clearShopFlag " + effects.clearShopFlag);
			if (effects.unlockScene) push("unlockScene " + effects.unlockScene);
			if (effects.queueScene) push("queueScene " + effects.queueScene);
			if (effects.addMoney) push("addMoney " + effects.addMoney);
			if (effects.spendMoney) push("spendMoney " + effects.spendMoney);
			if (effects.addItem) push("addItem " + (effects.addItem.itemId || "?"));
		}
		return out;
	};

	// -----------------------------
	// 3) Gift rules tester helpers
	// -----------------------------
	setup.cheatsListGiftRules = setup.cheatsListGiftRules || function (npcId, itemId, qty) {
		setup.ensureGiftState();
		var sv = State.variables;
		qty = Number(qty || 1);
		if (!isFinite(qty) || qty < 1) qty = 1;

		var prevCount = 0;
		if (sv.giftLog && npcId && sv.giftLog[npcId] && typeof sv.giftLog[npcId][itemId] === "number") prevCount = sv.giftLog[npcId][itemId];

		var ctx = {
			kind: "gift",
			npcId: npcId || "",
			itemId: itemId || "",
			qty: qty,
			day: (typeof setup._nowDay === "function") ? setup._nowDay() : 0,
			giftCountBefore: prevCount,
			_applyChance: false
		};

		var rules = Array.isArray(setup.giftRules) ? setup.giftRules.slice() : [];
		rules.sort(function (a, b) {
			var pa = (a && typeof a.priority === "number") ? a.priority : 0;
			var pb = (b && typeof b.priority === "number") ? b.priority : 0;
			return pb - pa;
		});

		var out = [];
		for (var i = 0; i < rules.length; i++) {
			var r = rules[i];
			if (!r) continue;
			ctx._idx = i;
			var matches = (typeof setup._ruleMatches === "function") ? setup._ruleMatches(r, ctx) : false;
			if (!matches) continue;

			var canFire = (typeof setup._ruleCanFire === "function") ? setup._ruleCanFire("gift", r, ctx) : true;
			out.push({
				id: String(r.id || ""),
				priority: (typeof r.priority === "number") ? r.priority : 0,
				once: String(r.once || ""),
				cooldownDays: Number(r.cooldownDays || 0) || 0,
				stop: !!r.stop,
				canFire: !!canFire,
				chance: (r.when && typeof r.when.chance === "number") ? Number(r.when.chance) : null,
				effects: r.effects
			});
		}
		return out;
	};


	// -----------------------------
	// 4) Dynamic Events debug helpers
	// -----------------------------
	setup.dynExplainIneligible = setup.dynExplainIneligible || function (def, manual) {
		var reasons = [];
		if (!def) return ["missing def"];

		if (def.enabled === false) reasons.push("disabled");
		if (!manual && def.auto === false) reasons.push("auto=false");
		if (!def.sceneId) reasons.push("missing sceneId");

		var now = (typeof setup._dynNow === "function") ? setup._dynNow() : { passage: (typeof State !== "undefined" ? State.passage : ""), timeOfDayIndex: 0, weekdayIndex: 0, day: 0, timeKey: "" };

		// passage match
		if (def.passages && typeof setup._matchPattern === "function") {
			if (!setup._matchPattern(now.passage, def.passages)) reasons.push("passage mismatch");
		}

		// weekdays
		if (Array.isArray(def.weekdays) && def.weekdays.length) {
			var ok = false;
			for (var i = 0; i < def.weekdays.length; i++) {
				if (Number(def.weekdays[i]) === Number(now.weekdayIndex)) { ok = true; break; }
			}
			if (!ok) reasons.push("weekday mismatch");
		}

		// time window
		if (def.minTimeIndex != null || def.maxTimeIndex != null) {
			var mi = (def.minTimeIndex != null) ? Number(def.minTimeIndex) : 0;
			var ma = (def.maxTimeIndex != null) ? Number(def.maxTimeIndex) : mi;
			var ti = Number(now.timeOfDayIndex) || 0;
			if (ti < mi || ti > ma) reasons.push("timeOfDay mismatch");
		}

		// npc present
		if (Array.isArray(def.npcPresent) && def.npcPresent.length) {
			var sv = State.variables;
			if (!sv || !sv.npcs) reasons.push("npcPresent requires sv.npcs");
			else {
				for (var j = 0; j < def.npcPresent.length; j++) {
					var nid = String(def.npcPresent[j] || "");
					if (!nid || !sv.npcs[nid]) { reasons.push("npcPresent missing npc " + nid); break; }
					if (String(sv.npcs[nid].currentLocation || "") !== String(now.passage || "")) { reasons.push("npcPresent not here: " + nid); break; }
				}
			}
		}

		// cooldown / once
		var st = (typeof setup.ensureDynamicEvents === "function") ? setup.ensureDynamicEvents() : null;
		if (st) {
			var id = String(def.id || "");
			var cdKey = def.cooldownKey ? String(def.cooldownKey) : String(def.onceKey || id);
			if (def.once || def.onceKey) {
				var okKey = String(def.onceKey || id);
				if (st.once && st.once[okKey]) reasons.push("once already fired");
			}
			if (def.cooldownDays && Number(def.cooldownDays) > 0) {
				var last = st.last && st.last[cdKey];
				if (last && typeof last.day === "number") {
					if ((Number(now.day) - last.day) < Number(def.cooldownDays)) reasons.push("cooldown active");
				}
			}
		}

		// structured require
		if (def.require && typeof setup.questCheckRequire === "function") {
			var ctx2 = { now: now, event: { type: "passage", passage: now.passage, timeKey: now.timeKey } };
			if (!setup.questCheckRequire(def.require, ctx2)) reasons.push("require not met");
		}

		// Note: chance is rolled in picker; here we just display the value (not a hard ineligible)
		return reasons;
	};

	setup.dynamicEventFireNow = setup.dynamicEventFireNow || function (id) {
		setup.ensureDynamicEvents();
		var def = setup.dynamicEventDefs ? setup.dynamicEventDefs[String(id)] : null;
		if (!def) return false;
		return (typeof setup._dynTrigger === "function") ? setup._dynTrigger(def, {}, null) : false;
	};


	// ---------------------------------------------------------
	// Cheats screen (override placeholder with real tools)
	// ---------------------------------------------------------
	setup.phoneRenderCheats = function () {
		var sv = State.variables;
		if (typeof setup.migrateSaveIfNeeded === "function") setup.migrateSaveIfNeeded();
		if (!sv.cheatsState || typeof sv.cheatsState !== "object" || Array.isArray(sv.cheatsState)) {
			sv.cheatsState = { tab: "validation", giftNpcId: "", giftItemId: "", giftQty: 1, dynShowLog: true };
		}

		var tab = String(sv.cheatsState.tab || "validation");

		var html = '';
		html += '<div class="phone-section phone-cheats">';
		html += '  <div class="phone-section-title">Dev Tools</div>';

		// Tabs
		html += '  <div class="phone-chips phone-cheats-tabs">';
		function chip(key, label) {
			html += '    <button class="phone-chip' + (tab === key ? ' active' : '') + '" data-cheats-tab="' + key + '">' + label + '</button>';
		}
		chip("validation", "Validation");
		chip("gift", "Gift tester");
		chip("dyn", "Dynamic events");
		html += '  </div>';

		// ---------------- Validation tab ----------------
		if (tab === "validation") {
			var last = sv.cheatsValidation || null;
			html += '  <div class="phone-cheats-panel">';
			html += '    <div class="phone-cheats-actions">';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-validate="1">Run validation</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-refresh="1">Refresh</button>';
			html += '    </div>';

			if (last && last.time) {
				var t = new Date(Number(last.time) || Date.now());
				html += '    <div class="phone-cheats-meta">Last run: ' + setup._cheatsEscape(t.toLocaleString()) + '</div>';
				html += '    <div class="phone-cheats-summary ' + (last.ok ? 'ok' : 'bad') + '">';
				html += '      ' + (last.ok ? 'OK' : 'Issues found') + ' — Errors: ' + (last.errors ? last.errors.length : 0) + ', Warnings: ' + (last.warnings ? last.warnings.length : 0);
				html += '    </div>';

				function renderList(title, arr, cls) {
					if (!arr || !arr.length) return;
					html += '    <div class="phone-cheats-subtitle">' + title + '</div>';
					html += '    <div class="phone-cheats-list ' + cls + '">';
					for (var i = 0; i < arr.length; i++) {
						var it = arr[i];
						html += '      <div class="phone-cheats-row">' + setup._cheatsEscape(it.msg) + '</div>';
					}
					html += '    </div>';
				}
				renderList("Errors", last.errors, "errs");
				renderList("Warnings", last.warnings, "warns");
			} else {
				html += '    <div class="phone-cheats-muted">Run validation to check items/offers/rules/events.</div>';
			}

			html += '  </div>';
		}

		// ---------------- Gift tester tab ----------------
		if (tab === "gift") {
			setup.ensureGiftState();
			var npcId = String(sv.cheatsState.giftNpcId || "");
			var itemId = String(sv.cheatsState.giftItemId || "");
			var qty = Number(sv.cheatsState.giftQty || 1);
			if (!isFinite(qty) || qty < 1) qty = 1;

			// Defaults: first unlocked npc + first item
			var npcKeys = (sv.npcs && typeof sv.npcs === "object") ? Object.keys(sv.npcs) : [];
			npcKeys.sort(function (a, b) {
				var na = (sv.npcs[a] && sv.npcs[a].name) ? sv.npcs[a].name : a;
				var nb = (sv.npcs[b] && sv.npcs[b].name) ? sv.npcs[b].name : b;
				return String(na).localeCompare(String(nb));
			});

			if (!npcId && npcKeys.length) npcId = npcKeys[0];
			if (!itemId && Array.isArray(setup.shopItems) && setup.shopItems.length) itemId = String(setup.shopItems[0].id || "");

			html += '  <div class="phone-cheats-panel">';
			html += '    <div class="phone-cheats-subtitle">Test gift rule matching</div>';

			// Controls
			html += '    <div class="phone-cheats-form">';
			html += '      <div class="phone-cheats-field"><div class="lbl">NPC</div><select class="phone-cheats-select" data-cheats-gift-npc="1">';
			for (var i = 0; i < npcKeys.length; i++) {
				var id = npcKeys[i];
				var nm = (sv.npcs[id] && sv.npcs[id].name) ? sv.npcs[id].name : id;
				html += '<option value="' + setup._cheatsEscape(id) + '"' + (id === npcId ? ' selected' : '') + '>' + setup._cheatsEscape(nm + ' (' + id + ')') + '</option>';
			}
			html += '      </select></div>';

			html += '      <div class="phone-cheats-field"><div class="lbl">Item</div><select class="phone-cheats-select" data-cheats-gift-item="1">';
			var items = Array.isArray(setup.shopItems) ? setup.shopItems.slice() : [];
			items.sort(function (a, b) { return String(a.name || a.id).localeCompare(String(b.name || b.id)); });
			for (var j = 0; j < items.length; j++) {
				var it = items[j];
				if (!it || !it.id) continue;
				html += '<option value="' + setup._cheatsEscape(it.id) + '"' + (String(it.id) === itemId ? ' selected' : '') + '>' + setup._cheatsEscape((it.name || it.id) + ' (' + it.id + ')') + '</option>';
			}
			html += '      </select></div>';

			html += '      <div class="phone-cheats-field small"><div class="lbl">Qty</div><input class="phone-cheats-input" type="number" min="1" max="999" step="1" value="' + qty + '" data-cheats-gift-qty="1"></div>';
			html += '      <div class="phone-cheats-field"><button class="phone-btn phone-btn-small" data-cheats-gift-run="1">Run</button></div>';
			html += '    </div>';

			// Output
			var list = setup.cheatsListGiftRules(npcId, itemId, qty);
			if (!list.length) {
				html += '    <div class="phone-cheats-muted">No matching gift rules for this NPC+item.</div>';
			} else {
				html += '    <div class="phone-cheats-subtitle">Matched rules (by priority)</div>';
				html += '    <div class="phone-cheats-list">';
				list.forEach(function (r) {
					var lines = setup._cheatsEffectLines(r.effects);
					html += '      <div class="phone-cheats-card">';
					html += '        <div class="row1"><span class="id">' + setup._cheatsEscape(r.id || "(no id)") + '</span><span class="meta">pr:' + (r.priority || 0) + (r.stop ? ' • stop' : '') + '</span></div>';
					html += '        <div class="row2 ' + (r.canFire ? 'ok' : 'bad') + '">' + (r.canFire ? 'Will fire now' : 'Blocked by once/cooldown') + (r.chance != null ? (' • chance ' + r.chance) : '') + '</div>';
					if (lines.length) {
						html += '        <div class="effects">';
						lines.slice(0, 10).forEach(function (ln) { html += '<div class="eff">' + setup._cheatsEscape(ln) + '</div>'; });
						if (lines.length > 10) html += '<div class="eff">…</div>';
						html += '        </div>';
					} else {
						html += '        <div class="effects"><div class="eff muted">(no effects)</div></div>';
					}
					html += '      </div>';
				});
				html += '    </div>';
			}
			html += '  </div>';
		}

		// ---------------- Dynamic events tab ----------------
		if (tab === "dyn") {
			setup.ensureDynamicEvents();
			var st = State.variables.dynEventState;
			var auto = !!State.variables.dynEventsAuto;

			html += '  <div class="phone-cheats-panel">';
			html += '    <div class="phone-cheats-subtitle">Dynamic Events</div>';

			html += '    <div class="phone-cheats-actions">';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-dyn-auto="1">' + (auto ? 'Auto: ON' : 'Auto: OFF') + '</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-dyn-tick="1">Tick (manual)</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-dyn-clearlog="1">Clear log</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-refresh="1">Refresh</button>';
			html += '    </div>';

			// Log
			if (sv.cheatsState.dynShowLog) {
				html += '    <div class="phone-cheats-subtitle">Debug log</div>';
				html += '    <div class="phone-cheats-list log">';
				var log = (st && Array.isArray(st.log)) ? st.log : [];
				var start = Math.max(0, log.length - 20);
				for (var i2 = log.length - 1; i2 >= start; i2--) {
					html += '      <div class="phone-cheats-row muted">' + setup._cheatsEscape(log[i2]) + '</div>';
				}
				if (!log.length) html += '      <div class="phone-cheats-row muted">(empty)</div>';
				html += '    </div>';
			}

			// Events list
			var defs = setup.dynamicEventDefs || {};
			var keys = Object.keys(defs);
			keys.sort();
			html += '    <div class="phone-cheats-subtitle">Events</div>';
			if (!keys.length) {
				html += '    <div class="phone-cheats-muted">No dynamic events defined.</div>';
			} else {
				html += '    <div class="phone-cheats-list">';
				keys.forEach(function (id) {
					var def = defs[id];
					if (!def) return;
					def.id = String(def.id || id);

					var eligible = (typeof setup._dynEligible === "function") ? setup._dynEligible(def, {}, false) : false;
					var reasons = eligible ? [] : setup.dynExplainIneligible(def, false);
					var chance = (def.chance == null ? null : Number(def.chance));
					var pr = (typeof def.priority === "number") ? def.priority : 0;

					// last fired
					var cdKey = def.cooldownKey ? String(def.cooldownKey) : String(def.onceKey || def.id);
					var last = st && st.last ? st.last[cdKey] : null;

					html += '      <div class="phone-cheats-card">';
					html += '        <div class="row1"><span class="id">' + setup._cheatsEscape(def.id) + '</span><span class="meta">pr:' + pr + (chance != null ? (' • chance ' + chance) : '') + '</span></div>';
					html += '        <div class="row2 ' + (eligible ? 'ok' : 'bad') + '">' + (eligible ? 'Eligible now' : ('Not eligible: ' + setup._cheatsEscape(reasons.slice(0, 2).join(", ") || "blocked"))) + '</div>';
					html += '        <div class="row3 muted">scene: ' + setup._cheatsEscape(def.sceneId || "(none)") + (last && typeof last.day === "number" ? (' • last: day ' + last.day + ' @ ' + (last.passage || "?")) : '') + '</div>';
					html += '        <div class="row4 actions"><button class="phone-btn phone-btn-small" data-cheats-dyn-fire="' + setup._cheatsEscape(def.id) + '">Fire now</button></div>';
					html += '      </div>';
				});
				html += '    </div>';
			}

			html += '  </div>';
		}

		html += '</div>';
		return html;
	};


	// ---------------------------------------------------------
	// Bind new cheats handlers after phoneRender()
	// ---------------------------------------------------------
	setup.phoneBindCheatsHandlers = function ($content) {
		if (!$content || !$content.find) return;

		$content.find("[data-cheats-tab]").off("click.cheatsTab").on("click.cheatsTab", function () {
			var sv = State.variables;
			sv.cheatsState = sv.cheatsState || {};
			sv.cheatsState.tab = $(this).attr("data-cheats-tab") || "validation";
			setup.phoneRender();
		});

		$content.find("[data-cheats-refresh]").off("click.cheatsRefresh").on("click.cheatsRefresh", function () {
			setup.phoneRender();
		});

		$content.find("[data-cheats-validate]").off("click.cheatsValidate").on("click.cheatsValidate", function () {
			var sv = State.variables;
			sv.cheatsValidation = setup.validateCatalogs({ strict: false });
			setup.phoneRender();
		});

		// Gift tester controls
		$content.find("[data-cheats-gift-npc]").off("change.cheatsGiftNpc").on("change.cheatsGiftNpc", function () {
			var sv = State.variables;
			sv.cheatsState = sv.cheatsState || {};
			sv.cheatsState.giftNpcId = $(this).val() || "";
		});
		$content.find("[data-cheats-gift-item]").off("change.cheatsGiftItem").on("change.cheatsGiftItem", function () {
			var sv = State.variables;
			sv.cheatsState = sv.cheatsState || {};
			sv.cheatsState.giftItemId = $(this).val() || "";
		});
		$content.find("[data-cheats-gift-qty]").off("input.cheatsGiftQty change.cheatsGiftQty").on("input.cheatsGiftQty change.cheatsGiftQty", function () {
			var sv = State.variables;
			sv.cheatsState = sv.cheatsState || {};
			var v = Number($(this).val() || 1);
			if (!isFinite(v) || v < 1) v = 1;
			sv.cheatsState.giftQty = v;
		});
		$content.find("[data-cheats-gift-run]").off("click.cheatsGiftRun").on("click.cheatsGiftRun", function () {
			setup.phoneRender();
		});

		// Dynamic events controls
		$content.find("[data-cheats-dyn-auto]").off("click.cheatsDynAuto").on("click.cheatsDynAuto", function () {
			var sv = State.variables;
			sv.dynEventsAuto = !sv.dynEventsAuto;
			setup.phoneRender();
		});
		$content.find("[data-cheats-dyn-clearlog]").off("click.cheatsDynClear").on("click.cheatsDynClear", function () {
			var st = setup.ensureDynamicEvents();
			st.log = [];
			setup.phoneRender();
		});
		$content.find("[data-cheats-dyn-tick]").off("click.cheatsDynTick").on("click.cheatsDynTick", function () {
			var n = (typeof setup.dynamicEventsTick === "function") ? setup.dynamicEventsTick({ manual: true, max: 1 }) : 0;
			try { if (typeof setup.toast === "function") setup.toast("Dyn tick: " + n, "info", 1200); } catch (e) {}
			setup.phoneRender();
		});
		$content.find("[data-cheats-dyn-fire]").off("click.cheatsDynFire").on("click.cheatsDynFire", function () {
			var id = $(this).attr("data-cheats-dyn-fire") || "";
			var ok = setup.dynamicEventFireNow(id);
			try { if (typeof setup.toast === "function") setup.toast(ok ? ("Fired: " + id) : ("Failed: " + id), ok ? "success" : "error", 1400); } catch (e) {}
			setup.phoneRender();
		});
	};

	// Wrap phoneRender() once to bind our extra handlers
	if (!setup.__patch8_wrapPhoneRender && typeof setup.phoneRender === "function") {
		setup.__patch8_wrapPhoneRender = true;
		var _oldPhoneRender = setup.phoneRender;
		setup.phoneRender = function () {
			_oldPhoneRender.apply(this, arguments);
			try {
				var $c = jQuery("#phone-overlay .phone-content");
				setup.phoneBindCheatsHandlers($c);
			} catch (e) { /* ignore */ }
		};
	}
})();


:: MINIPHONEPLUS_PATCH8_DEVTOOLS_CSS [stylesheet]
/* PATCH8: Dev tools styling (lightweight) */
.phone-cheats .phone-cheats-panel { margin-top: 10px; }
.phone-cheats .phone-cheats-actions { display:flex; gap:8px; flex-wrap:wrap; margin:8px 0 10px; }
.phone-cheats .phone-cheats-meta { opacity:.75; font-size:12px; margin:6px 0; }
.phone-cheats .phone-cheats-summary { padding:8px 10px; border-radius:12px; margin:8px 0; }
.phone-cheats .phone-cheats-summary.ok { background: rgba(70, 200, 120, .15); }
.phone-cheats .phone-cheats-summary.bad { background: rgba(240, 90, 90, .15); }
.phone-cheats .phone-cheats-subtitle { font-weight:700; margin:10px 0 6px; }
.phone-cheats .phone-cheats-muted { opacity:.75; font-size:13px; margin:8px 0; }
.phone-cheats .phone-cheats-list { display:flex; flex-direction:column; gap:6px; }
.phone-cheats .phone-cheats-list.log { max-height: 220px; overflow:auto; }
.phone-cheats .phone-cheats-row { padding:6px 8px; border-radius:10px; background: rgba(255,255,255,.06); }
.phone-cheats .phone-cheats-row.muted { opacity:.75; }
.phone-cheats .phone-cheats-card { padding:10px 10px; border-radius:14px; background: rgba(255,255,255,.08); }
.phone-cheats .phone-cheats-card .row1 { display:flex; justify-content:space-between; gap:10px; }
.phone-cheats .phone-cheats-card .row1 .id { font-weight:700; }
.phone-cheats .phone-cheats-card .row1 .meta { opacity:.75; font-size:12px; white-space:nowrap; }
.phone-cheats .phone-cheats-card .row2 { margin-top:6px; font-size:13px; }
.phone-cheats .phone-cheats-card .row2.ok { color: rgba(120,240,170,1); }
.phone-cheats .phone-cheats-card .row2.bad { color: rgba(255,160,160,1); }
.phone-cheats .phone-cheats-card .row3 { margin-top:6px; font-size:12px; opacity:.75; }
.phone-cheats .phone-cheats-card .row4.actions { margin-top:8px; }
.phone-cheats .phone-cheats-form { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; }
.phone-cheats .phone-cheats-field { display:flex; flex-direction:column; gap:4px; min-width: 180px; }
.phone-cheats .phone-cheats-field.small { min-width: 90px; width: 90px; }
.phone-cheats .phone-cheats-field .lbl { font-size:12px; opacity:.75; }
.phone-cheats .phone-cheats-select, .phone-cheats .phone-cheats-input {
  padding:8px 10px; border-radius:12px; border:1px solid rgba(255,255,255,.15);
  background: rgba(0,0,0,.20); color: inherit;
}
.phone-cheats .effects { margin-top:8px; display:flex; flex-direction:column; gap:4px; }
.phone-cheats .eff { font-size:12px; opacity:.9; }
.phone-cheats .eff.muted { opacity:.6; }


:: MINIPHONEPLUS_PATCH9_REWARDS_GATE_RELATIONS_QUESTPROGRESS_CLOCK_INDEX_DEV [script]

/* ============================================================
   PATCH9: Rewards + Gate 2.0 + Quest step progress + Clock + Indexes + Dev Mode
   - Adds setup.applyRewards(rewards, ctx)
   - Adds setup.canSeeContent(rule, ctx) with reasons
   - Enhances dynamic events with gate + rewards
   - Enhances quests with counter/collect/timer/visit steps + (x/y) display
   - Ensures relation levels update when npc stats change; emits events
   - World clock helpers + dayChanged event + <<addDays>> macro
   - Index rebuild helpers for faster lookup + devtools buttons
   ============================================================ */
(function () {
	if (setup.__PATCH9_CORE_UPGRADES) return;
	setup.__PATCH9_CORE_UPGRADES = true;

	// ------------------------------
	// DEV MODE (safe)
	// ------------------------------
	setup.ensureDevMode = function () {
		var sv = (typeof State !== "undefined" && State.variables) ? State.variables : null;
		if (!sv) return false;
		if (typeof sv.devMode !== "boolean") {
			try { sv.devMode = !!(typeof Config !== "undefined" && Config && Config.debug); }
			catch (e) { sv.devMode = true; }
		}
		return sv.devMode;
	};
	setup.isDev = function () {
		var sv = (typeof State !== "undefined" && State.variables) ? State.variables : null;
		if (!sv) return true;
		if (typeof sv.devMode !== "boolean") setup.ensureDevMode();
		return !!sv.devMode;
	};
	setup.setDevMode = function (v) {
		var sv = (typeof State !== "undefined" && State.variables) ? State.variables : null;
		if (!sv) return false;
		sv.devMode = !!v;
		return sv.devMode;
	};

	// ------------------------------
	// small utils
	// ------------------------------
	setup.pushCapped = function (arr, item, cap) {
		if (!Array.isArray(arr)) return arr;
		cap = Number(cap || 0);
		if (!isFinite(cap) || cap <= 0) { arr.push(item); return arr; }
		arr.push(item);
		if (arr.length > cap) arr.splice(0, arr.length - cap);
		return arr;
	};

	// ------------------------------
	// INDEXES (fast lookup)
	// ------------------------------
	setup.rebuildIndexes = function (force) {
		setup.__idx = setup.__idx || { _stamp: 0 };
		var idx = setup.__idx;

		// light "stamp" to detect changes
		var stamp = 0;
		try {
			stamp =
				((setup.shopItems && setup.shopItems.length) ? setup.shopItems.length : 0) * 1000000 +
				((setup.shopOffers && setup.shopOffers.length) ? setup.shopOffers.length : 0) * 1000 +
				((setup.giftRules && setup.giftRules.length) ? setup.giftRules.length : 0);
		} catch (e) { stamp = Date.now(); }

		if (!force && idx._stamp === stamp && idx.itemById && idx.offerById) return idx;

		idx._stamp = stamp;
		idx.itemById = {};
		idx.offerById = {};
		idx.giftRuleById = {};

		try {
			var items = Array.isArray(setup.shopItems) ? setup.shopItems : [];
			for (var i = 0; i < items.length; i++) {
				var it = items[i];
				if (it && it.id) idx.itemById[String(it.id)] = it;
			}
		} catch (e) {}

		try {
			var offers = Array.isArray(setup.shopOffers) ? setup.shopOffers : [];
			for (var j = 0; j < offers.length; j++) {
