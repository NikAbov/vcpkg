	setup.invRemove(itemId, 1);
	if (setup.toast) setup.toast("Discarded", "info", 1200);
	setup.phoneRender();
});

// Inventory use (uses selected qty if available; reusable items clamp to 1)
$content.find("[data-inv-use]").off("click.invUse").on("click.invUse", function (ev) {
	if (ev && ev.stopPropagation) ev.stopPropagation();
	var itemId = $(this).attr("data-inv-use");
	if (!itemId) return;

	var q = 1;
	if (State.variables.invUseQty && typeof State.variables.invUseQty[itemId] === "number") {
		q = Number(State.variables.invUseQty[itemId] || 1);
		if (!isFinite(q) || q < 1) q = 1;
	}
	if (typeof setup.invClampUseQty === "function") q = setup.invClampUseQty(itemId, q);
	setup.invUseItem(itemId, q);
	setup.phoneRender();
});

// Inventory use qty chips
$content.find("[data-inv-useqty]").off("click.invUseQty").on("click.invUseQty", function (ev) {
	if (ev && ev.stopPropagation) ev.stopPropagation();
	var itemId = $(this).attr("data-item-id") || (State.variables.phoneScreenData ? State.variables.phoneScreenData.itemId : "");
	var n = Number($(this).attr("data-inv-useqty") || 1);
	if (!State.variables.invUseQty || typeof State.variables.invUseQty !== "object") State.variables.invUseQty = {};
	if (!isFinite(n) || n < 1) n = 1;
	if (typeof setup.invClampUseQty === "function") n = setup.invClampUseQty(itemId, n);
	State.variables.invUseQty[itemId] = n;
	setup.phoneRender();
});



