				var qid = String(r.questStart || "");
				safe(function () {
					if (typeof setup.questStart === "function") setup.questStart(qid);
				}, "questStart");
				continue;
			}

			if (r.questComplete) {
				var qc = String(r.questComplete || "");
				safe(function () {
					if (typeof setup.questComplete === "function") setup.questComplete(qc);
				}, "questComplete");
				continue;
			}

			if (r.npcStat && typeof r.npcStat === "object") {
				var npcId = String(r.npcId || (ctx && ctx.npcId) || "");
				safe(function () {
					if (!npcId) return;
					var keys = Object.keys(r.npcStat);
					for (var k = 0; k < keys.length; k++) {
						var sk = keys[k];
						var dv = Number(r.npcStat[sk] || 0);
						if (!isFinite(dv) || dv === 0) continue;
						if (typeof setup.addNpcStat === "function") setup.addNpcStat(npcId, sk, dv);
					}
				}, "npcStat");
				continue;
			}

			if (r.heroStat && typeof r.heroStat === "object") {
				safe(function () {
					var keys2 = Object.keys(r.heroStat);
					for (var k2 = 0; k2 < keys2.length; k2++) {
						var hk = keys2[k2];
						var dv2 = Number(r.heroStat[hk] || 0);
						if (!isFinite(dv2) || dv2 === 0) continue;
						if (typeof setup.addHeroStat === "function") setup.addHeroStat(hk, dv2);
						else if (typeof setup.setHeroStat === "function" && typeof setup.getHeroStat === "function") {
