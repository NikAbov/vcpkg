:: 18 check {"position":"200,300","size":"100,100"}
<<run setup.initGameState()>>
<<if !$contentLocked>>
''Выбор категорий контента делается один раз и сохраняется для этого сейва.''

<<set _trans = $contentSettings.trans>>
<<set _nsfw = $contentSettings.nsfw>>
<<set _violence = $contentSettings.violence>>
<<set _futa = $contentSettings.futa>>

* <<checkbox "_trans" true false>> Trans контент
* <<checkbox "_nsfw" true false>> NSFW/эротика
* <<checkbox "_violence" true false>> Насилие
* <<checkbox "_futa" true false>> Futa

<<button "Применить и начать">>
	<<run setup.applyContentChoice({ trans:_trans, nsfw:_nsfw, violence:_violence, futa:_futa })>>
	<<goto "home">>
<</button>>

<<button "Без чувствительного">>
	<<run setup.applyContentChoice({ trans:false, nsfw:false, violence:true, futa:false })>>
	<<goto "home">>
<</button>>

<<button "Включить всё">>
	<<run setup.applyContentChoice({ trans:true, nsfw:true, violence:true, futa:true })>>
	<<goto "home">>
<</button>>
<<else>>
<<goto "home">>
<</if>>

