			name      : "Residential area",
			passage   : "residental",
			//description: "Тихое место для размышлений.",
			//timeCost  : 1,
			energyCost: 5,
			x         : 91.29,
			y         : 83.75,	
			icon      : "src/icon/area.png"
		},
      
      	
      
		{
			id        : "cityhall",
			name      : "City Hall",
			passage   : "cityhall",
			//description: "Можно перекусить и встретить людей.",
			//timeCost  : 1,
			energyCost: 3,
			x         : 24,
			y         : 28.37,			
			icon      : "src/icon/hall.png"
		}
	];

	// Найти локацию по id
	setup.mapGetLocationById = function (id) {
		if (!id || !Array.isArray(setup.mapLocations)) {
			return null;
		}
		for (var i = 0; i < setup.mapLocations.length; i++) {
			if (setup.mapLocations[i].id === id) {
				return setup.mapLocations[i];
			}
		}
		return null;
	};

	// Локации, которые видны игроку (пока показываем все)
	setup.mapGetVisibleLocations = function () {
		return Array.isArray(setup.mapLocations) ? setup.mapLocations : [];
	};

	// Можно ли переместиться к локации
	setup.mapCanTravelTo = function (loc, sv) {
		if (!loc) return false;
		if (!sv) sv = State.variables;

		// Пример: запрещаем, если не хватает энергии
		if (typeof loc.energyCost === "number" && loc.energyCost > 0 && typeof sv.heroEnergy === "number") {
			if (sv.heroEnergy < loc.energyCost) {
				return false;
			}
		}
		return true;
	};

	// Человекочитаемое название текущей локации
	setup.mapGetCurrentLocationName = function () {
		var sv = State.variables;
		var id = sv.currentLocationId;
		if (!id) {
			return "Unknown";
		}
		var loc = setup.mapGetLocationById(id);
		return loc ? loc.name : "Unknown";
	};

	// Переход по клику в карте
	setup.mapTravel = function (locId) {
		var sv  = State.variables;
		var loc = setup.mapGetLocationById(locId);

		if (!loc) {
			UI.alert("Эта локация пока не настроена: " + locId);
			return;
		}

		if (!setup.mapCanTravelTo(loc, sv)) {
			UI.alert("Ты сейчас не можешь туда отправиться.");
			return;
		}

		// Закрываем карту
		if (typeof setup.mapCloseOverlay === "function") {
			setup.mapCloseOverlay();
		}

		// Энергия
		if (typeof loc.energyCost === "number" && typeof sv.heroEnergy === "number") {
			var cost = loc.energyCost;
			if (cost > 0) {
				sv.heroEnergy -= cost;
				if (sv.heroEnergy < 0) sv.heroEnergy = 0;
			}
		}

		// Время
		if (typeof loc.timeCost === "number" && loc.timeCost > 0 && typeof setup.advanceTime === "function") {
			setup.advanceTime(loc.timeCost);
		}

		// Запоминаем текущую локацию
		sv.currentLocationId = loc.id;

		// Переходим в пассаж
		if (loc.passage && Story.has(loc.passage)) {
			Engine.play(loc.passage);
		} else {
			UI.alert('Пассаж для локации "' + loc.name + '" не найден: ' + (loc.passage || "не указан"));
		}
	};

	// Гарантируем, что оверлей карты есть в DOM
	setup.mapEnsureOverlay = function () {
		if ($("#map-overlay").length) {
			return;
		}

		var html = '' +
			'<div id="map-overlay" class="game-overlay">' +
			'  <div class="map-overlay-backdrop"></div>' +
			'  <div class="map-overlay-window">' +
			'    <div class="map-overlay-header">' +
			'      <span class="map-overlay-title">Карта</span>' +
			'      <button class="map-overlay-close" type="button">&times;</button>' +
			'    </div>' +
			'    <div class="map-overlay-body">' +
			'      <div id="map-overlay-content"></div>' +
			'    </div>' +
			'  </div>' +
			'</div>';

		$("body").append(html);

		var $ov = $("#map-overlay");

		$ov.find(".map-overlay-close, .map-overlay-backdrop").on("click", function () {
			setup.mapCloseOverlay();
		});
	};

	// Открыть / закрыть оверлей карты
	setup.mapOpenOverlay = function () {
		setup.mapEnsureOverlay();
		setup.mapRenderOverlay();
		$("#map-overlay").addClass("visible");
	};

	setup.mapCloseOverlay = function () {
		$("#map-overlay").removeClass("visible");
	};

	// Отрисовка содержимого карты: фон + иконки
	setup.mapRenderOverlay = function () {
		var sv     = State.variables;
		var locs   = setup.mapGetVisibleLocations();
		var hereId = sv.currentLocationId || null;

		var $content = $("#map-overlay-content");
		$content.empty();

		var html = '';

		html += '<div class="map-screen-current">Сейчас: ' +
			'<span class="map-screen-current-name">' +
			setup.escapeHtml(setup.mapGetCurrentLocationName()) +
			'</span>' +
			'<span class="map-screen-current-npc-icons"></span>' +
			'</div>';

		// фон карты зависит от времени суток, используем те же картинки, что и для пассажа "map"
		var timeKey   = setup.getTimeOfDayKey ? setup.getTimeOfDayKey() : "day";
		var mapBgPath = (setup.backgroundBasePath || "") + "map-" + timeKey + ".png";

		html += '<div class="map-image-wrapper">';
		html += '  <img src="' + mapBgPath + '" class="map-image" alt="Map">';

		locs.forEach(function (loc) {
			var disabled = !setup.mapCanTravelTo(loc, sv);
			var isHere   = (loc.id === hereId);

			var classes = ["map-pin"];
			if (disabled) classes.push("map-pin-disabled");
			if (isHere)   classes.push("map-pin-current");

			// Подсказка показывает имя пассажа, а не NPC
			var tips = [];

			if (loc.passage) {
				// Показываем имя пассажа (идентификатор твина)
				tips.push("Пассаж: " + loc.passage);
			} else if (loc.name) {
				// Или просто имя локации, если пассажа нет
				tips.push(loc.name);
			}

			var title = tips.join(" | ");

			var left = (typeof loc.x === "number" ? loc.x : 50);
			var top  = (typeof loc.y === "number" ? loc.y : 50);

			html += '<button class="' + classes.join(" ") + '"' +
			    ' type="button"' +
			    ' data-map-id="' + loc.id + '"' +
			    ' style="left:' + left + '%; top:' + top + '%;"' +
    (title ? ' title="' + setup.escapeHtml(title) + '"' : '') +
    '>';

var iconSrc = loc.icon || "src/img/map/default-pin.png";

html += '<img class="map-pin-icon" src="' + iconSrc + '" alt="">';


// Если хочешь вернуть текстовое название локации на пине — раскомментируй:
// html += '<span class="map-pin-label">' + setup.escapeHtml(loc.name) + '</span>';

html += '</button>';
		});

		html += '</div>'; // .map-image-wrapper

		$content.append(html);

		$content.find(".map-pin").off("click.map").on("click.map", function () {
			var locId = $(this).attr("data-map-id");
			if (locId) {
				setup.mapTravel(locId);
			}
		});
	};
	/* ИКОНОК ДЛЯ КНОПОК (PNG)
	   ------------------------------------------------------------------ */

	setup.uiIcons = {
		map      : "src/icon/map.png",       // кнопка "Карта"
		inventory: "src/icon/case.png", // кнопка "Инвентарь"
		save     : "src/icon/save.png",       // кнопка "Сохранить"
      	timeNext : "src/icon/time.png"   // ← новая иконка для переключения времени
		// в будущем можно добавить, например:
		// quests: "img/ui/icon_quests.png",
		// settings: "img/ui/icon_settings.png",
	};

  
  
  
  	/* ------------------------------------------------------------------
	   Применяем иконки к кнопкам по атрибуту data-ui-icon
	   ------------------------------------------------------------------ */

	setup.refreshButtonIcons = function () {
		if (!setup.uiIcons) {
			return;
		}

		$("[data-ui-icon]").each(function () {
			var $img = $(this);
			var key = $img.attr("data-ui-icon");

			if (!key) {
				return;
			}

			var path = setup.uiIcons[key];

			if (path) {
				$img.attr("src", path);
				$img.attr("alt", key);
				$img.show();
			} else {
				// Если для такого ключа нет иконки — можно скрыть картинку
				$img.hide();
			}
		});
	};

  
  
  
  
	/* ------------------------------------------------------------------
	   ЛОГИКА ПРОГОНА ВРЕМЕНИ (утро → день → вечер → ночь → +день)
	   ------------------------------------------------------------------ */

	/**
	 * Сдвигает время на указанное количество шагов.
	 * 1 шаг = следующий этап суток.
	 * После ночи увеличивает счётчик дней и день недели.
	 */
	setup.advanceTime = function (steps) {
		if (typeof steps !== "number" || steps < 1) {
			steps = 1;
		}

		var sv = State.variables;
		var prevDay = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;
		var timeLen = setup.timeOfDayKeys.length;
		var i;

		for (i = 0; i < steps; i++) {
			sv.timeOfDayIndex++;

			if (sv.timeOfDayIndex >= timeLen) {
				// Завершился цикл утро–день–вечер–ночь
				sv.timeOfDayIndex = 0;
				sv.dayCounter += 1;
				sv.weekdayIndex = (sv.weekdayIndex + 1) % setup.weekdayNames.length;
			}
		}

		// Deliver orders if day changed
		if (typeof setup.shopProcessDeliveries === "function" && sv.dayCounter !== prevDay) {
			setup.shopProcessDeliveries();
		}

		// Refresh shop offers (restock rules) if day changed
		if (typeof setup.shopRefreshAllVendors === "function" && sv.dayCounter !== prevDay) {
			setup.shopRefreshAllVendors();
		}

		// Обновляем визуал в UI-баре
		setup.updateCustomUIBar();
	};

  
  	/* ------------------------------------------------------------------
	   МАКРОС <<advanceTime>> ДЛЯ ИГРЫ
	   Использование:
	     <<advanceTime>>        – сдвинуть время на 1 шаг
	     <<advanceTime 2>>      – сдвинуть время на 2 шага
	   ------------------------------------------------------------------ */
	if (typeof Macro === "object" && Macro.add) {
		if (!Macro.has("advanceTime")) Macro.add("advanceTime", {
			skipArgs: false,
			handler : function () {
				var steps = 1;

				if (this.args.length > 0) {
					var n = parseInt(this.args[0], 10);
					if (!Number.isFinite(n) || n < 1) {
						return this.error(
							"Неверный аргумент. Используй <<advanceTime>> или <<advanceTime 2>> и т.п."
						);
					}
					steps = n;
				}

				setup.advanceTime(steps);
			}
		});
	}

  
  
  
	/* ------------------------------------------------------------------
	   СОЗДАНИЕ КАСТОМНОГО UI-БАРА
	   ------------------------------------------------------------------ */

	setup.createCustomUIBar = function () {
		// На всякий случай, если уже создан — ничего не делаем
		if ($("#custom-ui-bar").length > 0) {
			return;
		}

				// Каркас UI-бара
		var html =
			'<div id="custom-ui-bar">' +
			'  <div id="custom-ui-time-row">' +
			'    <img class="time-icon" data-time="morning" src="src/icon/morning.png" alt="Morning">' +
			'    <img class="time-icon" data-time="day" src="src/icon/day.png" alt="Day">' +
			'    <img class="time-icon" data-time="evening" src="src/icon/evening.png" alt="Evening">' +
			'    <img class="time-icon" data-time="night" src="src/icon/night.png" alt="Night">' +
            '    <button id="custom-ui-btn-nexttime" class="time-next-btn" title="Следующее время суток">' +
'      <img class="time-icon time-next-icon" data-ui-icon="timeNext" src="" alt="Следующее время">' +
'    </button>' +
			"  </div>" +
			'  <div id="custom-ui-weekday">' +
			'    <span id="custom-ui-weekday-label"></span>' +
			"  </div>" +

			// 🧍‍♂️ БЛОК ХАРАКТЕРИСТИК ГЕРОЯ
			'  <div id="custom-ui-hero">' +
			'    <div id="custom-ui-hero-header">' +
			'      <span id="custom-ui-hero-name"></span>' +
			'      <span id="custom-ui-hero-money"></span>' +
			"    </div>" +
			
			'    <div class="custom-ui-hero-stat">' +
			'      <span class="hero-stat-label">Energy</span>' +
			'      <div class="hero-stat-bar"><div class="hero-stat-fill" data-hero-stat="energy"></div></div>' +
			"    </div>" +
            
            
            '    <div class="custom-ui-hero-stat">' +
			'      <span class="hero-stat-label">Strength</span>' +
			'      <div class="hero-stat-bar"><div class="hero-stat-fill" data-hero-stat="str"></div></div>' +
			"    </div>" +
            
            
            '    <div class="custom-ui-hero-stat">' +
			'      <span class="hero-stat-label">Charisma</span>' +
			'      <div class="hero-stat-bar"><div class="hero-stat-fill" data-hero-stat="char"></div></div>' +
			"    </div>" +
             
            '    <div class="custom-ui-hero-stat">' +
			'      <span class="hero-stat-label">Authority</span>' +
			'      <div class="hero-stat-bar"><div class="hero-stat-fill" data-hero-stat="aut"></div></div>' +
			"    </div>" +
                     
			'    <div class="custom-ui-hero-stat">' +
			'      <span class="hero-stat-label">Intellect</span>' +
			'      <div class="hero-stat-bar"><div class="hero-stat-fill" data-hero-stat="int"></div></div>' +
			"    </div>" +
			"  </div>" +

			'  <div id="custom-ui-phone-wrapper">' +
			'    <div id="custom-ui-phone">' +
			'      <div id="custom-ui-phone-screen">' +
			'        <div id="custom-ui-phone-badge"></div>' +
			'        <div id="custom-ui-phone-appbadges"></div>' +
			'        <div id="custom-ui-phone-banner" role="button" tabindex="0" aria-label="Notification"></div>' +
			"      </div>" +
			'      <div id="custom-ui-phone-bubbles"></div>' +
			"    </div>" +
			"  </div>" +
			'  <div id="custom-ui-buttons">' +
			'    <button id="custom-ui-btn-map" class="custom-ui-btn">' +
			'      <img class="custom-ui-btn-icon" data-ui-icon="map" src="" alt="Map">' +
			'      <span class="custom-ui-btn-label">Map</span>' +
			"    </button>" +
			'    <button id="custom-ui-btn-inventory" class="custom-ui-btn">' +
			'      <img class="custom-ui-btn-icon" data-ui-icon="inventory" src="" alt="Inventory">' +
			'      <span class="custom-ui-btn-label">Inventory</span>' +
			"    </button>" +
			'    <button id="custom-ui-btn-save" class="custom-ui-btn">' +
			'      <img class="custom-ui-btn-icon" data-ui-icon="save" src="" alt="Save">' +
			'      <span class="custom-ui-btn-label">Save</span>' +
			"    </button>" +
			"  </div>" +
			"</div>";

		// Вставляем бар в начало #story (основной контейнер SugarCube)
		$("#story").prepend(html);

		// Клик по телефону → открыть всплывающее окно
		$("#custom-ui-phone").on("click", function () {
			setup.openPhoneDialog();
		});

		// Deep-links on mini-phone (badge / app icons / bubbles / banner)
		$("#custom-ui-phone")
			.off("click.miniDeepBadge", "#custom-ui-phone-badge")
			.on("click.miniDeepBadge", "#custom-ui-phone-badge", function (e) {
				e.preventDefault();
				e.stopPropagation();
				setup.phoneMiniOpen("notifs");
			});

		$("#custom-ui-phone")
			.off("click.miniDeepApp", ".mini-app-badge-item")
			.on("click.miniDeepApp", ".mini-app-badge-item", function (e) {
				e.preventDefault();
				e.stopPropagation();
				var app = $(this).attr("data-mini-app") || "";
				if (app) setup.phoneMiniOpen(app);
			});

		$("#custom-ui-phone")
			.off("click.miniDeepBubble", ".phone-bubble")
			.on("click.miniDeepBubble", ".phone-bubble", function (e) {
				e.preventDefault();
				e.stopPropagation();
				var open = $(this).attr("data-mini-open") || "";
				if (open) {
					setup.phoneMiniOpen(open);
					return;
				}
				var app = $(this).attr("data-mini-app") || "";
				var npcId = $(this).attr("data-npc-id") || "";
				if (app) setup.phoneMiniOpen(app, npcId);
			});

		$("#custom-ui-phone")
			.off("click.miniDeepBanner", "#custom-ui-phone-banner")
			.on("click.miniDeepBanner", "#custom-ui-phone-banner", function (e) {
				// banner can be empty/hidden
				var $b = $(this);
				if (!$b.hasClass("visible")) return;
				e.preventDefault();
				e.stopPropagation();
				var open = $b.attr("data-mini-open") || "";
				if (open) { setup.phoneMiniOpen(open); return; }
				var app = $b.attr("data-mini-app") || "";
				var npcId = $b.attr("data-npc-id") || "";
				if (app) setup.phoneMiniOpen(app, npcId);
			});

      // Кнопка смены времени суток
$("#custom-ui-btn-nexttime").on("click", function () {
	// 1) двигаем время на один шаг (утро → день → вечер → ночь → +день)
	setup.advanceTime(1);

	// 2) перезагружаем текущий пассаж, чтобы обновился текст
	// State.passage содержит имя активного пассажа
	Engine.play(State.passage);
});

      
		// Кнопка "Карта" → открыть оверлей карты
		$("#custom-ui-btn-map").on("click", function () {
			if (typeof setup.mapOpenOverlay === "function") {
				setup.mapOpenOverlay();
			} else if (Story.has("Map")) {
				// запасной вариант: если оверлей не инициализирован, переходим в пассаж "Map"
				Engine.play("Map");
			} else {
				UI.alert('Пассаж "Map" пока не создан.');
			}
		});

		// Кнопка "Инвентарь" → перейти в пассаж "Inventory" (если он существует)
		$("#custom-ui-btn-inventory").on("click", function () {
			// Open inventory inside the phone (single source of truth)
			setup.phoneGo("invHome");
			setup.openPhoneDialog();
		});

		// Кнопка "Сохранить" → стандартное диалоговое окно сохранений SugarCube 
		$("#custom-ui-btn-save").on("click", function () {
			UI.saves();
		});
	};

  
  	/* ------------------------------------------------------------------
	   ОБНОВЛЕНИЕ БЛОКА ХАРАКТЕРИСТИК ГЕРОЯ
	   ------------------------------------------------------------------ */

	setup.updateHeroUI = function () {
		if ($("#custom-ui-hero").length === 0) {
			return;
		}

		var sv = State.variables;

		var name = typeof sv.heroName === "string" ? sv.heroName : "Герой";
		var money =
			typeof sv.heroMoney === "number" ? sv.heroMoney : 0;

		$("#custom-ui-hero-name").text(name);
		$("#custom-ui-hero-money").text(money + " $"); // можно заменить символ валюты

		function clamp01(x) {
			if (!Number.isFinite(x)) return 0;
			if (x < 0) return 0;
			if (x > 100) return 100;
			return x;
		}

		var int = clamp01(sv.heroInt);
		var energy = clamp01(sv.heroEnergy);
		var str = clamp01(sv.heroStr);
      	var aut = clamp01(sv.heroAut);
      	var char = clamp01(sv.heroChar);

		$('[data-hero-stat="int"]').css("width", int + "%");
      	$('[data-hero-stat="str"]').css("width", str + "%");
     	$('[data-hero-stat="aut"]').css("width", aut + "%");
		$('[data-hero-stat="energy"]').css("width", energy + "%");
		$('[data-hero-stat="char"]').css("width", char + "%");
	};

  
  
  
	/* ------------------------------------------------------------------
	   ОБНОВЛЕНИЕ UI-БАРА (время суток, день недели, телефон)
	   ------------------------------------------------------------------ */

	setup.updateCustomUIBar = function () {
		// Если по какой-то причине бар ещё не создан — выходим
		if ($("#custom-ui-bar").length === 0) {
			return;
		}

		var sv = State.variables;
      
      // --- ФОН UI-БАРА ---
		var bg =
			typeof sv.uiBarBg === "string" && sv.uiBarBg
				? sv.uiBarBg
				: null;

		if (bg) {
			$("#custom-ui-bar").css({
				"background-image"   : 'url("' + bg + '")',
				"background-size"    : "cover",
				"background-position": "center top",
				"background-repeat"  : "no-repeat"
			});
		} else {
			// fallback: просто цвет, если вдруг нет картинки
			$("#custom-ui-bar").css({
				"background-image": "none"
			});
		}
      

		// --- ВРЕМЯ СУТОК (подсветка активной иконки) ---
		var timeKey =
			setup.timeOfDayKeys[sv.timeOfDayIndex] || setup.timeOfDayKeys[0];

		$("#custom-ui-time-row .time-icon").each(function () {
			var $icon = $(this);
			if ($icon.attr("data-time") === timeKey) {
				$icon.addClass("active");
			} else {
				$icon.removeClass("active");
			}
		});

		// --- ДЕНЬ НЕДЕЛИ ---
		var weekdayName = setup.weekdayNames[sv.weekdayIndex] || "";
		$("#custom-ui-weekday-label").text(weekdayName);

		// --- ТЕЛЕФОН: обои ---
		var wallpaper =
			typeof sv.phoneWallpaper === "string" && sv.phoneWallpaper
				? sv.phoneWallpaper
				: "src/img/agatha/wphone1.jpg";

		$("#custom-ui-phone-screen").css(
			"background-image",
			'url("' + wallpaper + '")'
		);

		// --- ТЕЛЕФОН: уведомления (Messages + Fans + Match) ---
		setup.phoneRefreshMiniNotifs();

		// мини-пузыри на мини-телефоне
		setup.phoneRefreshMiniBubbles();

		// --- ГЕРОЙ ---
		setup.updateHeroUI();
	};

      
	

		/* ------------------------------------------------------------------
   ВСПЛЫВАЮЩИЙ ТЕЛЕФОН (оверлей с полноценным UI)
   ------------------------------------------------------------------ */

setup.openPhoneDialog = function () {
	var sv = State.variables;
	var wallpaper =
		typeof sv.phoneWallpaper === "string" && sv.phoneWallpaper
			? sv.phoneWallpaper
			: "src/img/agatha/wphone1.jpg";
	var unread =
		typeof sv.phoneUnread === "number" && sv.phoneUnread > 0
			? sv.phoneUnread
			: 0;

	// Если оверлей ещё не создан — создаём
	if ($("#phone-overlay").length === 0) {
		var html =
			'<div id="phone-overlay">' +
			'  <div id="phone-overlay-backdrop"></div>' +
			'  <div id="phone-overlay-inner">' +
			'    <div id="phone-overlay-phone">' +
			'      <div id="phone-overlay-screen">' +
			'        <div id="phone-overlay-screen-content"></div>' +
			'        <div id="phone-overlay-homebar-hitbox"></div>' +
			"      </div>" +
			'      <div id="phone-overlay-badge"></div>' +
			"    </div>" +
			"  </div>" +
			"</div>";

		$("body").append(html);

		// фон кликом — закрыть телефон
		$("#phone-overlay-backdrop").on("click", function () {
			setup.closePhoneDialog();
		});

		// клики внутри телефона не закрывают
		$("#phone-overlay-inner").on("click", function (e) {
			e.stopPropagation();
		});

		// home-bar (нижняя полоска) — домой/закрыть
		$("#phone-overlay-screen").on("click", "#phone-overlay-homebar-hitbox", function () {
			if (sv.phoneScreen !== "home") {
				setup.phoneGoHome();
			} else {
				setup.closePhoneDialog();
			}
		});

		// ESC — закрыть
		$(document).on("keyup.phoneOverlay", function (e) {
			if (e.key === "Escape") {
				setup.closePhoneDialog();
			}
		});
	}

	// обои
	$("#phone-overlay-screen").css(
		"background-image",
		'url("' + wallpaper + '")'
	);

	// бейдж уведомлений
	if (unread > 0) {
		$("#phone-overlay-badge").text(unread).show();
	} else {
		$("#phone-overlay-badge").hide();
	}

	// показываем оверлей
	$("#phone-overlay").addClass("visible");

	// рисуем внутренний UI
	setup.phoneRender();
};

setup.closePhoneDialog = function () {
	$("#phone-overlay").removeClass("visible");
};

setup.phoneSyncWallpaper = function () {
	var sv = State.variables;
	var wallpaper =
		typeof sv.phoneWallpaper === "string" && sv.phoneWallpaper
			? sv.phoneWallpaper
			: "src/img/agatha/wphone1.jpg";

	$("#phone-overlay-screen").css(
		"background-image",
		'url("' + wallpaper + '")'
	);
};

// Больше не показываем цифру unread на большом телефоне
setup.phoneSyncBadges = function () {
    $("#phone-overlay-badge").hide();
};



		/* ------------------------------------------------------------------
	   ХУКИ SugarCube: инициализация и обновление
	   ------------------------------------------------------------------ */

	// Один раз при полной готовности истории
	$(document).one(":storyready", function () {
		setup.initGameState();
		setup.createCustomUIBar();
		setup.refreshButtonIcons();  // ← подставляем PNG-иконки
		setup.updateCustomUIBar();

		// Предзагружаем фоны карты (map-<timeKey>.png), чтобы карта не "просыпалась" со второго раза
		if (Array.isArray(setup.timeOfDayKeys)) {
			setup.timeOfDayKeys.forEach(function (key) {
				var img = new Image();
				img.src = (setup.backgroundBasePath || "") + "map-" + key + ".png";
			});
		}
	});

	/* ------------------------------------------------------------
	   ВНУТРЕННИЕ КОМНАТЫ (apartment building)
	   ------------------------------------------------------------ */

	// Текстура по умолчанию для кнопок комнат, когда нет никакой отдельной картинки
	setup.apartmentDefaultTexture = setup.apartmentDefaultTexture
		|| ((setup.backgroundBasePath || "") + "default.png");

	// Дефолтные картинки по типу комнаты
	// ВАЖНО: тут подправь пути под свои реальные файлы
	setup.apartmentRoomTypeDefaults = setup.apartmentRoomTypeDefaults || {
		kitchen  : (setup.backgroundBasePath || "") + "room-kitchen.png",
		bathroom : (setup.backgroundBasePath || "") + "room-bathroom.png",
		living   : (setup.backgroundBasePath || "") + "room-living.png",
		bedroom  : (setup.backgroundBasePath || "") + "room-bedroom.png",
		corridor : (setup.backgroundBasePath || "") + "room-corridor.png",
		balcony  : (setup.backgroundBasePath || "") + "room-balcony.png"
	};

	// Общий конфиг комнат по зданиям/пассажам
	setup.apartmentRoomConfig = setup.apartmentRoomConfig || {};

	// Конфиг для пассажа "apartment building"
	setup.apartmentRoomConfig["apartment building"] = [
		{
			locId  : "home",
			passage: "home",
			title  : "Home",
			type   : "home"
		},
		{
			locId  : "ubathroom",
			passage: "ubathroom",
			title  : "Bathroom",
			type   : "bathroom"
		},
		{
			locId  : "ukitchen",
			passage: "ukitchen",
			title  : "Kitchen",
			type   : "kitchen"
		},
		{
			locId  : "ulivingroom",
			passage: "ulivingroom",
			title  : "Living Room",
			type   : "living"
		},
		{
			locId  : "ubedroom",
			passage: "ubedroom",
			title  : "Bedroom",
			type   : "bedroom"
		},
		{
			locId  : "unclehome",
			passage: "unclehome",
			title  : "Uncle Room",
			type   : "bedroom"
		}
	];


	// Конфиг для пассажа "home"
	setup.apartmentRoomConfig["home"] = [
		{
			locId  : "livingroom",
			passage: "livingroom",
			title  : "LivingRoom",
			type   : "livingroom"
		},
		{
			locId  : "bathroom",
			passage: "bathroom",
			title  : "Bathroom",
			type   : "bathroom"
		},
		{
			locId  : "kitchen",
			passage: "kitchen",
			title  : "Kitchen",
			type   : "kitchen"
		},
		{
			locId  : "girlsroom",
			passage: "girlsroom",
			title  : "Girlsroom",
			type   : "bedroom"
		},
		{
			locId  : "momroom",
			passage: "momroom",
			title  : "Croy Bedroom",
			type   : "bedroom"
		},
		{
			locId  : "mcroom",
			passage: "mcroom",
			title  : "My Bedroom",
			type   : "bedroom"
		}
	];


	// Рендер сетки 3×2 с кнопками комнат
	setup.renderApartmentRoomGrid = function (buildingId) {
		var cfg = setup.apartmentRoomConfig[buildingId];
		if (!cfg || !cfg.length) {
			return "<!-- no rooms configured for " + buildingId + " -->";
		}

		// Обёртка + постоянный бар над кнопками
		var html = '<div class="apartment-room-wrapper">';
		html += '<div class="apartment-room-npcbar"></div>';
		html += '<div class="apartment-room-grid">';

		cfg.forEach(function (room) {
			var locId   = room.locId   || room.passage || room.id;
			var passage = room.passage || locId;
			var title   = room.title   || passage;
			var roomType = room.type || null;

			// Выбираем картинку
			var img;
			if (room.img && room.img.length) {
				// 1) Уникальный фон для конкретной комнаты
				img = room.img;
			} else if (
				roomType &&
				setup.apartmentRoomTypeDefaults &&
				setup.apartmentRoomTypeDefaults[roomType]
			) {
				// 2) Дефолт по типу (kitchen, bathroom, living, bedroom, ...)
				img = setup.apartmentRoomTypeDefaults[roomType];
			} else {
				// 3) Общая текстура
				img = setup.apartmentDefaultTexture;
			}

			var style = img
				? ' style="background-image:url(\'' + img + '\');"'
				: "";

			html += '<button class="apartment-room-button"'
				+ ' data-passage="' + passage + '"'
				+ ' data-loc-id="' + locId + '"'
				+ style
				+ '>';

			html += '<div class="apartment-room-title">'
				+ setup.escapeHtml(title)
				+ "</div>";
		
			html += "</button>";
		});

		html += "</div></div>";
		return html;
	};

	// Макрос <<apartmentRooms>> — рендерит сетку для текущего пассажа или указанного id
	if (!Macro.has("apartmentRooms")) Macro.add("apartmentRooms", {
		handler : function () {
			var buildingId;

			// 1) аргумент макроса: <<apartmentRooms "apartment building">>
			if (this.args.length > 0 && this.args[0]) {
				buildingId = this.args[0];
			}
			// 2) иначе — имя текущего пассажа
			else {
				buildingId = passage();
			}

			if (!buildingId) {
				return this.error("<<apartmentRooms>>: не удалось определить id здания/пассажа.");
			}

			if (typeof setup.renderApartmentRoomGrid !== "function") {
				return this.error("setup.renderApartmentRoomGrid не определён.");
			}

			var html = setup.renderApartmentRoomGrid(buildingId);
			jQuery(this.output).append(html);
		}
	});

	// Клик по кнопке комнаты → переход в нужный пассаж
	jQuery(document).on("click", ".apartment-room-button", function () {
		var passageName = jQuery(this).attr("data-passage");
		if (!passageName) {
			return;
		}
		Engine.play(passageName);
	});



	// При каждом входе в пассаж обновляем UI-бар и фон
	$(document).on(":passagestart", function (ev) {
		// Wallet mirrors heroMoney
		if (typeof setup.syncWallet === "function") setup.syncWallet();

		if (typeof setup.updateCustomUIBar === "function") {
			setup.updateCustomUIBar();
		}

		var p = ev.passage;

		// Гейт по контент-тегам пассажей (Twine tags).
		// Чтобы ветки не появлялись при отключённой категории — помечай пассаж тегом из contentCatalog (например: trans).
		if (p && Array.isArray(p.tags) && p.tags.length && typeof setup.isContentAllowed === "function") {
			if (!setup.isContentAllowed(p.tags)) {
				window.setTimeout(function () { Engine.play("home"); }, 0);
				return;
			}
		}

		var name = p && p.title ? p.title : null;
		if (typeof setup.updateBackgroundForPassage === "function") {
			setup.updateBackgroundForPassage(name);
		}
	});
})();

/* ============================================================
   МИРОВАЯ ЛОГИКА: ВРЕМЯ, РАСПИСАНИЯ NPC И СОБЫТИЯ
   ============================================================ */

(function () {
    /* ------------------------------------------------------------
       Базовые расписания NPC.
       Ключи дней: 0..6, как sv.weekdayIndex (0 = Monday).
       Ключи времени: "morning", "day", "evening", "night".
       Значения: строка-локация (id локации в игре).
       Это только пример — под себя можешь править как угодно.
       ------------------------------------------------------------ */

    window.setup = window.setup || {};
    setup.npcSchedules = setup.npcSchedules || {
        npc_elly: {
            0: { morning: "girlsroom",  day: "kitchen", evening: "livingroom",night: "bathroom" },
            1: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",night: "ubedroom" },
            2: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",night: "ubedroom" },
            3: { morning: "ulivingroom",  day: "cityhall", evening: "park", night: "ubedroom" },
            4: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall", night: "ubedroom" },
            5: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",night: "ubedroom" },
            6: { morning: "ulivingroom",  day: "ulivingroom", evening: "ulivingroom", night: "ubedroom" }
        },
        npc_mia: {
            0: { morning: "ulivingroom",  day: "cityhall", evening: "park",               night: "ubedroom" },
            1: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",           night: "ubedroom" },
            2: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",           night: "ubedroom" },
            3: { morning: "ulivingroom",  day: "cityhall", evening: "park",               night: "ubedroom" },
            4: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",           night: "ubedroom" },
            5: { morning: "ulivingroom",  day: "cityhall", evening: "cityhall",           night: "ubedroom" },
            6: { morning: "ulivingroom",  day: "ulivingroom", evening: "ulivingroom", night: "ubedroom" }
        }
    };

    /* ------------------------------------------------------------
       Гарантируем, что у каждого NPC есть поля для мира:
       - relationKey, status, scheduleId, currentLocation,
         tripId/tripLocation/tripReturnDay.
       ------------------------------------------------------------ */
    setup.ensureNpcWorldState = function () {
        var sv = State.variables || {};

        if (typeof sv.npcs !== "object" || !sv.npcs) {
            if (typeof setup.initNpcState === "function") {
                setup.initNpcState();
                sv = State.variables || {};
            } else {
                return;
            }
        }

        Object.keys(sv.npcs).forEach(function (id) {
            var npc = sv.npcs[id];
            if (!npc) return;

            if (typeof npc.relationKey !== "string") {
                npc.relationKey = "acquaintance";
            }
            if (typeof npc.status !== "string") {
                npc.status = "normal"; // normal | onTrip | onQuest | busy
            }
            if (typeof npc.scheduleId !== "string") {
                // по умолчанию пробуем использовать id NPC как ключ расписания
                npc.scheduleId = (setup.npcSchedules && setup.npcSchedules[id]) ? id : null;
            }
            if (typeof npc.currentLocation !== "string") {
                // дефолтная "домашняя" локация
                npc.currentLocation = id + "_home";
            }
            if (typeof npc.tripId !== "string") {
                npc.tripId = null;
            }
            if (typeof npc.tripLocation !== "string") {
                npc.tripLocation = null;
            }
            if (typeof npc.tripReturnDay !== "number") {
                npc.tripReturnDay = -1;
            }
        });
    };

  
  
  	// где-нибудь рядом с npcSchedules / mapLocations
setup.npcLocationToMapId = {
    "elly_home": "home",
    "mia_home" : "apartment building",

    // комнаты внутри apartment building
    "ubathroom"  : "apartment building",
    "ukitchen"   : "apartment building",
    "ulivingroom": "apartment building",
    "ubedroom"   : "apartment building",
    "unclehome"  : "apartment building",


    "city_park"   : "park",
    "city_office" : "cityhall",
    "city_cafe"   : "cityhall",
    "city_mall"   : "cityhall",
    "city_bar"    : "cityhall",
    "city_club"   : "cityhall" // или сделаешь отдельную точку "club" на карте
};

  
  
  
  
    /* ------------------------------------------------------------
       Обновление локаций NPC по расписанию.
       Вызывается:
       - после смены времени (advanceTime),
       - после инициализации игры.
       ------------------------------------------------------------ */
    setup.updateNpcLocations = function () {
        var sv = State.variables || {};
        setup.ensureNpcWorldState();

        if (!sv.npcs) return;

        var timeKey = (typeof setup.getTimeOfDayKey === "function")
            ? setup.getTimeOfDayKey()
            : "day";

        var weekdayIndex = Number(sv.weekdayIndex) || 0; // 0..6

        Object.keys(sv.npcs).forEach(function (id) {
            var npc = sv.npcs[id];
            if (!npc) return;

            // 1) Поездка / задание имеют приоритет
            if (npc.status === "onTrip" && typeof npc.tripLocation === "string" && npc.tripLocation) {
                npc.currentLocation = npc.tripLocation;
                return;
            }
            if (npc.status === "onQuest" && typeof npc.questLocation === "string" && npc.questLocation) {
                npc.currentLocation = npc.questLocation;
                return;
            }

            // 2) Обычное расписание
            var scheduleKey = npc.scheduleId || (setup.npcSchedules && setup.npcSchedules[id] ? id : null);
            if (!scheduleKey || !setup.npcSchedules || !setup.npcSchedules[scheduleKey]) {
                return;
            }

            var schedGroup = setup.npcSchedules[scheduleKey];
            var daySched   = schedGroup[weekdayIndex];
            if (!daySched) return;

            var loc = daySched[timeKey];
            if (typeof loc === "string") {
                npc.currentLocation = loc;
            }
        });
    };
  
  
  
  	// Вернуть список NPC, которые сейчас "привязаны" к этой карте-локации
setup.getNpcsAtMapLocation = function (mapLocId) {
    var sv = State.variables || {};
    var result = [];

    if (!sv.npcs) return result;

    Object.keys(sv.npcs).forEach(function (id) {
        var npc = sv.npcs[id];
        if (!npc || !npc.currentLocation) return;

        var npcLoc = npc.currentLocation;
        var mapId  = npcLoc;

        // если есть таблица соответствий — используем её
        if (setup.npcLocationToMapId && setup.npcLocationToMapId[npcLoc]) {
            mapId = setup.npcLocationToMapId[npcLoc];
        }

        if (mapId !== mapLocId) return;

        var def = setup.npcDefinitions.find(function (d) { return d.id === id; });
        var name = def
            ? (typeof def.name === "function" ? def.name() : def.name)
            : id;

        result.push({
            id   : id,
            name : name
        });
    });

    return result;
};


setup.npcLocationToMapId = Object.assign({}, setup.npcLocationToMapId, {
    "kitchen-home-apartment building": "apartment building",
    "bathroom-home-apartment building": "apartment building",
    "home-apartment building": "apartment building"
    // и т.д. под свои реальные id
});



// Универсальный помощник: NPC в конкретном пассаже (по имени пассажа)
setup.getNpcsAtLocation = function (locId) {
    var sv = State.variables || {};
    var result = [];

    if (!sv.npcs || !locId) {
        return result;
    }

    Object.keys(sv.npcs).forEach(function (id) {
        var npc = sv.npcs[id];
        if (!npc || typeof npc.currentLocation !== "string") {
            return;
        }
        if (npc.currentLocation !== locId) {
            return;
        }

        var def = Array.isArray(setup.npcDefinitions)
            ? setup.npcDefinitions.find(function (d) { return d.id === id; })
            : null;

        var name = def
            ? (typeof def.name === "function" ? def.name() : def.name)
            : id;
        var icon = def && def.icon ? def.icon : null;

        result.push({
            id   : id,
            name : name,
            icon : icon
        });
    });

    return result;
};

// Рендер ряда маленьких круглых иконок NPC
setup.renderNpcIconRow = function (npcList, extraClass) {
    if (!Array.isArray(npcList) || npcList.length === 0) {
        return "";
    }

    var cls = "npc-icon-row";
    if (extraClass) {
        cls += " " + extraClass;
    }

    var html = '<div class="' + cls + '">';

    npcList.forEach(function (n) {
        var title = setup.escapeHtml(n.name || n.id || "");
        var icon  = n.icon || "src/img/elly/avatar.png";

        html += ''
            + '<span class="npc-icon" title="' + title + '">'
            +   '<img src="' + icon + '" alt="' + title + '">'
            + '</span>';
    });

    html += '</div>';
    return html;
};

// Иконки NPC для внутренних локаций (квартиры / комнаты)
// locId = имя пассажа
setup.renderNpcIconsForLocation = function (locId) {
    var list = setup.getNpcsAtLocation(locId);
    return setup.renderNpcIconRow(list, "npc-icon-row-inline");
};

// Иконки NPC для карты (по id точки карты)
setup.renderNpcIconsForMapLocation = function (mapLocId) {
    var list = setup.getNpcsAtMapLocation(mapLocId);
    return setup.renderNpcIconRow(list, "npc-icon-row-map");
};


  
	setup.locationTree = setup.locationTree || {
	"apartment building": [
		"home-apartment building",
		"unclehome"
	],

	"home-apartment building": [
		"kitchen-home-apartment building",
		"bathroom-home-apartment building",
		"living-home-apartment building",
		"bedroom-home-apartment building"
	]

	// сюда же можно добавить другие дома / офисы аналогично
};

  

    /* ------------------------------------------------------------
       Система событий (скелет).
       Массив setup.gameEvents можно дополнять в других скриптах.
       Каждый элемент:
       {
         id: "elly_missed_3_days",
         npcId: "npc_elly",
         trigger: "time" | "location" | "phone" | "manual",
         once: true,
         kind: "phone" | "phonePassage" | "scene",
         condition: function(sv) { ... },
         sequence: function(sv) { return [...]; } // для kind="phone"
         passage:  "ИмяПассажа"                    // для kind="phonePassage"
         scenePassage: "ИмяСцены",                 // для kind="scene"
         onComplete: function(sv) { ... }
       }
       ------------------------------------------------------------ */
    setup.gameEvents = setup.gameEvents || [];

    setup.runWorldEvents = function (trigger) {
        var sv = State.variables || {};
        trigger = trigger || "time";

        if (!Array.isArray(setup.gameEvents) || !setup.gameEvents.length) {
            return;
        }

        setup.gameEvents.forEach(function (ev) {
            if (!ev) return;
            if (ev.disabled) return;

            // если событие помечено контент-тегами — пропускаем, если запрещено
            if (ev.contentTags && !setup.isContentAllowed(ev.contentTags)) return;

            // фильтр по триггеру: если задан, должен совпасть
            if (ev.trigger && ev.trigger !== trigger) return;

            // одноразовые события
            if (ev.once && ev._done) return;

            // условие
            if (typeof ev.condition === "function" && !ev.condition(sv)) {
                return;
            }

            // ВЫПОЛНЕНИЕ
            if (ev.kind === "phone" && typeof setup.phoneRunSequence === "function") {
                var steps = (typeof ev.sequence === "function") ? ev.sequence(sv) : ev.sequence;
                if (Array.isArray(steps) && steps.length) {
                    setup.phoneRunSequence(ev.npcId, steps);
                }
            }
            else if (ev.kind === "phonePassage" && typeof setup.runPhonePassage === "function") {
                var pName = (typeof ev.passage === "function") ? ev.passage(sv) : ev.passage;
                if (pName) {
                    setup.runPhonePassage(ev.npcId, pName);
                }
            }
            else if (ev.kind === "scene" && typeof Engine === "object" && typeof Engine.play === "function") {
                var sceneName = (typeof ev.scenePassage === "function") ? ev.scenePassage(sv) : ev.scenePassage;
                if (sceneName) {
                    Engine.play(sceneName);
                }
            }

            // пост-эффекты
            if (typeof ev.onComplete === "function") {
                ev.onComplete(sv);
            }
            if (ev.once) {
                ev._done = true;
            }
        });
    };

    /* Удобная обёртка: проверки только телефонных событий */
    setup.runPhoneEventChecks = function () {
        setup.runWorldEvents("phone");
    };

    /* ------------------------------------------------------------
       Пост-хуки для initGameState и advanceTime, чтобы не лезть
       внутрь уже существующих функций.
       ------------------------------------------------------------ */
    (function () {
        var origInit = setup.initGameState;
        setup.initGameState = function () {
            if (typeof origInit === "function") {
                origInit();
            }
            if (typeof setup.initNpcState === "function") {
                setup.initNpcState();
            }
            setup.ensureNpcWorldState();
            setup.updateNpcLocations();
        };

        var origAdvance = setup.advanceTime;
        setup.advanceTime = function (steps) {
            if (typeof origAdvance === "function") {
                origAdvance(steps);
            }
            // после сдвига времени обновляем локации и события
            setup.updateNpcLocations();
            setup.runWorldEvents("time");
        };
    })();
})();

