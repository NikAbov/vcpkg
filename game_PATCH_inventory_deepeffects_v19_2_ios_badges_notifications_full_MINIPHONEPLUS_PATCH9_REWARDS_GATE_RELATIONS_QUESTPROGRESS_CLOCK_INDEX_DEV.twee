:: StoryScript [script]
(function () {
	/* ------------------------------------------------------------------
	   БАЗОВЫЕ НАСТРОЙКИ СОХРАНЕНИЙ (автосейв и автозагрузка)
	   ------------------------------------------------------------------ */

	/* Автосейв (может быть deprecated, но всё ещё работает)  */
	if (typeof Config === "object" && Config.saves) {
	// Включаем автосейв (старый синтаксис, всё ещё работает)
	// Config.saves.autosave = true; // deprecated
// Новая система автосейвов (для свежих версий SugarCube) 
	Config.saves.maxAutoSaves = 1;

	// 🔥 Главное изменение:
	// Если автосейв есть — загрузит его автоматически,
	// если нет или не получилось — просто загрузит стартовый пассаж.
	// Config.saves.autoload = true; // deprecated
}


	/* ------------------------------------------------------------------
	   ГЛОБАЛЬНЫЕ НАСТРОЙКИ И СОСТОЯНИЕ
	   ------------------------------------------------------------------ */

	if (typeof setup !== "object") {
		window.setup = {};
	}

	// Ключи времени суток — не отображаются, только для логики
	setup.timeOfDayKeys = ["morning", "day", "evening", "night"];

	// Названия дней недели (можешь заменить на свои)
	setup.weekdayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
	// Базовая папка для фоновых картинок пассажей
	setup.backgroundBasePath = "src/img/passage/";

	// Получить строковый ключ времени суток на основе индекса
	setup.getTimeOfDayKey = function () {
		var sv   = State.variables;
		var idx  = Number(sv.timeOfDayIndex) || 0;
		var keys = setup.timeOfDayKeys || [];

		if (!keys.length) return "day";
		if (idx < 0 || idx >= keys.length) idx = 0;
		return keys[idx];
	};

	// Обновить фон текущего пассажа (фон зависит от имени пассажа и времени суток)
	setup.updateBackgroundForPassage = function (passageName) {
		var basePath = setup.backgroundBasePath || "";

		// Определяем имя пассажа, если не передали явно
		if (!passageName) {
			if (State.passage && State.passage.title) {
				passageName = State.passage.title;
			} else {
				return;
			}
		}

		var timeKey   = setup.getTimeOfDayKey();
		var candidate = basePath + passageName + "-" + timeKey + ".png";
		var fallback  = basePath + "default.png";

		var sv = State.variables;
		if (!sv._bgCache) {
			sv._bgCache = {};
		}

		var $story = $("#story");
		var img = new Image();

		img.onload = function () {
			$story.css("background-image", 'url("' + candidate + '")');
			sv._bgCache.current = candidate;
		};

		img.onerror = function () {
			$story.css("background-image", 'url("' + fallback + '")');
			sv._bgCache.current = fallback;
		};

		img.src = candidate;
	};

   
  
  /* ----------------------------------------------------------
   Макрос для диалогов: <<npcSay "npc_alice">> ... <</npcSay>>
   ---------------------------------------------------------- */

if (!Macro.has("npcSay")) Macro.add("npcSay", {
	tags : null, // контейнерный макрос: <<npcSay "npc_id" ...>> ... <</npcSay>>

	/*
		АПГРЕЙД (этот чат): аватар + эмоции + выравнивание + микро-анимация

		Поддержка аргументов (порядок):
		1) npcId   (обязательно)  : "npc_alice"
		2) side OR emotion (опц.) : "left" / "right"  ИЛИ  "happy"/"angry"/...
		3) emotion (опц.)         : если 2-й аргумент был side
		Примеры:
		  <<npcSay "npc_alice">> ... <</npcSay>>                 (side auto)
		  <<npcSay "npc_alice" "left">> ... <</npcSay>>          (явно слева)
		  <<npcSay "npc_alice" "right">> ... <</npcSay>>         (явно справа)
		  <<npcSay "npc_alice" "happy">> ... <</npcSay>>         (эмоция, side auto)
		  <<npcSay "npc_alice" "right" "angry">> ... <</npcSay>> (side + эмоция)

		Как сделать игрока справа, раз он тоже NPC:
		  В setup.npcDefinitions для игрока добавь:
		    { id:"npc_player", ..., isPlayer:true, side:"right" }
		  (side имеет приоритет; если его нет — isPlayer даст right)
	*/

	handler : function () {
		if (this.args.length < 1) {
			return this.error('Нужен id NPC, например: <<npcSay "npc_alice">> ... <</npcSay>>');
		}

		var npcId = String(this.args[0]);

		// args parsing: 2-й аргумент может быть side ИЛИ emotion
		var a1 = (this.args[1] == null ? "" : String(this.args[1])).trim().toLowerCase();
		var a2 = (this.args[2] == null ? "" : String(this.args[2])).trim().toLowerCase();

		var side = "";
		var emotion = "";

		var isSide = (a1 === "left" || a1 === "right" || a1 === "l" || a1 === "r");
		if (isSide) {
			side = (a1[0] === "r") ? "right" : "left";
			emotion = a2;
		} else {
			emotion = a1; // если это не side — считаем эмоцией
		}

		if (!Array.isArray(setup.npcDefinitions)) {
			return this.error("setup.npcDefinitions не найден");
		}

		var def = setup.npcDefinitions.find(function (d) {
			return d && d.id === npcId;
		});

		if (!def) {
			return this.error('NPC с id "' + npcId + '" не найден в setup.npcDefinitions');
		}

		// side auto: def.side -> def.isPlayer -> left
		if (!side) {
			var defSide = (def.side == null ? "" : String(def.side)).trim().toLowerCase();
			if (defSide === "left" || defSide === "right") {
				side = defSide;
			} else if (def.isPlayer === true) {
				side = "right";
			} else {
				side = "left";
			}
		}

		// нормализация эмоции -> класс
		function slugify(s) {
			s = (s == null ? "" : String(s)).trim().toLowerCase();
			if (!s) return "";
			s = s.replace(/[^a-z0-9_\-]+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
			return s.slice(0, 40);
		}
		var emoSlug = slugify(emotion);
		var emoClass = emoSlug ? (" dialog--emo-" + emoSlug) : "";

		var sideClass = (side === "right") ? "dialog--right" : "dialog--left";

		var name   = def.name   || npcId;
		var avatar = def.avatar || def.icon || "src/img/npc/default.png";
		var color  = def.color  || "#ffffff";

		var borderColor = "rgba(255,255,255,0.12)";
		if (typeof color === "string" && /^#[0-9a-fA-F]{6}$/.test(color)) {
			borderColor = color + "33";
		}

		var body = this.payload[0].contents;

		var safeNpcId = setup.escapeHtml(String(npcId));
		var safeName  = setup.escapeHtml(String(name));

		var html = '' +
			'<div class="dialog ' + sideClass + emoClass + ' dialog-npc-' + safeNpcId + '" ' +
				 'data-npc="' + safeNpcId + '" ' +
				 (emoSlug ? ('data-emotion="' + setup.escapeHtml(emoSlug) + '" ') : '') +
				 'style="--accent:' + setup.escapeHtml(String(color)) + ';">' +
				'<div class="dialog-avatar" style="background-image:url(\'' + avatar + '\');"></div>' +
				'<div class="dialog-content" style="border-color:' + borderColor + ';">' +
					'<div class="dialog-name">' + safeName + '</div>' +
					'<div class="dialog-text">' + body + '</div>' +
				'</div>' +
			'</div>';

		$(this.output).wiki(html);
	}
});

/* ------------------------------------------------------
   Macro: <<onEvent "type" "ServicePassage">>
   Registers a service passage to be included when event is emitted.
   - Stored in $gameEventHandlers[type] = [passageNames...]
   - On emit: $eventType / $eventData are set for the service passage.
   Example:
     :: Service_OnBuy
     <<if $eventType is "buy">>
       <<run console.log("Bought:", $eventData.offerId)>>
     <</if>>
   ------------------------------------------------------ */
if (!Macro.has("onEvent")) Macro.add("onEvent", {
	handler: function () {
		var type = String(this.args[0] || "").trim();
		var passageName = String(this.args[1] || "").trim();
		if (!type || !passageName) return;

		var sv = State.variables;
		if (!sv.gameEventHandlers || typeof sv.gameEventHandlers !== "object" || Array.isArray(sv.gameEventHandlers)) sv.gameEventHandlers = {};
		if (!Array.isArray(sv.gameEventHandlers[type])) sv.gameEventHandlers[type] = [];

		if (sv.gameEventHandlers[type].indexOf(passageName) === -1) {
			sv.gameEventHandlers[type].push(passageName);
		}
	}
});



/* ----------------------------------------------------------
   Scene/Location header: <<sceneHeader "Location" "Subtitle" "🌙">>
   ---------------------------------------------------------- */
if (!Macro.has("sceneHeader")) Macro.add("sceneHeader", {
	handler : function () {
		var title = (this.args[0] == null ? "" : String(this.args[0]));
		var sub   = (this.args[1] == null ? "" : String(this.args[1]));
		var icon  = (this.args[2] == null ? "" : String(this.args[2]));

		if (!title) return;

		var html = '<div class="sc-sceneHeader">' +
			(icon ? '<div class="sc-sceneHeader__icon">' + setup.escapeHtml(icon) + '</div>' : '') +
			'<div class="sc-sceneHeader__text">' +
				'<div class="sc-sceneHeader__title">' + setup.escapeHtml(title) + '</div>' +
				(sub ? '<div class="sc-sceneHeader__sub">' + setup.escapeHtml(sub) + '</div>' : '') +
			'</div>' +
		'</div>';

		$(this.output).wiki(html);
	}
});


/* ----------------------------------------------------------
   Choice buttons
   ----------------------------------------------------------
   Wrapper:
     <<choices>>
       <<choice "Text">> ...payload... <</choice>>
       <<choice "Another" $enabled "hint">> ... <</choice>>
     <</choices>>
---------------------------------------------------------- */

if (!Macro.has("choices")) {
	Macro.add("choices", {
		tags : null,
		handler : function () {
			var body = this.payload[0].contents;
			$(this.output).wiki('<div class="sc-choices">' + body + '</div>');
		}
	});
}

/*
  NOTE:
  В SugarCube уже может существовать макрос <<choice>> (или он может быть добавлен сторонним кодом).
  Поэтому:
   - наш макрос всегда доступен как <<uichoice>>
   - алиас <<choice>> создаём ТОЛЬКО если имя свободно
*/
(function () {
	"use strict";

	function addChoiceMacro(name, errName) {
		if (Macro.has(name)) return;

		Macro.add(name, {
			tags : null,
			handler : function () {
				var label = (this.args[0] == null ? "" : String(this.args[0]));
				if (!label) return this.error('<<' + errName + '>> требует label: <<' + errName + ' "Текст">> ... <</' + errName + '>>');

				var enabled = true;
				var hint = "";

				if (this.args.length >= 2) enabled = !!this.args[1];
				if (this.args.length >= 3) hint = (this.args[2] == null ? "" : String(this.args[2]));

				var payload = this.payload[0].contents || "";

				var $wrap = $('<div class="sc-choice"></div>');
				var $btn  = $('<button type="button" class="sc-choice__btn"></button>');
				$btn.text(label);

				if (!enabled) {
					$btn.prop("disabled", true).addClass("is-disabled");
					if (hint) $btn.attr("title", hint);
				} else {
					$btn.on("click", function () {
						try {
							var tmp = document.createElement("span");
							new Wikifier(tmp, payload);
						} catch (e) {
							console.error(e);
							if (setup.toast) setup.toast("Ошибка выбора", "error", 2200);
						}
					});
				}

				$wrap.append($btn);

				if (hint) {
					var $sub = $('<div class="sc-choice__hint"></div>');
					$sub.text(hint);
					$wrap.append($sub);
				}

				$wrap.appendTo(this.output);
			}
		});
	}

	// Всегда даём безопасное имя
	addChoiceMacro("uichoice", "uichoice");

	// И только если имя свободно — алиас
	if (!Macro.has("choice")) {
		addChoiceMacro("choice", "choice");
	}
})();




/* ----------------------------------------------------------
   Toast notifications
   ----------------------------------------------------------
   JS API:
     setup.toast("Text", "info|success|warn|error", 2200);

   Macro:
     <<toast "Text" "success" 2500>>
---------------------------------------------------------- */

(function () {
	function ensureToastRoot() {
		var el = document.getElementById("sc-toasts");
		if (el) return el;

		el = document.createElement("div");
		el.id = "sc-toasts";
		el.className = "sc-toasts";
		document.body.appendChild(el);
		return el;
	}

	setup.toast = function (message, type, duration) {
		message = (message == null ? "" : String(message));
		if (!message) return;

		type = (type == null ? "info" : String(type)).toLowerCase();
		if (!duration || isNaN(duration)) duration = 2200;

		var root = ensureToastRoot();

		var item = document.createElement("div");
		item.className = "sc-toast sc-toast--" + type;

		var txt = document.createElement("div");
		txt.className = "sc-toast__text";
		txt.textContent = message;

		item.appendChild(txt);
		root.appendChild(item);

		setTimeout(function () {
			item.classList.add("is-leaving");
			setTimeout(function () {
				if (item && item.parentNode) item.parentNode.removeChild(item);
			}, 260);
		}, duration);
	};

	if (!Macro.has("toast")) Macro.add("toast", {
		handler : function () {
			var msg = (this.args[0] == null ? "" : String(this.args[0]));
			var type = (this.args[1] == null ? "info" : String(this.args[1]));
			var ms = (this.args[2] == null ? 2200 : Number(this.args[2]));

			if (setup.toast) setup.toast(msg, type, ms);
		}
	});
})();

/* ----------------------------------------------------------
   Chips for actions/emotions inside dialogue text
   ----------------------------------------------------------
   Usage examples (inside <<npcSay>> ...):
     <<act "вздыхает">> Я… не знаю.
     Ты серьёзно? <<emo "злится">>

   Universal:
     <<chip "NSFW" "warn">>
     <<chip "романтика" "good">>
     <<chip "пауза" "muted">>

   NOTE:
   - chip text is escaped (safe). Keep it short (1–3 words).
   - second arg is an optional style key -> adds CSS class: sc-chip--<style>
---------------------------------------------------------- */

(function () {
	"use strict";

	function slug(s) {
		s = (s == null ? "" : String(s)).trim().toLowerCase();
		if (!s) return "";
		return s.replace(/[^a-z0-9_\-]+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "").slice(0, 30);
	}

	setup._chipHtml = function (text, styleKey) {
		var t = setup.escapeHtml(text == null ? "" : String(text));
		if (!t) return "";
		var sk = slug(styleKey);
		var cls = "sc-chip" + (sk ? (" sc-chip--" + sk) : "");
		return '<span class="' + cls + '">' + t + '</span>';
	};

	if (!Macro.has("chip")) Macro.add("chip", {
		handler : function () {
			var text = (this.args[0] == null ? "" : String(this.args[0]));
			var styleKey = (this.args[1] == null ? "" : String(this.args[1]));
			var html = setup._chipHtml(text, styleKey);
			if (html) $(this.output).append(html);
		}
	});

	if (!Macro.has("act")) Macro.add("act", {
		handler : function () {
			var text = (this.args[0] == null ? "" : String(this.args[0]));
			var html = setup._chipHtml(text, "act");
			if (html) $(this.output).append(html);
		}
	});

	if (!Macro.has("emo")) Macro.add("emo", {
		handler : function () {
			var text = (this.args[0] == null ? "" : String(this.args[0]));
			var html = setup._chipHtml(text, "emo");
			if (html) $(this.output).append(html);
		}
	});
})();





  /* =====================================================
   Content categories (выбор игрока в начале игры)
   ===================================================== */

/**
 * Каталог категорий контента.
 * Добавляй новые категории сюда — и используй их как tags в:
 *  - NPC: def.contentTags: ["trans", ...]
 *  - passage tags (Twine): trans / nsfw / violence / futa
 *  - events: ev.contentTags: [...]
 *  - phone steps: step.contentTags: [...]
 */
// setup.contentCatalog is loaded from AUTOGEN (__IDE_DATA__)

/* Универсальная проверка тегов контента */
setup.isContentAllowed = function (tags) {
	var sv = State.variables || {};
	sv.contentSettings = sv.contentSettings || {};
	var cs = sv.contentSettings;
	var catalog = setup.contentCatalog || {};

	if (!tags || !tags.length) {
		return true; // нет тегов — контент всегда ок
	}

	for (var i = 0; i < tags.length; i++) {
		var tag = tags[i];
		if (!tag) continue;

		// Игнорируем любые теги, которых нет в каталоге (чтобы случайные Twine-tags не влияли)
		if (!catalog[tag]) continue;

		// Явно выключено пользователем
		if (cs[tag] === false) {
			return false;
		}

		// Если настройки ещё нет, но в каталоге default=false — считаем запрещённым до выбора
		if ((cs[tag] === undefined || cs[tag] === null) && catalog[tag].default === false) {
			return false;
		}
	}

	return true;
};

/* Применить выбор контента один раз (потом блокируется) */
setup.applyContentChoice = function (choiceObj) {
	var sv = State.variables || {};
	sv.contentSettings = sv.contentSettings || {};
	choiceObj = choiceObj || {};

	// если уже зафиксировано — ничего не меняем
	if (sv.contentLocked) {
		return;
	}

	var catalog = setup.contentCatalog || {};
	Object.keys(catalog).forEach(function (k) {
		if (typeof choiceObj[k] === "boolean") {
			sv.contentSettings[k] = choiceObj[k];
		} else if (typeof sv.contentSettings[k] !== "boolean") {
			// если вообще нет значения — ставим дефолт
			sv.contentSettings[k] = !!catalog[k].default;
		}
	});

	sv.contentLocked = true;

	// Пересборка мира под выбранные категории
	if (typeof setup.initNpcState === "function") setup.initNpcState();
	if (typeof setup.ensureMessagesState === "function") setup.ensureMessagesState();
	if (typeof setup.ensureNpcWorldState === "function") setup.ensureNpcWorldState();
	if (typeof setup.updateNpcLocations === "function") setup.updateNpcLocations();
	if (typeof setup.updateCustomUIBar === "function") setup.updateCustomUIBar();
};


  
  
  
