// eBay open item
$content.find("[data-ebay-open]").off("click.ebayOpen").on("click.ebayOpen", function () {
	var offerId = $(this).attr("data-ebay-open");
	if (!offerId) return;
	setup.phoneGo("ebayItem", { offerId: offerId });
});

// eBay orders
$content.find("[data-ebay-orders]").off("click.ebayOrders").on("click.ebayOrders", function () {
	setup.phoneGo("ebayOrders");
});
// eBay refresh listings
$content.find("[data-ebay-refresh]").off("click.ebayRefresh").on("click.ebayRefresh", function (ev) {
	if (ev && ev.stopPropagation) ev.stopPropagation();
	var n = setup.shopRefreshVendor("app_ebay");
	if (setup.toast) {
		setup.toast(n ? ("Listings updated: " + n) : "No updates yet", n ? "info" : "warn", 1600);
	}
	setup.phoneRender();
});


// eBay buy
$content.find("[data-ebay-buy]").off("click.ebayBuy").on("click.ebayBuy", function (ev) {
	if (ev && ev.stopPropagation) ev.stopPropagation();
	var offerId = $(this).attr("data-ebay-buy");
	if (!offerId) return;

	if (!setup.shopOfferCanBuy(offerId, 1)) {
		if (setup.toast) setup.toast("Sold out", "warn", 1800);
		return;
	}

	setup.shopPurchaseOffer(offerId, 1);
	setup.phoneRender();
});

