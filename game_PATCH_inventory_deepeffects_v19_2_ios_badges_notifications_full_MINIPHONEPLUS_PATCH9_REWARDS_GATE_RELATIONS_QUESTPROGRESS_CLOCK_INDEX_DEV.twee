	// альбомы (главный экран галереи)
	$content.find("[data-gallery-open-npc]").off("click.galleryOpenNpc").on("click.galleryOpenNpc", function () {
		var npcId = $(this).attr("data-gallery-open-npc");
		if (npcId) setup.phoneGo("galleryNpc", { npcId: npcId });
	});

	// фильтры в галерее NPC (без пуша в историю)
	$content.find("[data-gallery-filter]").off("click.galleryFilter").on("click.galleryFilter", function (ev) {
		ev.preventDefault();
		var f = $(this).attr("data-gallery-filter") || "all";
		State.variables.phoneScreenData = State.variables.phoneScreenData || {};
		State.variables.phoneScreenData.filter = f;
		setup.phoneRender();
	});

	// сортировка в галерее NPC (Newest/Oldest)
	$content.find("[data-gallery-sort]").off("click.gallerySort").on("click.gallerySort", function (ev) {
		ev.preventDefault();
		var v = $(this).attr("data-gallery-sort") || "toggle";
		State.variables.phoneScreenData = State.variables.phoneScreenData || {};
		if (v === "toggle") {
			State.variables.phoneScreenData.sort = (State.variables.phoneScreenData.sort === "old") ? "new" : "old";
		} else {
			State.variables.phoneScreenData.sort = v;
		}
		setup.phoneRender();
	});

	// открыть медиа (просмотр)
	$content.find("[data-gallery-open-media]").off("click.galleryOpenMedia").on("click.galleryOpenMedia", function () {
		var v = $(this).attr("data-gallery-open-media") || "";
		var parts = v.split("::");
		if (parts.length !== 2) return;
		setup.phoneGo("galleryView", { npcId: parts[0], mediaId: parts[1] });
	});

	// поставить обои (из viewer)
	$content.find("[data-gallery-set-wallpaper]").off("click.gallerySetWp").on("click.gallerySetWp", function () {
		var v = $(this).attr("data-gallery-set-wallpaper") || "";
		var parts = v.split("::");
		if (parts.length !== 2) return;
		setup.phoneSetWallpaperFromNpc(parts[0], parts[1]);
	});

	// zoom viewer (toggle)
	$content.find("[data-gallery-zoom]").off("click.galleryZoom").on("click.galleryZoom", function (ev) {
		ev.preventDefault();
		var $view = $content.find(".phone-gallery-view");
		if (!$view.length) return;
		$view.toggleClass("zoomed");
		$view.find(".phone-gallery-view-img").css("background-position", "50% 50%");
	});

	// pan (drag) when zoomed
	$content.find(".phone-gallery-view-img").off("mousedown.galleryPan touchstart.galleryPan").on("mousedown.galleryPan touchstart.galleryPan", function (ev) {
		var $img = $(this);
		var $view = $img.closest(".phone-gallery-view");
		if (!$view.hasClass("zoomed")) return;

		ev.preventDefault();

		function getPoint(e) {
			var oe = e.originalEvent || e;
			if (oe.touches && oe.touches.length) return oe.touches[0];
			if (oe.changedTouches && oe.changedTouches.length) return oe.changedTouches[0];
			return oe;
		}

		function parsePos(v) {
			if (!v) return 50;
			v = String(v).trim().toLowerCase();
			if (v === "left" || v === "top") return 0;
			if (v === "right" || v === "bottom") return 100;
			if (v === "center") return 50;
			var m = v.match(/(-?\d+(\.\d+)?)%/);
			if (m) return parseFloat(m[1]);
			return 50;
		}

		var p0 = getPoint(ev);
		var startX = p0.pageX;
		var startY = p0.pageY;

		var w = $img.outerWidth() || 1;
		var h = $img.outerHeight() || 1;

		var bp = ($img.css("background-position") || "50% 50%").split(" ");
		var startPosX = parsePos(bp[0]);
		var startPosY = parsePos(bp[1] || bp[0]);

		$(document).off(".galleryPanDoc");
		$(document).on("mousemove.galleryPanDoc touchmove.galleryPanDoc", function (e) {
			var p = getPoint(e);
			var dx = p.pageX - startX;
			var dy = p.pageY - startY;

			var nx = startPosX + (dx / w) * 100;
			var ny = startPosY + (dy / h) * 100;

			nx = Math.max(0, Math.min(100, nx));
			ny = Math.max(0, Math.min(100, ny));

			$img.css("background-position", nx + "% " + ny + "%");
		}).on("mouseup.galleryPanDoc touchend.galleryPanDoc touchcancel.galleryPanDoc", function () {
			$(document).off(".galleryPanDoc");
		});
	});

	// (legacy) кнопка "Поставить на обои" в старой галерее NPC
	$content.find("[data-set-wallpaper-id]").off("click.galleryLegacyWp").on("click.galleryLegacyWp", function () {
		var npcId = $(this).attr("data-npc-id");
		var mediaId = $(this).attr("data-set-wallpaper-id");
		setup.phoneSetWallpaperFromNpc(npcId, mediaId);
	});

	

	// ---------------------------
	// Fans app bindings
	// ---------------------------
	$content.find("[data-fans-open-creator]").off("click.fansOpen").on("click.fansOpen", function () {
		var npcId = $(this).attr("data-fans-open-creator");
		if (npcId) setup.phoneGo("fansCreator", { npcId: npcId });
	});

	$content.find("[data-fans-sub]").off("click.fansSub").on("click.fansSub", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var npcId = $(this).attr("data-fans-sub");
		if (npcId) setup.fansToggleSub(npcId);
	});


	$content.find("[data-fans-subplan]").off("click.fansSubPlan").on("click.fansSubPlan", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var v = $(this).attr("data-fans-subplan") || "";
		var parts = v.split("::");
		if (parts.length === 2) setup.fansSetPlan(parts[0], parts[1]);
	});

	$content.find("[data-fans-unsub]").off("click.fansUnsub").on("click.fansUnsub", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var npcId = $(this).attr("data-fans-unsub");
		if (npcId) setup.fansUnsub(npcId);
	});

	$content.find("[data-fans-tip]").off("click.fansTip").on("click.fansTip", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var v = $(this).attr("data-fans-tip") || "";
		var parts = v.split("::");
		if (parts.length === 2) setup.fansTip(parts[0], Number(parts[1]));
	});

	$content.find("[data-fans-unlock-ppv]").off("click.fansPpv").on("click.fansPpv", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var v = $(this).attr("data-fans-unlock-ppv") || "";
		var parts = v.split("::");
		if (parts.length === 2) setup.fansUnlockPpv(parts[0], parts[1]);
	});

	$content.find("[data-fans-msg]").off("click.fansMsg").on("click.fansMsg", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var npcId = $(this).attr("data-fans-msg");
		if (npcId) setup.phoneGo("fansChat", { npcId: npcId });
	});

	$content.find("[data-fans-open-post]").off("click.fansPost").on("click.fansPost", function () {
		var v = $(this).attr("data-fans-open-post") || "";
		var parts = v.split("::");
		if (parts.length === 2) setup.phoneGo("fansPost", { npcId: parts[0], postId: parts[1] });
	});

	$content.find("[data-fans-unlock]").off("click.fansUnlock").on("click.fansUnlock", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var v = $(this).attr("data-fans-unlock") || "";
		var parts = v.split("::");
		if (parts.length === 2) setup.fansUnlockPost(parts[0], parts[1]);
	});

	$content.find("[data-fans-like]").off("click.fansLike").on("click.fansLike", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var v = $(this).attr("data-fans-like") || "";
		var parts = v.split("::");
		if (parts.length === 2) setup.fansToggleLike(parts[0], parts[1]);
	});

	$content.find("[data-fans-tip]").off("click.fansTip").on("click.fansTip", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var npcId = $(this).attr("data-fans-tip");
		var amt = Number($(this).attr("data-amt") || 1);
		if (npcId) setup.fansTip(npcId, amt);
	});

	$content.find("[data-fans-backcreator]").off("click.fansBack").on("click.fansBack", function () {
		var npcId = $(this).attr("data-fans-backcreator");
		if (npcId) setup.phoneGo("fansCreator", { npcId: npcId });
	});

	$content.find("[data-fans-addcoins]").off("click.fansAddCoins").on("click.fansAddCoins", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var n = Number($(this).attr("data-fans-addcoins") || 0);
		setup.fansAddCoins(n);
	});

	// ---------------------------
	// Match app bindings
	// ---------------------------
	$content.find("[data-match-start]").off("click.matchStart").on("click.matchStart", function () {
		setup.phoneGo("matchSwipe");
	});

	$content.find("[data-match-swipe]").off("click.matchSwipe").on("click.matchSwipe", function () {
		var dir = $(this).attr("data-match-swipe");
		setup.matchSwipe(dir);
		// если закончились профили — вернемся домой матч-приложения
		if (State.variables.phoneScreen === "matchSwipe" && !setup.matchCurrentNpcId()) {
			setup.phoneGo("matchHome");
		}
	});

	// Swipe gesture (drag card) on Match screen
	if (typeof setup.bindMatchSwipeGesture === "function") {
		setup.bindMatchSwipeGesture($content);
	}

	// "Keep swiping" button on It's a Match screen
	$content.find("[data-match-continue]").off("click.matchContinue").on("click.matchContinue", function () {
		setup.phoneBack();
	});

	$content.find("[data-match-open-chat]").off("click.matchChat").on("click.matchChat", function () {
		var npcId = $(this).attr("data-match-open-chat");
		if (npcId) setup.phoneGo("matchChat", { npcId: npcId });
	});


	// ---------------------------------------------------------
	// Notifications center
	// ---------------------------------------------------------
	$content.find("[data-notifs-clear]").off("click.notifsClear").on("click.notifsClear", function () {
		var sv = State.variables;
		sv.phoneNotifs = [];
		setup.phoneRender();
	});

	$content.find("[data-notifs-filter]").off("click.notifsFilter").on("click.notifsFilter", function () {
		var sv = State.variables;
		sv.notifsFilter = $(this).attr("data-notifs-filter") || "all";
		setup.phoneRender();
	});

	
	$content.find("[data-notif-group-toggle]").off("click.notifGroupToggle").on("click.notifGroupToggle", function () {
		var sv = State.variables;
		var app = $(this).attr("data-notif-group-toggle") || "";
		if (!sv.notifsGroupOpen || typeof sv.notifsGroupOpen !== "object" || Array.isArray(sv.notifsGroupOpen)) sv.notifsGroupOpen = {};
		if (typeof sv.notifsGroupOpen[app] !== "boolean") sv.notifsGroupOpen[app] = false;
		sv.notifsGroupOpen[app] = !sv.notifsGroupOpen[app];
		setup.phoneRender();
	});

	$content.find("[data-notif-open]").off("click.notifOpen").on("click.notifOpen", function () {
		var id = $(this).attr("data-notif-open");
		if (id) setup.phoneOpenNotif(id);
	});


// (кнопки квестов, подсказок и т.п. можем добавить позже)
};

setup.phoneGetTitle = function (screen) {
	var sv = (typeof State !== "undefined" && State.variables) ? State.variables : {};
	switch (screen) {
		case "gallery": return "Gallery";
		case "galleryNpc": return "Gallery";
		case "galleryView": return "Gallery";
		case "notifs": return "Notifications";
		case "contacts": return "Contacts";
		case "contactNpc": {
			var npcId = sv.phoneScreenData && sv.phoneScreenData.npcId;
			if (npcId && setup.npcDefinitions && setup.npcDefinitions.length) {
				for (var i = 0; i < setup.npcDefinitions.length; i++) {
					if (setup.npcDefinitions[i].id === npcId) {
						var def = setup.npcDefinitions[i];
						var n = (typeof def.name === "function") ? def.name() : (def.name || "Contact");
						return n;
					}
				}
			}
			return "Contact";
		}

		// WhatsApp-like Messages UI
		case "messages": return "WhatsApp";
		case "messagesChat": {
			var npcId = sv.phoneScreenData && sv.phoneScreenData.npcId;
			if (npcId && setup.npcDefinitions && setup.npcDefinitions.length) {
				for (var i = 0; i < setup.npcDefinitions.length; i++) {
					if (setup.npcDefinitions[i].id === npcId) {
						var def = setup.npcDefinitions[i];
						var n = (typeof def.name === "function") ? def.name() : (def.name || "Chat");
						return n;
					}
				}
			}
			return "Chat";
		}

		case "quests": {
		var d = sv.phoneScreenData || {};
		if (d && d.view === "detail" && d.questId && setup.questDefs && setup.questDefs[d.questId]) {
			return (setup.questDefs[d.questId].title || "Quest");
		}
		return "Quests";
	}


		case "achievements": {
			var d2 = sv.phoneScreenData || {};
			if (d2 && d2.view === "detail" && d2.id && setup.unlockCatalog && setup.unlockCatalog[d2.id]) {
				return (setup.unlockCatalog[d2.id].title || "Achievement");
			}
			return "Achievements";
		}

		case "cheats": return "Cheats";
		case "fansHome": return "Fans";
		case "fansCreator": return "Fans";
		case "fansPost": return "Fans";
		case "fansInbox": return "Fans — Messages";
		case "fansChat": return "Fans — Chat";
		case "matchHome": return "Match";
		case "matchSwipe": return "Match";
		case "matchItsAMatch": return "Match";
		case "matchInbox": return "Match — Messages";
		case "matchChat": return "Match — Chat";
		case "fansCoins": return "Fans — Coins";
		case "ebayHome": return "eBay";
		case "ebayItem": return "eBay — Item";
		case "ebayOrders": return "eBay — Orders";
		case "invHome": return "Inventory";
		case "invItem": return "Inventory";
		case "invGift": return "Gift";
		default: return "";
	}
};


setup.escapeHtml = function (str) {
	return String(str)
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#039;");
};

  
  
  
  
  /* ------------------------------------------------------------------
   ГЛАВНЫЙ ЭКРАН: иконки приложений
   ------------------------------------------------------------------ */

setup.phoneRenderHome = function () {
	var sv = State.variables;

	// ensure DM states (so unread totals exist)
	if (setup.ensureFansDmState) setup.ensureFansDmState();
	if (setup.ensureMatchDmState) setup.ensureMatchDmState();

	var counts = setup.phoneGetAppUnreadCounts
		? setup.phoneGetAppUnreadCounts()
		: { messages: (sv.phoneUnread || 0), fans: (sv.fansApp && sv.fansApp.unread) || 0, match: (sv.matchApp && sv.matchApp.unread) || 0, total: 0 };

	function badgeHtml(n) {
		n = Number(n || 0);
		if (!isFinite(n) || n <= 0) return "";
		var label = setup.phoneFormatBadgeNumber ? setup.phoneFormatBadgeNumber(n) : (n > 99 ? "99+" : String(n));
		return '<div class="phone-app-badge">' + label + '</div>';
	}

	var html = '';
	html += '<div class="phone-home-grid">';

	html += '  <button class="phone-app-icon" data-app="gallery">';
	html += '    <div class="phone-app-icon-inner app-gallery"></div>';
	html += '    <div class="phone-app-label">Gallery</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="contacts">';
	html += '    <div class="phone-app-icon-inner app-contacts"></div>';
	html += '    <div class="phone-app-label">Contacts</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="messages">';
	html +=       badgeHtml(counts.messages);
	html += '    <div class="phone-app-icon-inner app-messages"></div>';
	html += '    <div class="phone-app-label">Messages</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="quests">';
	html += '    <div class="phone-app-icon-inner app-quests"></div>';
	html += '    <div class="phone-app-label">Quests</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="achievements">';
	html += '    <div class="phone-app-icon-inner app-achievements"><span class="phone-app-emoji">🏆</span></div>';
	html += '    <div class="phone-app-label">Achievements</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="cheats">';
	html += '    <div class="phone-app-icon-inner app-cheats"></div>';
	html += '    <div class="phone-app-label">Cheats</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="ebay">';
	html += '    <div class="phone-app-icon-inner app-ebay"></div>';
	html += '    <div class="phone-app-label">eBay</div>';
	html += '  </button>';

	// social apps
	html += '  <button class="phone-app-icon" data-app="fans">';
	html +=       badgeHtml(counts.fans);
	html += '    <div class="phone-app-icon-inner app-fans"></div>';
	html += '    <div class="phone-app-label">Fans</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="match">';
	html +=       badgeHtml(counts.match);
	html += '    <div class="phone-app-icon-inner app-match"></div>';
	html += '    <div class="phone-app-label">Match</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon" data-app="inventory">';
	html += '    <div class="phone-app-icon-inner app-inventory"></div>';
	html += '    <div class="phone-app-label">Inventory</div>';
	html += '  </button>';


	// Несколько неактивных иконок-чтоб было не пусто
	html += '  <button class="phone-app-icon disabled" tabindex="-1" aria-disabled="true">';
	html += '    <div class="phone-app-icon-inner app-dummy"></div>';
	html += '    <div class="phone-app-label">---</div>';
	html += '  </button>';

	html += '  <button class="phone-app-icon disabled" tabindex="-1" aria-disabled="true">';
	html += '    <div class="phone-app-icon-inner app-dummy"></div>';
	html += '    <div class="phone-app-label">---</div>';
	html += '  </button>';

	html += '</div>';
	return html;
}

/* Phone: Notification Center (log) */
setup.phoneRenderNotifs = function () {
	var sv = State.variables;
	setup.phoneEnsureNotifLog();

	var html = '';
	html += '<div class="phone-section phone-notifs">';
	html += '  <div class="phone-notifs-actions">';
	html += '    <button class="phone-btn phone-btn-small" data-notifs-clear="1">Clear</button>';
	html += '  </div>';
	var _nf = (typeof sv.notifsFilter === "string") ? sv.notifsFilter : "all";
	html += '  <div class="phone-chips phone-notifs-filters">';
	html += '    <button class="phone-chip' + (_nf === "all" ? ' active' : '') + '" data-notifs-filter="all">All</button>';
	html += '    <button class="phone-chip' + (_nf === "messages" ? ' active' : '') + '" data-notifs-filter="messages">Messages</button>';
	html += '    <button class="phone-chip' + (_nf === "fans" ? ' active' : '') + '" data-notifs-filter="fans">Fans</button>';
	html += '    <button class="phone-chip' + (_nf === "match" ? ' active' : '') + '" data-notifs-filter="match">Match</button>';
	html += '    <button class="phone-chip' + (_nf === "quests" ? ' active' : '') + '" data-notifs-filter="quests">Quests</button>';
	html += '    <button class="phone-chip' + (_nf === "achievements" ? ' active' : '') + '" data-notifs-filter="achievements">Achievements</button>';
	html += '    <button class="phone-chip' + (_nf === "ebay" ? ' active' : '') + '" data-notifs-filter="ebay">eBay</button>';
	html += '    <button class="phone-chip' + (_nf === "inventory" ? ' active' : '') + '" data-notifs-filter="inventory">Inventory</button>';
	html += '  </div>';

	if (!sv.phoneNotifs || sv.phoneNotifs.length === 0) {
		html += '  <div class="phone-empty">No notifications</div>';
		html += '</div>';
		return html;
	}

	html += '  <div class="phone-notifs-list">';
	var list = sv.phoneNotifs.slice(0, 60);
	var _nf2 = (typeof sv.notifsFilter === "string") ? sv.notifsFilter : "all";
	if (_nf2 !== "all") {
		list = list.filter(function (x) { return String((x && x.app) || "core") === _nf2; });
	}
	if (!list.length) {
		html += '    <div class="phone-empty">No notifications</div>';
		html += '  </div>';
		html += '</div>';
		return html;
	}

if (_nf2 === "all") {
	// grouped view (iOS-like)
	if (!sv.notifsGroupOpen || typeof sv.notifsGroupOpen !== "object" || Array.isArray(sv.notifsGroupOpen)) sv.notifsGroupOpen = {};
	var groups = {};
	var order = [];
	for (var gi = 0; gi < list.length; gi++) {
		var nn = list[gi];
		var aa = String((nn && nn.app) || "messages");
		if (!groups[aa]) { groups[aa] = []; order.push(aa); }
		groups[aa].push(nn);
	}

	for (var oi = 0; oi < order.length; oi++) {
		var appG = order[oi];
		var arr = groups[appG] || [];
		if (!arr.length) continue;

		var head = arr[0];
		var appClsG = (appG === "fans") ? "app-fans" :
			(appG === "match") ? "app-match" :
			(appG === "quests") ? "app-quests" :
			(appG === "achievements") ? "app-achievements" :
			(appG === "ebay") ? "app-ebay" :
			(appG === "inventory") ? "app-inventory" : "app-messages";

		var labelG = (appG === "messages") ? "Messages" :
			(appG === "fans") ? "Fans" :
			(appG === "match") ? "Match" :
			(appG === "quests") ? "Quests" :
			(appG === "achievements") ? "Achievements" :
			(appG === "ebay") ? "eBay" :
			(appG === "inventory") ? "Inventory" : setup.escapeHtml(appG);

		if (typeof sv.notifsGroupOpen[appG] !== "boolean") sv.notifsGroupOpen[appG] = false;
		var isOpen = !!sv.notifsGroupOpen[appG];

		var headTitle = (setup.escapeHtml ? setup.escapeHtml(head.title || "") : (head.title || ""));
		var headText  = (setup.escapeHtml ? setup.escapeHtml(setup.phoneMiniShort(head.text || "", 64)) : (head.text || ""));

		html += '    <div class="phone-notif-group">';
		html += '      <button class="phone-notif-group-head" data-notif-group-toggle="' + (setup.escapeHtml ? setup.escapeHtml(appG) : appG) + '">';
		html += '        <div class="phone-notif-icon"><div class="phone-app-icon-inner ' + appClsG + ' mini-app-icon"></div></div>';
		html += '        <div class="phone-notif-body">';
		html += '          <div class="phone-notif-title">' + labelG + ' <span class="phone-notif-count">(' + arr.length + ')</span></div>';
		html += '          <div class="phone-notif-text">' + headTitle + (headText ? (': ' + headText) : '') + '</div>';
		html += '        </div>';
		html += '        <div class="phone-notif-chevron">' + (isOpen ? '▾' : '▸') + '</div>';
		html += '      </button>';

		if (isOpen) {
			html += '      <div class="phone-notif-group-items">';
			for (var ii = 0; ii < arr.length; ii++) {
				var n = arr[ii];
				var app = String(n.app || "core");
				var appCls = (app === "fans") ? "app-fans" :
					(app === "match") ? "app-match" :
					(app === "quests") ? "app-quests" :
					(app === "achievements") ? "app-achievements" :
					(app === "ebay") ? "app-ebay" :
					(app === "inventory") ? "app-inventory" : "app-messages";
				var title = (setup.escapeHtml ? setup.escapeHtml(n.title || "") : (n.title || ""));
				var text  = (setup.escapeHtml ? setup.escapeHtml(setup.phoneMiniShort(n.text || "", 64)) : (n.text || ""));
				html += '        <button class="phone-notif-item" data-notif-open="' + (setup.escapeHtml ? setup.escapeHtml(n.id) : n.id) + '">';
				html += '          <div class="phone-notif-icon"><div class="phone-app-icon-inner ' + appCls + ' mini-app-icon"></div></div>';
				html += '          <div class="phone-notif-body">';
				html += '            <div class="phone-notif-title">' + title + '</div>';
				html += '            <div class="phone-notif-text">' + text + '</div>';
				html += '          </div>';
				html += '        </button>';
			}
			html += '      </div>';
		}
		html += '    </div>';
	}
} else {
	// flat list for specific filter
	for (var i = 0; i < list.length; i++) {
		var n = list[i];
		var app = String(n.app || "core");
		var appCls = (app === "fans") ? "app-fans" : (app === "match") ? "app-match" : (app === "quests") ? "app-quests" : (app === "achievements") ? "app-achievements" : (app === "ebay") ? "app-ebay" : (app === "inventory") ? "app-inventory" : "app-messages";
		var title = (setup.escapeHtml ? setup.escapeHtml(n.title || "") : (n.title || ""));
		var text  = (setup.escapeHtml ? setup.escapeHtml(setup.phoneMiniShort(n.text || "", 64)) : (n.text || ""));
		html += '    <button class="phone-notif-item" data-notif-open="' + (setup.escapeHtml ? setup.escapeHtml(n.id) : n.id) + '">';
		html += '      <div class="phone-notif-icon"><div class="phone-app-icon-inner ' + appCls + ' mini-app-icon"></div></div>';
		html += '      <div class="phone-notif-body">';
		html += '        <div class="phone-notif-title">' + title + '</div>';
		html += '        <div class="phone-notif-text">' + text + '</div>';
		html += '      </div>';
		html += '    </button>';
	}
}
	html += '  </div>';
	html += '</div>';
	return html;
};

setup.phoneOpenNotif = function (notifId) {
	var sv = State.variables;
	setup.phoneEnsureNotifLog();
	if (!notifId) return;

	var n = null;
	for (var i = 0; i < sv.phoneNotifs.length; i++) {
		if (sv.phoneNotifs[i] && sv.phoneNotifs[i].id === notifId) { n = sv.phoneNotifs[i]; break; }
	}
	if (!n) return;

	// prefer explicit deep-open if provided
	if (n.meta && n.meta.open) {
		setup.phoneMiniOpen(String(n.meta.open || ""), n.npcId || "");
		return;
	}

	var app = String(n.app || "");
	var npcId = n.npcId || "";

	if (app === "messages") {
		setup.phoneGo("messages");
		if (npcId) setup.phoneGo("messagesChat", { npcId: npcId });
		return;
	}

	if (app === "fans") {
		setup.phoneGo("fansInbox");
		if (npcId) setup.phoneGo("fansChat", { npcId: npcId });
		return;
	}

	if (app === "match") {
		setup.phoneGo("matchInbox");
		if (npcId) setup.phoneGo("matchChat", { npcId: npcId });
		return;
	}

	if (app === "quests") {
		var qid = (n.meta && n.meta.questId) ? String(n.meta.questId) : "";
		if (qid) setup.phoneGo("quests", { view: "detail", questId: qid });
		else setup.phoneGo("quests");
		return;
	}

	if (app === "achievements") {
		setup.phoneGo("achievements");
		return;
	}

	if (app === "ebay") {
		setup.phoneGo("ebayOrders");
		return;
	}

	// default
	setup.phoneGo("notifs");
};
;


  
  
  
  

/* ------------------------------------------------------------------
   APP: Fans (creator/subscription feed, OnlyFans-like)
   ------------------------------------------------------------------
   ВАЖНО: это "механика" приложения. Контент (посты/медиа) ты заполняешь сам.
   Никаких жёстких ограничений на тему нет, но следи за рейтингом игры.

   State:
     $fansApp = {
       coins: 0,
       subs: { npcId:true },
       unlocked: { npcId: { postId:true } },
       liked: { npcId: { postId:true } }
     }

   Setup data (пример):
     setup.fansCreators = [
       { npcId:"npc_alice", handle:"@alice", subPrice: 10, posts:[
         { id:"p1", ts:"Day 1", text:"...", price: 5, locked:true,
           media:{ type:"img", src:"src/img/...", orient:"v", pos:"50% 20%" } }
       ]}
     ];
  ------------------------------------------------------------------ */

setup.ensureFansAppState = function () {
	var sv = State.variables;

	if (typeof sv.fansApp !== "object" || !sv.fansApp) {
		sv.fansApp = { coins: 0, subs: {}, unlocked: {}, liked: {}, tips: {}, ppvUnlocked: {} };
	}
	if (typeof sv.fansApp.coins !== "number") sv.fansApp.coins = 0;
	if (typeof sv.fansApp.subs !== "object" || !sv.fansApp.subs) sv.fansApp.subs = {};
	if (typeof sv.fansApp.unlocked !== "object" || !sv.fansApp.unlocked) sv.fansApp.unlocked = {};
	if (typeof sv.fansApp.liked !== "object" || !sv.fansApp.liked) sv.fansApp.liked = {};

	if (typeof sv.fansApp.tips !== "object" || !sv.fansApp.tips) sv.fansApp.tips = {};
	if (typeof sv.fansApp.ppvUnlocked !== "object" || !sv.fansApp.ppvUnlocked) sv.fansApp.ppvUnlocked = {};
};

setup.fansGetCreators = function () {
	// Появляются только NPC с включённым флагом apps.fans
	var list = Array.isArray(setup.fansCreators) ? setup.fansCreators : [];
	return list.filter(function (c) {
		return c && c.npcId && setup.npcHasAppFlag(c.npcId, "fans");
	});
};

setup.fansGetCreator = function (npcId) {
	var list = setup.fansGetCreators();
	for (var i = 0; i < list.length; i++) {
		if (list[i] && list[i].npcId === npcId) return list[i];
	}
	return null;
};


/* ----------------------------------------------------------
   Fans: posts
   ----------------------------------------------------------
   Creator posts live in setup.fansCreators[].posts (array).
   Post schema (minimal):
     { id:"p1", ts:"Day 1 • 12:40", text:"...", locked:true, price:5,
       thumb:"src/...", preview:"src/...",
       media:{ src:"src/...", type:"image|video", orient:"h|v", pos:"50% 50%" } }
---------------------------------------------------------- */
if (!setup.fansGetPosts) setup.fansGetPosts = function (npcId) {
	var c = setup.fansGetCreator(npcId);
	if (!c) return [];
	var raw = Array.isArray(c.posts) ? c.posts : [];
	var out = [];
	for (var i = 0; i < raw.length; i++) {
		var p = raw[i];
		if (!p) continue;
		// гарантируем id, чтобы рендер не падал
		if (p.id == null || p.id === "") p.id = "post" + i;
		out.push(p);
	}
	return out;
};



/* ----------------------------------------------------------
   Fans: subscription plans (free + paid tiers)
   ----------------------------------------------------------
   Creator can define either:
     - subPrice / subPeriodDays (legacy single-plan)
   OR
     - plans: [
         { id:"free",    label:"Free",    price:0,  periodDays:30 },
         { id:"basic",   label:"Basic",   price:10, periodDays:30 },
         { id:"premium", label:"Premium", price:25, periodDays:30 }
       ]

   Post gating options:
     - subOnly: true          -> requires ANY active subscription (including free)
     - minPlan: "basic"       -> requires plan rank >= "basic"
     - minPlan: 2             -> numeric rank (0..N-1) in creator.plans order

   Notes:
   - If creator has ONLY paid plans, then user must subscribe to any paid plan to see subOnly posts.
   - You can still use locked PPV posts with price/unlock (separate from plans).
---------------------------------------------------------- */

setup.fansGetPlans = function (npcIdOrCreator) {
	var c = npcIdOrCreator;
	if (typeof npcIdOrCreator === "string") c = setup.fansGetCreator(npcIdOrCreator);
	if (!c) return [];

	// Normalize creator.plans
	var raw = Array.isArray(c.plans) ? c.plans : null;
	var out = [];

	if (raw && raw.length) {
		raw.forEach(function (p, idx) {
			if (!p) return;
			var id = (p.id != null ? String(p.id) : ("plan" + idx));
			out.push({
				id         : id,
				label      : (p.label != null ? String(p.label) : id),
				price      : (typeof p.price === "number" ? p.price : 0),
				periodDays : (typeof p.periodDays === "number" ? p.periodDays : ((typeof c.subPeriodDays === "number") ? c.subPeriodDays : 30)),
				_rank      : idx
			});
		});
	} else {
		// Legacy single plan via subPrice
		var price = (typeof c.subPrice === "number") ? c.subPrice : 0;
		out.push({
			id         : (price > 0 ? "paid" : "free"),
			label      : (price > 0 ? "Paid" : "Free"),
			price      : price,
			periodDays : (typeof c.subPeriodDays === "number") ? c.subPeriodDays : 30,
			_rank      : 0
		});
	}

	// Ensure stable ordering by _rank
	out.sort(function (a, b) { return (a._rank||0) - (b._rank||0); });
	return out;
};

setup.fansGetPlanById = function (npcId, planId) {
	var plans = setup.fansGetPlans(npcId);
	var pid = (planId == null ? "" : String(planId));
	for (var i = 0; i < plans.length; i++) {
		if (plans[i].id === pid) return plans[i];
	}
	return null;
};

setup.fansHasFreePlan = function (npcId) {
	var plans = setup.fansGetPlans(npcId);
	return plans.some(function (p) { return (p.price||0) <= 0; });
};

setup.fansMinPlanPrice = function (npcIdOrCreator) {
	var plans = setup.fansGetPlans(npcIdOrCreator);
	if (!plans.length) return 0;
	var min = plans[0].price || 0;
	for (var i = 1; i < plans.length; i++) {
		min = Math.min(min, plans[i].price || 0);
	}
	return min;
};

setup.fansPlanRank = function (npcId, planId) {
	var plans = setup.fansGetPlans(npcId);
	var pid = (planId == null ? "" : String(planId));
	for (var i = 0; i < plans.length; i++) {
		if (plans[i].id === pid) return i;
	}
	return -1;
};

setup.fansGetActivePlanId = function (npcId) {
	var sub = setup.fansGetSub(npcId);
	return sub ? (sub.plan || "paid") : null;
};

setup.fansIsActiveSub = function (npcId) {
	return !!setup.fansGetSub(npcId);
};

setup.fansCanSeePost = function (npcId, post) {
	if (!post) return false;

	// If not subOnly / no minPlan -> public
	var subOnly = !!post.subOnly;
	var hasMin = ("minPlan" in post);

	// If neither gate is set -> public
	if (!subOnly && !hasMin) return true;

	var sub = setup.fansGetSub(npcId);
	if (!sub) return false;

	// minPlan gating
	if (hasMin) {
		var req = post.minPlan;

		// numeric -> rank
		if (typeof req === "number" && isFinite(req)) {
			var userRankN = setup.fansPlanRank(npcId, sub.plan);
			return userRankN >= req;
		}

		// string -> plan id
		var reqId = String(req);
		var userRank = setup.fansPlanRank(npcId, sub.plan);
		var reqRank = setup.fansPlanRank(npcId, reqId);
		if (reqRank >= 0) return userRank >= reqRank;

		// unknown plan -> fallback to subOnly behavior
		return true;
	}

	// subOnly only
	return true;
};

setup.fansUnsub = function (npcId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	if (setup.fansGetSub(npcId)) {
		delete sv.fansApp.subs[npcId];
		if (setup.toast) setup.toast("Unsubscribed", "info", 1800);
		if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
	}
};

setup.fansSetPlan = function (npcId, planId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	var c = setup.fansGetCreator(npcId);
	if (!c) return;

	var plan = setup.fansGetPlanById(npcId, planId);
	if (!plan) {
		if (setup.toast) setup.toast("Plan not found", "warn", 1800);
		return;
	}

	var cur = setup.fansGetSub(npcId);
	if (cur && cur.plan === plan.id) {
		// same plan -> treat as "unsubscribe" for convenience
		setup.fansUnsub(npcId);
		return;
	}

	// Charge full price for the period (simple model)
	var price = plan.price || 0;
	if (price > 0 && sv.fansApp.coins < price) {
		if (setup.toast) setup.toast("Not enough coins", "warn", 2200);
		return;
	}
	if (price > 0) sv.fansApp.coins -= price;

	var expires = null;
	if (typeof sv.day === "number") expires = sv.day + (plan.periodDays || 30);

	sv.fansApp.subs[npcId] = {
		active     : true,
		plan       : plan.id,
		price      : price,
		periodDays : (plan.periodDays || 30),
		expiresDay : expires
	};

	if (setup.toast) setup.toast(price > 0 ? ("Subscribed: " + plan.label) : ("Subscribed: " + plan.label), "success", 1800);
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

// Tips (coins -> creator)
setup.fansTip = function (npcId, amount) {
	setup.ensureFansAppState();
	var sv = State.variables;
	var n = Number(amount);
	if (!n || isNaN(n) || n <= 0) return;

	if (sv.fansApp.coins < n) {
		if (setup.toast) setup.toast("Not enough coins", "warn", 2000);
		return;
	}
	sv.fansApp.coins -= n;

	if (!sv.fansApp.tips[npcId]) sv.fansApp.tips[npcId] = 0;
	sv.fansApp.tips[npcId] += n;

	if (setup.toast) setup.toast("Tip sent: " + n + " coins", "success", 1800);
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

// PPV messages (optional): creator.ppv = [{id,text,price,media?}]
setup.fansHasPpv = function (npcId, ppvId) {
	setup.ensureFansAppState();
	var u = State.variables.fansApp.ppvUnlocked[npcId];
	return !!(u && u[ppvId]);
};

setup.fansUnlockPpv = function (npcId, ppvId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	var c = setup.fansGetCreator(npcId);
	if (!c || !Array.isArray(c.ppv)) return;

	var item = c.ppv.find(function (x) { return x && x.id === ppvId; });
	if (!item) return;

	if (setup.fansHasPpv(npcId, ppvId)) return;

	var price = (typeof item.price === "number") ? item.price : 0;
	if (price > 0 && sv.fansApp.coins < price) {
		if (setup.toast) setup.toast("Not enough coins", "warn", 2200);
		return;
	}
	if (price > 0) sv.fansApp.coins -= price;

	if (!sv.fansApp.ppvUnlocked[npcId]) sv.fansApp.ppvUnlocked[npcId] = {};
	sv.fansApp.ppvUnlocked[npcId][ppvId] = true;

	// Quest event hook (Fans PPV unlock)
	if (typeof setup.questEvent === "function") setup.questEvent("fans_ppv_unlock", { npcId: String(npcId), ppvId: String(ppvId), price: price });

	// Optional: drop a short note into Messages thread (text only)
	if (typeof setup._phoneAddNpcMessage === "function") {
		if (item.text) setup._phoneAddNpcMessage(npcId, item.text, { type:"text", source:"fans" });
	}

	
	// Quest event hook (Fans DM PPV unlock)
	if (typeof setup.questEvent === "function") setup.questEvent("fans_ppv_unlock", { npcId: String(npcId), ppvId: String(ppvId), price: price });

if (setup.toast) setup.toast("PPV unlocked", "success", 1800);
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};



setup.fansGetSub = function (npcId) {
	setup.ensureFansAppState();
	var sub = State.variables.fansApp.subs[npcId];

	// backward compat: true -> object
	if (sub === true) {
		sub = { plan: "paid", price: 0, active: true, expiresDay: null };
		State.variables.fansApp.subs[npcId] = sub;
	}
	if (!sub || typeof sub !== "object") return null;

	// optional expiry if $day exists
	var day = State.variables.day;
	if (typeof sub.expiresDay === "number" && typeof day === "number" && day > sub.expiresDay) {
		delete State.variables.fansApp.subs[npcId];
		return null;
	}
	return sub;
};

setup.fansIsSubbed = function (npcId) {
	return !!setup.fansGetSub(npcId);
};

setup.fansToggleSub = function (npcId) {
	// Legacy button support:
	// - if already subscribed -> unsubscribe
	// - else -> subscribe to best default plan:
	//     prefer free plan if exists, otherwise cheapest paid plan
	setup.ensureFansAppState();
	var c = setup.fansGetCreator(npcId);
	if (!c) return;

	if (setup.fansGetSub(npcId)) {
		setup.fansUnsub(npcId);
		return;
	}

	var plans = setup.fansGetPlans(npcId);
	if (!plans.length) return;

	// pick free if exists else cheapest
	var best = plans[0];
	plans.forEach(function (p) {
		if ((p.price||0) <= 0) best = p;
	});
	if ((best.price||0) > 0) {
		plans.forEach(function (p) {
			if ((p.price||0) < (best.price||0)) best = p;
		});
	}
	setup.fansSetPlan(npcId, best.id);
};

setup.fansHasUnlocked = function (npcId, postId) {
	setup.ensureFansAppState();
	var u = State.variables.fansApp.unlocked[npcId];
	return !!(u && u[postId]);
};

setup.fansUnlockPost = function (npcId, postId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	var c = setup.fansGetCreator(npcId);
	if (!c) return;
	var post = (c.posts || []).find(function (p) { return p && p.id === postId; });
	if (!post) return;

	if (setup.fansHasUnlocked(npcId, postId)) return;

	var price = (typeof post.price === "number") ? post.price : 0;
	if (price > 0 && sv.fansApp.coins < price) {
		if (setup.toast) setup.toast("Not enough coins", "warn", 2200);
		return;
	}
	if (price > 0) sv.fansApp.coins -= price;

	if (!sv.fansApp.unlocked[npcId]) sv.fansApp.unlocked[npcId] = {};
	sv.fansApp.unlocked[npcId][postId] = true;

	// Quest event hook (Fans post unlock)
	if (typeof setup.questEvent === "function") setup.questEvent("fans_post_unlock", { npcId: String(npcId), postId: String(postId) });

// If post has media -> add to NPC Gallery on unlock (so Gallery shows what player got)
if (typeof setup.phoneAddMediaToNpcGallery === "function" && post && post.media && post.media.src) {
	var mObj = {
		id          : (post.media.id || ("fans_post_" + npcId + "_" + postId)),
		thumb       : (post.thumb || post.preview || post.media.thumb || post.media.src || ""),
		full        : (post.media.full || post.media.src || ""),
		canWallpaper: (post.media.canWallpaper !== false),
		orient      : (post.media.orient || "h"),
		pos         : (post.media.pos || "50% 50%"),
		fit         : (post.media.fit || "cover")
	};
	setup.phoneAddMediaToNpcGallery(npcId, mObj);
}

	if (setup.toast) setup.toast("Unlocked", "success", 1800);
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

setup.fansToggleLike = function (npcId, postId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	if (!sv.fansApp.liked[npcId]) sv.fansApp.liked[npcId] = {};
	if (sv.fansApp.liked[npcId][postId]) delete sv.fansApp.liked[npcId][postId];
	else sv.fansApp.liked[npcId][postId] = true;
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

setup.fansTip = function (npcId, amount) {
	setup.ensureFansAppState();
	var sv = State.variables;
	amount = Number(amount);
	if (!amount || amount <= 0) amount = 1;
	if (sv.fansApp.coins < amount) {
		if (setup.toast) setup.toast("Not enough coins", "warn", 2200);
		return;
	}
	sv.fansApp.coins -= amount;
	if (setup.toast) setup.toast("Tip sent: -" + amount, "success", 1800);
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

// helper: add coins from story
setup.fansAddCoins = function (n) {
	setup.ensureFansAppState();
	n = Number(n);
	if (!n || isNaN(n)) n = 0;
	State.variables.fansApp.coins += n;
	if (State.variables.fansApp.coins < 0) State.variables.fansApp.coins = 0;
	if (setup.toast) setup.toast("Coins: +" + n, "info", 1600);
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

setup.phoneRenderFansHome = function () {
	setup.ensureFansAppState();
	var sv = State.variables;
	var creators = setup.fansGetCreators();

	// Group by availability of a free plan (min price == 0)
	var freeList = [];
	var paidList = [];
	creators.forEach(function (c) {
		var minPrice = setup.fansMinPlanPrice(c);
		(minPrice <= 0 ? freeList : paidList).push(c);
	});

	function subTag(npcId, c) {
		var sub = setup.fansGetSub(npcId);
		if (sub) {
			var plan = setup.fansGetPlanById(npcId, sub.plan);
			var label = plan ? plan.label : (sub.plan || "Subscribed");
			return 'Subscribed • ' + setup.escapeHtml(label);
		}
		var minPrice = setup.fansMinPlanPrice(c);
		return (minPrice <= 0) ? 'Free' : ('From ' + minPrice + ' coins');
	}

	function renderList(title, list) {
		if (!list.length) return '';
		var out = '';
		out += '<div class="fans-section-title">' + setup.escapeHtml(title) + '</div>';
		out += '<div class="fans-creator-list">';
		list.forEach(function (c) {
			if (!c || !c.npcId) return;
			var npcId = c.npcId;
			var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; }) || {};
			var name = (typeof def.name === "function") ? def.name() : (def.name || npcId);
			var avatar = def.icon || def.avatar || "src/img/npc/default.png";
			out += '' +
				'<button class="fans-creator-row" data-fans-open-creator="' + npcId + '">' +
				'  <div class="fans-creator-avatar" style="background-image:url(\'' + avatar + '\')"></div>' +
				'  <div class="fans-creator-main">' +
				'    <div class="fans-creator-name">' + setup.escapeHtml(name) + '</div>' +
				'    <div class="fans-creator-handle">' + setup.escapeHtml(c.handle || "") + '</div>' +
				'  </div>' +
				'  <div class="fans-creator-pill">' + subTag(npcId, c) + '</div>' +
				'</button>';
		});
		out += '</div>';
		return out;
	}

	var coins = (sv.fansApp && typeof sv.fansApp.coins === "number") ? sv.fansApp.coins : 0;

	var html = '' +
	'<div class="phone-section phone-fans fans-app">' +
	'  <div class="fans-topbar">' +
	'    <div class="fans-brand"><span class="fans-brand-dot"></span><span class="fans-brand-text">Fans</span></div>' +
	'    <div class="fans-top-actions">' +
	'      <div class="fans-coins">💰 <b>' + coins + '</b></div>' +
	'      <button class="fans-iconbtn" data-fans-coins-shop="1" title="Buy coins">➕</button>' +
	'      <button class="fans-iconbtn" data-fans-inbox="1" title="Inbox">✉</button>' +
	'    </div>' +
	'  </div>' +
	'  <div class="fans-search">' +
	'    <div class="fans-search-ico">🔎</div>' +
	'    <input class="fans-search-input" type="text" placeholder="Search creators" disabled>' +
	'  </div>' +
	renderList("Free", freeList) +
	renderList("Paid", paidList) +
	'</div>';

	return html;
};




/* =====================================================
   Phone app: Fans — Coins (buy coins for cash)
   ===================================================== */
setup.phoneRenderFansCoins = function () {
	setup.ensureShopState();
	setup.ensureFansAppState();
	var sv = State.variables;

	var cash = setup.getHeroStat("heroMoney");
	var coins = (sv.fansApp && typeof sv.fansApp.coins === "number") ? sv.fansApp.coins : 0;

	var offers = setup.shopGetOffersByVendor("app_fans_coins", true);

	var html = '' +
	'<div class="phone-section phone-fans fans-app">' +
	'  <div class="fans-topbar">' +
	'    <div class="fans-brand"><span class="fans-brand-dot"></span><span class="fans-brand-text">Fans</span></div>' +
	'    <div class="fans-top-actions">' +
	'      <div class="fans-coins">💰 <b>' + coins + '</b></div>' +
	'      <button class="fans-iconbtn" data-fans-inbox="1" title="Inbox">✉</button>' +
	'    </div>' +
	'  </div>' +

	'  <div class="ebay-subbar">' +
	'    <div class="ebay-subbar-left">Buy coins</div>' +
	'    <div class="ebay-subbar-right">Cash: <b>$' + cash + '</b></div>' +
	'  </div>' +

	'  <div class="ebay-list">';

	offers.forEach(function (of) {
		var title = of.title || ("+" + (of.grant && of.grant.fansCoins ? of.grant.fansCoins : 0) + " coins");
		var desc = of.desc || "";
		html += '' +
		'<div class="ebay-card">' +
		'  <div class="ebay-card-main">' +
		'    <div class="ebay-card-title">' + setup.escapeHtml(title) + '</div>' +
		(desc ? ('    <div class="ebay-card-desc">' + setup.escapeHtml(desc) + '</div>') : '') +
		'    <div class="ebay-card-meta">Price: <b>$' + Number(of.price || 0) + '</b></div>' +
		'  </div>' +
		'  <div class="ebay-card-actions">' +
		'    <button class="phone-btn phone-btn-primary" data-fans-buy-coins="' + setup.escapeHtml(of.id) + '">Buy</button>' +
		'  </div>' +
		'</div>';
	});

	if (!offers.length) {
		html += '<div class="phone-ui-placeholder">No coin packs available.</div>';
	}

	html += '' +
	'  </div>' +
	'</div>';

	return html;
};


/* =====================================================
   Phone app: eBay (shipping purchases)
   ===================================================== */

setup.phoneRenderEbayHome = function () {
	setup.ensureShopState();
	var sv = State.variables;

	var cash = setup.getHeroStat("heroMoney");
	var offersAll = setup.shopGetOffersByVendor("app_ebay", true);

	// state (search + category)
	if (typeof sv.ebaySearch !== "string") sv.ebaySearch = "";
	if (typeof sv.ebayCat !== "string") sv.ebayCat = "all";
	var q = sv.ebaySearch.trim().toLowerCase();

	// categories from visible offers
	var cats = { all: "All" };
	offersAll.forEach(function (of) {
		var it = setup.shopGetItem(of.itemId) || {};
		var type = (it.type || "other");
		if (!cats[type]) cats[type] = type.charAt(0).toUpperCase() + type.slice(1);
	});

	function matchesQuery(item, offer) {
		if (!q) return true;
		var name = (item.name || offer.title || offer.itemId || "").toLowerCase();
		var desc = (item.desc || offer.desc || "").toLowerCase();
		return (name.indexOf(q) >= 0) || (desc.indexOf(q) >= 0);
	}

	var offers = offersAll.filter(function (of) {
		var it = setup.shopGetItem(of.itemId) || {};
		if (sv.ebayCat && sv.ebayCat !== "all") {
			var type = (it.type || "other");
			if (type !== sv.ebayCat) return false;
		}
		return matchesQuery(it, of);
	});

	// order badge
	var pending = 0;
	if (Array.isArray(sv.orders)) {
		sv.orders.forEach(function (o) {
			if (o && o.vendorId === "app_ebay" && !o.delivered) pending++;
		});
	}

	function esc(s) { return setup.escapeHtml(String(s || "")); }
	function short(s, n) {
		s = String(s || "").trim();
		if (!s) return "";
		if (s.length <= n) return s;
		return s.slice(0, Math.max(0, n - 1)) + "…";
	}

	var html = '' +
	'<div class="phone-section phone-ebay ebay-app">' +
	'  <div class="ebay-topbar">' +
	'    <div class="ebay-brandlogo" aria-label="eBay">' +
	'      <span class="l1">e</span><span class="l2">b</span><span class="l3">a</span><span class="l4">y</span>' +
	'    </div>' +
	'    <div class="ebay-top-actions">' +
	'      <div class="ebay-cash">Cash: <b>$' + cash + '</b></div>' +
	'      <button class="ebay-iconbtn" data-ebay-refresh="1" title="Refresh listings">⟳</button>' +
	'      <button class="ebay-iconbtn" data-ebay-orders="1" title="Orders">' +
	'        📦' + (pending ? ('<span class="ebay-badge">' + pending + '</span>') : '') +
	'      </button>' +
	'    </div>' +
	'  </div>' +

	'  <div class="ebay-search-row">' +
	'    <input class="ebay-search" data-ebay-search="1" type="text" placeholder="Search on eBay" value="' + esc(sv.ebaySearch) + '">' +
	'    <button class="ebay-clear" data-ebay-search-clear="1" title="Clear">✕</button>' +
	'  </div>' +

	'  <div class="ebay-chips">';

	Object.keys(cats).forEach(function (k) {
		var active = (sv.ebayCat === k) || (!sv.ebayCat && k === "all");
		html += '<button class="ebay-chip' + (active ? ' is-active' : '') + '" data-ebay-cat="' + esc(k) + '">' + esc(cats[k]) + '</button>';
	});

	html += '' +
	'  </div>' +

	'  <div class="ebay-grid">';

	offers.forEach(function (of) {
		var item = setup.shopGetItem(of.itemId) || {};
		var name = item.name || of.title || of.itemId || of.id;
		var desc = item.desc || of.desc || "";
		var thumb = setup.shopGetThumbUrl(item);

		var eta = Number(of.etaDays || 1);
		if (!isFinite(eta) || eta < 0) eta = 1;
		var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : null;
		var deliverDay = (day !== null) ? (day + eta) : null;
		var etaText = (eta <= 0) ? "Arrives today" : ("Arrives in ~" + eta + " day(s)");
		if (deliverDay !== null) etaText += " (Day " + deliverDay + ")";

		// stock / exclusive
		var stockInfo = setup.shopGetOfferStockInfo(of.id);
		var soldOut = (stockInfo.mode !== "unlimited" && stockInfo.stock <= 0);
		var stockMeta = (stockInfo.mode === "unlimited") ? "" : (soldOut ? " · Sold out" : (" · " + stockInfo.stock + " left"));


		
		var stockBadge = '';
		if (soldOut) {
			stockBadge = '<div class="ebay-stock-badge soldout">Sold out</div>';
		} else if (stockInfo.mode !== "unlimited" && stockInfo.stock <= 2) {
			stockBadge = '<div class="ebay-stock-badge low">Only ' + stockInfo.stock + ' left</div>';
		}
html += '' +
		'<div class="ebay-prod" data-ebay-open="' + esc(of.id) + '">' +
		'  <div class="ebay-thumbwrap">' +
		'    <img class="ebay-thumb" src="' + esc(thumb) + '" alt="">' +
		'  </div>' +
		'  <div class="ebay-prod-body">' +
		'    <div class="ebay-prod-title">' + esc(short(name, 36)) + '</div>' +
		(desc ? ('    <div class="ebay-prod-desc">' + esc(short(desc, 64)) + '</div>') : '') +
		'    <div class="ebay-prod-price">$' + Number(of.price || 0) + '</div>' +
		
			(stockBadge ? ('    ' + stockBadge) : '') +
'    <div class="ebay-prod-meta">Buy It Now · ' + esc(etaText + stockMeta) + '</div>' +
		'    <div class="ebay-prod-actions">' +
		'      <button class="ebay-mini-btn ebay-mini-primary" data-ebay-buy="' + esc(of.id) + '"' + (soldOut ? ' disabled' : '') + '>' + (soldOut ? 'Sold out' : 'Buy') + '</button>' +
		'      <button class="ebay-mini-btn" data-ebay-open="' + esc(of.id) + '">Details</button>' +
		'    </div>' +
		'  </div>' +
		'</div>';
	});

	if (!offers.length) {
		html += '<div class="phone-ui-placeholder">No listings right now. More items will appear as you progress.</div>';
	}

	html += '' +
	'  </div>' +
	'</div>';

	return html;
};




setup.phoneRenderEbayItem = function (offerId) {
	setup.ensureShopState();
	var sv = State.variables;

	var offer = setup.shopGetOffer(offerId);
	if (!offer) {
		return '<div class="phone-ui-placeholder">Item not found.</div>';
	}

	var item = setup.shopGetItem(offer.itemId) || {};
	var cash = setup.getHeroStat("heroMoney");

	function esc(s) { return setup.escapeHtml(String(s || "")); }

	var name = item.name || offer.title || offer.itemId || offer.id;
	var desc = item.descLong || offer.descLong || offer.desc || item.desc || "";
	var thumb = setup.shopGetThumbUrl(item);
	var eta = Number(offer.etaDays || 1);
	if (!isFinite(eta) || eta < 0) eta = 1;

	var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : null;
	var deliverDay = (day !== null) ? (day + eta) : null;
	var etaText = (eta <= 0) ? "Arrives today" : ("Arrives in ~" + eta + " day(s)");
	if (deliverDay !== null) etaText += " (Day " + deliverDay + ")";

	// stock / exclusive
	var stockInfo = setup.shopGetOfferStockInfo(offer.id);
	var soldOut = (stockInfo.mode !== "unlimited" && stockInfo.stock <= 0);
	var stockText = (stockInfo.mode === "unlimited") ? "In stock" : (soldOut ? "Sold out" : (stockInfo.stock + " left"));


	
	var stockBadge = '';
	if (soldOut) {
		stockBadge = '<div class="ebay-stock-badge soldout">Sold out</div>';
	} else if (stockInfo.mode !== "unlimited" && stockInfo.stock <= 2) {
		stockBadge = '<div class="ebay-stock-badge low">Only ' + stockInfo.stock + ' left</div>';
	}
var html = '' +
	'<div class="phone-section phone-ebay ebay-app">' +
	'  <div class="ebay-item">' +
	'    <div class="ebay-item-hero">' +
	'      <img class="ebay-item-img" src="' + esc(thumb) + '" alt="">' +
	'    </div>' +
	'    <div class="ebay-item-body">' +
	'      <div class="ebay-item-title">' + esc(name) + '</div>' +
	
	(stockBadge ? ('      ' + stockBadge) : '') +
(desc ? ('      <div class="ebay-item-desc">' + esc(desc) + '</div>') : '') +
	'      <div class="ebay-item-price">$' + Number(offer.price || 0) + '</div>' +
	'      <div class="ebay-item-meta">Estimated delivery: <b>' + esc(etaText) + '</b> · Stock: <b>' + esc(stockText) + '</b> · Cash: <b>$' + cash + '</b></div>' +
	'      <div class="ebay-item-actions">' +
	'        <button class="phone-btn phone-btn-primary ebay-buy-btn" data-ebay-buy="' + esc(offer.id) + '"' + (soldOut ? ' disabled' : '') + '>' + (soldOut ? 'Sold out' : 'Buy It Now') + '</button>' +
	'        <button class="phone-btn ebay-watch-btn" data-ebay-watch="' + esc(offer.id) + '">Watch</button>' +
	'      </div>' +
	'      <div class="ebay-item-note">' +
	'        <div class="ebay-note-row"><b>Seller:</b> Verified seller</div>' +
	'        <div class="ebay-note-row"><b>Returns:</b> 14 days</div>' +
	'        <div class="ebay-note-row"><b>Delivery:</b> Added to your Orders and delivered automatically.</div>' +
	'      </div>' +
	'    </div>' +
	'  </div>' +
	'</div>';

	return html;
};




setup.phoneRenderEbayOrders = function () {
	setup.ensureShopState();
	var sv = State.variables;
	if (typeof sv.ebayOrdersFilter !== "string") sv.ebayOrdersFilter = "all";
	function esc(s) { return setup.escapeHtml(String(s || "")); }
	var ordersAll = Array.isArray(sv.orders) ? sv.orders.filter(function (o) { return o && o.vendorId === "app_ebay"; }) : [];
	var pending = ordersAll.filter(function (o) { return !o.delivered; });
	var delivered = ordersAll.filter(function (o) { return !!o.delivered; });
	var list = ordersAll;
	if (sv.ebayOrdersFilter === "pending") list = pending;
	if (sv.ebayOrdersFilter === "delivered") list = delivered;
	var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;
	var html = '' +
	'<div class="phone-section phone-ebay ebay-app">' +
	'  <div class="ebay-orders-head">' +
	'    <div class="ebay-orders-title">Orders</div>' +
	'    <div class="ebay-orders-count">' + esc(pending.length) + ' pending · ' + esc(delivered.length) + ' delivered</div>' +
	'  </div>' +
	'  <div class="ebay-chips ebay-chips-orders">' +
	'    <button class="ebay-chip' + (sv.ebayOrdersFilter === "all" ? ' is-active' : '') + '" data-ebay-orders-filter="all">All</button>' +
	'    <button class="ebay-chip' + (sv.ebayOrdersFilter === "pending" ? ' is-active' : '') + '" data-ebay-orders-filter="pending">Pending</button>' +
	'    <button class="ebay-chip' + (sv.ebayOrdersFilter === "delivered" ? ' is-active' : '') + '" data-ebay-orders-filter="delivered">Delivered</button>' +
	'  </div>' +
	'  <div class="ebay-orders-list">';
	if (!list.length) {
		html += '<div class="phone-ui-placeholder">No orders yet.</div>';
	} else {
		list.forEach(function (ord) {
			var offer = setup.shopGetOffer(ord.offerId) || {};
			var item = setup.shopGetItem(ord.itemId) || {};
			var name = item.name || offer.title || ord.itemId || ord.offerId || "Item";
			var thumb = setup.shopGetThumbUrl(item);
			var qty = Number(ord.qty || 1);
			if (!isFinite(qty) || qty < 1) qty = 1;
			var deliverDay = (typeof ord.deliverDay === "number") ? ord.deliverDay : null;
			var daysLeft = (deliverDay !== null) ? (deliverDay - day) : null;
			var status = "";
			if (ord.delivered) {
				var dd = (typeof ord.deliveredDay === "number") ? ord.deliveredDay : deliverDay;
				status = "Delivered" + (typeof dd === "number" ? (" (Day " + dd + ")") : "");
			} else {
				if (daysLeft === null) {
					status = "Shipping";
				} else if (daysLeft <= 0) {
					status = "Arrives today" + (deliverDay !== null ? (" (Day " + deliverDay + ")") : "");
				} else {
					status = "Arrives in " + daysLeft + " day(s)" + (" (Day " + deliverDay + ")");
				}
			}
			var placedDay = (typeof ord.placedDay === "number") ? ord.placedDay : null;
			var meta = (placedDay !== null ? ("Ordered Day " + placedDay + " · ") : "") + status;
			html += '' +
			'<div class="ebay-order-row">' +
			'  <div class="ebay-order-thumb"><img src="' + esc(thumb) + '" alt=""></div>' +
			'  <div class="ebay-order-body">' +
			'    <div class="ebay-order-title">' + esc(name) + (qty > 1 ? (' <span class="ebay-order-qty">x' + qty + '</span>') : '') + '</div>' +
			'    <div class="ebay-order-meta">' + esc(meta) + '</div>' +
			'  </div>' +
			'</div>';
		});
	}
	html += '' +
	'  </div>' +
	'</div>';
	return html;
};

/* =====================================================
   APP: Inventory (Phone)
   -----------------------------------------------------
   Goal:
     - Show what player owns (State.variables.inv itemId->qty)
     - Allow basic actions:
         * open item details
         * discard item (qty - 1)
         * gift item to NPC (and optional effects)
   Data model:
     - Items metadata live in setup.shopItems[] (single catalog)
     - Inventory quantities live in $inv (object: itemId -> qty)
     - Gift history lives in $giftLog (npcId -> itemId -> count)
     - Optional gift effects are configured in setup.giftRules[]
   ===================================================== */

setup.ensureGiftState = function () {
	var sv = State.variables;
	if (!sv) return;

	// Gift history (counts): npcId -> itemId -> count
	if (!sv.giftLog || typeof sv.giftLog !== "object" || Array.isArray(sv.giftLog)) {
		sv.giftLog = {};
	}

	// Gift meta (timestamps, last qty, etc.): npcId -> itemId -> { firstDay, lastDay, lastQty, count }
	if (!sv.giftLogMeta || typeof sv.giftLogMeta !== "object" || Array.isArray(sv.giftLogMeta)) {
		sv.giftLogMeta = {};
	}

	// Rule trigger bookkeeping (for once/cooldowns): key -> { count, lastDay }
	if (!sv.ruleFired || typeof sv.ruleFired !== "object" || Array.isArray(sv.ruleFired)) {
		sv.ruleFired = {};
	}

	// Item usage bookkeeping: itemId -> { count, lastDay }
	if (!sv.itemUseLog || typeof sv.itemUseLog !== "object" || Array.isArray(sv.itemUseLog)) {
		sv.itemUseLog = {};
	}

	// Author-facing scene unlock flags
	if (!sv.unlockedScenes || typeof sv.unlockedScenes !== "object" || Array.isArray(sv.unlockedScenes)) {
		sv.unlockedScenes = {};
	}

	// Optional: queue story scenes/events without hard-jumping passages
	if (!Array.isArray(sv.sceneQueue)) {
		sv.sceneQueue = [];
	}
};

setup.invGetQty = function (itemId) {
	setup.ensureShopState();
	var sv = State.variables;
	if (!sv || !sv.inv || !itemId) return 0;
	var q = Number(sv.inv[itemId] || 0);
	return (isFinite(q) && q > 0) ? q : 0;
};

setup.invRemove = function (itemId, qty) {
	setup.ensureShopState();
	var sv = State.variables;
	if (!sv || !sv.inv || !itemId) return false;
	qty = Number(qty || 0);
	if (!isFinite(qty) || qty <= 0) return false;

	var cur = setup.invGetQty(itemId);
	if (cur <= 0) return false;

	// remove via existing inventory helper
	setup.shopAddToInventory(itemId, -qty);
	return true;
};

// Gift + item-use rules engine (advanced, safe, no eval)
// --------------------------------------------------------------------
// Author-facing arrays (optional):
//
// setup.giftRules = [
//   {
//     id: "perfume_like_alice",
//     itemId: "vanilla_perfume",     // string | array
//     npcId: "npc_elly",             // string | array | "*" (any unlocked NPC)
//     priority: 10,                  // higher runs earlier
//     once: "perNpcItem",            // "global" | "perNpc" | "perItem" | "perNpcItem" | "perDay" | "perNpcDay" | "never"
//     cooldownDays: 0,               // optional
//     when: {
//       firstTime: true,             // first gift of this item to this NPC
//       requiresShopFlags: ["flag1"],
//       lacksShopFlags: ["flag2"],
//       relationIn: ["friend","lover"],
//       npcStatsMin: { affection: 10 },
//       heroStatsMin:{ confidence: 5 },
//       dayMin: 1,
//       dayMax: 999,
//       chance: 1.0                  // 0..1, evaluated at apply-time (preview ignores chance<1)
//     },
//     effects: [
//       { type:"npcStat", key:"affection", delta:+10 },         // delta * qty by default
//       { type:"setShopFlag", flag:"ebay_mystery_unlocked" },
//       { type:"unlockScene", id:"scene_perfume_reaction" },
//       { type:"toast", text:"She loved the perfume!" }
//     ],
//     stop: false                    // if true, stops further rules after this one fires
//   }
// ];
//
// setup.itemUseRules = [
//   {
//     id:"use_mystery_box",
//     itemId:"mystery_box",
//     once:"perDay",
//     effects:[
//       { type:"addMoney", delta: 50 },
//       { type:"toast", text:"You found $50 inside!" }
//     ]
//   }
// ];
//
// Effects supported (safe):
//   toast, npcStat, heroStat, setShopFlag, clearShopFlag, unlockScene, queueScene,
//   addMoney, spendMoney, addItem, removeItem, addFansCoins
// --------------------------------------------------------------------

if (!Array.isArray(setup.giftRules)) setup.giftRules = [];
if (!Array.isArray(setup.itemUseRules)) setup.itemUseRules = [];

/* ============================================================
   Authoring helpers (optional DSL)
   ------------------------------------------------------------
   Goal: let you define deep gift/use effects as a "constructor",
   not as verbose objects.

   You can still write raw objects in setup.giftRules / setup.itemUseRules.
   These helpers are just sugar.

   Usage examples (copy/paste):
     // 1) First time Elly gets vanilla perfume
     setup.Gift.first("npc_elly","vanilla_perfume")
       .prio(20).relIn(["friend","lover"]).npcMin({ affection: 20 })
       .npcStat("affection", +15)
       .npcApp("fans", true)              // unlock Fans app for this NPC (optional)
       .queueScene("SCN_ELLY_PERFUME_01") // or .unlockScene(...)
       .toast("Elly: Ммм… это мой любимый аромат!")
       .stop()
       .add();

     // 2) Generic rule: any gift gives +2 affection
     setup.Gift.any("gift_generic_aff")
       .prio(0).npc("*")
       .npcStat("affection", +2)
       .add();

     // 3) Use consumable item
     setup.Use.on("energy_drink")
       .heroStat("stamina", +10)
       .toast("+10 stamina")
       .add();
   ============================================================ */

setup.E = setup.E || {};
setup.E.toast = function (text, style, ms) {
	return { type: "toast", text: String(text || ""), style: style || "info", ms: (ms === undefined ? 2200 : Number(ms)) };
};
setup.E.npcStat = function (key, delta, perQty) {
	return { type: "npcStat", key: String(key || ""), delta: (typeof delta === "function" ? delta : Number(delta || 0)), perQty: (perQty === false ? false : true) };
};
setup.E.heroStat = function (key, delta, perQty) {
	return { type: "heroStat", key: String(key || ""), delta: (typeof delta === "function" ? delta : Number(delta || 0)), perQty: (perQty === false ? false : true) };
};
setup.E.setShopFlag = function (flag, value) {
	return { type: "setShopFlag", flag: String(flag || ""), value: (value === undefined ? true : !!value) };
};
setup.E.clearShopFlag = function (flag) {
	return { type: "clearShopFlag", flag: String(flag || "") };
};
setup.E.unlockScene = function (id) {
	return { type: "unlockScene", id: String(id || "") };
};
setup.E.queueScene = function (id, payload, opts) {
	return { type: "queueScene", id: String(id || ""), payload: payload || null, opts: (opts && typeof opts === "object") ? opts : null };
};
setup.E.addMoney = function (delta, perQty) {
	return { type: "addMoney", delta: (typeof delta === "function" ? delta : Number(delta || 0)), perQty: (perQty === false ? false : true) };
};
setup.E.spendMoney = function (cost, perQty) {
	return { type: "spendMoney", cost: (typeof cost === "function" ? cost : Number(cost || 0)), perQty: (perQty === false ? false : true) };
};
setup.E.addItem = function (itemId, qty, perQty) {
	return { type: "addItem", itemId: String(itemId || ""), qty: (typeof qty === "function" ? qty : Number(qty || 1)), perQty: (perQty === false ? false : true) };
};
setup.E.removeItem = function (itemId, qty, perQty) {
	return { type: "removeItem", itemId: String(itemId || ""), qty: (typeof qty === "function" ? qty : Number(qty || 1)), perQty: (perQty === false ? false : true) };
};
setup.E.addFansCoins = function (delta, perQty) {
	return { type: "addFansCoins", delta: (typeof delta === "function" ? delta : Number(delta || 0)), perQty: (perQty === false ? false : true) };
};
// NEW: unlock/disable phone apps for NPC (Fans/Match/etc.)
setup.E.npcApp = function (appKey, value, npcId) {
	return { type: "npcAppFlag", appKey: String(appKey || ""), value: (value === undefined ? true : !!value), npcId: (npcId ? String(npcId) : "") };
};
// NEW: unlock Fans content without paying (story reward)
setup.E.fansUnlockPost = function (postId, npcId) {
	return { type: "fansUnlockPost", npcId: (npcId ? String(npcId) : ""), postId: String(postId || "") };
};
setup.E.fansUnlockPPV = function (ppvId, npcId) {
	return { type: "fansUnlockPPV", npcId: (npcId ? String(npcId) : ""), ppvId: String(ppvId || "") };
};

// NEW: add media to NPC Gallery (unlocks wallpapers if canWallpaper=true)
setup.E.addNpcGalleryMedia = function (media, npcId) {
	return { type: "addNpcGalleryMedia", npcId: (npcId ? String(npcId) : ""), media: media || null };
};

// NEW: send NPC DM message in Fans/Match (for milestones, jealousy, etc.)
// opts can include: { delaySeconds, media:{id,thumb,full,canWallpaper}, ppv:{id,price,text,media}, previewText }
setup.E.fansNpcMsg = function (text, opts, npcId) {
	return { type: "fansNpcMsg", npcId: (npcId ? String(npcId) : ""), text: String(text || ""), opts: (opts && typeof opts === "object") ? opts : null };
};
setup.E.matchNpcMsg = function (text, opts, npcId) {
	return { type: "matchNpcMsg", npcId: (npcId ? String(npcId) : ""), text: String(text || ""), opts: (opts && typeof opts === "object") ? opts : null };
};


setup.Gift = setup.Gift || {};
setup.Use  = setup.Use  || {};

setup._mergeArr = function (dst, src) {
	if (!Array.isArray(src) || !src.length) return dst;
	if (!Array.isArray(dst)) dst = [];
	src.forEach(function (x) { if (x !== undefined && x !== null) dst.push(x); });
	return dst;
};

setup._RuleBuilder = function (kind, id) {
	this.kind = String(kind || "gift");
	this.r = {
		id: id || (this.kind + "_" + Math.floor(Math.random() * 1e9)),
		priority: 0,
		when: {},
		effects: [],
		stop: false
	};
	return this;
};

setup._RuleBuilder.prototype.id = function (id) { this.r.id = String(id || this.r.id); return this; };
setup._RuleBuilder.prototype.prio = function (n) { this.r.priority = Number(n || 0) || 0; return this; };
setup._RuleBuilder.prototype.priority = setup._RuleBuilder.prototype.prio;

setup._RuleBuilder.prototype.npc = function (npcId) { this.r.npcId = npcId; return this; };          // gift
setup._RuleBuilder.prototype.item = function (itemId) { this.r.itemId = itemId; return this; };      // gift/use
setup._RuleBuilder.prototype.type = function (itemType) { this.r.itemType = itemType; return this; };// gift
setup._RuleBuilder.prototype.once = function (mode) { this.r.once = mode; return this; };
setup._RuleBuilder.prototype.cooldown = function (days) { this.r.cooldownDays = Number(days || 0) || 0; return this; };
setup._RuleBuilder.prototype.stop = function (v) { this.r.stop = (v === undefined ? true : !!v); return this; };

setup._RuleBuilder.prototype.when = function (obj) {
	if (!obj || typeof obj !== "object") return this;
	if (!this.r.when || typeof this.r.when !== "object") this.r.when = {};
	for (var k in obj) {
		if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;
		this.r.when[k] = obj[k];
	}
	return this;
};

// common "when" sugar
setup._RuleBuilder.prototype.firstTime = function () { return this.when({ firstTime: true }); };
setup._RuleBuilder.prototype.reqFlags = function (flags) {
	this.r.when.requiresShopFlags = setup._mergeArr(this.r.when.requiresShopFlags, setup._asArr(flags) || []);
	return this;
};
setup._RuleBuilder.prototype.noFlags = function (flags) {
	this.r.when.lacksShopFlags = setup._mergeArr(this.r.when.lacksShopFlags, setup._asArr(flags) || []);
	return this;
};
setup._RuleBuilder.prototype.relIn = function (arr) { return this.when({ relationIn: setup._asArr(arr) }); };
setup._RuleBuilder.prototype.npcMin = function (map) { return this.when({ npcStatsMin: map || {} }); };
setup._RuleBuilder.prototype.heroMin = function (map) { return this.when({ heroStatsMin: map || {} }); };
setup._RuleBuilder.prototype.dayBetween = function (minDay, maxDay) { return this.when({ dayMin: minDay, dayMax: maxDay }); };
setup._RuleBuilder.prototype.chance = function (p) { return this.when({ chance: Number(p || 0) }); };

// effects sugar
setup._RuleBuilder.prototype.effect = function (e) { if (e) this.r.effects.push(e); return this; };
setup._RuleBuilder.prototype.effects = function (arr) {
	if (Array.isArray(arr)) { for (var i = 0; i < arr.length; i++) this.effect(arr[i]); }
	return this;
};
setup._RuleBuilder.prototype.toast = function (text, style, ms) { return this.effect(setup.E.toast(text, style, ms)); };
setup._RuleBuilder.prototype.npcStat = function (key, delta, perQty) { return this.effect(setup.E.npcStat(key, delta, perQty)); };
setup._RuleBuilder.prototype.heroStat = function (key, delta, perQty) { return this.effect(setup.E.heroStat(key, delta, perQty)); };
setup._RuleBuilder.prototype.setFlag = function (flag, value) { return this.effect(setup.E.setShopFlag(flag, value)); };
setup._RuleBuilder.prototype.clearFlag = function (flag) { return this.effect(setup.E.clearShopFlag(flag)); };
setup._RuleBuilder.prototype.unlockScene = function (id) { return this.effect(setup.E.unlockScene(id)); };
setup._RuleBuilder.prototype.queueScene = function (id, payload, opts) { return this.effect(setup.E.queueScene(id, payload, opts)); };
setup._RuleBuilder.prototype.addMoney = function (delta, perQty) { return this.effect(setup.E.addMoney(delta, perQty)); };
setup._RuleBuilder.prototype.spendMoney = function (cost, perQty) { return this.effect(setup.E.spendMoney(cost, perQty)); };
setup._RuleBuilder.prototype.addItem = function (itemId, qty, perQty) { return this.effect(setup.E.addItem(itemId, qty, perQty)); };
setup._RuleBuilder.prototype.removeItem = function (itemId, qty, perQty) { return this.effect(setup.E.removeItem(itemId, qty, perQty)); };
setup._RuleBuilder.prototype.addFansCoins = function (delta, perQty) { return this.effect(setup.E.addFansCoins(delta, perQty)); };
setup._RuleBuilder.prototype.npcApp = function (appKey, value, npcId) { return this.effect(setup.E.npcApp(appKey, value, npcId)); };
setup._RuleBuilder.prototype.fansUnlockPost = function (postId, npcId) { return this.effect(setup.E.fansUnlockPost(postId, npcId)); };
setup._RuleBuilder.prototype.fansUnlockPPV = function (ppvId, npcId) { return this.effect(setup.E.fansUnlockPPV(ppvId, npcId)); };
setup._RuleBuilder.prototype.addNpcGalleryMedia = function (media, npcId) { return this.effect(setup.E.addNpcGalleryMedia(media, npcId)); };

setup._RuleBuilder.prototype.add = function () {
	if (this.kind === "use") setup.itemUseRules.push(this.r);
	else setup.giftRules.push(this.r);
	return this.r;
};

// Entry points
setup.Gift.rule  = function (id) { return new setup._RuleBuilder("gift", id); };
setup.Gift.any   = function (id) { return new setup._RuleBuilder("gift", id); };
setup.Gift.first = function (npcId, itemId, id) {
	return new setup._RuleBuilder("gift", id || ("gift_first_" + String(npcId) + "_" + String(itemId)))
		.npc(npcId).item(itemId)
		.once("perNpcItem")
		.firstTime();
};

setup.Use.rule = function (id) { return new setup._RuleBuilder("use", id); };
setup.Use.on   = function (itemId, id) { return new setup._RuleBuilder("use", id || ("use_" + String(itemId))).item(itemId); };


/* =====================================================
   Templates (Preset builders)
   -----------------------------------------------------
   Goal: create "deep effects" rules in 1–2 lines.
   Each template returns a RuleBuilder, so you can chain
   more methods and finish with .add().
   Tip: pass { add:true } to auto-add immediately.
   ===================================================== */

setup.Templates = setup.Templates || {};

// normalize options
setup.Templates._opt = function (o) { return o || {}; };

// apply shared options to a builder (safe, no eval)
setup.Templates._applyCommon = function (b, o) {
	o = o || {};
	if (o.id) b.id(o.id);
	if (o.priority !== undefined) b.prio(o.priority);
	if (o.once) b.once(o.once);
	if (o.cooldownDays) b.cooldown(o.cooldownDays);
	if (o.stop !== undefined) b.stop(o.stop);

	// common "when" sugar
	if (o.reqFlags) b.reqFlags(o.reqFlags);
	if (o.noFlags) b.noFlags(o.noFlags);
	if (o.relIn) b.relIn(o.relIn);
	if (o.npcMin) b.npcMin(o.npcMin);
	if (o.heroMin) b.heroMin(o.heroMin);

	// day window (optional)
	if (o.dayMin !== undefined || o.dayMax !== undefined) {
		var minD = (o.dayMin !== undefined) ? Number(o.dayMin) : -999999;
		var maxD = (o.dayMax !== undefined) ? Number(o.dayMax) :  999999;
		b.dayBetween(minD, maxD);
	}

	if (o.chance !== undefined) b.chance(o.chance);
	return b;
};

setup.Templates._finish = function (b, o) {
	if (o && o.add) b.add();
	return b;
};

setup.Templates._setClearFlags = function (b, o) {
	o = o || {};
	if (o.setFlags) {
		var sf = Array.isArray(o.setFlags) ? o.setFlags : [o.setFlags];
		sf.forEach(function (f) { if (f) b.setFlag(String(f), true); });
	}
	if (o.clearFlags) {
		var cf = Array.isArray(o.clearFlags) ? o.clearFlags : [o.clearFlags];
		cf.forEach(function (f) { if (f) b.clearFlag(String(f)); });
	}
	return b;
};

/* -----------------------------
   Gift templates
   ----------------------------- */

// Romance-style gift: +affection (or any npcStat key), optional scene unlock/queue, optional app unlocks
// usage:
//   setup.Templates.romanceGift("npc_elly","vanilla_perfume",{ scene:"SCN_ELLY_PERFUME_01" }).add();
setup.Templates.romanceGift = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_romance_" + String(npcId) + "_" + String(itemId));
	var b = setup.Gift.first(npcId, itemId, id);

	// defaults
	if (o.priority === undefined) b.prio(30);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	// common romance constraints
	if (!o.relIn) b.relIn(["friend", "lover"]);
	if (o.minAffection !== undefined) b.npcMin({ affection: Number(o.minAffection || 0) });

	// main stat bump
	var key = o.statKey || "affection";
	var delta = (o.delta !== undefined) ? o.delta : +10;
	b.npcStat(key, delta, (o.perQty === false ? false : true));

	// optional app unlocks
	if (o.unlockFans) b.npcApp("fans", true);
	if (o.unlockMatch) b.npcApp("match", true);

	// optional story hooks
	if (o.unlockScene) b.unlockScene(String(o.unlockScene));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	// optional toast
	if (o.toast) b.toast(String(o.toast));

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};

// Unlock one or multiple phone apps for NPC (Fans/Match/whatever you use)
// usage: setup.Templates.unlockApps("npc_elly","phone_upgrade",["fans","match"],{ toast:"..." }).add();
setup.Templates.unlockApps = function (npcId, itemId, apps, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_unlockApps_" + String(npcId) + "_" + String(itemId));
	var b = setup.Gift.first(npcId, itemId, id);

	if (o.priority === undefined) b.prio(50);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	(apps || []).forEach(function (appKey) {
		if (appKey) b.npcApp(String(appKey), true);
	});

	if (o.toast) b.toast(String(o.toast));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};

// Convenience wrappers
setup.Templates.unlockFans = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);
	return setup.Templates.unlockApps(npcId, itemId, ["fans"], o);
};
setup.Templates.unlockMatch = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);
	return setup.Templates.unlockApps(npcId, itemId, ["match"], o);
};

// Unlock Fans content (post / ppv) as a reward for a gift
// usage: setup.Templates.fansContentReward("npc_elly","lingerie_set",{ posts:["post_01"], ppv:["ppv_02"] }).add();
setup.Templates.fansContentReward = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_fansContent_" + String(npcId) + "_" + String(itemId));
	var b = setup.Gift.first(npcId, itemId, id);

	if (o.priority === undefined) b.prio(45);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	// unlock app by default unless explicitly disabled
	if (o.unlockFans !== false) b.npcApp("fans", true);

	var posts = o.posts || [];
	var ppv = o.ppv || [];
	(Array.isArray(posts) ? posts : [posts]).forEach(function (pid) { if (pid) b.fansUnlockPost(String(pid)); });
	(Array.isArray(ppv) ? ppv : [ppv]).forEach(function (pid) { if (pid) b.fansUnlockPPV(String(pid)); });

	if (o.toast) b.toast(String(o.toast));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};

// Wallpaper / gallery reward for a gift (adds media to NPC gallery; canWallpaper can unlock wallpapers)
// usage:
//   setup.Templates.wallpaperReward("npc_elly","polaroid_photo",{
//       id:"elly_polaroid_01", thumb:"img/.._t.jpg", full:"img/..jpg", canWallpaper:true
//   },{ toast:"New photo added!" }).add();
setup.Templates.wallpaperReward = function (npcId, itemId, media, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_wallpaper_" + String(npcId) + "_" + String(itemId));
	var b = setup.Gift.first(npcId, itemId, id);

	if (o.priority === undefined) b.prio(35);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	b.addNpcGalleryMedia(media || null, String(npcId));

	if (o.toast) b.toast(String(o.toast));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};

// Set/clear shop flags as a reward for a gift (useful for unlocking offers, vendors, story availability)
// usage: setup.Templates.shopFlagUnlock("npc_elly","mysterious_key",{ setFlags:["ebay_secret"] }).add();
setup.Templates.shopFlagUnlock = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_shopFlags_" + String(npcId) + "_" + String(itemId));
	var b = setup.Gift.first(npcId, itemId, id);

	if (o.priority === undefined) b.prio(25);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	setup.Templates._setClearFlags(b, o);

	if (o.toast) b.toast(String(o.toast));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	return setup.Templates._finish(b, o);
};

/* -----------------------------
   Use templates
   ----------------------------- */

// Simple consumable: modify hero stat on use
// usage: setup.Templates.useHeroStat("energy_drink","stamina",+10,{ toast:"+10 stamina" }).add();
setup.Templates.useHeroStat = function (itemId, statKey, delta, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_useHero_" + String(itemId));
	var b = setup.Use.on(itemId, id);

	if (o.priority === undefined) b.prio(10);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	b.heroStat(String(statKey || "stamina"), delta, (o.perQty === false ? false : true));

	if (o.toast) b.toast(String(o.toast));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};

// Consumable: modify NPC stat on use (rare, but useful for scripted items)
// usage: setup.Templates.useNpcStat("mood_pill","npc_elly","mood",+5,{ toast:"..." }).add();
setup.Templates.useNpcStat = function (itemId, npcId, statKey, delta, o) {
	o = setup.Templates._opt(o);
	var id = o.id || ("tpl_useNpc_" + String(itemId) + "_" + String(npcId));
	var b = setup.Use.on(itemId, id);

	if (o.priority === undefined) b.prio(10);
	if (o.stop === undefined) b.stop(true);

	setup.Templates._applyCommon(b, o);

	// force target npcId in effect itself
	b.effect({ type: "npcStat", npcId: String(npcId || ""), key: String(statKey || "affection"), delta: delta, perQty: (o.perQty === false ? false : true) });

	if (o.toast) b.toast(String(o.toast));
	if (o.scene) b.queueScene(String(o.scene), o.scenePayload);

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};


// small helpers
setup._asArr = function (v) {
	if (v === undefined || v === null) return null;
	return Array.isArray(v) ? v : [v];
};
setup._nowDay = function () {
	var sv = State.variables;
	return (typeof sv.dayCounter === "number") ? sv.dayCounter : ((typeof sv.day === "number") ? sv.day : 0);
};


/* -----------------------------
   Super-templates (one-liners)
   -----------------------------
   These templates may create MULTIPLE rules at once.
   They return a small helper object:
     - .add()      : add all generated rules
     - .builders[] : array of RuleBuilders
   Use { add:true } to auto-add immediately.
   ----------------------------- */

setup.Templates._Multi = function (builders, o) {
	builders = Array.isArray(builders) ? builders : [];
	o = setup.Templates._opt(o);
	var obj = {
		builders: builders,
		add: function () {
			this.builders.forEach(function (b) { if (b && typeof b.add === "function") b.add(); });
			return this.builders;
		}
	};
	if (o.add) obj.add();
	return obj;
};


// Romance tiers: different effect depending on current NPC stat tier (default: affection).
// Creates N rules with npcMin thresholds; higher tiers have higher priority and stop=true by default.
// usage (one-liner):
//   setup.Templates.romanceTierGift("npc_elly","roses",{ add:true });
// usage (custom tiers):
//   setup.Templates.romanceTierGift("npc_elly","roses",{ tiers:[{min:0,delta:2},{min:40,delta:6,scene:"SCN"},{min:80,delta:12}], add:true });
setup.Templates.romanceTierGift = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);

	var statKey = o.statKey || "affection";
	var relIn = ("relIn" in o) ? o.relIn : ["friend", "lover"];
	var baseId = o.id || ("tpl_romanceTier_" + String(npcId) + "_" + String(itemId));
	var basePrio = (o.priority === undefined) ? 35 : Number(o.priority || 0);

	var tiers = (Array.isArray(o.tiers) && o.tiers.length) ? o.tiers.slice() : [
		{ min: 80, delta: 14, toast: o.toastHigh || "", scene: o.sceneHigh || "" },
		{ min: 50, delta: 10, toast: o.toastMid  || "", scene: o.sceneMid  || "" },
		{ min: 20, delta: 6,  toast: o.toastLow  || "", scene: o.sceneLow  || "" },
		{ min: 0,  delta: 3,  toast: "" }
	];
	tiers.sort(function (a, b) { return Number((b && b.min) || 0) - Number((a && a.min) || 0); });

	var builders = [];
	for (var i = 0; i < tiers.length; i++) {
		var t = tiers[i] || {};
		var id = baseId + "_t" + i;

		var bld = (o.firstOnly ? setup.Gift.first(npcId, itemId, id) : setup.Gift.rule(id).npc(npcId).item(itemId));

		// once/cooldown
		if (t.once !== undefined) bld.once(t.once);
		else if (o.once !== undefined) bld.once(o.once);

		if (t.cooldownDays !== undefined) bld.cooldown(t.cooldownDays);
		else if (o.cooldownDays !== undefined) bld.cooldown(o.cooldownDays);

		// priority/stop
		bld.prio((t.priority !== undefined) ? Number(t.priority || 0) : (basePrio + (tiers.length - i)));
		bld.stop((t.stop !== undefined) ? !!t.stop : (o.stop !== undefined ? !!o.stop : true));

		// shared conditions
		if (relIn) bld.relIn(relIn);
		if (t.when && typeof t.when === "object") bld.when(t.when);

		// stat threshold
		var minVal = Number((t.min !== undefined) ? t.min : 0);
		if (isFinite(minVal) && minVal > 0) {
			var mm = {}; mm[statKey] = minVal;
			bld.npcMin(mm);
		}

		// flags/day/chance
		if (o.requiresFlags) bld.when({ requiresShopFlags: o.requiresFlags });
		if (o.lacksFlags) bld.when({ lacksShopFlags: o.lacksFlags });
		if (o.dayMin !== undefined || o.dayMax !== undefined) bld.when({ dayMin: o.dayMin, dayMax: o.dayMax });
		if (o.chance !== undefined) bld.chance(o.chance);
		if (t.chance !== undefined) bld.chance(t.chance);

		// core effect: npcStat
		var perQty = (t.perQty !== undefined) ? t.perQty : (o.perQty !== undefined ? o.perQty : true);
		var delta = (t.delta !== undefined) ? t.delta : (o.delta !== undefined ? o.delta : 0);
		bld.effect({ type: "npcStat", key: statKey, delta: delta, perQty: (perQty === false ? false : true) });

		// optional app unlocks
		if (t.unlockFans || o.unlockFans) bld.effect({ type: "npcAppFlag", npcId: String(npcId), appKey: "fans", value: true });
		if (t.unlockMatch || o.unlockMatch) bld.effect({ type: "npcAppFlag", npcId: String(npcId), appKey: "match", value: true });

		// fans content unlock
		if (Array.isArray(t.posts)) t.posts.forEach(function (pid) { if (pid) bld.effect({ type: "fansUnlockPost", npcId: String(npcId), postId: String(pid) }); });
		if (Array.isArray(t.ppv))  t.ppv.forEach(function (ppvId) { if (ppvId) bld.effect({ type: "fansUnlockPPV", npcId: String(npcId), ppvId: String(ppvId) }); });

		// scene
		var sceneId = t.scene || "";
		if (sceneId) {
			if (t.sceneMode === "unlock" || o.sceneMode === "unlock") bld.unlockScene(sceneId);
			else bld.queueScene(sceneId, { npcId: String(npcId), itemId: String(itemId), tierMin: minVal });
		}

		// toast
		var toastText = t.toast || "";
		if (toastText) bld.toast(toastText);

		// set/clear flags (merge template + tier)
		setup.Templates._setClearFlags(bld, o);
		if (t.setFlags || t.clearFlags) setup.Templates._setClearFlags(bld, t);

		builders.push(bld);
	}

	return setup.Templates._Multi(builders, o);
};


// Jealousy trigger: when you gift something to someone else, apply effects to jealousNpcId.
// Typical use: lower trust / raise jealousy, set a flag, queue a scene, optionally DM.
// NOTE: by default excludes gifts to the jealous NPC itself (excludeNpcIds).
// usage:
//   setup.Templates.jealousyTrigger("npc_elly",{ itemId:"roses", deltaTrust:-6, scene:"SCN_ELLY_JEALOUS_01", add:true });
setup.Templates.jealousyTrigger = function (jealousNpcId, o) {
	o = setup.Templates._opt(o);

	var id = o.id || ("tpl_jealousy_" + String(jealousNpcId));
	var b = setup.Gift.rule(id);

	// What gift triggers jealousy?
	if (o.itemId) b.item(o.itemId);
	if (o.itemType) b.type(o.itemType);

	// Who you gift to (recipient). Default: anyone.
	b.npc(o.watchNpcId || "*");

	// Default: once per day per jealous NPC
	if (o.once === undefined) b.once("perNpcDay"); else if (o.once) b.once(o.once);
	if (o.cooldownDays !== undefined) b.cooldown(o.cooldownDays);

	b.prio((o.priority === undefined) ? 85 : Number(o.priority || 0));
	b.stop(!!o.stop); // default false: don't block other gift rules

	// exclude gifts to the jealous npc itself
	var ex = [String(jealousNpcId)];
	if (Array.isArray(o.excludeNpcIds)) ex = ex.concat(o.excludeNpcIds);
	b.when({ excludeNpcIds: ex });

	// Optional: only if jealous NPC has specific relationKey with hero (e.g. lover)
	if (o.jealousRelIn) {
		var relList = setup._asArr(o.jealousRelIn) || [];
		b.when({ custom: function () {
			var sv = State.variables;
			var rk = (sv && sv.npcs && sv.npcs[jealousNpcId]) ? (sv.npcs[jealousNpcId].relationKey || "") : "";
			return !relList.length || relList.indexOf(rk) !== -1;
		}});
	}

	// Effects apply to jealousNpcId (NOT the recipient)
	var trustKey = o.trustKey || "trust";
	var jealousKey = o.jealousKey || "jealousy";

	var dTrust = (o.deltaTrust !== undefined) ? Number(o.deltaTrust || 0) : -5;
	var dJeal  = (o.deltaJealousy !== undefined) ? Number(o.deltaJealousy || 0) : +5;

	if (isFinite(dTrust) && dTrust !== 0) b.effect({ type: "npcStat", npcId: String(jealousNpcId), key: trustKey, delta: dTrust, perQty: false });
	if (isFinite(dJeal)  && dJeal  !== 0) b.effect({ type: "npcStat", npcId: String(jealousNpcId), key: jealousKey, delta: dJeal,  perQty: false });

	// Optional: set a shop flag as a simple narrative latch
	if (o.flag) b.effect({ type: "setShopFlag", flag: String(o.flag), value: true });

	// Optional: queue a scene with payload including jealous + recipient + item
	if (o.scene) {
		b.queueScene(String(o.scene), {
			jealousNpcId  : String(jealousNpcId),
			recipientNpcId: function (ctx) { return ctx.npcId; },
			itemId        : function (ctx) { return ctx.itemId; },
			day           : function (ctx) { return ctx.day; }
		});
	}

	// Optional: DM message (Fans or Match)
	if (o.fansDmText) b.effect(setup.E.fansNpcMsg(String(o.fansDmText), o.fansDmOpts || {}, String(jealousNpcId)));
	if (o.matchDmText) b.effect(setup.E.matchNpcMsg(String(o.matchDmText), o.matchDmOpts || {}, String(jealousNpcId)));

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};


// Fans milestone: a "reward bundle" for a specific NPC.
// Unlock posts/PPV, optionally add wallpaper, optionally send an automatic Fans DM.
// Default trigger: first gift of itemId to npcId (once perNpcItem).
// usage (one-liner):
//   setup.Templates.fansMilestone("npc_elly","lingerie_set",{ posts:["post_01"], ppv:["ppv_02"], dmText:"I posted something special for you 😈", wallpaper:{id:"w1",thumb:"...",full:"...",canWallpaper:true}, add:true });
setup.Templates.fansMilestone = function (npcId, itemId, o) {
	o = setup.Templates._opt(o);

	var id = o.id || ("tpl_fansMilestone_" + String(npcId) + "_" + String(itemId));
	var on = (o.on === "use") ? "use" : "gift";

	var b = (on === "use") ? setup.Use.on(itemId, id) : setup.Gift.first(npcId, itemId, id);

	b.prio((o.priority === undefined) ? 60 : Number(o.priority || 0));
	if (o.stop === undefined) b.stop(true);

	// ensure NPC has Fans app
	b.effect({ type: "npcAppFlag", npcId: String(npcId), appKey: "fans", value: true });

	// unlock content
	var posts = setup._asArr(o.posts) || [];
	var ppv   = setup._asArr(o.ppv)   || [];
	posts.forEach(function (pid) { if (pid) b.effect({ type: "fansUnlockPost", npcId: String(npcId), postId: String(pid) }); });
	ppv.forEach(function (ppvId) { if (ppvId) b.effect({ type: "fansUnlockPPV", npcId: String(npcId), ppvId: String(ppvId) }); });

	// optional: add wallpaper to gallery
	if (o.wallpaper) b.effect({ type: "addNpcGalleryMedia", npcId: String(npcId), media: o.wallpaper });

	// optional: auto DM message in Fans (text/media/ppv)
	if (o.dmText || o.dmOpts) {
		b.effect(setup.E.fansNpcMsg(String(o.dmText || "New content unlocked."), o.dmOpts || {}, String(npcId)));
	}

	// optional: queue scene
	if (o.scene) b.queueScene(String(o.scene), { npcId: String(npcId), itemId: String(itemId), kind: "fansMilestone" });

	// optional: flag latch
	if (o.flag) b.effect({ type: "setShopFlag", flag: String(o.flag), value: true });

	setup.Templates._setClearFlags(b, o);
	return setup.Templates._finish(b, o);
};

setup._npcStatVal = function (npcId, key) {
	var sv = State.variables;
	if (!sv || !sv.npcs || !sv.npcs[npcId] || !sv.npcs[npcId].stats) return 0;
	var n = Number(sv.npcs[npcId].stats[key] || 0);
	return (isFinite(n) ? n : 0);
};
setup._hasShopFlag = function (flag) {
	return !!setup.getShopFlag(flag, false);
};

// Queue scenes/events without hard-jumping passages (author decides how to consume them)
// ---------------------------------------------------------------------------
// Data model: $sceneQueue = [ { id, day, payload, meta } ]
// meta (optional):
//   mode:      "any" | "inline" | "runner"   (default: "any")
//   priority:  number (default: 0)
//   anchor:    string | string[] (inline only): passageName or "prefix*"
//   minDay/maxDay, minTimeIndex/maxTimeIndex (optional constraints)
//
// Author usage examples:
//   setup.queueScene("SCN_ELLY_PERFUME_01", { npcId:"npc_elly", itemId:"vanilla_perfume" });
//   setup.queueScene("SCN_HOME_EVENT_01", null, { mode:"inline", anchor:"home*", priority:50 });
//   setup.queueScene("SCN_BIG_EVENT_01", null, { mode:"runner" });

setup.ensureSceneState = function () {
	setup.ensureGiftState();
	var sv = State.variables;
	if (!sv) return;
	if (!Array.isArray(sv.sceneQueue)) sv.sceneQueue = [];
	if (typeof sv.sceneQueueAuto !== "boolean") sv.sceneQueueAuto = false;
	if (typeof sv.activeSceneId !== "string") sv.activeSceneId = "";
	if (typeof sv.sceneReturn !== "string") sv.sceneReturn = "";
	if (typeof sv.sceneMode !== "string") sv.sceneMode = "";
	if (typeof sv.sceneId !== "string") sv.sceneId = "";
	if (typeof sv.sceneInlineId !== "string") sv.sceneInlineId = "";
	if (!("scenePayload" in sv)) sv.scenePayload = null;
	if (!("sceneInlineMeta" in sv)) sv.sceneInlineMeta = null;
};

setup.queueScene = function (sceneId, payload, opts) {
	setup.ensureSceneState();
	var sv = State.variables;
	if (!sceneId) return;

	opts = (opts && typeof opts === "object") ? opts : {};

	function numOrNull(v) {
		if (v === undefined || v === null || v === "") return null;
		var n = Number(v);
		return (isFinite(n) ? n : null);
	}

	var meta = {
		mode        : String(opts.mode || "any"),
		priority    : Number(opts.priority || 0),
		anchor      : (opts.anchor === undefined ? null : opts.anchor),
		minDay      : numOrNull(opts.minDay),
		maxDay      : numOrNull(opts.maxDay),
		minTimeIndex: numOrNull(opts.minTimeIndex),
		maxTimeIndex: numOrNull(opts.maxTimeIndex)
	};
	if (!isFinite(meta.priority)) meta.priority = 0;

	sv.sceneQueue.push({ id: String(sceneId), day: setup._nowDay(), payload: payload || null, meta: meta });
};

// Legacy FIFO pop (kept for compatibility)
setup.popScene = function () {
	setup.ensureSceneState();
	var sv = State.variables;
	return (sv.sceneQueue && sv.sceneQueue.length) ? sv.sceneQueue.shift() : null;
};

setup._sceneAnchorMatch = function (anchor, passageName) {
	if (!anchor) return true;
	passageName = String(passageName || "");
	var list = Array.isArray(anchor) ? anchor : [anchor];
	for (var i = 0; i < list.length; i++) {
		var a = (list[i] == null) ? "" : String(list[i]);
		if (!a) continue;
		if (a.slice(-1) === "*") {
			var pref = a.slice(0, -1);
			if (pref === "" || passageName.indexOf(pref) === 0) return true;
		} else {
			if (passageName === a) return true;
		}
	}
	return false;
};

setup._sceneItemReady = function (item, wantMode, passageName) {
	if (!item || !item.id) return false;
	var meta = (item.meta && typeof item.meta === "object") ? item.meta : {};
	var mode = String(meta.mode || "any");
	wantMode = String(wantMode || "any");

	// mode filter
	if (wantMode !== "any") {
		if (mode !== "any" && mode !== wantMode) return false;
	}

	// day/time windows
	var sv = State.variables;
	var nowDay = setup._nowDay();
	var tIdx = Number((sv && sv.timeOfDayIndex) || 0);
	if (!isFinite(tIdx)) tIdx = 0;

	if (meta.minDay !== null && typeof meta.minDay === "number" && nowDay < meta.minDay) return false;
	if (meta.maxDay !== null && typeof meta.maxDay === "number" && nowDay > meta.maxDay) return false;
	if (meta.minTimeIndex !== null && typeof meta.minTimeIndex === "number" && tIdx < meta.minTimeIndex) return false;
	if (meta.maxTimeIndex !== null && typeof meta.maxTimeIndex === "number" && tIdx > meta.maxTimeIndex) return false;

	// anchor (inline only)
	if (wantMode === "inline") {
		if (!setup._sceneAnchorMatch(meta.anchor, passageName)) return false;
	}

	return true;
};

// Consume next queued scene by priority (desc), then FIFO order
setup.consumeScene = function (opts) {
	setup.ensureSceneState();
	var sv = State.variables;
	opts = (opts && typeof opts === "object") ? opts : {};
	var wantMode = String(opts.mode || "any");
	var passageName = String(opts.passageName || (State.passage && State.passage.title) || "");

	var bestIdx = -1;
	var bestPr  = -Infinity;
	for (var i = 0; i < sv.sceneQueue.length; i++) {
		var it = sv.sceneQueue[i];
		if (!setup._sceneItemReady(it, wantMode, passageName)) continue;
		var pr = Number((it && it.meta && it.meta.priority) || 0);
		if (!isFinite(pr)) pr = 0;
		if (bestIdx === -1 || pr > bestPr) {
			bestIdx = i;
			bestPr = pr;
		}
	}
	if (bestIdx === -1) return null;
	return sv.sceneQueue.splice(bestIdx, 1)[0];
};

// Runner start/exit helpers
setup.sceneRunnerStart = function (sceneId, payload, returnPassage) {
	setup.ensureSceneState();
	var sv = State.variables;
	if (!sceneId) return false;

	sv.activeSceneId = String(sceneId);
	sv.scenePayload  = payload || null;
	sv.sceneReturn   = String(returnPassage || (State.passage && State.passage.title) || "home");
	sv.sceneMode     = "runner";
	sv.sceneId       = sv.activeSceneId;

	Engine.play("__SceneRunner");
	return true;
};

setup.sceneRunnerExit = function () {
	setup.ensureSceneState();
	var sv = State.variables;
	var ret = String(sv.sceneReturn || "home");

	sv.activeSceneId = "";
	sv.sceneMode = "";
	sv.sceneId = "";
	sv.sceneInlineId = "";
	sv.sceneInlineMeta = null;
	sv.scenePayload = null;
	// keep sceneQueueAuto

	Engine.play(ret);
};

// Optional auto-consumer: starts runner scenes after each passage (when enabled)
setup.sceneTick = function (reason) {
	setup.ensureSceneState();
	var sv = State.variables;
	if (!sv.sceneQueueAuto) return false;
	if (sv.activeSceneId) return false;

	// Don't interrupt overlays
	try {
		if ((typeof $ === "function") && (("#phone-overlay" && $("#phone-overlay").hasClass("visible")) || ("#map-overlay" && $("#map-overlay").hasClass("visible")))) {
			return false;
		}
	} catch (e) {}

	var it = setup.consumeScene({ mode: "runner" });
	if (!it) return false;
	return setup.sceneRunnerStart(it.id, it.payload, (State.passage && State.passage.title) || "home");
};

// One-time hook: run sceneTick on :passageend (only if $sceneQueueAuto is enabled)
if (!setup._sceneQueueConsumerHook) {
	setup._sceneQueueConsumerHook = true;
	$(document).on(":passageend", function () {
		try { setup.sceneTick("passageend"); } catch (e) {}
	});
}

// Rule bookkeeping (once/cooldowns)
setup._ruleKey = function (kind, rule, ctx) {
	var id = (rule && rule.id) ? String(rule.id) : "rule_" + String(ctx && ctx._idx || 0);
	var scope = (rule && rule.once) ? String(rule.once) : "never";
	if (rule && rule.oncePerNpc && !rule.once) scope = "perNpcItem"; // legacy

	var k = kind + ":" + id + ":" + scope;
	if (scope === "global") return k;
	if (scope === "perNpc") return k + ":" + String(ctx.npcId || "");
	if (scope === "perItem") return k + ":" + String(ctx.itemId || "");
	if (scope === "perNpcItem") return k + ":" + String(ctx.npcId || "") + ":" + String(ctx.itemId || "");
	if (scope === "perDay") return k + ":" + String(ctx.day || 0);
	if (scope === "perNpcDay") return k + ":" + String(ctx.npcId || "") + ":" + String(ctx.day || 0);
	// "never" or unknown
	return null;
};
setup._ruleCanFire = function (kind, rule, ctx) {
	setup.ensureGiftState();
	var sv = State.variables;

	// cooldownDays
	var cd = Number(rule && rule.cooldownDays || 0);
	if (!isFinite(cd) || cd < 0) cd = 0;

	var key = setup._ruleKey(kind, rule, ctx);
	if (!key) return true;

	var rec = sv.ruleFired[key];
	if (!rec || typeof rec !== "object") return true;

	if (cd > 0 && typeof rec.lastDay === "number") {
		if ((ctx.day - rec.lastDay) < cd) return false;
	}

	// once semantics
	var once = (rule && rule.once) ? String(rule.once) : (rule && rule.oncePerNpc ? "perNpcItem" : "never");
	if (once && once !== "never") {
		// if fired at least once -> do not fire again
		if (typeof rec.count === "number" && rec.count > 0) return false;
	}

	return true;
};
setup._ruleMarkFired = function (kind, rule, ctx) {
	setup.ensureGiftState();
	var sv = State.variables;

	var key = setup._ruleKey(kind, rule, ctx);
	if (!key) return;

	var rec = sv.ruleFired[key];
	if (!rec || typeof rec !== "object") rec = { count: 0, lastDay: null };
	rec.count = (typeof rec.count === "number" ? rec.count : 0) + 1;
	rec.lastDay = ctx.day;
	sv.ruleFired[key] = rec;
};

// Rule matcher (conditions)
setup._ruleMatches = function (rule, ctx) {
	if (!rule) return false;

	// item match
	if (rule.itemId || rule.itemIds) {
		var list = setup._asArr(rule.itemIds || rule.itemId) || [];
		if (list.length && list.indexOf(ctx.itemId) === -1) return false;
	}

	// npc match (optional)
	if (rule.npcId || rule.npcIds) {
		var nl = setup._asArr(rule.npcIds || rule.npcId) || [];
		if (nl.length && nl[0] !== "*" && nl.indexOf(ctx.npcId) === -1) return false;
	}

	// type match (optional, uses item.type)
	if (rule.itemType) {
		var tl = setup._asArr(rule.itemType) || [];
		var def = setup.shopGetItem(ctx.itemId) || {};
		if (tl.length && tl.indexOf(def.type || "other") === -1) return false;
	}

	var w = rule.when || {};

	// extra filters (optional)
	if (w.excludeNpcIds) {
		var ex = setup._asArr(w.excludeNpcIds) || [];
		if (ex.length && ex.indexOf(ctx.npcId) !== -1) return false;
	}
	if (w.excludeItemIds) {
		var exi = setup._asArr(w.excludeItemIds) || [];
		if (exi.length && exi.indexOf(ctx.itemId) !== -1) return false;
	}
	if (typeof w.custom === "function") {
		// author predicate (keep deterministic + side-effect free!)
		try { if (!w.custom(ctx, rule)) return false; } catch (e) { return false; }
	}

	// day window
	if (typeof w.dayMin === "number" && ctx.day < w.dayMin) return false;
	if (typeof w.dayMax === "number" && ctx.day > w.dayMax) return false;

	// first-time gift/use (uses ctx.giftCountBefore / ctx.useCountBefore)
	if (w.firstTime === true) {
		var n = (typeof ctx.giftCountBefore === "number") ? ctx.giftCountBefore : ((typeof ctx.useCountBefore === "number") ? ctx.useCountBefore : 0);
		if (n > 0) return false;
	}

	// shop flags
	if (Array.isArray(w.requiresShopFlags)) {
		for (var i = 0; i < w.requiresShopFlags.length; i++) {
			if (!setup._hasShopFlag(w.requiresShopFlags[i])) return false;
		}
	}
	if (Array.isArray(w.lacksShopFlags)) {
		for (var j = 0; j < w.lacksShopFlags.length; j++) {
			if (setup._hasShopFlag(w.lacksShopFlags[j])) return false;
		}
	}

	// relation key filter (gift only)
	if (w.relationIn && ctx.npcId) {
		var sv = State.variables;
		var rk = (sv && sv.npcs && sv.npcs[ctx.npcId]) ? (sv.npcs[ctx.npcId].relationKey || "") : "";
		var rl = setup._asArr(w.relationIn) || [];
		if (rl.length && rl.indexOf(rk) === -1) return false;
	}

	// npc stat mins
	if (w.npcStatsMin && ctx.npcId) {
		for (var k in w.npcStatsMin) {
			if (!Object.prototype.hasOwnProperty.call(w.npcStatsMin, k)) continue;
			var need = Number(w.npcStatsMin[k] || 0);
			if (!isFinite(need)) continue;
			if (setup._npcStatVal(ctx.npcId, k) < need) return false;
		}
	}

	// hero stat mins
	if (w.heroStatsMin) {
		for (var h in w.heroStatsMin) {
			if (!Object.prototype.hasOwnProperty.call(w.heroStatsMin, h)) continue;
			var need2 = Number(w.heroStatsMin[h] || 0);
			if (!isFinite(need2)) continue;
			if (setup.getHeroStat(h) < need2) return false;
		}
	}

	// chance (evaluated at apply-time only; caller can ignore for previews)
	if (typeof w.chance === "number") {
		var c = w.chance;
		if (!isFinite(c)) c = 1;
		if (c <= 0) return false;
		if (c < 1 && ctx._applyChance === true) {
			if (Math.random() > c) return false;
		}
	}

	return true;
};

// Apply effects (supports array-form and legacy object-form)

// Resolve payload object: if any field is a function(ctx), evaluate it safely.
setup._resolvePayload = function (payload, ctx) {
	if (!payload || typeof payload !== "object") return payload;
	var out = Array.isArray(payload) ? [] : {};
	for (var k in payload) {
		if (!Object.prototype.hasOwnProperty.call(payload, k)) continue;
		var v = payload[k];
		if (typeof v === "function") {
			try { out[k] = v(ctx); } catch (e) { out[k] = null; }
		} else if (v && typeof v === "object" && !Array.isArray(v)) {
			// shallow nested resolve
			out[k] = setup._resolvePayload(v, ctx);
		} else {
			out[k] = v;
		}
	}
	return out;
};

setup.applyEffects = function (effects, ctx) {
	setup.ensureGiftState();
	setup.ensureShopState();
	var sv = State.variables;

	if (!effects) return;

	// legacy object-form
	if (!Array.isArray(effects) && typeof effects === "object") {
		// npc stat deltas
		if (effects.npcStats && typeof effects.npcStats === "object" && ctx.npcId) {
			for (var k in effects.npcStats) {
				if (!Object.prototype.hasOwnProperty.call(effects.npcStats, k)) continue;
				var d = Number(effects.npcStats[k] || 0);
				if (isFinite(d) && d !== 0) setup.addNpcStat(ctx.npcId, k, d * (ctx.qty || 1));
			}
		}
		// hero stat deltas
		if (effects.heroStats && typeof effects.heroStats === "object") {
			for (var h in effects.heroStats) {
				if (!Object.prototype.hasOwnProperty.call(effects.heroStats, h)) continue;
				var d2 = Number(effects.heroStats[h] || 0);
				if (isFinite(d2) && d2 !== 0) setup.addHeroStat(h, d2 * (ctx.qty || 1));
			}
		}
		// shop flags
		if (Array.isArray(effects.setShopFlags)) {
			effects.setShopFlags.forEach(function (flag) { if (flag) setup.setShopFlag(flag, true); });
		}
		if (Array.isArray(effects.clearShopFlags)) {
			effects.clearShopFlags.forEach(function (flag2) { if (flag2) setup.setShopFlag(flag2, false); });
		}
		// scenes
		if (Array.isArray(effects.unlockScenes)) {
			effects.unlockScenes.forEach(function (sid) { if (sid) sv.unlockedScenes[sid] = true; });
		}
		if (Array.isArray(effects.queueScenes)) {
			effects.queueScenes.forEach(function (sid2) { if (sid2) setup.queueScene(sid2, { npcId: ctx.npcId, itemId: ctx.itemId, qty: ctx.qty }); });
		}
		// economy
		if (typeof effects.addMoney === "number") setup.addMoney(effects.addMoney * (ctx.qty || 1));
		if (typeof effects.spendMoney === "number") setup.spendMoney(effects.spendMoney * (ctx.qty || 1));
		if (typeof effects.fansCoins === "number") {
			setup.ensureFansAppState();
			sv.fansApp.coins += effects.fansCoins * (ctx.qty || 1);
		}
		// inventory
		if (effects.addItems && typeof effects.addItems === "object") {
			for (var itId in effects.addItems) {
				if (!Object.prototype.hasOwnProperty.call(effects.addItems, itId)) continue;
				var q = Number(effects.addItems[itId] || 0);
				if (isFinite(q) && q !== 0) setup.shopAddToInventory(itId, q);
			}
		}
		if (effects.removeItems && typeof effects.removeItems === "object") {
			for (var itId2 in effects.removeItems) {
				if (!Object.prototype.hasOwnProperty.call(effects.removeItems, itId2)) continue;
				var q2 = Number(effects.removeItems[itId2] || 0);
				if (isFinite(q2) && q2 !== 0) setup.shopAddToInventory(itId2, -Math.abs(q2));
			}
		}

		if (typeof effects.toast === "string" && effects.toast && setup.toast) setup.toast(effects.toast, "info", 2200);
		return;
	}

	// array-form actions
	if (!Array.isArray(effects)) return;

	effects.forEach(function (a) {
		if (!a || !a.type) return;
		var t = String(a.type);

		if (t === "toast") {
			if (setup.toast && a.text) setup.toast(String(a.text), a.style || "info", Number(a.ms || 2200));
			return;
		}

		if (t === "npcStat" && a.key) {
			var nid0 = a.npcId ? String(a.npcId) : (ctx.npcId || "");
			if (!nid0) return;
			var d = (typeof a.delta === "function") ? Number(a.delta(ctx) || 0) : Number(a.delta || 0);
			if (isFinite(d) && d !== 0) setup.addNpcStat(nid0, String(a.key), d * ((a.perQty === false) ? 1 : (ctx.qty || 1)));
			return;
		}

if (t === "heroStat" && a.key) {
			var d2 = (typeof a.delta === "function") ? Number(a.delta(ctx) || 0) : Number(a.delta || 0);
			if (isFinite(d2) && d2 !== 0) setup.addHeroStat(String(a.key), d2 * ((a.perQty === false) ? 1 : (ctx.qty || 1)));
			return;
		}

		if (t === "setShopFlag") {
			if (a.flag) setup.setShopFlag(String(a.flag), ("value" in a) ? !!a.value : true);
			if (Array.isArray(a.flags)) a.flags.forEach(function (f) { if (f) setup.setShopFlag(String(f), true); });
			return;
		}

		if (t === "clearShopFlag") {
			if (a.flag) setup.setShopFlag(String(a.flag), false);
			if (Array.isArray(a.flags)) a.flags.forEach(function (f2) { if (f2) setup.setShopFlag(String(f2), false); });
			return;
		}

		if (t === "npcAppFlag" && a.appKey) {
			var nid = a.npcId ? String(a.npcId) : (ctx.npcId || "");
			if (!nid) return;
			if (typeof setup.npcSetAppFlag === "function") {
				setup.npcSetAppFlag(nid, String(a.appKey), ("value" in a) ? !!a.value : true);
			}
			return;
		}

		if (t === "fansUnlockPost" && a.postId) {
			var nid2 = a.npcId ? String(a.npcId) : (ctx.npcId || "");
			if (!nid2) return;
			if (typeof setup.fansUnlockPost === "function") setup.fansUnlockPost(nid2, String(a.postId));
			return;
		}

		if (t === "fansUnlockPPV" && a.ppvId) {
			var nid3 = a.npcId ? String(a.npcId) : (ctx.npcId || "");
			if (!nid3) return;
			if (typeof setup.fansUnlockPPV === "function") setup.fansUnlockPPV(nid3, String(a.ppvId));
			else if (typeof setup.fansUnlockPpv === "function") setup.fansUnlockPpv(nid3, String(a.ppvId));
			return;
		}


		if (t === "addNpcGalleryMedia" && a.media) {
			var nid4 = a.npcId ? String(a.npcId) : (ctx.npcId || "");
			if (!nid4) return;
			if (typeof setup.phoneAddMediaToNpcGallery === "function") setup.phoneAddMediaToNpcGallery(nid4, a.media);
			return;
		}

if (t === "fansNpcMsg") {
	var nidM = a.npcId ? String(a.npcId) : (ctx.npcId || "");
	if (!nidM) return;
	var o = (a.opts && typeof a.opts === "object") ? a.opts : {};
	var delay = Number(o.delaySeconds || 0);
	if (!isFinite(delay) || delay < 0) delay = 0;

	// prefer explicit send helpers (typing + delay)
	if (o.ppv && typeof o.ppv === "object" && typeof setup.fansNpcSendPPV === "function") {
		setup.fansNpcSendPPV(
			nidM,
			String(a.text || o.previewText || "🔒 PPV"),
			delay,
			o.ppv.id,
			Number(o.ppv.price || 0),
			String(o.ppv.text || ""),
			o.ppv.media ? (o.ppv.media.id || "") : "",
			o.ppv.media ? (o.ppv.media.thumb || "") : "",
			o.ppv.media ? (o.ppv.media.full || o.ppv.media.thumb || "") : "",
			o.ppv.media ? (o.ppv.media.canWallpaper !== false) : true
		);
		return;
	}

	if (o.media && typeof o.media === "object" && typeof setup.fansNpcSendMedia === "function") {
		setup.fansNpcSendMedia(
			nidM,
			String(a.text || o.previewText || "📷 Photo"),
			delay,
			o.media.id || "",
			o.media.thumb || "",
			o.media.full || o.media.thumb || "",
			o.media.canWallpaper !== false
		);
		return;
	}

	if (delay > 0 && typeof setup.fansNpcSendText === "function") {
		setup.fansNpcSendText(nidM, String(a.text || ""), delay);
		return;
	}

	if (typeof setup._fansAddNpcMessage === "function") {
		setup._fansAddNpcMessage(nidM, String(a.text || ""), o);
		return;
	}

	if (typeof setup.fansNpcSendText === "function") setup.fansNpcSendText(nidM, String(a.text || ""), 0);
	return;
}

if (t === "matchNpcMsg") {
	var nidMM = a.npcId ? String(a.npcId) : (ctx.npcId || "");
	if (!nidMM) return;
	var o2 = (a.opts && typeof a.opts === "object") ? a.opts : {};
	var delay2 = Number(o2.delaySeconds || 0);
	if (!isFinite(delay2) || delay2 < 0) delay2 = 0;

	if (o2.media && typeof o2.media === "object" && typeof setup.matchNpcSendMedia === "function") {
		setup.matchNpcSendMedia(
			nidMM,
			String(a.text || o2.previewText || "📷 Photo"),
			delay2,
			o2.media.id || "",
			o2.media.thumb || "",
			o2.media.full || o2.media.thumb || "",
			o2.media.canWallpaper !== false
		);
		return;
	}

	if (delay2 > 0 && typeof setup.matchNpcSendText === "function") {
		setup.matchNpcSendText(nidMM, String(a.text || ""), delay2);
		return;
	}

	if (typeof setup._matchAddNpcMessage === "function") {
		setup._matchAddNpcMessage(nidMM, String(a.text || ""), o2);
		return;
	}

	if (typeof setup.matchNpcSendText === "function") setup.matchNpcSendText(nidMM, String(a.text || ""), 0);
	return;
}

		if (t === "unlockScene" && a.id) {
			sv.unlockedScenes[String(a.id)] = true;
			return;
		}

		if (t === "queueScene" && a.id) {
	var pl = a.payload || { npcId: ctx.npcId, itemId: ctx.itemId, qty: ctx.qty };
	pl = setup._resolvePayload(pl, ctx);
	setup.queueScene(String(a.id), pl, a.opts);
	return;
}

		if (t === "addMoney") {
			var dm = (typeof a.delta === "function") ? Number(a.delta(ctx) || 0) : Number(a.delta || 0);
			if (isFinite(dm) && dm !== 0) setup.addMoney(dm * ((a.perQty === false) ? 1 : (ctx.qty || 1)));
			return;
		}

		if (t === "spendMoney") {
			var cm = (typeof a.cost === "function") ? Number(a.cost(ctx) || 0) : Number(a.cost || 0);
			if (isFinite(cm) && cm > 0) setup.spendMoney(cm * ((a.perQty === false) ? 1 : (ctx.qty || 1)));
			return;
		}

		if (t === "addItem" && a.itemId) {
			var qi = (typeof a.qty === "function") ? Number(a.qty(ctx) || 1) : Number(a.qty || 1);
			if (!isFinite(qi) || qi === 0) return;
			setup.shopAddToInventory(String(a.itemId), qi * ((a.perQty === false) ? 1 : (ctx.qty || 1)));
			return;
		}

		if (t === "removeItem" && a.itemId) {
			var qr = (typeof a.qty === "function") ? Number(a.qty(ctx) || 1) : Number(a.qty || 1);
			if (!isFinite(qr) || qr === 0) return;
			setup.shopAddToInventory(String(a.itemId), -Math.abs(qr) * ((a.perQty === false) ? 1 : (ctx.qty || 1)));
			return;
		}

		if (t === "addFansCoins") {
			var dc = (typeof a.delta === "function") ? Number(a.delta(ctx) || 0) : Number(a.delta || 0);
			if (!isFinite(dc) || dc === 0) return;
			setup.ensureFansAppState();
			sv.fansApp.coins += dc * ((a.perQty === false) ? 1 : (ctx.qty || 1));
			return;
		}
	});
};

// Utility: detect whether item is "usable" (shows the Use button in Inventory UI)
setup.invIsUsable = function (itemId) {
	setup.ensureShopState();
	var it = setup.shopGetItem(itemId) || {};
	if (it.usable === true || it.consumable === true) return true;

	// If author defined a rule for this item, it counts as usable
	var rules = Array.isArray(setup.itemUseRules) ? setup.itemUseRules : [];
	for (var i = 0; i < rules.length; i++) {
		var r = rules[i];
		if (!r) continue;
		if (r.itemId || r.itemIds) {
			var list = setup._asArr(r.itemIds || r.itemId) || [];
			if (list.indexOf(itemId) !== -1) return true;
		}
	}
	return false;
};


// Clamp selected use qty:
// - only consumables can use > 1 at a time
// - always respects current inventory qty
setup.invClampUseQty = function (itemId, qty) {
	setup.ensureShopState();
	itemId = String(itemId || "");
	var it = setup.shopGetItem(itemId) || {};
	var q = Number(qty || 1);
	if (!isFinite(q) || q < 1) q = 1;

	// reusable items are "activate once"
	if (it.consumable !== true) return 1;

	var cur = setup.invGetQty(itemId);
	if (q > cur) q = cur;
	if (q < 1) q = 1;
	return q;
};

// Preview helper (best-effort): builds a short text line of deterministic effects (ignores chance<1)
setup.invPreviewRuleEffects = function (kind, npcId, itemId, qty) {
	var out = [];
	var rules = (kind === "gift") ? (Array.isArray(setup.giftRules) ? setup.giftRules : []) : (Array.isArray(setup.itemUseRules) ? setup.itemUseRules : []);
	var sv = State.variables;

	var ctx = {
		kind: kind,
		npcId: npcId || "",
		itemId: itemId || "",
		qty: Number(qty || 1),
		day: setup._nowDay(),
		giftCountBefore: (kind === "gift" && npcId && sv.giftLog && sv.giftLog[npcId] && typeof sv.giftLog[npcId][itemId] === "number") ? sv.giftLog[npcId][itemId] : 0,
		useCountBefore: (kind === "use" && sv.itemUseLog && sv.itemUseLog[itemId] && typeof sv.itemUseLog[itemId].count === "number") ? sv.itemUseLog[itemId].count : 0,
		_applyChance: false
	};

	for (var i = 0; i < rules.length; i++) {
		var r = rules[i];
		if (!r) continue;
		var w = r.when || {};
		if (typeof w.chance === "number" && w.chance < 1) continue; // ignore random previews
		ctx._idx = i;
		if (!setup._ruleMatches(r, ctx)) continue;
		if (!setup._ruleCanFire(kind, r, ctx)) continue;

		// legacy object-form (npcStats / unlockScenes / setShopFlags)
		if (r.effects && !Array.isArray(r.effects) && typeof r.effects === "object") {
			var eff = r.effects;
			if (eff.npcStats && npcId) {
				for (var k in eff.npcStats) {
					if (!Object.prototype.hasOwnProperty.call(eff.npcStats, k)) continue;
					var d = Number(eff.npcStats[k] || 0);
					if (isFinite(d) && d !== 0) out.push(k + (d > 0 ? " +" : " ") + (d * (ctx.qty || 1)));
				}
			}
			if (Array.isArray(eff.unlockScenes)) out.push("scene");
			if (Array.isArray(eff.setShopFlags)) out.push("unlock");
			continue;
		}

		// array-form actions
		if (Array.isArray(r.effects)) {
			r.effects.forEach(function (a) {
				if (!a || !a.type) return;
				var t = String(a.type);

				if (t === "npcStat" && a.key && npcId) {
					var d2 = (typeof a.delta === "function") ? NaN : Number(a.delta || 0);
					if (isFinite(d2) && d2 !== 0) out.push(String(a.key) + (d2 > 0 ? " +" : " ") + (d2 * (ctx.qty || 1)));
					return;
				}
				if (t === "heroStat" && a.key) {
					var d3 = (typeof a.delta === "function") ? NaN : Number(a.delta || 0);
					if (isFinite(d3) && d3 !== 0) out.push("hero " + String(a.key) + (d3 > 0 ? " +" : " ") + (d3 * (ctx.qty || 1)));
					return;
				}

				if (t === "unlockScene" || t === "queueScene") { out.push("scene"); return; }
				if (t === "setShopFlag") { out.push("unlock"); return; }
				if (t === "clearShopFlag") { out.push("lock"); return; }
				if (t === "addMoney") { out.push("money"); return; }
				if (t === "spendMoney") { out.push("cost"); return; }
				if (t === "addFansCoins") { out.push("coins"); return; }
				if (t === "addItem") { out.push("item+"); return; }
				if (t === "removeItem") { out.push("item-"); return; }
				if (t === "npcAppFlag") { out.push("app"); return; }
				if (t === "fansUnlockPost") { out.push("fans post"); return; }
				if (t === "fansUnlockPPV") { out.push("fans ppv"); return; }
				if (t === "addNpcGalleryMedia") { out.push("media"); return; }
			});
}
	}

	// de-dupe
	var seen = {};
	var out2 = [];
	out.forEach(function (s) { if (!seen[s]) { seen[s] = true; out2.push(s); } });
	if (!out2.length) return "";
	return "Effect: " + out2.slice(0, 3).join(", ") + (out2.length > 3 ? "…" : "");
};

// Apply gift rules (called by invGiftToNpc)
setup.invApplyGiftRules = function (npcId, itemId, qty, extraCtx) {
	setup.ensureGiftState();
	var sv = State.variables;
	if (!sv || !npcId || !itemId) return;

	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	var day = setup._nowDay();

	var prevCount = 0;
	if (extraCtx && typeof extraCtx.giftCountBefore === "number") prevCount = extraCtx.giftCountBefore;
	else if (sv.giftLog && sv.giftLog[npcId] && typeof sv.giftLog[npcId][itemId] === "number") prevCount = sv.giftLog[npcId][itemId];

	var ctx = {
		kind: "gift",
		npcId: npcId,
		itemId: itemId,
		qty: qty,
		day: day,
		giftCountBefore: prevCount,
		_applyChance: true
	};

	var rules = Array.isArray(setup.giftRules) ? setup.giftRules.slice() : [];
	// stable order: priority desc, then as-defined
	rules.sort(function (a, b) {
		var pa = (a && typeof a.priority === "number") ? a.priority : 0;
		var pb = (b && typeof b.priority === "number") ? b.priority : 0;
		return pb - pa;
	});

	for (var i = 0; i < rules.length; i++) {
		var r = rules[i];
		if (!r) continue;
		ctx._idx = i;

		if (!setup._ruleMatches(r, ctx)) continue;
		if (!setup._ruleCanFire("gift", r, ctx)) continue;

		var w = r.when || {};
		// Legacy oncePerNpc guard (first gift only)
		if (r.oncePerNpc === true && prevCount > 0) continue;

		setup.applyEffects(r.effects, ctx);
		setup._ruleMarkFired("gift", r, ctx);

		if (r.stop) break;
	}
};

// Apply item-use rules
setup.invApplyItemUseRules = function (itemId, qty, extraCtx) {
	setup.ensureGiftState();
	var sv = State.variables;
	if (!sv || !itemId) return;

	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	var day = setup._nowDay();

	var prev = 0;
	if (extraCtx && typeof extraCtx.useCountBefore === "number") prev = extraCtx.useCountBefore;
	else if (sv.itemUseLog && sv.itemUseLog[itemId] && typeof sv.itemUseLog[itemId].count === "number") prev = sv.itemUseLog[itemId].count;

	var ctx = {
		kind: "use",
		npcId: "",
		itemId: itemId,
		qty: qty,
		day: day,
		useCountBefore: prev,
		_applyChance: true
	};

	var rules = Array.isArray(setup.itemUseRules) ? setup.itemUseRules.slice() : [];
	rules.sort(function (a, b) {
		var pa = (a && typeof a.priority === "number") ? a.priority : 0;
		var pb = (b && typeof b.priority === "number") ? b.priority : 0;
		return pb - pa;
	});

	for (var i = 0; i < rules.length; i++) {
		var r = rules[i];
		if (!r) continue;
		ctx._idx = i;

		if (!setup._ruleMatches(r, ctx)) continue;
		if (!setup._ruleCanFire("use", r, ctx)) continue;

		setup.applyEffects(r.effects, ctx);
		setup._ruleMarkFired("use", r, ctx);

		if (r.stop) break;
	}
};

// Use an item from inventory (optional: consumable)
setup.invUseItem = function (itemId, qty) {
	setup.ensureShopState();
	setup.ensureGiftState();
	var sv = State.variables;
	if (!sv || !sv.inv || !itemId) return false;

	var it = setup.shopGetItem(itemId) || {};
	if (!setup.invIsUsable(itemId)) {
		if (setup.toast) setup.toast("Can't use this item", "warn", 1800);
		return false;
	}

	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	var cur = setup.invGetQty(itemId);
	var consumable = (it.consumable === true); // default: not consumable
	if (consumable && cur < qty) {
		if (setup.toast) setup.toast("Not enough items", "warn", 1800);
		return false;
	}

	// Usage log (before we apply rules so rules can use firstTime)
	var prev = (sv.itemUseLog[itemId] && typeof sv.itemUseLog[itemId].count === "number") ? sv.itemUseLog[itemId].count : 0;

	// Consume first (so any effects that add/remove items start from the "after use" state)
	if (consumable) {
		setup.invRemove(itemId, qty);
	}

	// Update usage log
	var day = setup._nowDay();
	if (!sv.itemUseLog[itemId] || typeof sv.itemUseLog[itemId] !== "object") sv.itemUseLog[itemId] = { count: 0, lastDay: null };
	sv.itemUseLog[itemId].count = (typeof sv.itemUseLog[itemId].count === "number" ? sv.itemUseLog[itemId].count : 0) + qty;
	sv.itemUseLog[itemId].lastDay = day;

	// Apply rules
	setup.invApplyItemUseRules(itemId, qty, { useCountBefore: prev });

	// Quest event hook
	if (typeof setup.questEvent === "function") setup.questEvent("use", { itemId: String(itemId), qty: qty });

	// Default toast (if author didn't toast)
	if (setup.toast) setup.toast(consumable ? "Used" : "Activated", "info", 1200);
	return true;
};

setup.invGiftToNpc = function (itemId, npcId, qty) {
	setup.ensureShopState();
	setup.ensureGiftState();
	var sv = State.variables;

	if (!sv || !sv.inv || !sv.npcs || !sv.npcs[npcId]) return false;

	// respect item.giftable flag (default: giftable)
	var it = setup.shopGetItem(itemId) || {};
	if (it.giftable === false) {
		if (setup.toast) setup.toast("Can't gift this item", "warn", 1800);
		return false;
	}

	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	// Non-stackable items are gifted as x1
	if (it.stackable === false) qty = 1;

	var cur = setup.invGetQty(itemId);
	if (cur < qty) {
		if (setup.toast) setup.toast("Not enough items", "warn", 1800);
		return false;
	}

	// Determine previous gift count BEFORE logging (needed for firstTime / once guards)
	var prevCount = 0;
	if (sv.giftLog && sv.giftLog[npcId] && typeof sv.giftLog[npcId][itemId] === "number") {
		prevCount = sv.giftLog[npcId][itemId];
	}

	// remove from inventory
	setup.invRemove(itemId, qty);

	// effects (optional)
	setup.invApplyGiftRules(npcId, itemId, qty, { giftCountBefore: prevCount });

	// log gift (counts)
	sv.giftLog[npcId] = (sv.giftLog[npcId] && typeof sv.giftLog[npcId] === "object") ? sv.giftLog[npcId] : {};
	if (typeof sv.giftLog[npcId][itemId] !== "number") sv.giftLog[npcId][itemId] = 0;
	sv.giftLog[npcId][itemId] += qty;

	// log gift meta (timestamps)
	var day = setup._nowDay();
	sv.giftLogMeta[npcId] = (sv.giftLogMeta[npcId] && typeof sv.giftLogMeta[npcId] === "object") ? sv.giftLogMeta[npcId] : {};
	var meta = sv.giftLogMeta[npcId][itemId];
	if (!meta || typeof meta !== "object") meta = {};
	if (typeof meta.firstDay !== "number") meta.firstDay = day;
	meta.lastDay = day;
	meta.lastQty = qty;
	meta.count = sv.giftLog[npcId][itemId];
	sv.giftLogMeta[npcId][itemId] = meta;

	// toast
	var def = null;
	for (var i = 0; i < setup.npcDefinitions.length; i++) {
		if (setup.npcDefinitions[i] && setup.npcDefinitions[i].id === npcId) { def = setup.npcDefinitions[i]; break; }
	}
	var npcName = def ? ((typeof def.name === "function") ? def.name() : def.name) : npcId;
	var item = setup.shopGetItem(itemId) || { name: itemId };
	if (setup.toast) setup.toast("🎁 Gifted " + (item.name || itemId) + " to " + npcName, "info", 2200);

	// Quest event hook
	if (typeof setup.questEvent === "function") setup.questEvent("gift", { npcId: String(npcId), itemId: String(itemId), qty: qty });

	// event hook
	if (typeof setup.emitGameEvent === "function") {
		setup.emitGameEvent("gift", { npcId: String(npcId), itemId: String(itemId), qty: qty });
	}

	return true;
};

setup.phoneRenderInvHome = function () {
	setup.ensureShopState();
	setup.ensureGiftState();
	var sv = State.variables;

	if (typeof sv.invSearch !== "string") sv.invSearch = "";
	if (typeof sv.invCat !== "string") sv.invCat = "all";           // dynamic by item.type
	if (typeof sv.invTag !== "string") sv.invTag = "all";           // fixed: all|gifts|consumables|keys|quest|new
	if (typeof sv.invFilter !== "string") sv.invFilter = "all";     // all | usable | giftable
	if (typeof sv.invSort !== "string") sv.invSort = "name";        // name | recent | qty | type

	var dayNow = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;
	var q = sv.invSearch.trim().toLowerCase();

	function esc(s) { return setup.escapeHtml(String(s == null ? "" : s)); }

	// build list
	var invEntries = [];
	if (sv.inv && typeof sv.inv === "object") {
		Object.keys(sv.inv).forEach(function (itemId) {
			var qty = Number(sv.inv[itemId] || 0);
			if (!isFinite(qty) || qty <= 0) return;

			var it = setup.shopGetItem(itemId) || { id: itemId };
			var type = it.type || "other";

			var meta = (sv.invMeta && sv.invMeta[itemId] && typeof sv.invMeta[itemId] === "object") ? sv.invMeta[itemId] : {};
			var tags = Array.isArray(it.tags) ? it.tags.slice() : [];

			// infer some tags for quick navigation
			var usable = setup.invIsUsable(itemId);
			var giftable = (it.giftable !== false);

			if (type === "gift" || tags.indexOf("gift") !== -1) tags.push("gifts");
			if (type === "consumable" || usable || tags.indexOf("consumable") !== -1) tags.push("consumables");
			if (type === "key" || tags.indexOf("key") !== -1) tags.push("keys");
			if (type === "quest" || tags.indexOf("quest") !== -1) tags.push("quest");

			if ((typeof meta.acquiredDay === "number" && meta.acquiredDay === dayNow) ||
				(typeof meta.lastChangeDay === "number" && meta.lastChangeDay === dayNow)) {
				tags.push("new");
			}

			// normalize
			tags = tags.map(function (t) { return String(t || "").toLowerCase(); }).filter(function (t) { return !!t; });
			// unique
			var seen = {};
			tags = tags.filter(function (t) { if (seen[t]) return false; seen[t] = true; return true; });

			invEntries.push({ item: it, qty: qty, type: type, tags: tags, meta: meta });
		});
	}

	// totals (unfiltered)
	var totalItems = 0;
	invEntries.forEach(function (e) { totalItems += e.qty; });

	// categories present (from types)
	var cats = { all: "All" };
	invEntries.forEach(function (e) {
		var tp = e.type || "other";
		if (!cats[tp]) cats[tp] = tp.charAt(0).toUpperCase() + tp.slice(1);
	});

	// fixed tags row
	var tagRow = [
		{ k: "all", label: "All" },
		{ k: "gifts", label: "Gifts" },
		{ k: "consumables", label: "Consumables" },
		{ k: "keys", label: "Keys" },
		{ k: "quest", label: "Quest" },
		{ k: "new", label: "New" }
	];

	// apply filters
	var list = invEntries.slice();

	if (q) {
		list = list.filter(function (e) {
			var it = e.item || {};
			var hay = (String(it.name || "") + " " + String(it.desc || "") + " " + String(it.id || "")).toLowerCase();
			return hay.indexOf(q) !== -1;
		});
	}

	if (sv.invFilter === "usable") {
		list = list.filter(function (e) { return !!setup.invIsUsable(e.item && e.item.id); });
	}
	if (sv.invFilter === "giftable") {
		list = list.filter(function (e) { return (e.item && e.item.giftable !== false); });
	}

	if (sv.invCat !== "all") {
		list = list.filter(function (e) { return String(e.type || "other") === String(sv.invCat); });
	}

	if (sv.invTag !== "all") {
		list = list.filter(function (e) { return Array.isArray(e.tags) && e.tags.indexOf(String(sv.invTag)) !== -1; });
	}

	// sort
	list.sort(function (a, b) {
		if (sv.invSort === "recent") {
			var ad = Number((a.meta && a.meta.lastChangeDay) || (a.meta && a.meta.acquiredDay) || 0);
			var bd = Number((b.meta && b.meta.lastChangeDay) || (b.meta && b.meta.acquiredDay) || 0);
			if (bd !== ad) return bd - ad;
		}
		if (sv.invSort === "qty") {
			if (b.qty !== a.qty) return b.qty - a.qty;
		}
		if (sv.invSort === "type") {
			var at = String(a.type || "other");
			var bt = String(b.type || "other");
			var c = at.localeCompare(bt);
			if (c !== 0) return c;
		}
		var an = String((a.item && (a.item.name || a.item.id)) || "");
		var bn = String((b.item && (b.item.name || b.item.id)) || "");
		return an.localeCompare(bn);
	});

	var cash = setup.getHeroStat("heroMoney");

	var html = '' +
	'<div class="phone-section phone-inv inv-app">' +
	'  <div class="inv-topbar">' +
	'    <div class="inv-title">Inventory</div>' +
	'    <div class="inv-meta">Cash: <b>' + cash + '$</b> · Items: <b>' + totalItems + '</b></div>' +
	'  </div>' +
	'  <div class="inv-subbar">' +
	'    <input class="inv-search" data-inv-search="1" type="text" placeholder="Search…" value="' + esc(sv.invSearch) + '">' +
	'  </div>';

	// filters (All / Usable / Giftable)
	html += '  <div class="inv-chips">';
	[
		{ k: "all", label: "All" },
		{ k: "usable", label: "Usable" },
		{ k: "giftable", label: "Giftable" }
	].forEach(function (o) {
		var active = (sv.invFilter === o.k) ? " active" : "";
		html += '<button class="inv-chip' + active + '" data-inv-filter="' + esc(o.k) + '">' + esc(o.label) + '</button>';
	});
	html += '  </div>';

	// tags
	html += '  <div class="inv-chips inv-chips-tags">';
	tagRow.forEach(function (o) {
		var active = (sv.invTag === o.k) ? " active" : "";
		html += '<button class="inv-chip' + active + '" data-inv-tag="' + esc(o.k) + '">' + esc(o.label) + '</button>';
	});
	html += '  </div>';

	// categories (types)
	html += '  <div class="inv-chips">';
	Object.keys(cats).forEach(function (k) {
		var active2 = (sv.invCat === k) ? " active" : "";
		html += '<button class="inv-chip' + active2 + '" data-inv-cat="' + esc(k) + '">' + esc(cats[k]) + '</button>';
	});
	html += '  </div>';

	// sort
	html += '  <div class="inv-chips">';
	[
		{ k: "name", label: "Name" },
		{ k: "recent", label: "Recent" },
		{ k: "qty", label: "Qty" },
		{ k: "type", label: "Type" }
	].forEach(function (o) {
		var active3 = (sv.invSort === o.k) ? " active" : "";
		html += '<button class="inv-chip' + active3 + '" data-inv-sort="' + esc(o.k) + '">' + esc(o.label) + '</button>';
	});
	html += '  </div>';

	html += '  <div class="inv-list">';

	if (!list.length) {
		html += '<div class="phone-ui-placeholder">No items.</div>';
	} else {
		list.forEach(function (e) {
			var it = e.item;
			var thumb = setup.shopGetThumbUrl(it);
			var name = esc(it.name || it.id || "Item");
			var desc = esc(it.desc || "");
			var qty  = e.qty;

			var giftable = (it.giftable !== false);
			var usable = setup.invIsUsable(it.id);

			html += '' +
			'<div class="inv-card" data-inv-open="' + esc(it.id) + '">' +
			'  <div class="inv-thumb" style="background-image:url(\'' + thumb + '\')"></div>' +
			'  <div class="inv-card-body">' +
			'    <div class="inv-card-title">' + name + (e.tags && e.tags.indexOf("new") !== -1 ? ' <span class="inv-new">NEW</span>' : '') + '</div>' +
			'    <div class="inv-card-desc">' + desc + '</div>' +
			'    <div class="inv-card-foot">' +
			'      <div class="inv-qty">x' + qty + '</div>' +
			'      <div class="inv-actions">' +
			(usable ? '        <button class="inv-iconbtn" data-inv-use="' + esc(it.id) + '" title="Use">✨</button>' : '') +
			(giftable ? '        <button class="inv-iconbtn" data-inv-gift="' + esc(it.id) + '" title="Gift">🎁</button>' : '') +
			'        <button class="inv-iconbtn" data-inv-discard="' + esc(it.id) + '" title="Discard">🗑</button>' +
			'      </div>' +
			'    </div>' +
			'  </div>' +
			'</div>';
		});
	}

	html += '' +
	'  </div>' +
	'</div>';

	return html;
};

setup.phoneRenderInvItem = function (itemId) {
	setup.ensureShopState();
	setup.ensureGiftState();
	var sv = State.variables;

	itemId = String(itemId || "");
	var it = setup.shopGetItem(itemId);

	if (!it) {
		return '<div class="phone-section phone-inv inv-app"><div class="inv-empty">Item not found.</div></div>';
	}

	var qty = setup.invGetQty(itemId);
	var thumb = setup.shopGetThumbUrl(it);
	var name = setup.escapeHtml(it.name || it.id || "Item");
	var desc = setup.escapeHtml(it.descLong || it.desc || "");
	var giftable = (it.giftable !== false);
	var usable = setup.invIsUsable(itemId);
	var consumable = (it.consumable === true);

	// usage/gift history
	var usedRec = (sv.itemUseLog && sv.itemUseLog[itemId] && typeof sv.itemUseLog[itemId] === "object") ? sv.itemUseLog[itemId] : null;
	var usedCount = usedRec && typeof usedRec.count === "number" ? usedRec.count : 0;
	var usedLast = usedRec && typeof usedRec.lastDay === "number" ? usedRec.lastDay : null;

	var giftedTotal = 0;
	var giftedLines = [];
	if (sv.giftLog && typeof sv.giftLog === "object") {
		Object.keys(sv.giftLog).forEach(function (nid) {
			var m2 = sv.giftLog[nid];
			if (!m2 || typeof m2 !== "object") return;
			var c = Number(m2[itemId] || 0);
			if (!isFinite(c) || c <= 0) return;
			giftedTotal += c;

			// npc name (best-effort)
			var def = setup.npcDefinitions.find(function (d) { return d && d.id === nid; }) || null;
			var nm = def ? ((typeof def.name === "function") ? def.name() : def.name) : nid;
			giftedLines.push(nm + " x" + c);
		});
	}
	
	var html = '' +
	'<div class="phone-section phone-inv inv-app">' +
	'  <div class="inv-item">' +
	'    <div class="inv-item-hero">' +
	'      <div class="inv-item-img" style="background-image:url(\'' + thumb + '\')"></div>' +
	'      <div class="inv-item-title">' + name + '</div>' +
	'      <div class="inv-item-meta">In inventory: <b>x' + qty + '</b></div>' +
	'    </div>' +
	'    <div class="inv-item-desc">' + desc + '</div>';

	// extra meta (history)
	html += '    <div class="inv-item-meta">';
	if (acquiredDay !== null) html += '<div>Acquired: <b>Day ' + acquiredDay + '</b></div>';
	if (lastChangeDay !== null) html += '<div>Last change: <b>Day ' + lastChangeDay + '</b></div>';

	if (usable) html += '<div>Usable: <b>' + (consumable ? 'Consumable' : 'Reusable') + '</b></div>';
	if (usedCount > 0) html += '<div>Used: <b>x' + usedCount + '</b>' + (usedLast !== null ? (' · last Day ' + usedLast) : '') + '</div>';
	if (giftedTotal > 0) html += '<div>Gifted: <b>x' + giftedTotal + '</b>' + (giftedLines.length ? (' · ' + setup.escapeHtml(giftedLines.slice(0, 3).join(", ")) + (giftedLines.length > 3 ? "…" : "")) : '') + '</div>';
	html += '    </div>';


	// use qty chips (consumables only)
	if (usable && consumable && qty > 1) {
		if (!sv.invUseQty || typeof sv.invUseQty !== "object" || Array.isArray(sv.invUseQty)) sv.invUseQty = {};
		var selU = Number(sv.invUseQty[itemId] || 1);
		if (!isFinite(selU) || selU < 1) selU = 1;
		selU = setup.invClampUseQty(itemId, selU);
		sv.invUseQty[itemId] = selU;

		var optsU = [1, 2, 5];
		var maxU = setup.invClampUseQty(itemId, qty);
		html += '    <div class="inv-useqty-title">Use amount:</div>';
		html += '    <div class="inv-chips inv-use-chips">';
		optsU.forEach(function (n) {
			if (n > maxU) return;
			var act = (selU === n) ? " active" : "";
			html += '<button class="inv-chip' + act + '" data-inv-useqty="' + n + '" data-item-id="' + setup.escapeHtml(itemId) + '">x' + n + '</button>';
		});
		// max
		var actM = (selU === maxU) ? " active" : "";
		html += '<button class="inv-chip' + actM + '" data-inv-useqty="' + maxU + '" data-item-id="' + setup.escapeHtml(itemId) + '">max</button>';
		html += '    </div>';
	} else {
		if (sv.invUseQty && sv.invUseQty[itemId]) sv.invUseQty[itemId] = 1;
	}


	// actions
	html += '    <div class="inv-item-actions">';
	if (usable) {
		var useLabel = it.useLabel ? String(it.useLabel) : (consumable ? "✨ Use" : "✨ Activate");
		html += '      <button class="phone-btn phone-btn-primary" data-inv-use="' + setup.escapeHtml(it.id) + '">' + setup.escapeHtml(useLabel) + '</button>';
	}
	if (giftable) html += '      <button class="phone-btn phone-btn-primary" data-inv-gift="' + setup.escapeHtml(it.id) + '">🎁 Gift</button>';
	html += '      <button class="phone-btn" data-inv-discard="' + setup.escapeHtml(it.id) + '">🗑 Discard</button>';
	html += '    </div>' +
	'  </div>' +
	'</div>';

	return html;
};

setup.phoneRenderInvGift = function (itemId) {
	setup.ensureShopState();
	setup.ensureGiftState();
	var sv = State.variables;

	// ensure NPC state exists
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
		sv = State.variables;
	}

	itemId = String(itemId || "");
	var it = setup.shopGetItem(itemId);

	if (!it) {
		return '<div class="phone-section phone-inv inv-app"><div class="inv-empty">Item not found.</div></div>';
	}

	var qty = setup.invGetQty(itemId);
	var name = setup.escapeHtml(it.name || it.id || "Item");
	var stackable = (it.stackable !== false);

	// gift qty selection (only for stackable items)
	if (!sv.invGiftQty || typeof sv.invGiftQty !== "object" || Array.isArray(sv.invGiftQty)) sv.invGiftQty = {};
	var sel = Number(sv.invGiftQty[itemId] || 1);
	if (!isFinite(sel) || sel < 1) sel = 1;
	if (!stackable) sel = 1;
	if (sel > qty) sel = qty;
	sv.invGiftQty[itemId] = sel;

	var html = '' +
	'<div class="phone-section phone-inv inv-app">' +
	'  <div class="inv-gift-head">' +
	'    <div class="inv-gift-title">Gift: <b>' + name + '</b></div>' +
	'    <div class="inv-gift-meta">Available: <b>x' + qty + '</b>' + (stackable && qty > 1 ? (' · Selected: <b>x' + sel + '</b>') : '') + '</div>' +
	'  </div>';

	// qty chips
	if (stackable && qty > 1) {
		var opts = [1, 2, 5];
		var max = qty;
		html += '  <div class="inv-chips">';
		opts.forEach(function (n) {
			if (n > max) return;
			var act = (sel === n) ? " active" : "";
			html += '<button class="inv-chip' + act + '" data-inv-giftqty="' + n + '" data-item-id="' + setup.escapeHtml(itemId) + '">x' + n + '</button>';
		});
		// max
		var act2 = (sel === max) ? " active" : "";
		html += '<button class="inv-chip' + act2 + '" data-inv-giftqty="' + max + '" data-item-id="' + setup.escapeHtml(itemId) + '">max</button>';
		html += '  </div>';
	}

	html += '  <div class="inv-npc-list">';

	var any = false;

	setup.npcDefinitions.forEach(function (def) {
		if (!def || !def.id) return;
		if (def.id === "npc_player") return;

		var st = sv.npcs && sv.npcs[def.id];
		if (!st || !st.unlocked) return;

		any = true;
		var icon = (typeof def.icon === "string" && def.icon) ? def.icon : "src/icon/avatar.png";
		var displayName = (typeof def.name === "function") ? def.name() : def.name;

		// relation label
		var relKey = st.relationKey || "acquaintance";
		var relMap = setup.npcRelationLabels || {};
		var relLabel = relMap[relKey] || relKey;

		// preview (best-effort)
		var preview = setup.invPreviewRuleEffects("gift", def.id, itemId, sel);

		html += '' +
		'<button class="inv-npc" data-inv-giftto="' + setup.escapeHtml(itemId) + '" data-npc-id="' + setup.escapeHtml(def.id) + '">' +
		'  <img class="inv-npc-icon" src="' + icon + '" alt="">' +
		'  <div class="inv-npc-body">' +
		'    <div class="inv-npc-name">' + setup.escapeHtml(displayName) + '</div>' +
		'    <div class="inv-npc-sub">' + setup.escapeHtml(relLabel) + (preview ? (' · <span class="inv-npc-preview">' + setup.escapeHtml(preview) + '</span>') : '') + '</div>' +
		'  </div>' +
		'</button>';
	});

	if (!any) {
		html += '<div class="inv-empty">No NPC available yet.</div>';
	}

	html += '' +
	'  </div>' +
	'</div>';

	return html;
};

setup.phoneRenderFansCreator = function (npcId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	var c = setup.fansGetCreator(npcId);
	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; }) || {};
	if (!c) return '<div class="phone-section phone-fans fans-app"><div class="phone-ui-placeholder">Creator not found.</div></div>';

	var name = (typeof def.name === "function") ? def.name() : (def.name || npcId);
	var avatar = def.icon || def.avatar || "src/img/npc/default.png";

	var sub = setup.fansGetSub(npcId);
	var plans = setup.fansGetPlans(npcId);

	var posts = setup.fansGetPosts(npcId);

	var cover = c.cover || avatar;

	var html = '' +
	'<div class="phone-section phone-fans fans-app">' +
	'  <div class="fans-profile-hero" style="background-image:url(\'' + cover + '\')">' +
	'    <div class="fans-hero-overlay"></div>' +
	'    <div class="fans-profile-header">' +
	'      <div class="fans-profile-avatar" style="background-image:url(\'' + avatar + '\')"></div>' +
	'      <div class="fans-profile-meta">' +
	'        <div class="fans-profile-name">' + setup.escapeHtml(name) + '</div>' +
	'        <div class="fans-profile-handle">' + setup.escapeHtml(c.handle || "") + '</div>' +
	'        <div class="fans-profile-bio">' + setup.escapeHtml(c.bio || "") + '</div>' +
	'      </div>' +
	'    </div>' +
	'  </div>';

	// subscription state + primary actions
	html += '<div class="fans-card fans-card-actions">';
	if (sub) {
		var plan = setup.fansGetPlanById(npcId, sub.plan);
		var label = plan ? plan.label : (sub.plan || "Subscribed");
		html += '  <div class="fans-subline"><span class="fans-sub-dot"></span> Subscribed • <b>' + setup.escapeHtml(label) + '</b></div>';
	} else {
		html += '  <div class="fans-subline muted">Not subscribed</div>';
	}

	// Plan chips
	if (plans && plans.length) {
		html += '  <div class="fans-plan-chips">';
		plans.forEach(function (p) {
			var active = !!(sub && sub.plan === p.id);
			var price = (p.price || 0);
			var label2 = (p.label || p.id) + (price > 0 ? (' • ' + price + 'c/mo') : ' • Free');
			html += '    <button class="fans-plan-chip' + (active ? ' is-active' : '') + '" data-fans-sub="' + npcId + '::' + p.id + '">' + setup.escapeHtml(label2) + '</button>';
		});
		html += '  </div>';
	}

	html += '  <div class="fans-primary-row">';
	if (sub) html += '    <button class="fans-btn ghost" data-fans-unsub="' + npcId + '">Unsubscribe</button>';
	html += '    <button class="fans-btn primary" data-fans-msg="' + npcId + '">Message</button>';
	html += '  </div>';

	// tips
	var tipped = sv.fansApp.tips && sv.fansApp.tips[npcId] ? sv.fansApp.tips[npcId] : 0;
	html += '  <div class="fans-tip-row">';
	html += '    <div class="fans-tip-label">Tip</div>';
	[1,5,10,25].forEach(function (amt) {
		html += '    <button class="fans-tip-btn" data-fans-tip="' + npcId + '::' + amt + '">+' + amt + '</button>';
	});
	html += '    <div class="fans-tip-total">Total: <b>' + tipped + '</b></div>';
	html += '  </div>';

	html += '</div>'; // actions card

	// posts grid (OnlyFans-ish)
	html += '<div class="fans-card">';
	html += '  <div class="fans-posts-title">Posts</div>';
	if (!posts || !posts.length) {
		html += '  <div class="phone-ui-placeholder">No posts yet.</div>';
	} else {
		html += '  <div class="fans-post-grid">';
		posts.forEach(function (p) {
			if (!p || !p.id) return;

			var locked = !!p.locked && !setup.fansHasUnlocked(npcId, p.id);
			var canSee = setup.fansCanSeePost(npcId, p);

			// choose thumbnail
			var thumb = p.thumb || p.preview || p.media || p.image || avatar;

			var badge = '';
			if (!canSee) badge = '<div class="fans-post-badge req">Plan</div>';
			else if (locked) badge = '<div class="fans-post-badge lock">PPV</div>';

			html += '' +
			'<button class="fans-post" data-fans-open-post="' + npcId + '::' + p.id + '">' +
			'  <div class="fans-post-thumb" style="background-image:url(\'' + thumb + '\')"></div>' +
			'  <div class="fans-post-shade"></div>' +
			badge +
			'</button>';
		});
		html += '  </div>';
	}
	html += '</div>'; // posts card

	html += '</div>'; // app root
	return html;
};


setup.phoneRenderFansPost = function (npcId, postId) {
	setup.ensureFansAppState();
	var sv = State.variables;
	var c = setup.fansGetCreator(npcId);
	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; }) || {};
	if (!c) return '<div class="phone-section phone-fans fans-app"><div class="phone-ui-placeholder">Creator not found.</div></div>';

	var post = (c.posts || []).find(function (p) { return p && p.id === postId; });
	if (!post) return '<div class="phone-section phone-fans fans-app"><div class="phone-ui-placeholder">Post not found.</div></div>';

	var name = (typeof def.name === "function") ? def.name() : (def.name || npcId);
	var canSee = setup.fansCanSeePost(npcId, post);

	var locked = !!post.locked && !setup.fansHasUnlocked(npcId, postId);
	var media = post.media || {};
	var src = media.src || "";
	var orient = media.orient || "h";
	var pos = media.pos || "50% 50%";

	var html = '<div class="phone-section phone-fans fans-app">';

	html += '<div class="fans-card fans-postview">';
	html += '  <div class="fans-post-head">';
	html += '    <div class="fans-post-author">' + setup.escapeHtml(name) + '</div>';
	html += '    <div class="fans-post-ts">' + setup.escapeHtml(post.ts || "") + '</div>';
	html += '  </div>';

	// Plan required
	if (!canSee) {
		var plans = setup.fansGetPlans(npcId);
		html += '<div class="fans-paywall">';
		html += '  <div class="fans-paywall-title">Subscribers only</div>';
		html += '  <div class="fans-paywall-text">Choose a plan to unlock this creator’s content.</div>';
		if (plans && plans.length) {
			html += '  <div class="fans-plan-chips">';
			plans.forEach(function (p) {
				var price = (p.price || 0);
				var label = (p.label || p.id) + (price > 0 ? (' • ' + price + 'c/mo') : ' • Free');
				html += '    <button class="fans-plan-chip" data-fans-sub="' + npcId + '::' + p.id + '">' + setup.escapeHtml(label) + '</button>';
			});
			html += '  </div>';
		}
		html += '  <button class="fans-btn primary" data-fans-msg="' + npcId + '">Message</button>';
		html += '</div>';
		html += '</div></div>';
		return html;
	}

// Media tile
if (src) {
	// Locked посты отображаем как paywalled tile (без fullscreen / без добавления в Gallery)
	if (locked) {
		html += '<div class="fans-post-media fans-post-media--' + setup.escapeHtml(orient) + '" style="--bg:url(\'' + src + '\'); --pos:' + setup.escapeHtml(pos) + ';">';
		var price2 = (typeof post.price === "number") ? post.price : 5;
		html += '<div class="fans-post-lock">🔒 Locked • ' + price2 + ' coins</div>';
		html += '</div>';
	} else {
		// Unlocked: используем общий sc-media (fullscreen + add-to-gallery на expand)
		var mObj2 = {
			id          : (media.id || ("fans_post_" + npcId + "_" + postId)),
			thumb       : (post.thumb || post.preview || media.thumb || src || ""),
			full        : (media.full || media.src || src || ""),
			canWallpaper: (media.canWallpaper !== false),
			orient      : orient,
			pos         : pos,
			fit         : (media.fit || "cover"),
    			fitFull     : "contain"
		};
		html += '<div class="fans-post-media-wrap">';
		html += setup._phoneRenderChatMedia(npcId, mObj2, (media.type || "image"), "");
		html += '</div>';
	}
}

// Text
	if (post.text) {
		html += '<div class="fans-post-text">' + setup.escapeHtml(post.text) + '</div>';
	}

	// Actions
	html += '<div class="fans-post-actions">';
	if (locked) {
		html += '<button class="fans-btn primary" data-fans-unlock="' + npcId + '::' + postId + '">Unlock</button>';
	} else {
		var likeOn = !!(sv.fansApp.liked && sv.fansApp.liked[npcId] && sv.fansApp.liked[npcId][postId]);
		html += '<button class="fans-likebtn' + (likeOn ? ' is-on' : '') + '" data-fans-like="' + npcId + '::' + postId + '">' + (likeOn ? '♥ Liked' : '♡ Like') + '</button>';
	}
	html += '<button class="fans-btn ghost" data-fans-msg="' + npcId + '">Message</button>';
	html += '</div>';

	html += '</div>'; // card
	html += '</div>'; // app
	return html;
};


/* ------------------------------------------------------------------
   APP: Match (Tinder-like swipe)
   ------------------------------------------------------------------
   State:
     $matchApp = {
       queue: [npcId...],
       liked: { npcId:true },
       passed:{ npcId:true },
       matches:{ npcId: { ts:"Day 1" } }
     }

   Setup data (пример):
     setup.matchProfiles = [
       { npcId:"npc_alice", title:"...", bio:"...", tags:["music","travel"], willMatch:true }
     ];
  ------------------------------------------------------------------ */

setup.matchGetProfiles = function () {
	// Только NPC с флагом apps.match
	var list = Array.isArray(setup.matchProfiles) ? setup.matchProfiles : [];
	return list.filter(function (p) {
		return p && p.npcId && setup.npcHasAppFlag(p.npcId, "match");
	});
};

setup.ensureMatchAppState = function () {
	var sv = State.variables;
	if (typeof sv.matchApp !== "object" || !sv.matchApp) {
		sv.matchApp = { queue: [], liked: {}, passed: {}, matches: {}, likesLeft: null, superLeft: null, dayStamp: null, superliked: {} };
	}
	if (!Array.isArray(sv.matchApp.queue)) sv.matchApp.queue = [];
	if (typeof sv.matchApp.liked !== "object" || !sv.matchApp.liked) sv.matchApp.liked = {};
	if (typeof sv.matchApp.passed !== "object" || !sv.matchApp.passed) sv.matchApp.passed = {};
	if (typeof sv.matchApp.matches !== "object" || !sv.matchApp.matches) sv.matchApp.matches = {};

	
	if (typeof sv.matchApp.superliked !== "object" || !sv.matchApp.superliked) sv.matchApp.superliked = {};

	// Daily limits (uses $day if exists)
	setup.matchLimits = setup.matchLimits || { likesPerDay: 25, superlikesPerDay: 3 };
	var hasDay = (typeof sv.day === "number");
	if (hasDay && typeof sv.matchApp.dayStamp !== "number") sv.matchApp.dayStamp = sv.day;

	// reset if day changed
	if (hasDay && sv.matchApp.dayStamp !== sv.day) {
		sv.matchApp.dayStamp = sv.day;
		sv.matchApp.likesLeft = setup.matchLimits.likesPerDay;
		sv.matchApp.superLeft = setup.matchLimits.superlikesPerDay;
	}

	// init counters (first run)
	if (typeof sv.matchApp.likesLeft !== "number") sv.matchApp.likesLeft = setup.matchLimits.likesPerDay;
	if (typeof sv.matchApp.superLeft !== "number") sv.matchApp.superLeft = setup.matchLimits.superlikesPerDay;
// Always rebuild queue from current profiles (so newly-enabled NPC appears immediately)
	sv.matchApp.queue = [];
	var list = setup.matchGetProfiles();
	list.forEach(function (p) {
		if (!p || !p.npcId) return;
		if (sv.matchApp.liked[p.npcId] || sv.matchApp.passed[p.npcId] || sv.matchApp.matches[p.npcId]) return;
		sv.matchApp.queue.push(p.npcId);
	});
};

setup.matchRebuildQueue = function () {
	setup.ensureMatchAppState();
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

setup.matchGetProfile = function (npcId) {
	var list = Array.isArray(setup.matchProfiles) ? setup.matchProfiles : [];
	for (var i = 0; i < list.length; i++) {
		if (list[i] && list[i].npcId === npcId) return list[i];
	}
	return null;
};

setup.matchCurrentNpcId = function () {
	setup.ensureMatchAppState();
	var q = State.variables.matchApp.queue;
	return (q && q.length) ? q[0] : "";
};

setup.matchSwipe = function (dir) {
	// dir: "left" | "right" | "super"
	setup.ensureMatchAppState();
	var sv = State.variables;
	var npcId = setup.matchCurrentNpcId();
	if (!npcId) return;

	// Enforce daily limits (only if counters exist)
	if (dir === "right") {
		if (typeof sv.matchApp.likesLeft === "number" && sv.matchApp.likesLeft <= 0) {
			if (setup.toast) setup.toast("No likes left today", "warn", 2200);
			return;
		}
	}
	if (dir === "super") {
		if (typeof sv.matchApp.superLeft === "number" && sv.matchApp.superLeft <= 0) {
			if (setup.toast) setup.toast("No superlikes left today", "warn", 2200);
			return;
		}
	}

	// Spend like/superlike
	if (dir === "right" && typeof sv.matchApp.likesLeft === "number") sv.matchApp.likesLeft = Math.max(0, sv.matchApp.likesLeft - 1);
	if (dir === "super" && typeof sv.matchApp.superLeft === "number") sv.matchApp.superLeft = Math.max(0, sv.matchApp.superLeft - 1);

	// remove from queue
	sv.matchApp.queue.shift();

	if (dir === "right" || dir === "super") {
		sv.matchApp.liked[npcId] = true;
		if (dir === "super") sv.matchApp.superliked[npcId] = true;

		var prof = setup.matchGetProfile(npcId) || {};
		var willMatch = ("willMatch" in prof) ? !!prof.willMatch : true; // default true
		if (dir === "super" && ("willMatchOnSuper" in prof)) willMatch = !!prof.willMatchOnSuper;

		if (willMatch) {
			sv.matchApp.matches[npcId] = { ts: prof.ts || "" };
			sv.matchApp.lastMatchNpcId = npcId;

			// hook for story logic (optional)
			if (typeof setup.onMatchCreated === "function") {
				try { setup.onMatchCreated(npcId); } catch (e) { console.error(e); }
			}

			// If the phone UI is open, show Tinder-like "It's a Match!" screen
			if ($("#phone-overlay").hasClass("visible")) {
				// refill for next swipe before we jump to the popup
				setup.ensureMatchAppState();
				setup.phoneGo("matchItsAMatch", { npcId: npcId });
				return;
			}

			if (setup.toast) setup.toast("It’s a match!", "success", 2200);
		} else {
			if (setup.toast) setup.toast("No match (yet)", "info", 1800);
		}
	} else {
		sv.matchApp.passed[npcId] = true;
	}

	// refill if needed
	setup.ensureMatchAppState();

	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

setup.bindMatchSwipeGesture = function ($root) {
	var sv = State.variables;
	if (!sv || sv.phoneScreen !== "matchSwipe") return;

	var $card = $root.find(".match-card").first();
	if ($card.length === 0) return;

	// Insert badges if missing (LIKE / NOPE / SUPER)
	if ($card.find(".match-swipe-badge").length === 0) {
		$card.append(
			'<div class="match-swipe-badge like">LIKE</div>' +
			'<div class="match-swipe-badge nope">NOPE</div>' +
			'<div class="match-swipe-badge super">SUPER</div>'
		);
	}

	$card.off(".matchDrag");

	var startX = 0, startY = 0, dx = 0, dy = 0;
	var active = false;
	var pid = null;

	var TH_X = 70;
	var TH_Y = 90;

	function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }

	function updateBadges() {
		var showLike = (dx > 35);
		var showNope = (dx < -35);
		var showSuper = (dy < -40 && Math.abs(dx) < 40);

		$card.find(".match-swipe-badge.like").toggleClass("show", showLike);
		$card.find(".match-swipe-badge.nope").toggleClass("show", showNope);
		$card.find(".match-swipe-badge.super").toggleClass("show", showSuper);
	}

	function resetCard() {
		$card.removeClass("dragging swiping-out");
		$card.css("transform", "");
		$card.find(".match-swipe-badge").removeClass("show");
	}

	function swipeOut(dir) {
		$card.addClass("swiping-out");
		var outX = (dir === "left") ? -420 : (dir === "right") ? 420 : 0;
		var outY = (dir === "super") ? -420 : dy;
		var rot = (dir === "left") ? -22 : (dir === "right") ? 22 : 0;
		$card.css("transform", "translate(" + outX + "px," + outY + "px) rotate(" + rot + "deg)");

		setTimeout(function () {
			// this will re-render the phone, so no need to resetCard()
			setup.matchSwipe(dir);
			// if the swipe didn't open the match popup, and profiles ended, return to Match home
			if (State.variables.phoneScreen === "matchSwipe" && !setup.matchCurrentNpcId()) {
				setup.phoneGo("matchHome");
			}
		}, 160);
	}

	$card.on("pointerdown.matchDrag", function (ev) {
		if (ev.pointerType === "mouse" && ev.button !== 0) return;

		active = true;
		pid = ev.pointerId;
		startX = ev.clientX;
		startY = ev.clientY;
		dx = 0; dy = 0;

		$card.addClass("dragging");
		try { $card[0].setPointerCapture(pid); } catch (e) {}
	});

	$card.on("pointermove.matchDrag", function (ev) {
		if (!active) return;
		if (pid !== null && ev.pointerId !== pid) return;

		dx = ev.clientX - startX;
		dy = ev.clientY - startY;

		var rot = clamp(dx / 15, -18, 18);
		$card.css("transform", "translate(" + dx + "px," + dy + "px) rotate(" + rot + "deg)");
		updateBadges();
	});

	function endDrag(ev) {
		if (!active) return;
		active = false;

		$card.removeClass("dragging");

		var dir = null;
		if (dy < -TH_Y && Math.abs(dx) < TH_X) dir = "super";
		else if (dx > TH_X) dir = "right";
		else if (dx < -TH_X) dir = "left";

		if (!dir) {
			resetCard();
			return;
		}

		swipeOut(dir);
	}

	$card.on("pointerup.matchDrag pointercancel.matchDrag", endDrag);
};



setup.phoneRenderMatchHome = function () {
	setup.ensureMatchAppState();
	var sv = State.variables;

	var html = '<div class="phone-section phone-match match-app">';

	html += '<div class="match-topbar">';
	html += '  <div class="match-brand">🔥 Match</div>';
	html += '  <button class="match-iconbtn" data-match-inbox="1" title="Chats">💬</button>';
	html += '</div>';

	html += '<div class="match-cta">';
	if (typeof sv.matchApp.likesLeft === "number" && typeof sv.matchApp.superLeft === "number") {
		html += '<div class="match-counters">Likes <b>' + sv.matchApp.likesLeft + '</b> • Super <b>' + sv.matchApp.superLeft + '</b></div>';
	}
	html += '  <button class="match-primary" data-match-start="1">Start swiping</button>';
	html += '</div>';

	var matches = Object.keys(sv.matchApp.matches || {});
	if (!matches.length) {
		html += '<div class="match-muted">No matches yet. Swipe right to start.</div>';
		html += '</div>';
		return html;
	}

	html += '<div class="match-subtitle">Matches</div>';
	html += '<div class="match-matches-row">';
	matches.forEach(function (npcId) {
		var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; }) || {};
		var name = (typeof def.name === "function") ? def.name() : (def.name || npcId);
		var avatar = def.icon || def.avatar || "src/img/npc/default.png";
		html += '' +
		'<button class="match-matchchip" data-match-open-chat="' + npcId + '">' +
		'  <div class="match-match-avatar" style="background-image:url(\'' + avatar + '\')"></div>' +
		'  <div class="match-match-name">' + setup.escapeHtml(name) + '</div>' +
		'</button>';
	});
	html += '</div>';

	html += '</div>';
	return html;
};


setup.phoneRenderMatchSwipe = function () {
	setup.ensureMatchAppState();
	var sv = State.variables;
	var npcId = setup.matchCurrentNpcId();

	if (!npcId) {
		return '<div class="phone-section phone-match match-app"><div class="phone-ui-placeholder">No more profiles.</div></div>';
	}

	var prof = setup.matchGetProfile(npcId) || {};
	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; }) || {};

	var name = (typeof def.name === "function") ? def.name() : (def.name || npcId);
	var avatar = (prof.photo || def.icon || def.avatar || "src/img/npc/default.png");
	var title = prof.title || "";
	var bio = prof.bio || "";
	var tags = Array.isArray(prof.tags) ? prof.tags : [];

	var likeDisabled = (typeof sv.matchApp.likesLeft === "number" && sv.matchApp.likesLeft <= 0);
	var superDisabled = (typeof sv.matchApp.superLeft === "number" && sv.matchApp.superLeft <= 0);

	var html = '<div class="phone-section phone-match match-app">';

	// Counters row (optional)
	if (typeof sv.matchApp.likesLeft === "number" && typeof sv.matchApp.superLeft === "number") {
		html += '<div class="match-counters2">Likes <b>' + sv.matchApp.likesLeft + '</b> • Super <b>' + sv.matchApp.superLeft + '</b></div>';
	}

	html += '<div class="match-card">';
	html += '  <div class="match-photo" style="background-image:url(\'' + avatar + '\')"></div>';
	html += '  <div class="match-gradient"></div>';
	html += '  <div class="match-cardtext">';
	html += '    <div class="match-name-lg">' + setup.escapeHtml(name) + '</div>';
	if (title) html += '    <div class="match-title">' + setup.escapeHtml(title) + '</div>';
	if (bio) html += '    <div class="match-bio">' + setup.escapeHtml(bio) + '</div>';
	if (tags.length) {
		html += '    <div class="match-tags">';
		tags.slice(0,6).forEach(function (t) {
			html += '<span class="match-tag">' + setup.escapeHtml(t) + '</span>';
		});
		html += '    </div>';
	}
	html += '  </div>';
	html += '</div>';

	html += '<div class="match-buttons">';
	html += '  <button class="match-btn pass" data-match-swipe="left" title="Nope">✕</button>';
	html += '  <button class="match-btn super' + (superDisabled ? ' disabled' : '') + '" data-match-swipe="super" title="Super Like">★</button>';
	html += '  <button class="match-btn like' + (likeDisabled ? ' disabled' : '') + '" data-match-swipe="right" title="Like">❤</button>';
	html += '</div>';

	html += '</div>';
	return html;
};

setup.phoneRenderMatchItsAMatch = function (npcId) {
	setup.ensureMatchAppState();
	var sv = State.variables;

	npcId = npcId || (sv.matchApp && sv.matchApp.lastMatchNpcId) || "";
	if (!npcId) {
		return '<div class="phone-section phone-match match-app"><div class="phone-ui-placeholder">No match selected.</div></div>';
	}

	var prof = setup.matchGetProfile(npcId) || {};
	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; }) || {};
	var name = (typeof def.name === "function") ? def.name() : (def.name || npcId);
	var avatar = (prof.photo || def.icon || def.avatar || "src/img/npc/default.png");

	var safeName = setup.escapeHtml(String(name));
	var safeAvatar = setup.escapeHtml(String(avatar));

	var html = '';
	html += '<div class="phone-section phone-match match-app match-itsamatch-screen">';
	html += '  <div class="match-itsamatch-wrap">';
	html += '    <div class="match-itsamatch-heart-bg"></div>';
	html += '    <div class="match-itsamatch-card">';
	html += '      <div class="match-itsamatch-title">It&#039;s a Match!</div>';
	html += '      <div class="match-itsamatch-sub">You and <b>' + safeName + '</b> liked each other.</div>';
	html += '      <div class="match-itsamatch-avatars">';
	html += '        <div class="match-itsamatch-avatar me"><span>YOU</span></div>';
	html += '        <div class="match-itsamatch-avatar them" style="background-image:url(' + safeAvatar + ')"></div>';
	html += '      </div>';
	html += '      <button class="match-itsamatch-btn primary" data-match-open-chat="' + setup.escapeHtml(String(npcId)) + '">Send a message</button>';
	html += '      <button class="match-itsamatch-btn" data-match-continue="1">Keep swiping</button>';
	html += '    </div>';
	html += '  </div>';
	html += '</div>';
	return html;
};




/* ------------------------------------------------------------------
   ГАЛЕРЕЯ
   ------------------------------------------------------------------ */

setup.phoneRenderGallery = function () {
	var sv = State.variables;

	// 🔒 страховка: если NPC ещё не инициализированы — инициализируем
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
		sv = State.variables;
	}

	function canWp(m) {
		return !!(m && (m.canWallpaper || m.wallpaper || m.isWallpaper));
	}
	function isVideo(m) {
		var src = (m && (m.full || m.thumb)) ? (m.full || m.thumb) : "";
		var k = (m && (m.kind || m.type)) ? String(m.kind || m.type).toLowerCase() : "";
		return (k === "video") || /\.(mp4|webm|mov|m4v)$/i.test(src);
	}
	function isPPV(m) {
		if (!m) return false;
		if (m.isPPV || m.ppv) return true;
		var id = (typeof m.id === "string") ? m.id : "";
		var src = (typeof m.source === "string") ? m.source : "";
		return (/ppv/i.test(id) || /ppv/i.test(src));
	}

	// Собираем "Recent" по всем NPC
	var recents = [];
	setup.npcDefinitions.forEach(function (def) {
		var st = sv.npcs[def.id];
		if (!st || !Array.isArray(st.gallery)) return;

		st.gallery.forEach(function (m) {
			if (!m) return;
			recents.push({ npcId: def.id, media: m });
		});
	});

	recents.sort(function (a, b) {
		var ta = (a.media && a.media.ts) ? a.media.ts : 0;
		var tb = (b.media && b.media.ts) ? b.media.ts : 0;
		if (ta !== tb) return ta - tb;
		return 0;
	});

	// последние 12, newest first
	recents = recents.slice(Math.max(0, recents.length - 12)).reverse();

	var html = '' +
		'<div class="phone-section phone-gallery-root">';

	if (recents.length) {
		html += '' +
			'<div class="phone-gallery-recent">' +
			'  <div class="phone-gallery-recent-head">' +
			'    <div class="phone-gallery-recent-title">Recent</div>' +
			'  </div>' +
			'  <div class="phone-gallery-recent-strip">';

		recents.forEach(function (r) {
			var npcId = r.npcId;
			var m = r.media;

			var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; });
			var st  = sv.npcs[npcId];

			var thumb = (m && (m.thumb || m.full)) ? (m.thumb || m.full) : "";
			if (!thumb && def) {
				thumb = def.avatar || def.icon || "";
			}

			var badges = '';
			if (isPPV(m))  badges += '<div class="phone-media-badge phone-media-badge--ppv">PPV</div>';
			if (isVideo(m)) badges += '<div class="phone-media-badge phone-media-badge--video">🎥</div>';

			html += '' +
				'<button class="phone-recent-item" data-gallery-open-media="' + npcId + '::' + m.id + '">' +
				'  <div class="phone-recent-thumb" style="background-image:url(\'' + thumb + '\')"></div>' +
				(badges ? ('  <div class="phone-media-badges">' + badges + '</div>') : '') +
				'</button>';
		});

		html += '' +
			'  </div>' +
			'</div>';
	}

	// Альбомы по NPC: плитки 2×N, обложка = последнее полученное медиа (или аватар)
	html += '' +
		'<div class="phone-gallery-album-grid">';

	setup.npcDefinitions.forEach(function (def) {
		var st = sv.npcs[def.id];
		if (!st) return;

		var count = Array.isArray(st.gallery) ? st.gallery.length : 0;

		// cover: последнее медиа, fallback аватар
		var cover = def.avatar || def.icon || "";
		if (st.gallery && st.gallery.length) {
			var last = st.gallery[st.gallery.length - 1];
			cover = (last && (last.thumb || last.full)) ? (last.thumb || last.full) : cover;
		}

		var displayName = (typeof def.name === "function") ? def.name() : def.name;

		html += '' +
			'<button class="phone-album-card" data-gallery-open-npc="' + def.id + '">' +
			'  <div class="phone-album-cover" style="background-image:url(\'' + cover + '\')"></div>' +
			'  <div class="phone-album-meta">' +
			'    <div class="phone-album-name">' + setup.escapeHtml(displayName) + '</div>' +
			'    <div class="phone-album-count">' + count + '</div>' +
			'  </div>' +
			'</button>';
	});

	html += '' +
		'</div>' +
		'</div>';

	return html;
};


setup.phoneRenderGalleryNpc = function (npcId) {
	var sv = State.variables;

	// 🔒 страховка: если NPC ещё не инициализированы — инициализируем
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
		sv = State.variables;
	}

	function canWp(m) {
		return !!(m && (m.canWallpaper || m.wallpaper || m.isWallpaper));
	}
	function isVideo(m) {
		var src = (m && (m.full || m.thumb)) ? (m.full || m.thumb) : "";
		var k = (m && (m.kind || m.type)) ? String(m.kind || m.type).toLowerCase() : "";
		return (k === "video") || /\.(mp4|webm|mov|m4v)$/i.test(src);
	}
	function isPPV(m) {
		if (!m) return false;
		if (m.isPPV || m.ppv) return true;
		var id = (typeof m.id === "string") ? m.id : "";
		var src = (typeof m.source === "string") ? m.source : "";
		return (/ppv/i.test(id) || /ppv/i.test(src));
	}

	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; });
	var st  = sv.npcs[npcId];

	if (!def || !st) {
		return '<div class="phone-section">NPC not found</div>';
	}

	var displayName = (typeof def.name === "function") ? def.name() : def.name;
	var avatar = def.avatar || def.icon || "";

	var filter = (sv.phoneScreenData && sv.phoneScreenData.filter) ? sv.phoneScreenData.filter : "all";
	var sort   = (sv.phoneScreenData && sv.phoneScreenData.sort) ? sv.phoneScreenData.sort : "new";

	var allItems = Array.isArray(st.gallery) ? st.gallery.slice() : [];

	// recent strip: последние 10, newest first (по ts, fallback по порядку)
	var recent = allItems.slice().sort(function (a, b) {
		var ta = (a && a.ts) ? a.ts : 0;
		var tb = (b && b.ts) ? b.ts : 0;
		return tb - ta;
	}).slice(0, 10);

	// применяем фильтр
	var items = allItems.slice();
	if (filter === "wallpapers") {
		items = items.filter(function (m) { return canWp(m); });
	}

	// сортировка
	items.sort(function (a, b) {
		var ta = (a && a.ts) ? a.ts : 0;
		var tb = (b && b.ts) ? b.ts : 0;
		if (sort === "old") return ta - tb;
		return tb - ta; // new
	});

	var html = '' +
		'<div class="phone-section phone-gallery-npc">' +
		'  <div class="phone-gallery-head">' +
		'    <button class="phone-back" data-gallery-back="1">‹</button>' +
		'    <div class="phone-gallery-head-main">' +
		(avatar ? ('      <div class="phone-gallery-head-avatar" style="background-image:url(\'' + avatar + '\')"></div>') : '') +
		'      <div class="phone-gallery-head-title">' + setup.escapeHtml(displayName) + '</div>' +
		'    </div>' +
		'  </div>' +

		'  <div class="phone-gallery-filters">' +
		'    <button class="phone-chip ' + (filter === "all" ? "active" : "") + '" data-gallery-filter="all">All</button>' +
		'    <button class="phone-chip ' + (filter === "wallpapers" ? "active" : "") + '" data-gallery-filter="wallpapers">Wallpapers</button>' +
		'    <button class="phone-chip phone-chip--ghost" data-gallery-sort="toggle">Sort: ' + (sort === "old" ? "Oldest" : "Newest") + '</button>' +
		'  </div>';

	if (recent.length) {
		html += '' +
			'  <div class="phone-gallery-recent phone-gallery-recent--npc">' +
			'    <div class="phone-gallery-recent-strip">';
		recent.forEach(function (m) {
			if (!m) return;
			var thumb = (m.thumb || m.full) ? (m.thumb || m.full) : "";
			var badges = '';
			if (isPPV(m))  badges += '<div class="phone-media-badge phone-media-badge--ppv">PPV</div>';
			if (isVideo(m)) badges += '<div class="phone-media-badge phone-media-badge--video">🎥</div>';
			if (canWp(m))   badges += '<div class="phone-media-badge phone-media-badge--wp">🖼</div>';

			html += '' +
				'<button class="phone-recent-item" data-gallery-open-media="' + npcId + '::' + m.id + '">' +
				'  <div class="phone-recent-thumb" style="background-image:url(\'' + thumb + '\')"></div>' +
				(badges ? ('  <div class="phone-media-badges">' + badges + '</div>') : '') +
				'</button>';
		});
		html += '' +
			'    </div>' +
			'  </div>';
	}

	html += '' +
		'  <div class="phone-gallery-grid">';

	if (!items.length) {
		html += '<div class="phone-muted">No media yet</div>';
	} else {
		items.forEach(function (media) {
			if (!media) return;
			var thumb = (media.thumb || media.full) ? (media.thumb || media.full) : "";
			var badges = '';

			if (isPPV(media))  badges += '<div class="phone-media-badge phone-media-badge--ppv">PPV</div>';
			if (isVideo(media)) badges += '<div class="phone-media-badge phone-media-badge--video">🎥</div>';
			if (canWp(media))   badges += '<div class="phone-media-badge phone-media-badge--wp">🖼</div>';

			html += '' +
				'<button class="phone-gallery-cell" data-gallery-open-media="' + npcId + '::' + media.id + '">' +
				'  <div class="phone-gallery-cell-thumb" style="background-image:url(\'' + thumb + '\')"></div>' +
				(badges ? ('  <div class="phone-media-badges">' + badges + '</div>') : '') +
				'</button>';
		});
	}

	html += '' +
		'  </div>' +
		'</div>';

	return html;
};
setup.phoneRenderGalleryView = function (npcId, mediaId) {
	var sv = State.variables;

	// 🔒 страховка: если NPC ещё не инициализированы — инициализируем
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
		sv = State.variables;
	}

	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; });
	var st  = sv.npcs[npcId];
	if (!def || !st || !Array.isArray(st.gallery)) {
		return '<div class="phone-section">Media not found</div>';
	}

	var media = st.gallery.find(function (m) { return m && m.id === mediaId; });
	if (!media) {
		return '<div class="phone-section">Media not found</div>';
	}

	var src = media.full || media.thumb || "";
	var canWp = !!(media.canWallpaper || media.wallpaper || media.isWallpaper);

	var html = '' +
		'<div class="phone-section phone-gallery-view">' +
		'  <div class="phone-gallery-view-top">' +
		'    <button class="phone-back" data-gallery-back="1">‹</button>' +
		'    <div class="phone-gallery-view-title">Media</div>' +
		'  </div>' +
		'  <div class="phone-gallery-view-canvas">' +
		'    <div class="phone-gallery-view-img" style="background-image:url(\'' + src + '\')"></div>' +
		'  </div>' +
		'  <div class="phone-gallery-view-actions">' +
		'    <button class="phone-btn" data-gallery-zoom="toggle">Zoom</button>' +
		(canWp ? ('    <button class="phone-btn phone-btn-primary" data-gallery-set-wallpaper="' + npcId + '::' + media.id + '">Set wallpaper</button>') : '') +
		'    <button class="phone-btn" data-gallery-back="1">Close</button>' +
		'  </div>' +
		'</div>';

	return html;
};



setup.phoneSetWallpaperFromNpc = function (npcId, mediaId) {
	var sv = State.variables;
	var st = sv.npcs[npcId];
	if (!st) return;

	var media = st.gallery.find(function (m) { return m.id === mediaId; });
	if (!media) return;

	// ставим обои
	sv.phoneWallpaper = media.full || media.thumb;

	// обновляем маленький телефон + большой
	setup.updateCustomUIBar();
	setup.phoneSyncWallpaper();
};

  
  
  
  
  /* ------------------------------------------------------------------
   КОНТАКТЫ
   ------------------------------------------------------------------ */

setup.phoneContactsLetter = function (name) {
	var s = String(name || "").trim();
	if (!s) return "#";
	var ch = s.charAt(0).toUpperCase();
	return ch || "#";
};

setup.phoneRenderContactsRow = function (r) {
	var sub = r.relLabel || "";
	if (r.statusTitle) sub = sub ? (sub + " • " + r.statusTitle) : r.statusTitle;

	var badges = "";
	if (r.hasFans)  badges += '<span class="ct-badge ct-badge--fans" title="Fans">F</span>';
	if (r.hasMatch) badges += '<span class="ct-badge ct-badge--match" title="Match">♥</span>';

	return ''
		+ '<button class="ct-row phone-npc-icon" data-target="contacts" data-npc-id="' + setup.escapeHtml(r.id) + '" data-search="' + setup.escapeHtml(r.hay) + '">'
		+ '  <div class="ct-avatar" style="background-image:url(\'' + setup.escapeHtml(r.avatar) + '\')"></div>'
		+ '  <div class="ct-main">'
		+ '    <div class="ct-name">' + setup.escapeHtml(r.name) + '</div>'
		+ '    <div class="ct-sub">' + setup.escapeHtml(sub) + '</div>'
		+ '  </div>'
		+ '  <div class="ct-right">'
		+ '    <div class="ct-badges">' + badges + '</div>'
		+ '    <div class="ct-chevron">›</div>'
		+ '  </div>'
		+ '</button>';
};


setup.phoneRenderContacts = function () {
	var sv = State.variables;

	// страховка: если NPC ещё не инициализированы — инициализируем
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
		sv = State.variables;
	}

	var qRaw = String(sv.contactsSearch || "");

	var rows = [];
	setup.npcDefinitions.forEach(function (def) {
		var st = sv.npcs[def.id];
		if (!st || !st.unlocked || !st.phoneUnlocked) return;

		var relKey = st.relationKey || "acquaintance";
		var relMap = setup.npcRelationLabels || {};
		var relLabel = relMap[relKey] || relKey;

		var statusTitle = "";
		if (st.relationStatus && setup.relationStatusConfig && setup.relationStatusConfig[st.relationStatus]) {
			statusTitle = setup.relationStatusConfig[st.relationStatus].title;
		}

		var name = (typeof def.name === "function") ? def.name() : (def.name || def.id);
		var avatar = def.icon || def.avatar || "src/img/npc/default.png";

		var hay = (String(name) + " " + String(relLabel) + " " + String(statusTitle)).toLowerCase();

		rows.push({
			id: def.id,
			name: name,
			avatar: avatar,
			relLabel: relLabel,
			statusTitle: statusTitle,
			hay: hay,
			letter: setup.phoneContactsLetter(name),
			hasFans: (typeof setup.npcHasAppFlag === "function") ? setup.npcHasAppFlag(def.id, "fans") : false,
			hasMatch: (typeof setup.npcHasAppFlag === "function") ? setup.npcHasAppFlag(def.id, "match") : false
		});
	});

	rows.sort(function (a, b) {
		return String(a.name).localeCompare(String(b.name));
	});

	var html = '';
	html += '<div class="ct-contacts">';
	html += '  <div class="ct-searchbar">';
	html += '    <span class="ct-search-ico">🔍</span>';
	html += '    <input class="ct-search-input" type="text" placeholder="Search" data-ct-search="1" value="' + setup.escapeHtml(qRaw) + '">';
	html += '    <button class="ct-search-clear" data-ct-search-clear="1" title="Clear">×</button>';
	html += '  </div>';

	html += '  <div class="ct-list">';

	if (!rows.length) {
		html += '<div class="ct-empty">No contacts yet.</div>';
	} else {
		var groups = {};
		rows.forEach(function (r) {
			var L = r.letter || "#";
			if (!groups[L]) groups[L] = [];
			groups[L].push(r);
		});
		var letters = Object.keys(groups).sort(function (a, b) { return String(a).localeCompare(String(b)); });
		letters.forEach(function (L) {
			html += '<div class="ct-letter">' + setup.escapeHtml(L) + '</div>';
			html += '<div class="ct-group">';
			groups[L].forEach(function (r) {
				html += setup.phoneRenderContactsRow(r);
			});
			html += '</div>';
		});

		// пустое состояние для поиска (показывается/скрывается через bind)
		html += '<div class="ct-empty ct-empty-search" style="display:none;">No matches.</div>';
	}

	html += '  </div>'; // ct-list
	html += '</div>'; // ct-contacts

	return html;
};



setup.phoneRenderContactNpc = function (npcId) {
	var sv = State.variables;

	// страховка: если NPC ещё не инициализированы — инициализируем
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
		sv = State.variables;
	}

	var def = setup.npcDefinitions.find(function (d) { return d.id === npcId; });
	var st  = sv.npcs[npcId];

	if (!def || !st) {
		return '<div class="ct-profile"><div class="ct-empty">Contact not found</div></div>';
	}

	var relMap   = setup.npcRelationLabels || {};
	var relKey   = st.relationKey || "acquaintance";
	var relLabel = relMap[relKey] || relKey;

	// человеческий статус отношений (Likes you / Hates you / etc)
	var statusTitle = "";
	if (st.relationStatus && setup.relationStatusConfig && setup.relationStatusConfig[st.relationStatus]) {
		statusTitle = setup.relationStatusConfig[st.relationStatus].title;
	}

	var displayName = (typeof def.name === "function") ? def.name() : (def.name || npcId);
	var avatar = def.avatar || def.icon || "src/img/npc/default.png";

	var hasFans  = (typeof setup.npcHasAppFlag === "function") ? setup.npcHasAppFlag(npcId, "fans") : false;
	var hasMatch = (typeof setup.npcHasAppFlag === "function") ? setup.npcHasAppFlag(npcId, "match") : false;

	var sub = relLabel;
	if (statusTitle) sub = sub ? (sub + " • " + statusTitle) : statusTitle;

	var html = '';
	html += '<div class="ct-profile">';

	html += '  <div class="ct-profile-top">';
	html += '    <div class="ct-profile-avatar" style="background-image:url(\'' + setup.escapeHtml(avatar) + '\')"></div>';
	html += '    <div class="ct-profile-name">' + setup.escapeHtml(displayName) + '</div>';
	html += '    <div class="ct-profile-sub">' + setup.escapeHtml(sub) + '</div>';
	html += '  </div>';

	html += '  <div class="ct-actions">';
	html += '    <button class="ct-action" data-ct-open="messages" data-npc-id="' + setup.escapeHtml(npcId) + '" title="Message">'
		+ '      <div class="ct-action-ico">💬</div><div class="ct-action-txt">Message</div>'
		+ '    </button>';
	html += '    <button class="ct-action" data-ct-open="gallery" data-npc-id="' + setup.escapeHtml(npcId) + '" title="Gallery">'
		+ '      <div class="ct-action-ico">🖼</div><div class="ct-action-txt">Gallery</div>'
		+ '    </button>';

	if (hasFans) {
		html += '    <button class="ct-action" data-ct-open="fans" data-npc-id="' + setup.escapeHtml(npcId) + '" title="Fans">'
			+ '      <div class="ct-action-ico">🟣</div><div class="ct-action-txt">Fans</div>'
			+ '    </button>';
	} else {
		html += '    <button class="ct-action" disabled title="Fans (locked)">'
			+ '      <div class="ct-action-ico">🟣</div><div class="ct-action-txt">Fans</div>'
			+ '    </button>';
	}

	if (hasMatch) {
		html += '    <button class="ct-action" data-ct-open="match" data-npc-id="' + setup.escapeHtml(npcId) + '" title="Match">'
			+ '      <div class="ct-action-ico">❤️</div><div class="ct-action-txt">Match</div>'
			+ '    </button>';
	} else {
		html += '    <button class="ct-action" disabled title="Match (locked)">'
			+ '      <div class="ct-action-ico">❤️</div><div class="ct-action-txt">Match</div>'
			+ '    </button>';
	}

	html += '  </div>';

	html += '  <div class="ct-cards">';
	html += '    <div class="ct-card"><div class="ct-card-title">Relationship</div><div class="ct-card-val">' + setup.escapeHtml(relLabel) + '</div></div>';
	if (statusTitle) {
		html += '    <div class="ct-card"><div class="ct-card-title">Status</div><div class="ct-card-val">' + setup.escapeHtml(statusTitle) + '</div></div>';
	}
	html += '  </div>';

	// безопасно получаем конфиг статов
	var statCfgList = Array.isArray(setup.npcStatConfig) ? setup.npcStatConfig : [];
	if (statCfgList.length) {
		html += '<div class="ct-stats">';
		statCfgList.forEach(function (cfg) {
			var key   = cfg.key;
			var label = cfg.label || key;
			var val = 0;
			if (st.stats && typeof st.stats[key] === "number") val = st.stats[key];
			if (val < 0) val = 0;
			if (val > 100) val = 100;
			html += ''
				+ '<div class="ct-stat">'
				+ '  <div class="ct-stat-top"><div class="ct-stat-label">' + setup.escapeHtml(label) + '</div><div class="ct-stat-val">' + val + '</div></div>'
				+ '  <div class="ct-stat-bar"><div class="ct-stat-fill" style="width:' + val + '%"></div></div>'
				+ '</div>';
		});
		html += '</div>';
	}

	html += '</div>';
	return html;
};

  
  
  

  /* ======================================================
   ТЕЛЕФОН: таймстемпы, галочки, рендер чата и списка
   ====================================================== */

  
  
  /* ======================================================
   ВРЕМЯ ДЛЯ СООБЩЕНИЙ В ТЕЛЕФОНЕ
   ====================================================== */

setup.phoneGetTimeLabel = function () {
	var sv = State.variables || {};
	var todKey = (typeof setup.getTimeOfDayKey === "function")
		? setup.getTimeOfDayKey()
		: "day";

	// Просто фиктивные часы по времени суток
	var map = {
		morning: "09:12",
		day    : "14:27",
		evening: "20:41",
		night  : "00:19"
	};

	var clock = map[todKey] || "12:00";
	return clock; // если захочешь, можно потом прикрутить "Day N · 14:27"
};

  
  
  
  /* ------------------------------------------------------
   Мини-движок "сценки" в чате
   ------------------------------------------------------ */
/*
steps: массив шагов вида
[
  { type: "npc",   text: "Сообщение 1", delay: 1.5 },
  { type: "npc",   text: "Сообщение 2", delay: 2.0 },
  {
    type: "choices",
    delay: 1.0,
    choices: [
      { id: "r1", label: "Ответ 1", text: "Полный текст ответа 1" },
      { id: "r2", label: "Ответ 2", text: "Полный текст ответа 2" }
    ]
  }
]
*/

setup.phoneRunSequence = function (npcId, steps) {
	setup.ensureMessagesState();
	var sv = State.variables;

	if (!sv.messages || !sv.messages[npcId]) return;
	if (!Array.isArray(steps) || !steps.length) return;

	var totalDelay = 0;

	steps.forEach(function (step) {
		if (!step || typeof step !== "object") return;
		// Если шаг помечен контент-тегами — пропускаем, если запрещено
		if (step.contentTags && !setup.isContentAllowed(step.contentTags)) return;

		var kind = step.type || "npc";
		var gap  = (typeof step.delay === "number") ? step.delay : 0;
		totalDelay += gap;

		
		// 0) Typing-only шаг (ТОЛЬКО ДЛЯ ТЕЛЕФОНА)
		//    { type:"typing", delay:0.4, seconds:1.0 }
		//    Показывает "печатает..." без сообщения и двигает таймлайн.
		if (kind === "typing") {
			var secondsT = (typeof step.seconds === "number") ? step.seconds
				: ((typeof step.duration === "number") ? step.duration
				: ((typeof step.typingDelay === "number") ? step.typingDelay : 1.0));

			// start typing
			window.setTimeout(function () {
				setup.ensureMessagesState();
				var svT = State.variables;
				if (svT.messages && svT.messages[npcId]) {
					svT.messages[npcId].typing = true;
					if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
				}
			}, totalDelay * 1000);

			// stop typing
			window.setTimeout(function () {
				setup.ensureMessagesState();
				var svT2 = State.variables;
				if (svT2.messages && svT2.messages[npcId]) {
					svT2.messages[npcId].typing = false;
					if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
				}
			}, (totalDelay + secondsT) * 1000);

			totalDelay += secondsT;
			return; // важно: не падать дальше в обработку сообщений
		}

		// 0.5) Просто подождать (без эффекта), если нужно
		//      { type:"wait", delay:0, seconds:0.8 }
		if (kind === "wait" || kind === "delay") {
			var secondsW = (typeof step.seconds === "number") ? step.seconds
				: ((typeof step.duration === "number") ? step.duration : 0);
			totalDelay += secondsW;
			return;
		}
// 1) Обычное текстовое сообщение NPC
		if (kind === "npc" || kind === "text") {
			var typingDelay = (typeof step.typingDelay === "number") ? step.typingDelay : 1.2;

			window.setTimeout(function () {
				setup.phoneNpcSendText(npcId, step.text || "", typingDelay);
			}, totalDelay * 1000);

			totalDelay += typingDelay;
		}

		// 2) Медиа-сообщение NPC
		else if (kind === "media") {
			var typingDelayM = (typeof step.typingDelay === "number") ? step.typingDelay : 1.2;

			window.setTimeout(function () {
				var mediaId      = step.mediaId      || (step.media && step.media.id);
				var thumbPath    = step.thumbPath    || (step.media && step.media.thumb);
				var fullPath     = step.fullPath     || (step.media && step.media.full);
				var canWallpaper = (step.canWallpaper != null)
					? step.canWallpaper
					: (step.media && step.media.canWallpaper);

				setup.phoneNpcSendMedia(
					npcId,
					step.text || "",
					typingDelayM,
					mediaId,
					thumbPath,
					fullPath,
					canWallpaper
				);
			}, totalDelay * 1000);

			totalDelay += typingDelayM;
		}

		// 3) Показать новые варианты ответа игрока
		else if (kind === "choices") {
			window.setTimeout(function () {
				setup.ensureMessagesState();
				var sv2 = State.variables;

				if (!sv2.phonePlayerChoices) {
					sv2.phonePlayerChoices = {};
				}
				sv2.phonePlayerChoices[npcId] = step.choices || [];

				if ($("#phone-overlay").hasClass("visible")) {
					setup.phoneRender();
				}
			}, totalDelay * 1000);
		}
	});
};

  
  
  
  
/* ------------------------------------------------------
   ensureMessagesState: инициализация состояния сообщений
   ------------------------------------------------------ */
setup.ensureMessagesState = function () {
	var sv = State.variables;

	// гарантируем NPC
	if (typeof sv.npcs !== "object" || !sv.npcs) {
		setup.initNpcState();
	}

	// общий объект сообщений
	if (!sv.messages) {
		sv.messages = {};
	}

	// поиск по чатам (для списка)
	if (typeof sv.messagesSearch !== "string") {
		sv.messagesSearch = "";
	}

	// для каждого NPC — создаём пустой чат, если ещё нет
	setup.npcDefinitions.forEach(function (def) {
		if (!sv.messages[def.id]) {
			sv.messages[def.id] = {
				previewText : "",   // ничего не показывает пока нет сообщений
				unread      : 0,
				typing      : false,
				thread      : []    // ПУСТОЙ массив, без автоприветствия
			};
		}
	});
};




/* ------------------------------------------------------
   Внутренний helper добавления сообщения от NPC
   ------------------------------------------------------ */
setup._phoneAddNpcMessage = function (npcId, text, opts) {
	opts = opts || {};
	setup.ensureMessagesState();

	var sv = State.variables;
	var msgState = sv.messages[npcId];
	if (!msgState) return;

	// Добавляем сообщение в поток
	var msg = {
		from : "npc",
		text : text,
		type : opts.type || "text",
		time : setup.phoneGetTimeLabel(),
		day  : setup.phoneGetDayCounter(),
		stamp: setup.phoneGetStamp()
	};

	// attachment/media (если есть)
	if (opts.media) {
		msg.media = opts.media;
		// если тип не задан — считаем это media
		if (!opts.type) msg.type = "media";
	}

	msgState.thread.push(msg);


	// event hook: incoming message
	if (typeof setup.emitGameEvent === "function") {
		setup.emitGameEvent("messageReceived", { app: "messages", npcId: String(npcId), message: msg });
	}
	// Все сообщения игрока до этого считаем прочитанными
	for (var i = msgState.thread.length - 1; i >= 0; i--) {
		var m = msgState.thread[i];
		if (m.from === "player") {
			m.status = "read";
		}
	}

	// Превью для списка чатов (WhatsApp-like)
	var preview = (typeof text === "string") ? text : "";
	if ((!preview || !preview.trim()) && msg.media) preview = "📷 Photo";
	msgState.previewText = preview;

	// Если сейчас не открыт чат с этим NPC — считаем как непрочитанное + показываем уведомление
	var chatIsOpen =
		(sv.phoneScreen === "messagesChat" &&
		 sv.phoneScreenData &&
		 sv.phoneScreenData.npcId === npcId &&
		 $("#phone-overlay").hasClass("visible"));

	if (!chatIsOpen) {
		var prevUnread = msgState.unread || 0;

		msgState.unread = prevUnread + 1;
		sv.phoneUnread  = (sv.phoneUnread  || 0) + 1;

		// обновляем пузыри на мини-телефоне
		setup.phoneRefreshMiniBubbles();

		// вибрация только если раньше от этого NPC не было непрочитанных
		if (prevUnread === 0) {
			setup.phoneMiniVibrate();
			// mini iOS-like banner + notification log
			var title = setup.phoneGetNpcName ? setup.phoneGetNpcName(npcId) : "Message";
			var snippet = msgState.previewText || text || "New message";
			setup.phoneMiniNotify("messages", npcId, title, setup.phoneMiniShort ? setup.phoneMiniShort(snippet, 60) : snippet, { silent: false });

		}
	}

	// Разблокируем контакт при первом сообщении
	var npcState = sv.npcs && sv.npcs[npcId];
	if (npcState && !npcState.phoneUnlocked) {
		npcState.phoneUnlocked = true;
	}

	// Если есть медиа — добавим его в галерею NPC
	if (opts.media && sv.npcs && sv.npcs[npcId]) {
		npcState = sv.npcs[npcId];

		var exists = npcState.gallery.some(function (m) { return m.id === opts.media.id; });
		if (!exists) {
			npcState.gallery.push({
				id           : opts.media.id,
				thumb        : opts.media.thumb,
				full         : opts.media.full,
				canWallpaper : !!opts.media.canWallpaper,
				ts           : (opts.media.ts || Date.now()),
				kind         : (opts.media.kind || opts.media.type || ""),
				isPPV        : !!(opts.media.isPPV || opts.media.ppv || (typeof opts.media.id === "string" && /ppv/i.test(opts.media.id)) || (typeof opts.media.source === "string" && /ppv/i.test(opts.media.source))),
				source       : (opts.media.source || "messages")
			});
		}
	}

	// Обновляем маленький телефон (бейдж) и большой (если открыт)
	setup.updateCustomUIBar();
	setup.phoneSyncBadges();

	if ($("#phone-overlay").hasClass("visible")) {
		setup.phoneRender();
	}
};


/* ------------------------------------------------------
   Helpers for WhatsApp-like Messages UI (days / stamps)
   ------------------------------------------------------ */
setup.phoneGetDayCounter = function () {
	var sv = State.variables || {};
	if (typeof sv.dayCounter === "number" && isFinite(sv.dayCounter)) return sv.dayCounter;
	if (typeof sv.day === "number" && isFinite(sv.day)) return sv.day;
	return 0;
};

setup.phoneGetStamp = function () {
	var day = setup.phoneGetDayCounter();
	var todKey = (typeof setup.getTimeOfDayKey === "function") ? setup.getTimeOfDayKey() : "day";
	var map = { morning: 1, day: 2, evening: 3, night: 4 };
	var t = map[todKey] || 0;
	return (day * 10) + t;
};

setup.phoneDayLabel = function (day) {
	var now = setup.phoneGetDayCounter();
	if (typeof day !== "number" || !isFinite(day)) day = now;
	if (day === now) return "Today";
	if (day === (now - 1)) return "Yesterday";
	return "Day " + day;
};



/* ------------------------------------------------------
   Отправка текстового сообщения NPC с задержкой + typing
   ------------------------------------------------------ */
setup.phoneNpcSendText = function (npcId, text, delaySeconds) {
	delaySeconds = delaySeconds || 0;

	setup.ensureMessagesState();
	var sv = State.variables;
	var msgState = sv.messages[npcId];
	if (!msgState) return;

	// Включаем "печатает..."
	msgState.typing = true;

	// если открыт чат, сразу отрисуем индикатор
	if ($("#phone-overlay").hasClass("visible")) {
		setup.phoneRender();
	}

	window.setTimeout(function () {
		// при срабатывании таймера берём актуальное состояние
		setup.ensureMessagesState();
		var sv2 = State.variables;
		var msgState2 = sv2.messages[npcId];
		if (!msgState2) return;

		// выключаем "печатает..."
		msgState2.typing = false;

		// добавляем само сообщение
		setup._phoneAddNpcMessage(npcId, text, { type: "text" });

	}, delaySeconds * 1000);
};


/* ------------------------------------------------------
   Отправка медиа-сообщения NPC с задержкой + typing
   ------------------------------------------------------ */
setup.phoneNpcSendMedia = function (npcId, text, delaySeconds, mediaId, thumbPath, fullPath, canWallpaper) {
	delaySeconds = delaySeconds || 0;

	setup.ensureMessagesState();
	var sv = State.variables;
	var msgState = sv.messages[npcId];
	if (!msgState) return;

	// "печатает..."
	msgState.typing = true;
	if ($("#phone-overlay").hasClass("visible")) {
		setup.phoneRender();
	}

	window.setTimeout(function () {
		setup.ensureMessagesState();
		var sv2 = State.variables;
		var msgState2 = sv2.messages[npcId];
		if (!msgState2) return;

		msgState2.typing = false;

		setup._phoneAddNpcMessage(npcId, text, {
			type : "media",
			media: {
				id          : mediaId,
				thumb       : thumbPath,
				full        : fullPath,
				canWallpaper: !!canWallpaper
			}
		});

	}, delaySeconds * 1000);
};


/* ------------------------------------------------------
   Ответ игрока (нажатие на вариант) + время + галочки
   ------------------------------------------------------ */
setup.phoneChoosePlayerReply = function (npcId, choiceId) {
	setup.ensureMessagesState();
	var sv = State.variables;

	if (!sv.phonePlayerChoices || !sv.phonePlayerChoices[npcId]) {
		return;
	}

	var list = sv.phonePlayerChoices[npcId];
	var choice = list.find(function (c) { return c.id === choiceId; });
	if (!choice) return;

	var msgState = sv.messages[npcId];
	if (!msgState) return;

	// 1) Добавляем сообщение игрока
	msgState.thread.push({
		from  : "player",
		text  : choice.text,
		type  : "text",
		time  : setup.phoneGetTimeLabel(),
		day   : setup.phoneGetDayCounter(),
		stamp : setup.phoneGetStamp(),
		status: "sent" // отправлено, но ещё не доставлено/прочитано
	});

	// WhatsApp-like: через небольшую паузу делаем "delivered", если ещё не было "read"
	var msgIndex = msgState.thread.length - 1;
	window.setTimeout(function () {
		setup.ensureMessagesState();
		var sv2 = State.variables;
		var st2 = sv2.messages && sv2.messages[npcId];
		if (!st2 || !st2.thread || !st2.thread.length) return;
		var m = st2.thread[msgIndex];
		if (m && m.from === "player" && m.status === "sent") {
			m.status = "delivered";
			// перерисуем если телефон открыт
			if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
		}
	}, 600);

	// 2) Обновляем preview в списке чатов
	msgState.previewText = choice.text;


	// event hook
	if (typeof setup.emitGameEvent === "function") {
		setup.emitGameEvent("playerReply", { app: "messages", npcId: String(npcId), choiceId: String(choiceId), text: String(choice.text || "") });
	}
	// 3) Помечаем чат как прочитанный (мы же сейчас внутри чата)
	msgState.unread = 0;

	// 4) Сохраняем lastChoice (на случай, если квест/логика захочет знать)
	sv.phoneLastChoice = {
		npcId   : npcId,
		choiceId: choiceId
	};

	// 5) Убираем варианты (игрок уже ответил)
	delete sv.phonePlayerChoices[npcId];

	// 6) Перерисовываем чат
	if ($("#phone-overlay").hasClass("visible")) {
		setup.phoneRender();
	}

	// 7) Если у варианта есть sequence/script – запускаем сценку
	if (choice.sequence && Array.isArray(choice.sequence)) {
		setup.phoneRunSequence(npcId, choice.sequence);
	} else if (choice.script && Array.isArray(choice.script)) {
		setup.phoneRunSequence(npcId, choice.script);
	}
};



/* ------------------------------------------------------
   Список чатов (Messages)
   ------------------------------------------------------ */
setup.phoneRenderMessages = function () {
	setup.ensureMessagesState();
	var sv = State.variables;

	var q = (typeof sv.messagesSearch === "string") ? sv.messagesSearch : "";

	if (typeof sv.messagesInboxFilter !== "string") sv.messagesInboxFilter = "all";

	// Собираем чаты (только unlocked + phoneUnlocked)
	var rows = [];

	setup.npcDefinitions.forEach(function (def) {
		var npcState = sv.npcs && sv.npcs[def.id];
		if (!npcState || !npcState.unlocked || !npcState.phoneUnlocked) return;

		var msgState = sv.messages[def.id];
		if (!msgState) return;

		var name = (typeof def.name === "function") ? def.name() : (def.name || def.id);
		var avatar = def.icon || def.avatarMini || def.avatar || "src/icon/avatar.png";

		var lastMsg = (msgState.thread && msgState.thread.length)
			? msgState.thread[msgState.thread.length - 1]
			: null;

		// preview: typing > explicit previewText > lastMsg
		var preview = "";
		if (msgState.typing) {
			preview = "typing…";
		} else if (msgState.previewText) {
			preview = msgState.previewText;
		} else if (lastMsg && lastMsg.text) {
			preview = lastMsg.text;
		} else if (lastMsg && lastMsg.media) {
			preview = "📷 Photo";
		}

		// time label
		var timeLabel = "";
		if (lastMsg) {
			var d = (typeof lastMsg.day === "number") ? lastMsg.day : null;
			if (d !== null && d !== setup.phoneGetDayCounter()) {
				timeLabel = setup.phoneDayLabel(d);
			} else {
				timeLabel = lastMsg.time || lastMsg.timeLabel || "";
			}
		}

		// sorting stamp
		var stamp = (lastMsg && typeof lastMsg.stamp === "number")
			? lastMsg.stamp
			: (msgState.thread ? msgState.thread.length : 0);

		var hay = (String(name) + " " + String(preview)).toLowerCase();

		rows.push({
			id      : def.id,
			name    : name,
			avatar  : avatar,
			msgState: msgState,
			lastMsg : lastMsg,
			preview : preview,
			timeLabel: timeLabel,
			stamp   : stamp,
			hay     : hay
		});
	});

	rows.sort(function (a, b) { return (b.stamp || 0) - (a.stamp || 0); });

	// минимальный фильтр inbox
	if (sv.messagesInboxFilter === "unread") {
		rows = rows.filter(function (r) { return (Number(r.msgState && r.msgState.unread) || 0) > 0; });
	}

	var html = '';
	html += '<div class="wa-messages">';
	html += '  <div class="wa-searchbar">';
	html += '    <span class="wa-search-ico">🔍</span>';
	html += '    <input class="wa-search-input" type="text" placeholder="Search" data-msg-search="1" value="' + setup.escapeHtml(q) + '">';
	html += '    <button class="wa-search-clear" data-msg-search-clear="1" title="Clear">×</button>';
	html += '  </div>';

	html += '  <div class="phone-chips phone-chips--messages">';
	html += '    <button class="phone-chip' + (sv.messagesInboxFilter === "all" ? " active" : "") + '" data-messages-filter="all">All</button>';
	html += '    <button class="phone-chip' + (sv.messagesInboxFilter === "unread" ? " active" : "") + '" data-messages-filter="unread">Unread</button>';
	html += '  </div>';

	html += '  <div class="wa-chatlist">';

	rows.forEach(function (r) {
		var unread = Number(r.msgState.unread) || 0;

		// ticks (only if last msg from player)
		var ticks = "";
		if (r.lastMsg && r.lastMsg.from === "player") {
			var st = r.lastMsg.status || "sent";
			if (st === "read") {
				ticks = '<span class="wa-ticks wa-ticks--read">✓✓</span>';
			} else if (st === "delivered") {
				ticks = '<span class="wa-ticks wa-ticks--delivered">✓✓</span>';
			} else {
				ticks = '<span class="wa-ticks wa-ticks--sent">✓</span>';
			}
		}

		html += ''
			+ '<button class="wa-chatrow phone-chat-list-item" '
			+ 'data-chat-id="' + setup.escapeHtml(r.id) + '" '
			+ 'data-search="' + setup.escapeHtml(r.hay) + '">'
			+ '  <div class="wa-avatar" style="background-image:url(\'' + setup.escapeHtml(r.avatar) + '\')"></div>'
			+ '  <div class="wa-chatmain">'
			+ '    <div class="wa-row1">'
			+ '      <div class="wa-name">' + setup.escapeHtml(r.name) + '</div>'
			+ '      <div class="wa-time">' + setup.escapeHtml(r.timeLabel || "") + '</div>'
			+ '    </div>'
			+ '    <div class="wa-row2">'
			+ '      <div class="wa-preview ' + (r.msgState.typing ? 'wa-preview--typing' : '') + '">' + ticks + setup.escapeHtml(r.preview || "") + '</div>'
			+ (unread > 0 ? '      <div class="wa-unread">' + unread + '</div>' : '')
			+ '    </div>'
			+ '  </div>'
			+ '</button>';
	});

	if (!rows.length) {
		html += '<div class="wa-empty">No chats yet.</div>';
	}

	// empty state for search
	html += '<div class="wa-empty wa-empty-search" style="display:none;">No matches.</div>';

	html += '  </div>'; // chatlist
	html += '</div>'; // wa-messages
	return html;
};



/* ------------------------------------------------------
   Экран конкретного чата (MessagesChat)
   ------------------------------------------------------ */
setup.phoneRenderMessagesChat = function (npcId) {
	setup.ensureMessagesState();
	var sv = State.variables;

	var def = null;
	if (setup.npcDefinitions && setup.npcDefinitions.length) {
		for (var i = 0; i < setup.npcDefinitions.length; i++) {
			if (setup.npcDefinitions[i].id === npcId) { def = setup.npcDefinitions[i]; break; }
		}
	}
	var msgState = sv.messages && sv.messages[npcId];
	if (!def || !msgState) {
		return '<div class="phone-section"><div class="wa-empty">Chat not found.</div></div>';
	}

	// Mark as read when opening chat
	if (msgState.unread) {
		sv.phoneUnread = Math.max(0, (sv.phoneUnread || 0) - (msgState.unread || 0));
		msgState.unread = 0;
		setup.phoneSyncBadges();
	}

	var name = (typeof def.name === "function") ? def.name() : (def.name || def.id);
	var avatar = def.icon || def.avatarMini || def.avatar || "src/icon/avatar.png";
	var status = msgState.typing ? "typing…" : ""; // можно расширить позже

	var html = '';
	html += '<div class="wa-chat">';

	// WhatsApp-like header inside content (statusbar сверху остаётся)
	html += '  <div class="wa-chat-header">';
	html += '    <div class="wa-chat-left">';
	html += '      <div class="wa-chat-avatar" style="background-image:url(\'' + setup.escapeHtml(avatar) + '\')"></div>';
	html += '      <div class="wa-chat-title">';
	html += '        <div class="wa-chat-name">' + setup.escapeHtml(name) + '</div>';
	html += '        <div class="wa-chat-status">' + setup.escapeHtml(status) + '</div>';
	html += '      </div>';
	html += '    </div>';
	html += '    <div class="wa-chat-actions">';
	html += '      <button class="wa-icon-btn" disabled title="Call">📞</button>';
	html += '      <button class="wa-icon-btn" disabled title="Video">🎥</button>';
	html += '      <button class="wa-icon-btn" disabled title="More">⋮</button>';
	html += '    </div>';
	html += '  </div>';

	// messages
	html += '  <div class="wa-chat-body phone-chat-bubbles">';

	var prevDay = null;
	var nowDay = setup.phoneGetDayCounter();

	for (var k = 0; k < msgState.thread.length; k++) {
		var m = msgState.thread[k] || {};
		var day = (typeof m.day === "number" && isFinite(m.day)) ? m.day : nowDay;

		if (prevDay === null || day !== prevDay) {
			html += '<div class="wa-day-sep">' + setup.escapeHtml(setup.phoneDayLabel(day)) + '</div>';
			prevDay = day;
		}

		var cls = (m.from === "player") ? "me" : "them";
		html += '<div class="phone-chat-bubble ' + cls + '">';

		// text
		if (m.text) {
			var txt = setup.escapeHtml(String(m.text)).replace(/\n/g, "<br>");
			html += '<div class="wa-msg-text">' + txt + '</div>';
		}

		// attachment preview
		if (m.media && (m.media.thumb || m.media.full) && typeof setup._phoneRenderChatMedia === "function") {
			html += setup._phoneRenderChatMedia(npcId, m.media, "image", "");
		}

		// meta (time + ticks)
		var meta = '';
		var t = m.time || m.timeLabel || "";
		if (t) meta += '<span class="wa-time">' + setup.escapeHtml(t) + '</span>';

		if (m.from === "player") {
			var st = m.status || "sent";
			if (st === "read") {
				meta += '<span class="wa-ticks wa-ticks--read">✓✓</span>';
			} else if (st === "delivered") {
				meta += '<span class="wa-ticks wa-ticks--delivered">✓✓</span>';
			} else {
				meta += '<span class="wa-ticks wa-ticks--sent">✓</span>';
			}
		}
		if (meta) html += '<div class="wa-meta">' + meta + '</div>';

		html += '</div>';
	}

	// typing indicator bubble at bottom (if enabled)
	if (msgState.typing) {
		html += '<div class="wa-typing-row"><div class="wa-typing-bubble"><span class="wa-dot"></span><span class="wa-dot"></span><span class="wa-dot"></span></div></div>';
	}

	html += '  </div>'; // wa-chat-body

	// Quick replies (choices)
	var choices = (sv.phonePlayerChoices && sv.phonePlayerChoices[npcId]) ? sv.phonePlayerChoices[npcId] : null;
	if (choices && choices.length) {
		html += '  <div class="wa-quickreplies">';
		for (var c = 0; c < choices.length; c++) {
			var ch = choices[c];
			html += '<button class="wa-chip phone-chat-choice" data-npc-id="' + setup.escapeHtml(npcId) + '" data-choice-id="' + setup.escapeHtml(ch.id) + '">';
			html += setup.escapeHtml(ch.text);
			html += '</button>';
		}
		html += '  </div>';
	} else {
		html += '  <div class="wa-quickreplies wa-quickreplies--empty"></div>';
	}

	// Input bar (visual only)
	html += '  <div class="wa-inputbar">';
	html += '    <div class="wa-input-ico">😊</div>';
	html += '    <div class="wa-input-fake">Message</div>';
	html += '    <div class="wa-input-ico">📎</div>';
	html += '    <div class="wa-input-ico wa-input-ico--mic">🎤</div>';
	html += '  </div>';

	html += '</div>'; // wa-chat
	return html;
};


  
  


  
  /* ------------------------------------------------------------------
   QUEST SYSTEM (v17)
   ------------------------------------------------------------------
   Goals:
   - No eval
   - Works via defs (setup.questDefs) + runtime state ($questState)
   - Progress can be event-driven (setup.questEvent) and/or passive checks
   - Friendly Phone UI (list + detail) on screen "quests"

   Runtime ($questState):
     {
       [questId]: {
         status: "locked"|"active"|"completed"|"failed",
         step:   0,           // current step index
         startedDay: number?,
         completedDay: number?,
         tracked: bool,
         showHint: bool
       }
     }

   Def (setup.questDefs[questId]):
     {
       title, desc, icon, type,
       steps: [ { id, text, hint?, require?, effects? } ],
       rewardEffects?,
       onStartEffects?,
       onCompleteEffects?,
       autoStart?: bool
     }

   Require schema (subset):
     { hasItem:{id,qty?} }
     { heroStatAtLeast:{key,min} }
     { npcStatAtLeast:{npcId,key,min} }
     { moneyAtLeast:number }
     { shopFlag:"flagId" } or { shopFlags:[...] }
     { questFlag:{questId?, flag, value?} }
     { event:{ type, npcId?, itemId?, postId?, ppvId?, offerId?, vendorId? } }
     { all:[require,...] } / { any:[require,...] }
------------------------------------------------------------------ */

// ---- Legacy questFlags API (kept) ----
setup.initQuestFlags = function () {
	var sv = State.variables;
	if (!sv.questFlags || typeof sv.questFlags !== "object" || Array.isArray(sv.questFlags)) {
		sv.questFlags = {};
	}
};

setup.setQuestFlag = function (questId, flag, value) {
	var sv = State.variables;
	setup.initQuestFlags();
	if (!sv.questFlags[questId] || typeof sv.questFlags[questId] !== "object") sv.questFlags[questId] = {};
	if (arguments.length < 3) sv.questFlags[questId][flag] = true;
	else sv.questFlags[questId][flag] = value;
};

setup.getQuestFlag = function (questId, flag, defaultValue) {
	var sv = State.variables;
	if (!sv.questFlags || !sv.questFlags[questId]) return defaultValue;
	if (!(flag in sv.questFlags[questId])) return defaultValue;
	return sv.questFlags[questId][flag];
};

setup.isQuestFlag = function (questId, flag, expected) {
	var val = setup.getQuestFlag(questId, flag, undefined);
	if (arguments.length < 3) return !!val;
	return val === expected;
};

// ---- Quest system core ----
setup.questDefs = setup.questDefs || {};

setup.ensureQuestSystem = function () {
	var sv = State.variables;
	// runtime state
	if (!sv.questState || typeof sv.questState !== "object" || Array.isArray(sv.questState)) {
		sv.questState = {};
	}
	// migration from legacy $quests array (simple list)
	if (Array.isArray(sv.quests) && !sv.__questMigrated_v17) {
		sv.quests.forEach(function (q) {
			if (!q || !q.id) return;
			if (!setup.questDefs[q.id]) {
				setup.questDefs[q.id] = {
					title: q.title || q.id,
					desc : q.desc || "",
					icon : "📜",
					type : "side",
					steps: [
						{ id: "legacy", text: (q.desc || ""), hint: (q.hint || ""), require: null }
					]
				};
			}
			if (!sv.questState[q.id]) {
				sv.questState[q.id] = {
					status: (q.completed ? "completed" : (q.active ? "active" : "locked")),
					step: 0,
					startedDay: null,
					completedDay: null,
					tracked: false,
					showHint: (q.showHint !== false)
				};
			}
		});
		sv.__questMigrated_v17 = true;
	}
};

setup.initQuests = function () {
	setup.ensureQuestSystem();
	// keep legacy $quests array to not break old saves/scripts
	var sv = State.variables;
	if (!Array.isArray(sv.quests)) sv.quests = [];
};

setup._nowDay = setup._nowDay || function () {
	var sv = State.variables;
	return (typeof sv.dayCounter === "number") ? sv.dayCounter : ((typeof sv.day === "number") ? sv.day : 0);
};

setup.questGetState = function (questId) {
	setup.ensureQuestSystem();
	var sv = State.variables;
	if (!sv.questState[questId]) {
		sv.questState[questId] = {
			status: "locked",
			step: 0,
			startedDay: null,
			completedDay: null,
			tracked: false,
			showHint: true
		};
	}
	return sv.questState[questId];
};

setup.questGetDef = function (questId) {
	return setup.questDefs ? setup.questDefs[questId] : null;
};

setup.questDefine = function (questId, def) {
	if (!questId) return;
	setup.questDefs = setup.questDefs || {};
	setup.questDefs[questId] = def || {};
	return setup.questDefs[questId];
};

// Fluent builder
setup._QuestBuilder = function (questId) {
	this.id = String(questId || "");
	this.def = { title: this.id, desc: "", icon: "📜", type: "side", steps: [] };
};
setup._QuestBuilder.prototype.title = function (t) { this.def.title = String(t || ""); return this; };
setup._QuestBuilder.prototype.desc  = function (t) { this.def.desc  = String(t || ""); return this; };
setup._QuestBuilder.prototype.icon  = function (t) { this.def.icon  = String(t || "📜"); return this; };
setup._QuestBuilder.prototype.type  = function (t) { this.def.type  = String(t || "side"); return this; };
setup._QuestBuilder.prototype.autoStart = function (v) { this.def.autoStart = (v !== false); return this; };
setup._QuestBuilder.prototype.step = function (text, require, effects, opts) {
	opts = opts || {};
	this.def.steps.push({
		id: opts.id || ("s" + (this.def.steps.length + 1)),
		text: String(text || ""),
		hint: (opts.hint != null ? String(opts.hint) : ""),
		require: require || null,
		effects: Array.isArray(effects) ? effects : (effects ? [effects] : null)
	});
	return this;
};
setup._QuestBuilder.prototype.reward = function (effects) {
	this.def.rewardEffects = Array.isArray(effects) ? effects : (effects ? [effects] : null);
	return this;
};
setup._QuestBuilder.prototype.onStart = function (effects) {
	this.def.onStartEffects = Array.isArray(effects) ? effects : (effects ? [effects] : null);
	return this;
};
setup._QuestBuilder.prototype.onComplete = function (effects) {
	this.def.onCompleteEffects = Array.isArray(effects) ? effects : (effects ? [effects] : null);
	return this;
};
setup._QuestBuilder.prototype.register = function () {
	setup.questDefine(this.id, this.def);
	// autoStart only if not started yet
	if (this.def.autoStart) {
		var st = setup.questGetState(this.id);
		if (st.status === "locked") setup.questStart(this.id);
	}
	return this.id;
};
setup.Quest = function (questId) { return new setup._QuestBuilder(questId); };

setup.questStart = function (questId) {
	setup.ensureQuestSystem();
	var def = setup.questGetDef(questId);
	if (!def) return false;
	var st = setup.questGetState(questId);
	if (st.status === "completed") return false;
	st.status = "active";
	st.step = 0;
	st.startedDay = setup._nowDay();
	if (typeof st.showHint !== "boolean") st.showHint = true;

	setup.setQuestFlag(questId, "started", true);
	if (def.onStartEffects && typeof setup.applyEffects === "function") setup.applyEffects(def.onStartEffects, { kind:"quest", questId: questId });
	if (setup.toast) setup.toast("📜 Quest started: " + (def.title || questId), "info", 1800);
	if (typeof setup.phoneMiniNotify === "function") {
		setup.phoneMiniNotify("quests", "", "Quests", "Started: " + (def.title || questId), { questId: questId });
	}

	setup.emitGameEvent("questStart", { questId: String(questId), title: String(def.title || questId) });
	return true;
};

setup.questComplete = function (questId) {
	setup.ensureQuestSystem();
	var def = setup.questGetDef(questId);
	var st = setup.questGetState(questId);
	st.status = "completed";
	st.completedDay = setup._nowDay();
	setup.setQuestFlag(questId, "completed", true);

	if (def) {
		if (def.rewardEffects && typeof setup.applyEffects === "function") setup.applyEffects(def.rewardEffects, { kind:"quest", questId: questId });
		if (def.onCompleteEffects && typeof setup.applyEffects === "function") setup.applyEffects(def.onCompleteEffects, { kind:"quest", questId: questId });
		if (setup.toast) setup.toast("✅ Quest completed: " + (def.title || questId), "success", 2000);
		if (typeof setup.phoneMiniNotify === "function") {
			setup.phoneMiniNotify("quests", "", "Quests", "Completed: " + (def.title || questId), { questId: questId, completed: true });
		}
	}

	setup.emitGameEvent("questComplete", { questId: String(questId), title: String((def && def.title) || questId) });
	return true;
};

setup.questFail = function (questId) {
	var st = setup.questGetState(questId);
	st.status = "failed";
	setup.setQuestFlag(questId, "failed", true);
	if (setup.toast) setup.toast("❌ Quest failed", "warn", 1800);
};

setup.questAbandon = function (questId) {
	var st = setup.questGetState(questId);
	if (st.status !== "active") return;
	st.status = "locked";
	st.step = 0;
	st.tracked = false;
	if (setup.toast) setup.toast("Quest abandoned", "info", 1600);
};

setup.questTrack = function (questId) {
	setup.ensureQuestSystem();
	var sv = State.variables;
	Object.keys(sv.questState).forEach(function (id) {
		if (sv.questState[id]) sv.questState[id].tracked = false;
	});
	var st = setup.questGetState(questId);
	st.tracked = true;
	if (setup.toast) setup.toast("📌 Tracked", "info", 1200);
};

setup.questUntrack = function (questId) {
	var st = setup.questGetState(questId);
	st.tracked = false;
	if (setup.toast) setup.toast("Untracked", "info", 1000);
};

setup.questGetTrackedId = function () {
	setup.ensureQuestSystem();
	var sv = State.variables;
	var ids = Object.keys(sv.questState);
	for (var i = 0; i < ids.length; i++) {
		var id = ids[i];
		if (sv.questState[id] && sv.questState[id].tracked) return id;
	}
	return "";
};

setup.questToggleHint = function (questId) {
	var st = setup.questGetState(questId);
	st.showHint = !st.showHint;
	return st.showHint;
};

// Require evaluation
setup.questCheckRequire = function (req, ctx) {
	if (!req) return true;
	ctx = ctx || {};
	var sv = State.variables;

	// composite
	if (Array.isArray(req.all)) {
		for (var i = 0; i < req.all.length; i++) if (!setup.questCheckRequire(req.all[i], ctx)) return false;
		return true;
	}
	if (Array.isArray(req.any)) {
		for (var j = 0; j < req.any.length; j++) if (setup.questCheckRequire(req.any[j], ctx)) return true;
		return false;
	}

	// hasItem
	if (req.hasItem) {
		var id = String(req.hasItem.id || "");
		var q = Number(req.hasItem.qty || 1);
		if (!isFinite(q) || q < 1) q = 1;
		if (typeof setup.invGetQty !== "function") return false;
		return setup.invGetQty(id) >= q;
	}

	// money
	if (typeof req.moneyAtLeast === "number") {
		var m = Number(req.moneyAtLeast || 0);
		var cur = (typeof setup.getHeroStat === "function") ? Number(setup.getHeroStat("heroMoney") || 0) : Number(sv.heroMoney || 0);
		return cur >= m;
	}

	// hero stat
	if (req.heroStatAtLeast) {
		var hk = String(req.heroStatAtLeast.key || "");
		var hm = Number(req.heroStatAtLeast.min || 0);
		var hv = (typeof setup.getHeroStat === "function") ? Number(setup.getHeroStat(hk) || 0) : Number(sv[hk] || 0);
		return hv >= hm;
	}

	// npc stat
	if (req.npcStatAtLeast) {
		var nid = String(req.npcStatAtLeast.npcId || "");
		var nk = String(req.npcStatAtLeast.key || "");
		var nm = Number(req.npcStatAtLeast.min || 0);
		if (!sv.npcs || !sv.npcs[nid]) return false;
		var nv = Number(sv.npcs[nid][nk] || 0);
		return nv >= nm;
	}

	// shop flag(s)
	if (req.shopFlag) {
		return (typeof setup.getShopFlag === "function") ? !!setup.getShopFlag(String(req.shopFlag), false) : false;
	}
	if (Array.isArray(req.shopFlags)) {
		for (var s = 0; s < req.shopFlags.length; s++) {
			if (!(typeof setup.getShopFlag === "function") || !setup.getShopFlag(String(req.shopFlags[s]), false)) return false;
		}
		return true;
	}

	// quest flag
	if (req.questFlag) {
		var qid = req.questFlag.questId ? String(req.questFlag.questId) : String(ctx.questId || "");
		var fl = String(req.questFlag.flag || "");
		if (!fl) return false;
		if ("value" in req.questFlag) return setup.isQuestFlag(qid, fl, req.questFlag.value);
		return setup.isQuestFlag(qid, fl);
	}

	// event matching (requires ctx.event)
	if (req.event) {
		var e = req.event;
		if (!ctx || !ctx.event) return false;
		if (String(e.type || "") !== String(ctx.event.type || "")) return false;
		var keys = ["npcId","itemId","postId","ppvId","offerId","vendorId"]; 
		for (var k = 0; k < keys.length; k++) {
			var key = keys[k];
			if (e[key] != null && String(e[key]) !== String(ctx.event[key] || "")) return false;
		}
		return true;
	}

	return true;
};

// Try to advance ONE step (called on events and passive checks)
setup.questTryAdvance = function (questId, ctx) {
	setup.ensureQuestSystem();
	var def = setup.questGetDef(questId);
	if (!def || !Array.isArray(def.steps) || def.steps.length === 0) return false;
	var st = setup.questGetState(questId);
	if (st.status !== "active") return false;

	var idx = Number(st.step || 0);
	if (!isFinite(idx) || idx < 0) idx = 0;
	if (idx >= def.steps.length) {
		// already past last step -> complete
		setup.questComplete(questId);
		return true;
	}

	var step = def.steps[idx];
	ctx = ctx || {};
	ctx.questId = questId;
	ctx.stepId = step ? step.id : "";

	if (!step) return false;
	if (!setup.questCheckRequire(step.require, ctx)) return false;

	// step effects
	if (step.effects && typeof setup.applyEffects === "function") {
		setup.applyEffects(step.effects, { kind:"questStep", questId: questId, stepId: step.id, event: (ctx.event || null) });
	}

	st.step = idx + 1;

	// toast per-step (small)
	if (setup.toast) setup.toast("➤ " + (def.title || questId) + ": " + (step.text || ""), "info", 1400);

	// complete if last
	if (st.step >= def.steps.length) {
		setup.questComplete(questId);
		return true;
	}

	return true;
};

// Passive check: advance quests whose current step is satisfied without an event
setup.questCheckPassive = function () {
	setup.ensureQuestSystem();
	var sv = State.variables;
	var ids = Object.keys(setup.questDefs || {});
	// safety: limit chain-advances per call
	var safety = 20;
	var progressed = false;
	while (safety-- > 0) {
		var any = false;
		for (var i = 0; i < ids.length; i++) {
			var id = ids[i];
			var st = sv.questState && sv.questState[id];
			if (!st || st.status !== "active") continue;
			var def = setup.questDefs[id];
			if (!def || !def.steps || !def.steps.length) continue;
			var step = def.steps[Number(st.step||0)];
			if (step && step.require && step.require.event) continue; // needs an event
			if (setup.questTryAdvance(id, { })) { any = true; progressed = true; }
		}
		if (!any) break;
	}
	return progressed;
};

// Public event entrypoint
setup.questEvent = function (type, payload) {
	setup.ensureQuestSystem();
	var sv = State.variables;
	var evt = Object.assign({ type: String(type || "") }, payload || {});

	var ids = Object.keys(setup.questDefs || {});
	for (var i = 0; i < ids.length; i++) {
		var id = ids[i];
		var st = sv.questState && sv.questState[id];
		if (!st || st.status !== "active") continue;
		setup.questTryAdvance(id, { event: evt });
	}
	// after event, also run passive checks (e.g. hasItem became true)
	setup.questCheckPassive();
};

// ---- Compatibility wrappers (old API) ----
setup.addQuest = function (id, opts) {
	setup.ensureQuestSystem();
	opts = opts || {};
	if (!setup.questDefs[id]) {
		setup.questDefs[id] = {
			title: opts.title || id,
			desc : opts.desc || "",
			icon : opts.icon || "📜",
			type : "side",
			steps: [ { id:"s1", text: (opts.desc || ""), hint: (opts.hint || ""), require: null } ]
		};
	}
	var st = setup.questGetState(id);
	st.showHint = ("showHint" in opts) ? !!opts.showHint : (typeof st.showHint === "boolean" ? st.showHint : true);
	if (("active" in opts) ? !!opts.active : true) {
		if (st.status === "locked") setup.questStart(id);
	}
	if (opts.completed) setup.questComplete(id);
	return { id:id };
};

setup.completeQuest = function (id) { return setup.questComplete(id); };
setup.showQuestHint = function (id, show) {
	var st = setup.questGetState(id);
	st.showHint = (show !== false);
};

// ---- Phone UI: Quests ----
setup.phoneRenderQuests = function () {
	setup.ensureQuestSystem();
	var sv = State.variables;
	var data = sv.phoneScreenData || {};
	var view = data.view || "list"; // list | detail
	var tab  = data.tab || "active"; // active | completed

	var esc = setup.escapeHtml;
	var ids = Object.keys(setup.questDefs || {});

	function getStatus(id) {
		var st = sv.questState && sv.questState[id];
		return st ? st.status : "locked";
	}

	function getVisibleIds() {
		return ids.filter(function (id) {
			var s = getStatus(id);
			if (tab === "completed") return (s === "completed");
			return (s === "active");
		});
	}

	function renderTabs() {
		var a = (tab === "active") ? " active" : "";
		var c = (tab === "completed") ? " active" : "";
		return '' +
			'<div class="q-tabs">' +
			'  <button class="q-tab' + a + '" data-quest-tab="active">Active</button>' +
			'  <button class="q-tab' + c + '" data-quest-tab="completed">Completed</button>' +
			'</div>';
	}

	function progressPct(id) {
		var def = setup.questDefs[id] || {};
		var st  = sv.questState[id] || {};
		var total = (def.steps && def.steps.length) ? def.steps.length : 1;
		var cur = Number(st.step || 0);
		if (!isFinite(cur) || cur < 0) cur = 0;
		if (cur > total) cur = total;
		return Math.round((cur / total) * 100);
	}

	function currentStepText(id) {
		var def = setup.questDefs[id] || {};
		var st  = sv.questState[id] || {};
		var idx = Number(st.step || 0);
		if (!def.steps || !def.steps.length) return "";
		if (idx >= def.steps.length) idx = def.steps.length - 1;
		var step = def.steps[idx];
		return step ? (step.text || "") : "";
	}

	function currentStepHint(id) {
		var def = setup.questDefs[id] || {};
		var st  = sv.questState[id] || {};
		var idx = Number(st.step || 0);
		if (!def.steps || !def.steps.length) return "";
		if (idx >= def.steps.length) idx = def.steps.length - 1;
		var step = def.steps[idx];
		return step ? (step.hint || "") : "";
	}

	// Detail view
	if (view === "detail") {
		var qid = String(data.questId || "");
		var def = setup.questDefs[qid];
		if (!def) {
			return '<div class="phone-section"><div class="phone-ui-placeholder">Quest not found</div></div>';
		}
		var st = setup.questGetState(qid);
		var pct = progressPct(qid);
		var status = st.status || "locked";
		var statusLabel = (status === "active") ? "ACTIVE" : (status === "completed") ? "COMPLETED" : (status === "failed") ? "FAILED" : "LOCKED";
		var tracked = st.tracked ? " tracked" : "";

		var html = '' +
		'<div class="phone-section q-detail">' +
		'  <div class="q-head">' +
		'    <div class="q-ico">' + esc(def.icon || "📜") + '</div>' +
		'    <div class="q-meta">' +
		'      <div class="q-title">' + esc(def.title || qid) + '</div>' +
		'      <div class="q-sub">' + esc(def.desc || "") + '</div>' +
		'    </div>' +
		'    <div class="q-pill q-pill--' + esc(status) + '">' + esc(statusLabel) + '</div>' +
		'  </div>' +
		'  <div class="q-progress"><div class="q-bar"><div class="q-bar-fill" style="width:' + pct + '%"></div></div><div class="q-pct">' + pct + '%</div></div>' +
		'  <div class="q-actions">' +
		'    <button class="q-btn' + tracked + '" data-quest-track="' + esc(qid) + '">' + (tracked ? '📌 Tracked' : '📌 Track') + '</button>' +
		'    <button class="q-btn" data-quest-hint="' + esc(qid) + '">' + (st.showHint ? '🙈 Hide hint' : '👁 Show hint') + '</button>' +
		(status === "active" ? ('    <button class="q-btn q-btn--danger" data-quest-abandon="' + esc(qid) + '">⛔ Abandon</button>') : '') +
		'  </div>';

		// steps
		if (Array.isArray(def.steps) && def.steps.length) {
			html += '<div class="q-steps">';
			for (var i = 0; i < def.steps.length; i++) {
				var s = def.steps[i];
				var done = (i < (st.step||0));
				var cur = (i === (st.step||0));
				html += '<div class="q-step' + (done ? ' done' : '') + (cur ? ' cur' : '') + '">' +
					'<div class="q-step-dot">' + (done ? '✓' : (cur ? '•' : '')) + '</div>' +
					'<div class="q-step-txt">' + esc(s.text || '') + '</div>' +
				'</div>';
				if (cur && st.showHint && s.hint) {
					html += '<div class="q-hint">💡 ' + esc(s.hint) + '</div>';
				}
			}
			html += '</div>';
		}

		html += '</div>';
		return html;
	}

	// List view
	var vis = getVisibleIds();
	var html2 = '' +
	'<div class="phone-section">' +
	'  <div class="phone-section-title">Quests</div>' +
		renderTabs() +
	'  <div class="q-list">';

	if (!vis.length) {
		html2 += '<div class="q-empty">No quests here yet.</div>';
	} else {
		vis.forEach(function (qid) {
			var def = setup.questDefs[qid] || {};
			var st = setup.questGetState(qid);
			var pct = progressPct(qid);
			var stepTxt = currentStepText(qid);
			var stepHint = currentStepHint(qid);
			html2 += '' +
			'<div class="q-card" data-quest-open="' + esc(qid) + '">' +
			'  <div class="q-card-ico">' + esc(def.icon || "📜") + '</div>' +
			'  <div class="q-card-main">' +
			'    <div class="q-card-title">' + esc(def.title || qid) + (st.tracked ? ' <span class="q-pin">📌</span>' : '') + '</div>' +
			'    <div class="q-card-step">' + esc(stepTxt || def.desc || "") + '</div>' +
			(st.showHint && stepHint ? ('    <div class="q-card-hint">💡 ' + esc(stepHint) + '</div>') : '') +
			'    <div class="q-card-bar"><div class="q-bar"><div class="q-bar-fill" style="width:' + pct + '%"></div></div><div class="q-pct">' + pct + '%</div></div>' +
			'  </div>' +
			'</div>';
		});
	}

	html2 += '  </div></div>';
	return html2;
};



setup.phoneRenderAchievements = function () {
	// Achievements / Unlockables UI (uses unlockCatalog + $unlocks / $unlockProgress)
	if (typeof setup.ensureUnlockState === "function") setup.ensureUnlockState();

	var sv = State.variables;
	var data = sv.phoneScreenData || {};
	var view = data.view || "list"; // list | detail
	var tab  = data.tab || "achievements"; // achievements | unlockables
	if (tab !== "achievements" && tab !== "unlockables") tab = "achievements";

	var esc = setup.escapeHtml;
	var catalog = setup.unlockCatalog || {};
	var ids = Object.keys(catalog);

	function isUnlocked(id) { return (typeof setup.isUnlocked === "function") ? setup.isUnlocked(id) : false; }
	function kindOf(id) { var d = catalog[id] || {}; return String(d.kind || "achievement").toLowerCase(); }
	function isAchievement(id) { return kindOf(id) === "achievement"; }

	function filterIds() {
		return ids.filter(function (id) {
			var isAch = isAchievement(id);
			return (tab === "achievements") ? isAch : (!isAch);
		});
	}

	function renderTabs() {
		var a = (tab === "achievements") ? " active" : "";
		var u = (tab === "unlockables") ? " active" : "";
		return '' +
			'<div class="q-tabs a-tabs">' +
			'  <button class="q-tab' + a + '" data-ach-tab="achievements">Achievements</button>' +
			'  <button class="q-tab' + u + '" data-ach-tab="unlockables">Unlockables</button>' +
			'</div>';
	}

	function progressInfo(id) {
		var def = catalog[id] || {};
		var total = (typeof def.progressTotal === "number" && isFinite(def.progressTotal)) ? def.progressTotal : 0;
		var cur = 0;
		if (sv.unlockProgress && typeof sv.unlockProgress[id] === "number") cur = Number(sv.unlockProgress[id] || 0);
		if (!isFinite(cur) || cur < 0) cur = 0;
		if (total > 0 && cur > total) cur = total;

		var unlocked = isUnlocked(id);
		var pct = 0;
		if (total > 0) pct = Math.round((cur / total) * 100);
		else pct = unlocked ? 100 : 0;

		return { cur: cur, total: total, pct: pct };
	}

	function display(id) {
		var def = catalog[id] || {};
		var unlocked = isUnlocked(id);
		var secret = !!def.secret;

		var title = unlocked ? (def.title || id) : (secret ? "???" : (def.title || id));
		var desc  = unlocked ? (def.desc || "") : (secret ? "Secret achievement" : (def.desc || ""));
		var icon  = unlocked ? (def.icon || "🏆") : (secret ? "❔" : (def.icon || "🏆"));

		return { def:def, unlocked:unlocked, secret:secret, title:title, desc:desc, icon:icon };
	}

	// Detail view
	if (view === "detail") {
		var aid = String(data.id || "");
		var d = display(aid);
		if (!d.def || !catalog[aid]) {
			return '<div class="phone-section"><div class="phone-ui-placeholder">Not found</div></div>';
		}

		var pi = progressInfo(aid);
		var statusLabel = d.unlocked ? "UNLOCKED" : "LOCKED";
		var pillClass = d.unlocked ? "q-pill--completed" : "q-pill--locked";

		var dayTxt = "";
		try {
			if (sv.unlocks && sv.unlocks.ids && sv.unlocks.ids[aid] && typeof sv.unlocks.ids[aid].day === "number") {
				dayTxt = "Day " + String(sv.unlocks.ids[aid].day);
			}
		} catch (e) {}

		var kind = String(d.def.kind || "achievement");
		var kindLabel = (kind.toLowerCase() === "achievement") ? "Achievement" : "Unlockable";

		var html = '' +
		'<div class="phone-section q-detail a-detail">' +
		'  <div class="q-head">' +
		'    <div class="q-ico">' + esc(d.icon) + '</div>' +
		'    <div class="q-meta">' +
		'      <div class="q-title">' + esc(d.title) + '</div>' +
		'      <div class="q-sub">' + esc(d.desc || "") + '</div>' +
		'      <div class="a-kind">' + esc(kindLabel) + (dayTxt ? (' • ' + esc(dayTxt)) : '') + '</div>' +
		'    </div>' +
		'    <div class="q-pill ' + pillClass + '">' + esc(statusLabel) + '</div>' +
		'  </div>';

		// Progress (if any)
		if (pi.total > 0) {
			html += '' +
			'  <div class="q-progress a-progress">' +
			'    <div class="q-bar"><div class="q-bar-fill" style="width:' + pi.pct + '%"></div></div>' +
			'    <div class="q-pct">' + esc(String(pi.cur)) + '/' + esc(String(pi.total)) + '</div>' +
			'  </div>';
		}

		html += '</div>';
		return html;
	}

	// List view
	var vis = filterIds();

	// sort: unlocked first, then title
	vis.sort(function (a, b) {
		var ua = isUnlocked(a) ? 1 : 0;
		var ub = isUnlocked(b) ? 1 : 0;
		if (ua !== ub) return (ub - ua);
		var ta = String((catalog[a] && catalog[a].title) ? catalog[a].title : a).toLowerCase();
		var tb = String((catalog[b] && catalog[b].title) ? catalog[b].title : b).toLowerCase();
		if (ta < tb) return -1;
		if (ta > tb) return 1;
		return 0;
	});

	var titleTop = (tab === "achievements") ? "Achievements" : "Unlockables";

	var out = '' +
	'<div class="phone-section">' +
	'  <div class="phone-section-title">' + esc(titleTop) + '</div>' +
		renderTabs() +
	'  <div class="q-list a-list">';

	if (!vis.length) {
		out += '<div class="q-empty">Nothing here yet.</div>';
	} else {
		vis.forEach(function (id) {
			var d = display(id);
			var pi = progressInfo(id);
			var lockedClass = d.unlocked ? "" : " locked";

			out += '' +
			'<div class="q-card a-card' + lockedClass + '" data-ach-open="' + esc(id) + '">' +
			'  <div class="q-card-ico">' + esc(d.icon) + '</div>' +
			'  <div class="q-card-main">' +
			'    <div class="q-card-title">' + esc(d.title) + '</div>' +
			'    <div class="q-card-step">' + esc(d.desc || "") + '</div>';

			if (pi.total > 0 && (!d.secret || d.unlocked)) {
				out += '' +
				'    <div class="q-card-bar">' +
				'      <div class="q-bar"><div class="q-bar-fill" style="width:' + pi.pct + '%"></div></div>' +
				'      <div class="q-pct">' + esc(String(pi.cur)) + '/' + esc(String(pi.total)) + '</div>' +
				'    </div>';
			}

			out += '' +
			'  </div>' +
			'</div>';
		});
	}

	out += '  </div></div>';
	return out;
};

setup.phoneRenderCheats = function () {
	return '' +
	'<div class="phone-section">' +
	'  <div class="phone-section-title">Cheats</div>' +
	'  <div class="phone-cheats-placeholder">' +
	'    Здесь позже сделаем включение подсказок для квестов, бонусы и т.п.' +
	'  </div>' +
	'</div>';
};

  

 	
	/* ------------------------------------------------------------------
	   DYNAMIC EVENTS (World Events / Reactive Scenes)
	   ------------------------------------------------------------------
	   Purpose:
	   - Make world feel alive: choose scenes based on location/time/stats/flags/quests/etc.
	   - No eval. Definitions are data-driven.
	   - Supports: conditions (via setup.questCheckRequire), weight/chance, priority, cooldown, once.
	   - Can render inline via macro <<dynEvents>> OR auto-tick on passage display (optional).
	   ------------------------------------------------------------------ */

	// Ensure runtime state is present in save
	setup.ensureDynamicEvents = function () {
		var sv = State.variables;
		if (!sv.dynEventState || typeof sv.dynEventState !== "object") {
			sv.dynEventState = {
				count: {},          // eventId -> number
				last: {},           // eventId/onceKey -> {day, timeOfDayIndex, passage}
				once: {},           // onceKey -> true
				log: []             // debug log (strings)
			};
		}
		setup.dynamicEventDefs = setup.dynamicEventDefs || {};
		return sv.dynEventState;
	};

	setup._dynLog = function (msg) {
		try {
			var st = setup.ensureDynamicEvents();
			if (!msg) return;
			st.log.push(String(msg));
			if (st.log.length > 120) st.log.splice(0, st.log.length - 120);
		} catch (e) {}
	};

	setup._dynNow = function () {
		var sv = State.variables;
		var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : ((typeof sv.day === "number") ? sv.day : 0);
		var tdx = Number(sv.timeOfDayIndex) || 0;
		var passage = (State.passage && State.passage.title) ? String(State.passage.title) : "";
		var weekdayIndex = Number(sv.weekdayIndex) || 0;
		return { day: day, timeOfDayIndex: tdx, timeKey: (setup.getTimeOfDayKey ? setup.getTimeOfDayKey() : "day"), passage: passage, weekdayIndex: weekdayIndex };
	};

	setup._matchPattern = function (text, pattern) {
		text = String(text || "");
		if (pattern == null) return false;
		if (Array.isArray(pattern)) {
			for (var i = 0; i < pattern.length; i++) if (setup._matchPattern(text, pattern[i])) return true;
			return false;
		}
		var p = String(pattern);
		if (!p) return false;
		if (p === text) return true;

		// Wildcard with *
		if (p.indexOf("*") !== -1) {
			// escape regex except *
			var reStr = "^" + p.split("*").map(function (s) { return s.replace(/[.+?^${}()|[\]\\]/g, "\\$&"); }).join(".*") + "$";
			try { return new RegExp(reStr).test(text); } catch (e) { return false; }
		}
		return false;
	};

	setup.dynamicEventDefine = function (eventId, def) {
		setup.ensureDynamicEvents();
		if (!eventId) return;
		def = (def && typeof def === "object") ? def : {};
		def.id = String(eventId);
		if (def.enabled == null) def.enabled = true;
		if (def.weight == null) def.weight = 1;
		if (def.chance == null) def.chance = 1;
		if (def.priority == null) def.priority = 0;
		if (!def.sceneId && def.scene) def.sceneId = def.scene;
		setup.dynamicEventDefs[def.id] = def;
		return def;
	};

	// Fluent builder: setup.DynEvent("EVT_ID").title(...).scene(...).where(...).require(...).cooldownDays(...).once(...).register()
	setup.DynEvent = function (eventId) {
		var d = { id: String(eventId || "") };
		var api = {
			title: function (t) { d.title = String(t || ""); return api; },
			desc: function (t) { d.desc = String(t || ""); return api; },
			icon: function (t) { d.icon = String(t || ""); return api; },
			scene: function (sid) { d.sceneId = String(sid || ""); return api; },
			mode: function (m) { d.mode = String(m || "inline"); return api; }, // inline|runner
			auto: function (v) { d.auto = !!v; return api; }, // if false, only manual macro will run it
			priority: function (n) { d.priority = Number(n || 0) || 0; return api; },
			weight: function (n) { d.weight = Number(n || 1) || 1; return api; },
			chance: function (n) { d.chance = Number(n || 1); if (!isFinite(d.chance)) d.chance = 1; return api; },
			where: function (pattern) { d.passages = pattern; return api; }, // passage name(s) or wildcard like "home*"
			time: function (minIdx, maxIdx) { d.minTimeIndex = Number(minIdx); d.maxTimeIndex = (maxIdx==null?Number(minIdx):Number(maxIdx)); return api; },
			weekday: function (arr) { d.weekdays = Array.isArray(arr) ? arr.slice() : [Number(arr)]; return api; },
			npcPresent: function (ids) { d.npcPresent = Array.isArray(ids) ? ids.slice() : [String(ids)]; return api; },
			require: function (req) { d.require = req; return api; }, // uses setup.questCheckRequire
			cooldownDays: function (n, key) { d.cooldownDays = Number(n || 0) || 0; if (key) d.cooldownKey = String(key); return api; },
			once: function (key) { d.onceKey = String(key || eventId || ""); d.once = true; return api; },
			effects: function (fx) { d.effects = fx; return api; }, // applied on trigger
			register: function () { return setup.dynamicEventDefine(eventId, d); }
		};
		return api;
	};

	setup._dynEligible = function (def, ctx, manual) {
		if (!def || def.enabled === false) return false;
		if (!manual && def.auto === false) return false;
		if (!def.sceneId) return false;

		var now = setup._dynNow();
		ctx = ctx || {};
		ctx.now = now;

		// passage match
		if (def.passages && !setup._matchPattern(now.passage, def.passages)) return false;

		// weekdays
		if (Array.isArray(def.weekdays) && def.weekdays.length) {
			var ok = false;
			for (var i = 0; i < def.weekdays.length; i++) if (Number(def.weekdays[i]) === Number(now.weekdayIndex)) { ok = true; break; }
			if (!ok) return false;
		}

		// time window
		if (def.minTimeIndex != null || def.maxTimeIndex != null) {
			var mi = (def.minTimeIndex != null) ? Number(def.minTimeIndex) : 0;
			var ma = (def.maxTimeIndex != null) ? Number(def.maxTimeIndex) : mi;
			var ti = Number(now.timeOfDayIndex) || 0;
			if (ti < mi || ti > ma) return false;
		}

		// npc present at this location (requires sv.npcs[].currentLocation to be updated)
		if (Array.isArray(def.npcPresent) && def.npcPresent.length) {
			var sv = State.variables;
			if (!sv.npcs) return false;
			for (var j = 0; j < def.npcPresent.length; j++) {
				var nid = String(def.npcPresent[j] || "");
				if (!nid || !sv.npcs[nid]) return false;
				if (String(sv.npcs[nid].currentLocation || "") !== String(now.passage || "")) return false;
			}
		}

		// cooldown / once bookkeeping
		var st = setup.ensureDynamicEvents();
		var cdKey = def.cooldownKey ? String(def.cooldownKey) : String(def.onceKey || def.id);
		if (def.once || def.onceKey) {
			var okKey = String(def.onceKey || def.id);
			if (st.once && st.once[okKey]) return false;
		}
		if (def.cooldownDays && Number(def.cooldownDays) > 0) {
			var last = st.last && st.last[cdKey];
			if (last && typeof last.day === "number") {
				if ((now.day - last.day) < Number(def.cooldownDays)) return false;
			}
		}

		// structured requirements (reuse quest checker)
		if (def.require && typeof setup.questCheckRequire === "function") {
			var ctx2 = Object.assign({}, ctx);
			// allow event requires to match a synthetic passage event
			if (!ctx2.event) ctx2.event = { type: "passage", passage: now.passage, timeKey: now.timeKey };
			if (!setup.questCheckRequire(def.require, ctx2)) return false;
		}

		return true;
	};

	setup._dynPickOne = function (ctx, opts) {
		setup.ensureDynamicEvents();
		opts = (opts && typeof opts === "object") ? opts : {};
		var manual = !!opts.manual;
		var exclude = opts.exclude || null; // object {id:true} or array
		var defs = setup.dynamicEventDefs || {};
		var list = [];
		var bestPr = -Infinity;

		function isExcluded(id) {
			if (!exclude) return false;
			if (Array.isArray(exclude)) return exclude.indexOf(id) !== -1;
			return !!exclude[id];
		}

		Object.keys(defs).forEach(function (id) {
			if (isExcluded(id)) return;
			var d = defs[id];
			if (!setup._dynEligible(d, ctx, manual)) return;
			var pr = Number(d.priority || 0) || 0;
			if (pr > bestPr) bestPr = pr;
		});

		// Only highest priority bucket
		Object.keys(defs).forEach(function (id) {
			if (isExcluded(id)) return;
			var d = defs[id];
			if (!setup._dynEligible(d, ctx, manual)) return;
			var pr = Number(d.priority || 0) || 0;
			if (pr !== bestPr) return;
			var w = Number(d.weight || 1);
			if (!isFinite(w) || w <= 0) w = 1;
			list.push({ def: d, w: w });
		});

		if (!list.length) return null;

		function weightedPick(arr) {
			var sum = 0;
			for (var i = 0; i < arr.length; i++) sum += arr[i].w;
			var r = Math.random() * sum;
			for (var j = 0; j < arr.length; j++) {
				r -= arr[j].w;
				if (r <= 0) return arr[j].def;
			}
			return arr[arr.length - 1].def;
		}

		var pick = weightedPick(list);

		// chance roll (if fails -> remove and retry a few times)
		var tries = Math.min(6, list.length);
		for (var t = 0; t < tries; t++) {
			var ch = Number(pick.chance == null ? 1 : pick.chance);
			if (!isFinite(ch)) ch = 1;
			if (ch >= 1 || Math.random() <= ch) return pick;

			// remove this pick and retry
			list = list.filter(function (x) { return x.def.id !== pick.id; });
			if (!list.length) return null;
			pick = weightedPick(list);
		}

		return null;
	};

	setup._dynTrigger = function (def, ctx, renderTarget) {
		if (!def) return false;
		setup.ensureDynamicEvents();
		var st = State.variables.dynEventState;
		var now = setup._dynNow();
		var id = String(def.id);

		// bookkeeping
		st.count[id] = Number(st.count[id] || 0) + 1;

		var cdKey = def.cooldownKey ? String(def.cooldownKey) : String(def.onceKey || id);
		st.last[cdKey] = { day: now.day, timeOfDayIndex: now.timeOfDayIndex, passage: now.passage };

		if (def.once || def.onceKey) {
			var okKey = String(def.onceKey || id);
			st.once[okKey] = true;
		}

		// effects on trigger
		if (def.effects && typeof setup.applyEffects === "function") {
			try { setup.applyEffects(def.effects, { kind: "dynEvent", eventId: id, passage: now.passage }); } catch (e) {}
		}

		// render scene
		try {
			var p = Story.get(String(def.sceneId));
			if (!p) return false;

			var sv = State.variables;
			sv.scenePayload = (def.payload != null) ? def.payload : (ctx && ctx.payload) || null;
			sv.sceneInlineMeta = Object.assign({}, def.meta || {}, { kind: "dynEvent", eventId: id });
			sv.sceneInlineId = String(def.sceneId);
			sv.sceneMode = "inline";
			sv.sceneId = String(def.sceneId);

			var frag = document.createDocumentFragment();
			jQuery(frag).wiki(p.processText());

			if (renderTarget) {
				// Macro output element
				renderTarget.append(frag);
			} else {
				// Auto slot at end of passage
				var $slot = jQuery(".dyn-events-slot").last();
				if (!$slot.length) {
					var $p = jQuery(".passage").last();
					if ($p.length) {
						$p.append('<div class="dyn-events-slot"></div>');
						$slot = jQuery(".dyn-events-slot").last();
					}
				}
				if ($slot && $slot.length) $slot[0].appendChild(frag);
			}

			setup._dynLog("[dyn] trigger " + id + " -> " + String(def.sceneId) + " @ " + now.passage);
			return true;
		} catch (e) {
			setup._dynLog("[dyn] trigger error " + id + ": " + e);
			return false;
		}
	};

	// Main tick: pick and trigger up to N events
	setup.dynamicEventsTick = function (opts) {
		setup.ensureDynamicEvents();
		opts = (opts && typeof opts === "object") ? opts : {};
		var manual = !!opts.manual;
		var max = Number(opts.max || 1);
		if (!isFinite(max) || max <= 0) max = 1;
		max = Math.floor(max);

		// Respect auto toggle (unless manual)
		if (!manual) {
			var sv = State.variables;
			if (!sv || !sv.dynEventsAuto) return 0;

			// don't interrupt phone/map overlays
			try {
				if ((("#phone-overlay" && jQuery("#phone-overlay").hasClass("visible"))) || (("#map-overlay" && jQuery("#map-overlay").hasClass("visible")))) {
					return 0;
				}
			} catch (e) {}
		}

		var triggered = 0;
		var exclude = {};
		for (var i = 0; i < max; i++) {
			var def = setup._dynPickOne({}, { manual: manual, exclude: exclude });
			if (!def) break;
			if (setup._dynTrigger(def, {}, opts.renderTarget || null)) {
				exclude[String(def.id)] = true;
				triggered++;
			} else {
				break;
			}
		}
		return triggered;
	};

	// Macro: render dynamic event scenes inline at a chosen spot:
	//   <<dynEvents>>            (1)
	//   <<dynEvents 2>>          (up to 2)
	//   <<dynEvents "all">>      (all possible, but still respects priority bucket and cooldown/once)
	if (!Macro.has("dynEvents")) Macro.add("dynEvents", {
		handler: function () {
			var arg0 = (this.args.length ? this.args[0] : 1);
			var max = 1;
			var all = false;
			if (typeof arg0 === "string" && arg0.toLowerCase() === "all") { all = true; max = 9999; }
			else { max = Number(arg0 || 1); if (!isFinite(max) || max <= 0) max = 1; max = Math.floor(max); }

			setup.ensureDynamicEvents();

			var triggered = 0;
			var exclude = {};
			for (var i = 0; i < max; i++) {
				var def = setup._dynPickOne({}, { manual: true, exclude: exclude });
				if (!def) break;
				if (setup._dynTrigger(def, {}, this.output)) {
					exclude[String(def.id)] = true;
					triggered++;
				} else {
					break;
				}
				if (!all && triggered >= max) break;
			}
		}
	});


	// Debug: print last N lines of dyn-events log: <<dynLog 30>>
	if (!Macro.has("dynLog")) Macro.add("dynLog", {
		handler: function () {
			setup.ensureDynamicEvents();
			var st = State.variables.dynEventState;
			var n = (this.args.length ? Number(this.args[0]) : 30);
			if (!isFinite(n) || n <= 0) n = 30;
			n = Math.floor(n);

			var lines = (st && Array.isArray(st.log)) ? st.log.slice(-n) : [];
			var txt = lines.join("\n");
			var esc = (typeof setup.escapeHtml === "function") ? setup.escapeHtml(txt) : txt.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
			jQuery(this.output).append('<pre class="dyn-log">' + esc + '</pre>');
		}
	});


	// Optional auto hook: if player enables $dynEventsAuto = true, try to trigger 1 event on each passagedisplay
	if (!setup._dynEventsHook) {
		setup._dynEventsHook = true;
		jQuery(document).on(":passagedisplay", function () {
			try { setup.dynamicEventsTick({ max: 1, manual: false }); } catch (e) {}
		});
	}



/* ------------------------------------------------------------------
	   КАРТА: локации + переходы + всплывающий оверлей
	   ------------------------------------------------------------------ */

