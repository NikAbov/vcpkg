		var tags = [];
		if (typeof rule === "string") tags = [rule];
		else if (Array.isArray(rule)) tags = rule;
		else if (rule && rule.contentTags) tags = arr(rule.contentTags);

		if (tags.length && typeof setup.isContentAllowed === "function") {
			if (!setup.isContentAllowed(tags)) fail("content tags not allowed");
		}

		// Feature flags
		if (ok && rule && (rule.featuresAll || rule.featuresAny)) {
			var fa = arr(rule.featuresAll);
			for (var i = 0; i < fa.length; i++) {
				if (!setup.isFeatureEnabled(String(fa[i]), true)) { fail("feature disabled: " + fa[i]); break; }
			}
			var fy = arr(rule.featuresAny);
			if (ok && fy.length) {
				var anyOk = false;
				for (var j = 0; j < fy.length; j++) if (setup.isFeatureEnabled(String(fy[j]), true)) { anyOk = true; break; }
				if (!anyOk) fail("no required feature enabled");
			}
