    setup.mapLocations = D.mapLocations;
  }

  // Location tree (parent -> [children])
  setup.locationTree = {};
  if (Array.isArray(D.locationParents)) {
    for (var i = 0; i < D.locationParents.length; i++) {
      var pair = D.locationParents[i];
      if (Array.isArray(pair) && pair.length >= 2) {
        setup.registerLocationParent(pair[0], pair[1]);
      }
    }
  }

  // Rooms by container/building
  if (D.roomsByContainer && typeof D.roomsByContainer === "object") {
    setup.apartmentRoomConfig = D.roomsByContainer;
  }

  // NPC defs: keep existing npc_player as first element, replace the rest
  var playerDef = null;
  if (Array.isArray(setup.npcDefinitions) && setup.npcDefinitions.length > 0) {
    playerDef = setup.npcDefinitions[0];
  }
  if (playerDef) {
    setup.npcDefinitions = [playerDef].concat(Array.isArray(D.npcDefs) ? D.npcDefs : []);
  } else if (Array.isArray(D.npcDefs)) {
    setup.npcDefinitions = D.npcDefs.slice();
  }

  // NPC schedules
  if (D.npcSchedules && typeof D.npcSchedules === "object") {
    setup.npcSchedules = D.npcSchedules;
  }

  // Content catalog / flags
  if (D.contentCatalog !== undefined) {
    setup.contentCatalog = D.contentCatalog;
  }

  // Room type defaults (for rooms UI)
  if (D.roomTypeDefaults && typeof D.roomTypeDefaults === "object") {
    setup.roomTypeDefaults = D.roomTypeDefaults;
    setup.apartmentRoomTypeDefaults = setup.apartmentRoomTypeDefaults || {};
    Object.keys(D.roomTypeDefaults).forEach(function (k) {
      var v = D.roomTypeDefaults[k];
      if (v && typeof v === "object" && typeof v.path === "string") {
        setup.apartmentRoomTypeDefaults[k] = (setup.backgroundBasePath || "") + v.path;
      }
    });
  }

  // NPC relation labels / stats config / relation status rules
  if (D.npcRelationLabels && typeof D.npcRelationLabels === "object") {
    setup.npcRelationLabels = D.npcRelationLabels;
  }
  if (Array.isArray(D.npcStatConfig)) {
    setup.npcStatConfig = D.npcStatConfig;
  }

  // HERO stat config / start stats
  if (Array.isArray(D.heroStatConfig)) {
    setup.heroStatConfig = D.heroStatConfig;
  }
  if (D.heroStartStats && typeof D.heroStartStats === "object") {
    setup.heroStartStats = D.heroStartStats;
  }
  if (D.npcRelationStatus && typeof D.npcRelationStatus === "object") {
    setup.npcRelationStatus = D.npcRelationStatus;
    // Phone UI titles (key -> {key,title})
    if (D.npcRelationStatus.statuses && typeof D.npcRelationStatus.statuses === "object") {
      var __cfg = {};
      Object.keys(D.npcRelationStatus.statuses).forEach(function (k) {
        var st = D.npcRelationStatus.statuses[k] || {};
        __cfg[k] = { key: k, title: st.title || k };
      });
      setup.relationStatusConfig = __cfg;
    }
  }
})();
/* === IDE AUTOGEN: HYDRATE END === */

/* Макросы для "служебных" пассажей со сценами/выборами */

/* Вставить содержимое другого пассажа, не переходя в него */
if (!Macro.has("sceneFrom")) Macro.add("sceneFrom", {
	handler : function () {
		if (this.args.length < 1) {
			return this.error('Нужно имя пассажа, например: <<sceneFrom "home_day_elly">>');
		}
		var passageName = String(this.args[0]);
		var p = Story.get(passageName);
		if (!p) {
			return this.error('Пассаж "' + passageName + '" не найден');
		}
		var frag = document.createDocumentFragment();
		jQuery(frag).wiki(p.processText());
		this.output.append(frag);
	}
});

/* Случайная сцена из списка служебных пассажей */
if (!Macro.has("sceneRandom")) Macro.add("sceneRandom", {
	handler : function () {
		if (this.args.length < 1) {
			return this.error('Нужно указать хотя бы один пассаж: <<sceneRandom "scene1" "scene2">>');
		}
		var candidates = [];
		for (var i = 0; i < this.args.length; i++) {
			var name = this.args[i];
			if (name == null) {
				continue;
			}
			name = String(name);
			var p = Story.get(name);
			if (p) {
				candidates.push(p);
			}
		}
		if (candidates.length === 0) {
			return; // ни один указаный пассаж не найден
		}
		var idx = Math.floor(Math.random() * candidates.length);
		var chosen = candidates[idx];

		var frag = document.createDocumentFragment();
		jQuery(frag).wiki(chosen.processText());
		this.output.append(frag);
	}
});



/* Scene Queue consumer macros
   - <<sceneQueued>>      : inline consume 1 scene and render it via sceneFrom
   - <<sceneQueued 3>>    : consume up to 3 scenes
   - <<sceneQueued "all">> : consume all matching scenes

   Scene payload exposure inside scenes:
     $scenePayload  : payload passed to queueScene
     $sceneId       : current queued scene id
     $sceneMode     : "inline" or "runner"

   End-of-scene helper:
     <<sceneDone>>           : inline -> clears vars; runner -> shows Continue
     <<sceneDone "Back">>    : runner Continue label
     <<sceneDone "auto">>    : runner -> auto return immediately
*/

if (!Macro.has("sceneQueued")) Macro.add("sceneQueued", {
	handler: function () {
		setup.ensureSceneState();
		var sv = State.variables;

		var arg0 = (this.args.length ? this.args[0] : 1);
		var max = 1;
		var all = false;
		if (typeof arg0 === "string" && arg0.toLowerCase() === "all") {
			all = true;
			max = 9999;
		} else {
			max = Number(arg0 || 1);
			if (!isFinite(max) || max <= 0) max = 1;
			max = Math.floor(max);
		}

		var rendered = 0;
		while (rendered < max) {
			var it = setup.consumeScene({ mode: "inline", passageName: (State.passage && State.passage.title) || "" });
			if (!it) break;

			var p = Story.get(String(it.id));
			if (!p) {
				// Scene passage not found -> skip
				rendered += 1;
				continue;
			}

			sv.scenePayload = it.payload || null;
			sv.sceneInlineMeta = it.meta || null;
			sv.sceneInlineId = String(it.id);
			sv.sceneMode = "inline";
			sv.sceneId = String(it.id);

			var frag = document.createDocumentFragment();
			jQuery(frag).wiki(p.processText());
			this.output.append(frag);

			rendered += 1;
			if (!all && rendered >= max) break;
		}
	}
});

if (!Macro.has("sceneDone")) Macro.add("sceneDone", {
	handler: function () {
		setup.ensureSceneState();
		var sv = State.variables;
		var mode = String(sv.sceneMode || "");

		// Runner mode: show Continue button (or auto return)
		if (mode === "runner" && sv.activeSceneId) {
			var a0 = (this.args.length ? this.args[0] : null);
			var auto = false;
			var label = "Continue";
			if (a0 === true) auto = true;
			if (typeof a0 === "string") {
				var s = a0.trim();
				if (s.toLowerCase() === "auto") auto = true;
				else if (s) label = s;
			}
			if (auto) {
				setup.sceneRunnerExit();
				return;
			}
			jQuery(this.output).wiki('<<link "' + label.replace(/"/g, '\\"') + '">><<run setup.sceneRunnerExit()>><</link>>');
			return;
		}

		// Inline (or any other context): just clear scene variables
		sv.sceneInlineId = "";
		sv.sceneInlineMeta = null;
		sv.scenePayload = null;
		sv.sceneMode = "";
		sv.sceneId = "";
	}
});

if (!Macro.has("sceneReturn")) Macro.add("sceneReturn", {
	handler: function () {
		// alias for <<sceneDone>>
		jQuery(this.output).wiki('<<sceneDone>>');
	}
});

/* ============================================================================
   MEDIA PATCH (2 sizes + focus control + fullscreen lightbox)
   ----------------------------------------------------------------------------
   Что добавляет:
   - Макрос <<media>> для красивого отображения фото/видео/аудио
   - 2 фиксированных варианта рамки:
       ORIENT = "v" (portrait/вертикаль)  |  ORIENT = "h" (landscape/горизонталь)
   - Управление "центровкой"/фокусом через CSS object-position (POS аргумент)
   - Кнопка ⤢ открывает fullscreen lightbox (картинка/видео/аудио)

   Синтаксис:
     <<media SRC [CAPTION] [TYPE] [ORIENT] [POS] [FULLSRC] [FIT]>>

     SRC      : строка, обязательна. (картинка/видео/аудио или превью-картинка)
     CAPTION  : строка, подпись (можно SugarCube wiki-разметку), опционально
     TYPE     : "img" | "video" | "audio" (если пусто — определяется по расширению SRC)
     ORIENT   : "v" или "h" (по умолчанию "h")
     POS      : object-position, напр. "50% 20%" / "center top" / "20% 50%" (по умолчанию "50% 50%")
     FULLSRC  : опционально. Для случая "превью-картинка + полное видео/фото"
     FIT      : "cover" | "contain" (по умолчанию "cover")

   Примеры:
     <<media "images/girl.jpg" "Вертикальное фото" "" "v" "50% 20%">>
     <<media "images/room.jpg" "Горизонтальное" "" "h" "30% 50%">>
     <<media "video/thumb.jpg" "Видео" "video" "h" "50% 35%" "video/full.mp4">>
     <<media "images/tall.jpg" "Без кропа" "" "v" "50% 50%" "" "contain">>

   Подстройка размеров:
   - Меняй max-width и aspect-ratio в StoryStylesheet (см. блок MEDIA PATCH CSS)
   ============================================================================ */
(function () {
  "use strict";

  /* ---------- Helpers ---------- */

  function normStr(v) {
    return (v == null) ? "" : String(v);
  }

  function stripQuery(src) {
    return normStr(src).split("#")[0].split("?")[0];
  }

  function extOf(src) {
    const s = stripQuery(src);
    const i = s.lastIndexOf(".");
    return i >= 0 ? s.slice(i + 1).toLowerCase() : "";
  }

  function isImageExt(ext) {
    return ["jpg","jpeg","png","gif","webp","avif","bmp","svg"].includes(ext);
  }

  function isVideoExt(ext) {
    return ["mp4","webm","ogv","ogg"].includes(ext);
  }

  function isAudioExt(ext) {
    return ["mp3","wav","ogg","m4a","aac","flac","opus"].includes(ext);
  }

  function detectType(src, explicit) {
    const t = normStr(explicit).trim().toLowerCase();
    if (t) return t;

    const ext = extOf(src);
    if (isVideoExt(ext)) return "video";
    if (isAudioExt(ext)) return "audio";
    if (isImageExt(ext)) return "img";
    return "img";
  }

  /* ---------- Lightbox ---------- */

  function ensureLightbox() {
    if (document.getElementById("sc-lightbox")) return;

    // Один раз добавляем DOM-объект лайтбокса.
    const html = `
      <div id="sc-lightbox" class="sc-lightbox" aria-hidden="true">
        <button type="button" class="sc-lightbox__close" aria-label="Закрыть">×</button>
        <div class="sc-lightbox__inner" role="dialog" aria-modal="true"></div>
        <div class="sc-lightbox__caption"></div>
      </div>
    `;
    document.body.insertAdjacentHTML("beforeend", html);

    // Закрытие по клику на фон
    $(document).on("click", "#sc-lightbox", function (ev) {
      if (ev.target.id === "sc-lightbox") closeLightbox();
    });

    // Закрытие по кнопке
    $(document).on("click", ".sc-lightbox__close", function () {
      closeLightbox();
    });

    // Закрытие по ESC
    $(document).on("keydown", function (ev) {
      if (ev.key === "Escape") closeLightbox();
    });
  }

  function closeLightbox() {
    const $lb = $("#sc-lightbox");
    if (!$lb.length) return;

    // Останавливаем видео/аудио
    $lb.find("video,audio").each(function () {
      try { this.pause(); } catch (e) {}
      try { this.currentTime = 0; } catch (e) {}
    });

    $lb.attr("aria-hidden", "true").removeClass("is-open");
    $lb.find(".sc-lightbox__inner").empty();
    $lb.find(".sc-lightbox__caption").empty();
  }

  function openLightbox(payload) {
    ensureLightbox();

    const type = payload.type;
    const src  = payload.src;
    const cap  = payload.caption || "";
    const pos  = payload.pos || "50% 50%";
    const fit  = payload.fit || "contain"; // в fullscreen по умолчанию лучше contain

    const $lb = $("#sc-lightbox");
    const $inner = $lb.find(".sc-lightbox__inner");
    const $cap = $lb.find(".sc-lightbox__caption");

    $inner.empty();
    $cap.empty();

    if (type === "video") {
      const $v = $(`<video class="sc-lightbox__media" controls autoplay playsinline preload="metadata"></video>`);
      $v.attr("src", src);
      $v.css({ "object-position": pos, "object-fit": fit });
      $inner.append($v);
    } else if (type === "audio") {
      const $a = $(`<audio class="sc-lightbox__audio" controls autoplay></audio>`);
      $a.attr("src", src);
      $inner.append($a);
    } else {
      const $i = $(`<img class="sc-lightbox__media" alt="">`);
      $i.attr("src", src);
      $i.css({ "object-position": pos, "object-fit": fit });
      $inner.append($i);
    }

    if (cap) {
      // Разрешаем SugarCube wiki-разметку в подписи
      $cap.wiki(cap);
    }

    $lb.attr("aria-hidden", "false").addClass("is-open");
  }

  // Делегированный клик по кнопке "расширить" (работает в любом пассаже)
  $(document).on("click", ".sc-media__expand", function (ev) {
    ev.preventDefault();
    ev.stopPropagation();

    const $card = $(this).closest(".sc-media");
    const type = $card.attr("data-type");
    const full = $card.attr("data-full") || $card.attr("data-src") || "";
    const cap  = $card.attr("data-caption") || "";
    const pos  = $card.attr("data-pos") || "50% 50%";
    const fit  = $card.attr("data-fit") || "contain";

    if (!full) return;
    openLightbox({ type, src: full, caption: cap, pos, fit });
  });

  /* ---------- Macro: <<media>> ---------- */

  if (!Macro.has("media")) Macro.add("media", {
    handler() {
      const src = normStr(this.args[0]).trim();
      if (!src) return this.error("<<media>> требует SRC первым аргументом.");

      const caption = normStr(this.args[1]);
      const explicitType = normStr(this.args[2]);
      const orientRaw = normStr(this.args[3]).trim().toLowerCase();
      const pos = normStr(this.args[4]).trim() || "50% 50%";
      const fullSrcArg = normStr(this.args[5]).trim();
      const fit = (normStr(this.args[6]).trim().toLowerCase() || "cover");

      const type = detectType(src, explicitType);

      // ORIENT: v/h. Всё остальное считаем h.
      const orient = (orientRaw === "v" || orientRaw === "portrait") ? "v" : "h";

      // Что открывается в fullscreen (по умолчанию тот же src)
      const fullSrc = fullSrcArg || src;

      // Собираем карточку
      const $wrap = $(`<div class="sc-media sc-media--${orient}"></div>`);
      $wrap.attr({
        "data-type": type,
        "data-src": src,
        "data-full": fullSrc,
        "data-caption": caption,
        "data-pos": pos,
        "data-fit": fit
      });

      // Переменные для CSS
      $wrap.css({ "--pos": pos, "--fit": fit });

      // Audio: без рамки аспект-отношения
      if (type === "audio") {
        $wrap.addClass("sc-media--audio");
        const $audio = $(`<audio class="sc-media__audio" controls preload="metadata"></audio>`);
        $audio.attr("src", src);
        $wrap.append($audio);
      } else {
        // Frame фиксированного соотношения (vertical/horizontal)
        const $frame = $(`<div class="sc-media__frame"></div>`);
        $wrap.append($frame);

        if (type === "video") {
          const srcExt = extOf(src);
          const srcIsVideo = isVideoExt(srcExt);

          if (!srcIsVideo && fullSrc && stripQuery(fullSrc) !== stripQuery(src)) {
            // Сценарий: SRC — превью-картинка, FULLSRC — реальный mp4/webm
            const $img = $(`<img class="sc-media__el" alt="">`);
            $img.attr("src", src);
            $img.css({ "object-position": pos, "object-fit": fit });
            $frame.append($img);
            $wrap.addClass("sc-media--hasThumb");
          } else {
            // SRC — само видео: показываем "живое" превью (loop, muted)
            const $vid = $(`<video class="sc-media__el" muted loop playsinline preload="metadata"></video>`);
            $vid.attr("src", src);
            $vid.css({ "object-position": pos, "object-fit": fit });
            $frame.append($vid);

            // Пытаемся запустить превью (браузер может запретить, но muted обычно разрешает)
            setTimeout(() => { try { $vid[0].play(); } catch (e) {} }, 0);
          }
        } else {
          // Image
          const $img = $(`<img class="sc-media__el" alt="">`);
          $img.attr("src", src);
          $img.css({ "object-position": pos, "object-fit": fit });
          $frame.append($img);
        }

        // Кнопка fullscreen
        const $btn = $(`<button type="button" class="sc-media__expand" aria-label="Открыть на весь экран">⤢</button>`);
        $frame.append($btn);
      }

      // Подпись
      if (caption) {
        const $cap = $(`<div class="sc-media__caption"></div>`);
        $cap.wiki(caption);
        $wrap.append($cap);
      }

      $wrap.appendTo(this.output);
    }
  });

/* =====================================================================
   FANS + MATCH: ОТДЕЛЬНЫЕ СИСТЕМЫ СООБЩЕНИЙ (НЕ $messages)
   ---------------------------------------------------------------------
   Зачем:
   - OnlyFans (Fans) и Tinder (Match) имеют свои "Inbox/Chat"
   - Не мешаемся с обычным приложением Messages
   - Медиа из этих чатов добавляется в Gallery NPC -> можно ставить на обои
   ---------------------------------------------------------------------
   Быстрый старт (из пассажей):
     <<run setup.fansNpcSendText("npc_elly", "Hey 😏", 1)>>
     <<run setup.fansNpcSendMedia("npc_elly","PPV photo", 1, "fans_elly_ppv1", "src/img/wallpapers/wall1.jpg", "src/img/wallpapers/wall1.jpg", true)>>

     <<run setup.matchNpcSendText("npc_chloe", "So… coffee?", 1)>>
     <<run setup.matchRunSequence("npc_chloe", [
         {type:"npc", text:"Hey", typingDelay:1.0},
         {type:"choices", choices:[
            {id:"c1", label:"Sure", text:"Sure 😊", sequence:[{type:"npc", text:"Great! 7pm."}]},
            {id:"c2", label:"Maybe", text:"Maybe later", sequence:[{type:"npc", text:"Okay 😄"}]}
         ]}
     ])>>
   ===================================================================== */

/* -----------------------------
   helpers: init DM state
   ----------------------------- */
setup.ensureFansDmState = function () {
    setup.ensureFansAppState();
    var sv = State.variables;

    if (!sv.fansApp.dm || typeof sv.fansApp.dm !== "object") sv.fansApp.dm = {};
    if (typeof sv.fansApp.unread !== "number") sv.fansApp.unread = 0;

    // создаём пустые треды для всех доступных creators (по флагу apps.fans)
    var creators = setup.fansGetCreators ? setup.fansGetCreators() : [];
    creators.forEach(function (c) {
        var npcId = c && c.npcId;
        if (!npcId) return;
        if (!sv.fansApp.dm[npcId]) {
            sv.fansApp.dm[npcId] = {
                previewText: "",
                unread     : 0,
                typing     : false,
                thread     : []
            };
        }
    });
};

setup.ensureMatchDmState = function () {
    setup.ensureMatchAppState();
    var sv = State.variables;

    if (!sv.matchApp.dm || typeof sv.matchApp.dm !== "object") sv.matchApp.dm = {};
    if (typeof sv.matchApp.unread !== "number") sv.matchApp.unread = 0;

    var matchedIds = Object.keys(sv.matchApp.matches || {});
    matchedIds.forEach(function (npcId) {
        if (!setup.npcHasAppFlag(npcId, "match")) return;
        if (!sv.matchApp.dm[npcId]) {
            sv.matchApp.dm[npcId] = {
                previewText: "",
                unread     : 0,
                typing     : false,
                thread     : []
            };
        }
    });
};

/* Typing helpers for Fans/Match (UI only) */
setup.fansSetTyping = function (npcId, on, durationMs, text) {
	setup.ensureFansDmState();
	var sv = State.variables;
	if (!npcId || !sv.fansApp || !sv.fansApp.dm) return;
	var dm = sv.fansApp.dm[npcId];
	if (!dm) return;

	on = !!on;
	dm.typing = on;
	dm.typingText = text || "typing…";

	// presence
	if (on) setup.phoneMarkNpcOnline(dm, (durationMs && Number(durationMs)>0) ? (Number(durationMs)+20000) : 45000);

	if (dm._typingTimer) {
		window.clearTimeout(dm._typingTimer);
		dm._typingTimer = 0;
	}
	if (on && durationMs && Number(durationMs) > 0) {
		dm.typingUntil = Date.now() + Number(durationMs);
		dm._typingTimer = window.setTimeout(function () {
			dm.typing = false;
			dm.typingUntil = 0;
			dm.typingText = "";
			if (sv.phoneIsOpen && (sv.phoneScreen === "fansChat" || sv.phoneScreen === "fansInbox")) setup.phoneRender();
			if (setup.phoneRefreshMiniBubbles) setup.phoneRefreshMiniBubbles();
		}, Number(durationMs));
	} else {
		dm.typingUntil = 0;
	}

	if (sv.phoneIsOpen && (sv.phoneScreen === "fansChat" || sv.phoneScreen === "fansInbox")) setup.phoneRender();
	if (setup.phoneRefreshMiniBubbles) setup.phoneRefreshMiniBubbles();
};

setup.matchSetTyping = function (npcId, on, durationMs, text) {
	setup.ensureMatchDmState();
	var sv = State.variables;
	if (!npcId || !sv.matchApp || !sv.matchApp.dm) return;
	var dm = sv.matchApp.dm[npcId];
	if (!dm) return;

	on = !!on;
	dm.typing = on;
	dm.typingText = text || "typing…";

	// presence
	if (on) setup.phoneMarkNpcOnline(dm, (durationMs && Number(durationMs)>0) ? (Number(durationMs)+20000) : 45000);

	if (dm._typingTimer) {
		window.clearTimeout(dm._typingTimer);
		dm._typingTimer = 0;
	}
	if (on && durationMs && Number(durationMs) > 0) {
		dm.typingUntil = Date.now() + Number(durationMs);
		dm._typingTimer = window.setTimeout(function () {
			dm.typing = false;
			dm.typingUntil = 0;
			dm.typingText = "";
			if (sv.phoneIsOpen && (sv.phoneScreen === "matchChat" || sv.phoneScreen === "matchInbox")) setup.phoneRender();
			if (setup.phoneRefreshMiniBubbles) setup.phoneRefreshMiniBubbles();
		}, Number(durationMs));
	} else {
		dm.typingUntil = 0;
	}

	if (sv.phoneIsOpen && (sv.phoneScreen === "matchChat" || sv.phoneScreen === "matchInbox")) setup.phoneRender();
	if (setup.phoneRefreshMiniBubbles) setup.phoneRefreshMiniBubbles();
};


/* ------------------------------------------------------
   Typing chance/timing + NPC presence ("online / last seen")
   ------------------------------------------------------ */
setup.phoneTypingConfig = setup.phoneTypingConfig || {
	enabled      : true,
	chance       : 0.45,   // probability to show typing before NPC message
	minDurMs     : 600,
	maxDurMs     : 2200,
	minLeadMs    : 200,    // how long BEFORE delivery typing stops (to feel natural)
	maxLeadMs    : 900,
	minDelayMs   : 500     // don't bother if delivery is almost instant
};

setup._randInt = setup._randInt || function (a, b) {
	a = Math.floor(Number(a || 0));
	b = Math.floor(Number(b || 0));
	if (b < a) { var t = a; a = b; b = t; }
	return a + Math.floor(Math.random() * (b - a + 1));
};

setup._clamp = setup._clamp || function (v, lo, hi) {
	v = Number(v);
	if (!isFinite(v)) v = 0;
	if (v < lo) v = lo;
	if (v > hi) v = hi;
	return v;
};

setup.phoneMarkNpcOnline = function (dm, ms) {
	if (!dm) return;
	var now = Date.now();
	dm.npcLastSeen = now;
	ms = Number(ms || 45000);
	if (!isFinite(ms) || ms < 5000) ms = 45000;
	dm.npcOnlineUntil = now + ms;
};

setup.phoneFormatLastSeen = function (ts) {
	ts = Number(ts || 0);
	if (!isFinite(ts) || ts <= 0) return "";
	var diff = Date.now() - ts;
	if (diff < 0) diff = 0;

	var sec = Math.floor(diff / 1000);
	if (sec < 60) return "last seen just now";

	var min = Math.floor(sec / 60);
	if (min < 60) return "last seen " + min + "m ago";

	var hr = Math.floor(min / 60);
	if (hr < 24) return "last seen " + hr + "h ago";

	var d = Math.floor(hr / 24);
	if (d === 1) return "last seen yesterday";
	return "last seen " + d + "d ago";
};

setup.phoneScheduleNpcTyping = function (app, npcId, delaySeconds, typingTextOverride) {
	var cfg = setup.phoneTypingConfig || {};
	if (!cfg.enabled) return;

	var totalMs = Math.floor(Number(delaySeconds || 0) * 1000);
	if (!isFinite(totalMs) || totalMs < cfg.minDelayMs) return;

	if (Math.random() > Number(cfg.chance || 0)) return;

	var dur = setup._randInt(cfg.minDurMs, cfg.maxDurMs);
	var lead = setup._randInt(cfg.minLeadMs, cfg.maxLeadMs);

	// ensure typing fits into delivery window
	dur = setup._clamp(dur, cfg.minDurMs, Math.max(cfg.minDurMs, totalMs - lead));
	var startMs = Math.max(0, totalMs - lead - dur);

	window.setTimeout(function () {
		if (app === "fans" && typeof setup.fansSetTyping === "function") {
			setup.fansSetTyping(npcId, true, dur, typingTextOverride || "typing…");
		}
		if (app === "match" && typeof setup.matchSetTyping === "function") {
			setup.matchSetTyping(npcId, true, dur, typingTextOverride || "typing…");
		}
	}, startMs);
};


/* ------------------------------------------------------
   Unified event hooks (no eval)
   - JS can emit: setup.emitGameEvent("buy", {...})
   - Authors can subscribe from passages:
       <<onEvent "buy" "Service_OnBuy">>
     Service passage can read:
       $eventType / $eventData
   ------------------------------------------------------ */
setup.GAME_EVENT_TYPES = setup.GAME_EVENT_TYPES || {
	buy            : "Purchase completed",
	delivery       : "Order delivered",
	ppvUnlock      : "PPV unlocked (Fans DM)",
	messageReceived: "Incoming message received",
	playerReply    : "Player replied (choice/quick reply)",
	gift           : "Gifted item to NPC",
	questStart     : "Quest started",
	questComplete  : "Quest completed",
	unlock         : "Achievement unlocked"
};

setup.emitGameEvent = function (type, data) {
	type = String(type || "").trim();
	if (!type) return;

	var sv = State.variables;
	if (!Array.isArray(sv.gameEventLog)) sv.gameEventLog = [];
	if (!sv.gameEventHandlers || typeof sv.gameEventHandlers !== "object" || Array.isArray(sv.gameEventHandlers)) sv.gameEventHandlers = {};

	var evt = {
		type : type,
		data : (data && typeof data === "object") ? data : { value: data },
		stamp: setup.phoneGetStamp ? setup.phoneGetStamp() : Date.now()
	};

	sv.gameEventLog.push(evt);
	// cap log
	if (sv.gameEventLog.length > 120) sv.gameEventLog = sv.gameEventLog.slice(-120);

	var handlers = sv.gameEventHandlers[type];
	if (!Array.isArray(handlers) || !handlers.length) return;

	// expose to service passages
	sv.eventType = evt.type;
	sv.eventData = evt.data;

	handlers.forEach(function (passageName) {
		passageName = String(passageName || "").trim();
		if (!passageName) return;
		try {
			var el = document.createElement("div");
			el.style.display = "none";
			document.body.appendChild(el);
			new Wikifier(el, '<<include "' + passageName.replace(/"/g, '\\"') + '">>');
			document.body.removeChild(el);
		} catch (e) {
			// ignore
		}
	});
};


/* ------------------------------------------------------
   Quick replies (templates) for Fans/Match chats
   ------------------------------------------------------ */
setup.phoneQuickReplies = setup.phoneQuickReplies || {
	fans : ["👍", "OK", "Later", "😍"],
	match: ["Hey 😊", "How are you?", "Tell me about you", "😉"]};

setup.fansSendQuickReply = function (npcId, text) {
	setup.ensureFansDmState();
	var sv = State.variables;
	if (!npcId || !sv.fansApp || !sv.fansApp.dm || !sv.fansApp.dm[npcId]) return;

	var dm = sv.fansApp.dm[npcId];
	dm.thread.push({
		from  : "player",
		text  : String(text || ""),
		type  : "text",
		time  : setup.phoneGetTimeLabel(),
		status: "sent"
	});
	dm.previewText = String(text || "");
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();

	// event hook
	setup.emitGameEvent("playerReply", { app: "fans", npcId: String(npcId), text: String(text || "") });
};

setup.matchSendQuickReply = function (npcId, text) {
	setup.ensureMatchDmState();
	var sv = State.variables;
	if (!npcId || !sv.matchApp || !sv.matchApp.dm || !sv.matchApp.dm[npcId]) return;

	var dm = sv.matchApp.dm[npcId];
	dm.thread.push({
		from  : "player",
		text  : String(text || ""),
		type  : "text",
		time  : setup.phoneGetTimeLabel(),
		status: "sent"
	});
	dm.previewText = String(text || "");
	if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();

	// event hook
	setup.emitGameEvent("playerReply", { app: "match", npcId: String(npcId), text: String(text || "") });
};

/* -----------------------------
   helper: add media to NPC Gallery (wallpapers)
   Added when user OPENS media in Fans/Match chats OR when PPV is unlocked.
   ----------------------------- */
setup.phoneAddMediaToNpcGallery = function (npcId, media) {
    var sv = State.variables;
    if (!npcId || !media || typeof media !== "object") return;
    if (!sv.npcs || !sv.npcs[npcId]) return;

    var st = sv.npcs[npcId];
    if (!Array.isArray(st.gallery)) st.gallery = [];

    var id = media.id || ("media_" + Date.now());
    var exists = st.gallery.some(function (m) { return m && m.id === id; });
    if (exists) return;

    st.gallery.push({
        id          : id,
        thumb       : media.thumb || "",
        full        : media.full || "",
        canWallpaper: !!media.canWallpaper,
        ts          : (media.ts || Date.now()),
        kind        : (media.kind || media.type || ""),
        isPPV       : !!(media.isPPV || media.ppv || (typeof id === "string" && /ppv/i.test(id)) || (typeof media.source === "string" && /ppv/i.test(media.source))),
        source      : (media.source || "unlock")
    });
};

/* -----------------------------
   helper: render media preview inside phone chat bubbles
   Uses the same .sc-media + .sc-media__expand lightbox handler you already have.
   Also stores media into NPC Gallery when user clicks expand (see bindings below).
   ----------------------------- */
setup._phoneRenderChatMedia = function (npcId, media, type, caption) {
    if (!media) return "";
    var sv = State.variables;
    var esc = setup.escapeHtml;

    var t = type || "image";
    var src = media.thumb || media.full || "";
    var full = media.full || media.thumb || "";
    var cap = caption || "";
    var pos = media.pos || "50% 50%";
    var fitPrev = media.fit || "contain";
    var fitFull = media.fitFull || fitPrev;
    var orient = (media.orient === "v" || media.orient === "portrait") ? "v" : "h";

    var html = '';
    html += '<div class="sc-media sc-media--' + esc(orient) + ' phone-chat-media" ' +
        'data-type="' + esc(t) + '" ' +
        'data-src="' + esc(src) + '" ' +
        'data-full="' + esc(full) + '" ' +
        'data-caption="' + esc(cap) + '" ' +
        'data-pos="' + esc(pos) + '" ' +
        'data-fit="' + esc(fitFull) + '" ' +
        'data-gallery-npc-id="' + esc(npcId) + '" ' +
        'data-gallery-media-id="' + esc(media.id || "") + '" ' +
        'data-gallery-thumb="' + esc(media.thumb || "") + '" ' +
        'data-gallery-full="' + esc(media.full || "") + '" ' +
        'data-gallery-wallpaper="' + (media.canWallpaper ? '1' : '0') + '"' +
        '>';

    html += '  <div class="sc-media__frame">';
    // we render as image preview (even if it's video thumb)
    html += '    <img class="sc-media__el" alt="" src="' + esc(src) + '" style="object-position:' + esc(pos) + ';object-fit:' + esc(fitPrev) + ';">';
    html += '    <button type="button" class="sc-media__expand" aria-label="Открыть на весь экран">⤢</button>';
    html += '  </div>';
    html += '</div>';

    return html;
};


/* -----------------------------
   Fans PPV (locked DM) state + unlock
   ----------------------------- */
setup.fansIsPPVUnlocked = function (npcId, ppvId) {
    setup.ensureFansAppState();
    var sv = State.variables;
    if (!sv.fansApp.ppvUnlocked || typeof sv.fansApp.ppvUnlocked !== "object") sv.fansApp.ppvUnlocked = {};
    if (!sv.fansApp.ppvUnlocked[npcId] || typeof sv.fansApp.ppvUnlocked[npcId] !== "object") return false;
    return !!sv.fansApp.ppvUnlocked[npcId][ppvId];
};

setup.fansUnlockPPV = function (npcId, ppvId) {
    setup.ensureFansDmState();
    setup.ensureFansAppState();
    var sv = State.variables;

    if (!sv.fansApp.ppvUnlocked || typeof sv.fansApp.ppvUnlocked !== "object") sv.fansApp.ppvUnlocked = {};
    if (!sv.fansApp.ppvUnlocked[npcId] || typeof sv.fansApp.ppvUnlocked[npcId] !== "object") sv.fansApp.ppvUnlocked[npcId] = {};

    if (sv.fansApp.ppvUnlocked[npcId][ppvId]) return; // already

    var dm = sv.fansApp.dm && sv.fansApp.dm[npcId];
    if (!dm) return;

    // find message with this ppvId
    var msg = dm.thread.find(function (m) { return m && m.type === "ppv" && m.ppv && m.ppv.id === ppvId; });
    if (!msg || !msg.ppv) return;

    var price = (typeof msg.ppv.price === "number") ? msg.ppv.price : 0;
    if (price > 0) {
        if (sv.fansApp.coins < price) {
            if (setup.toast) setup.toast("Not enough coins", "warn", 2200);
            return;
        }
        sv.fansApp.coins -= price;
    }

    sv.fansApp.ppvUnlocked[npcId][ppvId] = true;
    msg.ppv.unlocked = true;

    // update preview text in inbox to unlocked text (if provided)
    if (msg.ppv.text) dm.previewText = msg.ppv.text;

    // If PPV has media -> add to Gallery now (counts as "opened/unlocked")
    if (msg.ppv.media) {
        setup.phoneAddMediaToNpcGallery(npcId, msg.ppv.media);
    }

    // Unified event hook (ppvUnlock)
    setup.emitGameEvent("ppvUnlock", { npcId: String(npcId), ppvId: String(ppvId), price: Number(price||0), hasMedia: !!msg.ppv.media });

    if (setup.toast) setup.toast("PPV unlocked", "success", 1800);
    if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

/* convenience: send PPV to Fans DM (locked message) */
setup.fansNpcSendPPV = function (npcId, previewText, delaySeconds, ppvId, price, fullText, mediaId, thumbPath, fullPath, canWallpaper) {
    delaySeconds = delaySeconds || 0;
    setup.ensureFansDmState();
    var sv = State.variables;
    var dm = sv.fansApp.dm[npcId];
    if (!dm) return;

    // typing is cosmetic; schedule it with chance/timing
    dm.typing = false;
    dm.typingUntil = 0;
    dm.typingText = "";
    setup.phoneScheduleNpcTyping("fans", npcId, delaySeconds);
    if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();

    window.setTimeout(function () {
        setup.ensureFansDmState();
        var sv2 = State.variables;
        var dm2 = sv2.fansApp.dm[npcId];
        if (!dm2) return;
        dm2.typing = false;
        dm2.typingUntil = 0;
        dm2.typingText = "";

        setup._fansAddNpcMessage(npcId, previewText || "🔒 PPV", {
            type: "ppv",
            ppv: {
                id   : ppvId || ("ppv_" + Date.now()),
                price: (typeof price === "number") ? price : 0,
                text : fullText || "",
                media: (mediaId || thumbPath || fullPath) ? {
                    id          : mediaId || ("ppv_media_" + Date.now()),
                    thumb       : thumbPath || "",
                    full        : fullPath || thumbPath || "",
                    canWallpaper: (canWallpaper !== false)
                } : null
            }
        });
    }, delaySeconds * 1000);
};


/* ------------------------------------------------------
   add NPC message (+ add media to NPC Gallery)
   ------------------------------------------------------ */
setup._fansAddNpcMessage = function (npcId, text, opts) {
    opts = opts || {};
    setup.ensureFansDmState();
    var sv = State.variables;
    var dm = sv.fansApp.dm[npcId];
    if (!dm) return;

	// presence
	setup.phoneMarkNpcOnline(dm, 45000);

    // message id (stable reference for PPV unlock etc.)
    var msgId = opts.id || ("fans_msg_" + Date.now() + "_" + Math.floor(Math.random() * 1e9));

    var msg = {
        id  : msgId,
        from: "npc",
        text: text,
        type: opts.type || "text",
        time: setup.phoneGetTimeLabel(),
        day : setup.phoneGetDayCounter(),
        stamp: setup.phoneGetStamp()
    };

    // attach media (preview will be rendered in chat; wallpaper gets added on OPEN)
    if (opts.media && typeof opts.media === "object") {
        msg.media = {
            id          : opts.media.id || ("fans_media_" + Date.now()),
            thumb       : opts.media.thumb || opts.media.thumbPath || opts.media.path || "",
            full        : opts.media.full  || opts.media.fullPath  || opts.media.path || "",
            canWallpaper: !!opts.media.canWallpaper
        };
        if (msg.type === "text") msg.type = "media";
    }

    // PPV (locked DM)
    if (opts.ppv && typeof opts.ppv === "object") {
        msg.type = "ppv";
        msg.ppv = {
            id    : opts.ppv.id || ("fans_ppv_" + Date.now()),
            price : (typeof opts.ppv.price === "number") ? opts.ppv.price : 0,
            text  : opts.ppv.text || "",          // full text after unlock
            unlocked : false
        };
        if (opts.ppv.media && typeof opts.ppv.media === "object") {
            msg.ppv.media = {
                id          : opts.ppv.media.id || ("fans_ppv_media_" + Date.now()),
                thumb       : opts.ppv.media.thumb || "",
                full        : opts.ppv.media.full || "",
                canWallpaper: !!opts.ppv.media.canWallpaper
            };
        }
    }

    dm.thread.push(msg);

	// event hook: incoming message
	if (typeof setup.emitGameEvent === "function") {
		setup.emitGameEvent("messageReceived", { app: "fans", npcId: String(npcId), message: msg });
	}
    dm.lastStamp = msg.stamp;

    // preview text in inbox
    if (msg.type === "ppv" && msg.ppv && !msg.ppv.unlocked) {
        dm.previewText = "🔒 " + (text || "PPV");
    } else {
        dm.previewText = text;
    }

    // unread if chat not open
    var chatOpen = ($("#phone-overlay").hasClass("visible") &&
        sv.phoneScreen === "fansChat" &&
        sv.phoneScreenData && sv.phoneScreenData.npcId === npcId);

    if (!chatOpen) {
        var prevUnread = dm.unread || 0;
        dm.unread = prevUnread + 1;
        sv.fansApp.unread = (sv.fansApp.unread || 0) + 1;

        // refresh mini-phone notifications
        setup.phoneRefreshMiniNotifs();
        setup.phoneRefreshMiniBubbles();

        // mini iOS-like banner + notification log
        var title = setup.phoneGetNpcName ? setup.phoneGetNpcName(npcId) : "Fans";
        var snippet = dm.previewText || text || "New message";
        setup.phoneMiniNotify("fans", npcId, title, setup.phoneMiniShort ? setup.phoneMiniShort(snippet, 60) : snippet, { silent: false });

        // iOS-like haptic (only when thread becomes unread)
        if (prevUnread === 0) setup.phoneMiniVibrate();
    } else {
        dm.unread = 0;
    }

    if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

setup._matchAddNpcMessage = function (npcId, text, opts) {
    opts = opts || {};
    setup.ensureMatchDmState();
    var sv = State.variables;
    var dm = sv.matchApp.dm[npcId];
    if (!dm) return;

	// presence
	setup.phoneMarkNpcOnline(dm, 45000);

    var msgId = opts.id || ("match_msg_" + Date.now() + "_" + Math.floor(Math.random() * 1e9));

    var msg = {
        id  : msgId,
        from: "npc",
        text: text,
        type: opts.type || "text",
        time: setup.phoneGetTimeLabel(),
        day : setup.phoneGetDayCounter(),
        stamp: setup.phoneGetStamp()
    };

    if (opts.media && typeof opts.media === "object") {
        msg.media = {
            id          : opts.media.id || ("match_media_" + Date.now()),
            thumb       : opts.media.thumb || opts.media.thumbPath || opts.media.path || "",
            full        : opts.media.full  || opts.media.fullPath  || opts.media.path || "",
            canWallpaper: !!opts.media.canWallpaper
        };
        if (msg.type === "text") msg.type = "media";
    }

    dm.thread.push(msg);

	// event hook: incoming message
	if (typeof setup.emitGameEvent === "function") {
		setup.emitGameEvent("messageReceived", { app: "match", npcId: String(npcId), message: msg });
	}
    dm.lastStamp = msg.stamp;
    dm.previewText = text;

    var chatOpen = ($("#phone-overlay").hasClass("visible") &&
        sv.phoneScreen === "matchChat" &&
        sv.phoneScreenData && sv.phoneScreenData.npcId === npcId);

    if (!chatOpen) {
        var prevUnread = dm.unread || 0;
        dm.unread = prevUnread + 1;
        sv.matchApp.unread = (sv.matchApp.unread || 0) + 1;

        // refresh mini-phone notifications
        setup.phoneRefreshMiniNotifs();
        setup.phoneRefreshMiniBubbles();

        // mini iOS-like banner + notification log
        var title = setup.phoneGetNpcName ? setup.phoneGetNpcName(npcId) : "Match";
        var snippet = dm.previewText || text || "New message";
        setup.phoneMiniNotify("match", npcId, title, setup.phoneMiniShort ? setup.phoneMiniShort(snippet, 60) : snippet, { silent: false });

        // iOS-like haptic (only when thread becomes unread)
        if (prevUnread === 0) setup.phoneMiniVibrate();
    } else {
        dm.unread = 0;
    }

    if ($("#phone-overlay").hasClass("visible")) setup.phoneRender();
};

