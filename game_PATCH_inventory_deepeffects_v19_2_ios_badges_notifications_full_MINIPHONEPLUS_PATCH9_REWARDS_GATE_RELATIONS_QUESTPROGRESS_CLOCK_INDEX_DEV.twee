	// Messages: WhatsApp-like search (без перерендера, чтобы не терять фокус)
	$content.find("[data-msg-search]").off("input.msgSearch").on("input.msgSearch", function () {
		var raw = $(this).val() || "";
		var q = String(raw).toLowerCase().trim();
		State.variables.messagesSearch = raw;

		// фильтруем элементы списка
		$content.find(".wa-chatrow[data-search]").each(function () {
			var hay = String($(this).attr("data-search") || "").toLowerCase();
			var ok = (!q || hay.indexOf(q) !== -1);
			$(this).toggle(ok);
		});

		// "no matches"
		var any = $content.find(".wa-chatrow:visible").length > 0;
		$content.find(".wa-empty-search").toggle(!any && !!q);
	});

	$content.find("[data-msg-search-clear]").off("click.msgSearchClear").on("click.msgSearchClear", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		State.variables.messagesSearch = "";
		var $inp = $content.find("[data-msg-search]");
		$inp.val("");
		$inp.trigger("input");
	});

	// применяем фильтр после отрисовки (если что-то уже сохранено в $messagesSearch)
	window.setTimeout(function () {
		var $inp = $content.find("[data-msg-search]");
		if ($inp.length) $inp.trigger("input");
	}, 0);


	// Contacts: search filter (без перерендера)
	$content.find("[data-ct-search]").off("input.ctSearch").on("input.ctSearch", function () {
		var raw = $(this).val() || "";
		var q = String(raw).toLowerCase().trim();
		State.variables.contactsSearch = raw;

		$content.find(".ct-row[data-search]").each(function () {
			var hay = String($(this).attr("data-search") || "").toLowerCase();
			var ok = (!q || hay.indexOf(q) !== -1);
			$(this).toggle(ok);
		});

		// прячем пустые группы A/B/C… когда включён поиск
		$content.find(".ct-group").each(function () {
			var $g = $(this);
			var anyInGroup = $g.find(".ct-row:visible").length > 0;
			$g.toggle(!q || anyInGroup);
			$g.prev(".ct-letter").toggle(!q || anyInGroup);
		});

		var any = $content.find(".ct-row:visible").length > 0;
		// если в DOM нет .ct-row (например, контактов нет) — не мешаем
		$content.find(".ct-empty-search").toggle(!any && !!q);
	});

	$content.find("[data-ct-search-clear]").off("click.ctSearchClear").on("click.ctSearchClear", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		State.variables.contactsSearch = "";
		var $inp = $content.find("[data-ct-search]");
		$inp.val("");
		$inp.trigger("input");
	});

	// применяем фильтр после отрисовки (если что-то уже сохранено в $contactsSearch)
	window.setTimeout(function () {
		var $inp = $content.find("[data-ct-search]");
		if ($inp.length) $inp.trigger("input");
	}, 0);

	// Contacts profile: quick actions
	$content.find("[data-ct-open][data-npc-id]").off("click.ctOpen").on("click.ctOpen", function (ev) {
		ev.preventDefault();
		ev.stopPropagation();
		var npcId = $(this).attr("data-npc-id");
		var target = $(this).attr("data-ct-open");
		if (!npcId || !target) return;

		switch (target) {
			case "messages":
				setup.phoneGo("messagesChat", { npcId: npcId });
				break;
			case "gallery":
				setup.phoneGo("galleryNpc", { npcId: npcId });
				break;
			case "fans":
				setup.phoneGo("fansCreator", { npcId: npcId });
				break;
			case "match":
				setup.phoneGo("matchChat", { npcId: npcId });
				break;
		}
	});


  
  

	// галерея
	$content.find("[data-gallery-back]").off("click.galleryBack").on("click.galleryBack", function (ev) {
		ev.preventDefault();
		setup.phoneBack();
	});

	// (legacy) NPC-иконки, которые используются и в Contacts/Messages
	$content.find(".phone-npc-icon[data-npc-id]").off("click.npcIcon").on("click.npcIcon", function () {
		var npcId = $(this).attr("data-npc-id");
