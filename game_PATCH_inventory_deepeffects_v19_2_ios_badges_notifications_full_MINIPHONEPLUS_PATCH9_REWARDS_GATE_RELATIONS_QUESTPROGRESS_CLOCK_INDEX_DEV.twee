			if (r.effects && typeof setup.applyEffects === "function") {
				safe(function () { setup.applyEffects(r.effects, Object.assign({ kind: "rewardEffects" }, ctx)); }, "effects");
				continue;
			}
		}

		if (typeof setup.emitGameEvent === "function") {
			try { setup.emitGameEvent("rewardsApplied", { applied: applied, errors: errors, ctx: ctx }); } catch (e) {}
		}
		return { ok: errors.length === 0, applied: applied, errors: errors };
	};

