	// ------------------------------
	// SCENE GATE 2.0 (with reasons)
	// ------------------------------
	setup.canSeeContent = function (rule, ctx) {
		ctx = (ctx && typeof ctx === "object") ? ctx : {};
		var reasons = [];
		var ok = true;

		function fail(r) { ok = false; if (r) reasons.push(String(r)); }
		function arr(x) { return Array.isArray(x) ? x : (x == null ? [] : [x]); }

