:: Patch_V19_ContentGate2_RelLevels_Planner_Unlocks [script]
(function () {
	"use strict";

	// ------------------------------------------------------------
	// Patch guard
	// ------------------------------------------------------------
	setup.__patches = setup.__patches || {};
	var KEY = "v19_contentgate2_rellevels_planner_unlocks";
	if (setup.__patches[KEY]) return;
	setup.__patches[KEY] = true;

	// Small helpers
	function _sv() { return State && State.variables ? State.variables : {}; }
	function _has(obj, k) { return obj && Object.prototype.hasOwnProperty.call(obj, k); }
	function _arr(x) { return Array.isArray(x) ? x : (x == null ? [] : [x]); }
	function _num(x, d) { x = Number(x); return (isFinite(x) ? x : (d === undefined ? 0 : d)); }
	function _nowDay() { var sv = _sv(); return (typeof sv.dayCounter === "number") ? sv.dayCounter : 0; }

	// ============================================================
	// 1) Content Flags 2.0 (Sensitive tags + Feature flags)
	// ============================================================
	setup.contentFeatureCatalog = setup.contentFeatureCatalog || {}; // optional: define { key:{label,default} } in AUTOGEN later

	setup.ensureContentFeaturesState = function () {
		var sv = _sv();
		if (!sv.contentFeatures || typeof sv.contentFeatures !== "object") sv.contentFeatures = {};
		return sv.contentFeatures;
	};

	setup.isFeatureEnabled = function (key, defaultValue) {
		key = String(key || "");
		if (!key) return true;
		var f = setup.ensureContentFeaturesState();

		if (_has(f, key)) return !!f[key];

		var cat = setup.contentFeatureCatalog && setup.contentFeatureCatalog[key];
		if (cat && typeof cat.default === "boolean") return !!cat.default;

		return (defaultValue === undefined) ? true : !!defaultValue;
	};

	setup.setFeatureEnabled = function (key, value) {
		key = String(key || "");
		if (!key) return false;
		var f = setup.ensureContentFeaturesState();
		f[key] = !!value;
		return f[key];
	};
	setup.enableFeature  = function (key) { return setup.setFeatureEnabled(key, true); };
	setup.disableFeature = function (key) { return setup.setFeatureEnabled(key, false); };
	setup.toggleFeature  = function (key) { return setup.setFeatureEnabled(key, !setup.isFeatureEnabled(key, true)); };

	// Packages (optional). Only applies sensitive settings if content isn't locked yet.
	setup.contentPackages = setup.contentPackages || {
		safe: { label: "Safe", settings: { trans: false, nsfw: false, futa: false, violence: true }, features: {} },
		all : { label: "All",  settings: { trans: true,  nsfw: true,  futa: true,  violence: true }, features: {} }
	};

	setup.applyContentPackage = function (pkgId) {
		var pkg = setup.contentPackages && setup.contentPackages[String(pkgId || "")];
		if (!pkg) return false;

		var sv = _sv();
		sv.contentSettings = sv.contentSettings || {};

		// Sensitive settings can be locked after initial choice (your existing flow)
		var locked = !!sv.contentLocked;

		if (!locked && pkg.settings && typeof pkg.settings === "object") {
			Object.keys(pkg.settings).forEach(function (k) {
				sv.contentSettings[k] = !!pkg.settings[k];
			});
		}

		if (pkg.features && typeof pkg.features === "object") {
			var f = setup.ensureContentFeaturesState();
			Object.keys(pkg.features).forEach(function (k) {
				f[k] = !!pkg.features[k];
			});
		}

		return true;
	};

	// Extend existing setup.isContentAllowed to also gate feature flags.
	if (!setup.__isContentAllowed_v1 && typeof setup.isContentAllowed === "function") {
		setup.__isContentAllowed_v1 = setup.isContentAllowed;
	}

	setup.isContentAllowed = function (tags) {
		// normalize
		if (tags == null) return true;
		if (typeof tags === "string") tags = [tags];
		if (!Array.isArray(tags)) return true;
		if (tags.length === 0) return true;

		var catalog = setup.contentCatalog || {};
		var sens = [];
		var feat = [];

		for (var i = 0; i < tags.length; i++) {
