}
.phone-ebay.ebay-app .ebay-brand {
	font-weight: 900;
	letter-spacing: 0.4px;
	font-size: 14px;
}
.phone-ebay.ebay-app .ebay-top-actions {
	display: flex;
	align-items: center;
	gap: 6px;
}
.phone-ebay.ebay-app .ebay-iconbtn {
	border: none;
	background: rgba(255, 255, 255, 0.12);
	color: #fff;
	border-radius: 10px;
	padding: 4px 8px;
	cursor: pointer;
}

.phone-ebay.ebay-app .ebay-stock-badge {
	display: inline-block;
	padding: 2px 8px;
	border-radius: 999px;
	font-size: 10px;
	font-weight: 800;
	letter-spacing: 0.2px;
	margin-top: 6px;
	background: rgba(255, 255, 255, 0.14);
	border: 1px solid rgba(255, 255, 255, 0.16);
}
.phone-ebay.ebay-app .ebay-stock-badge.low {
	background: rgba(255, 200, 0, 0.20);
	border-color: rgba(255, 200, 0, 0.22);
}
.phone-ebay.ebay-app .ebay-stock-badge.soldout {
	background: rgba(255, 80, 80, 0.22);
	border-color: rgba(255, 80, 80, 0.24);
}
.phone-ebay.ebay-app .ebay-subbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	padding: 6px 10px;
	margin: 8px 0 10px;
	border-radius: 14px;
	background: rgba(0, 0, 0, 0.35);
}
.phone-ebay.ebay-app .ebay-list {
	display: flex;
	flex-direction: column;
	gap: 8px;
}
.phone-ebay.ebay-app .ebay-card {
	display: flex;
	align-items: stretch;
	justify-content: space-between;
	gap: 10px;
	padding: 10px;
	border-radius: 16px;
	background: rgba(255, 255, 255, 0.08);
	border: 1px solid rgba(255, 255, 255, 0.10);
}
.phone-ebay.ebay-app .ebay-card-title {
	font-weight: 800;
	margin-bottom: 4px;
}
.phone-ebay.ebay-app .ebay-card-desc {
	opacity: 0.9;
	font-size: 10px;
	margin-bottom: 6px;
}
.phone-ebay.ebay-app .ebay-card-meta {
	opacity: 0.95;
	font-size: 10px;
}
.phone-ebay.ebay-app .ebay-card-actions {
	display: flex;
	align-items: center;
	gap: 6px;
}
.phone-ebay.ebay-app .ebay-item {
	padding: 10px;
	border-radius: 18px;
	background: rgba(255, 255, 255, 0.08);
	border: 1px solid rgba(255, 255, 255, 0.10);
}
.phone-ebay.ebay-app .ebay-item-title {
	font-weight: 900;
	font-size: 14px;
	margin-bottom: 6px;
}
.phone-ebay.ebay-app .ebay-item-desc {
	opacity: 0.95;
	font-size: 10px;
	margin-bottom: 10px;
}
.phone-ebay.ebay-app .ebay-item-meta {
	opacity: 0.9;
	font-size: 10px;
	margin-bottom: 6px;
}
.phone-ebay.ebay-app .ebay-item-actions {
	margin-top: 10px;
}
.phone-ebay.ebay-app .ebay-badge {
	display: inline-block;
	padding: 2px 8px;
	border-radius: 999px;
	font-size: 10px;
	background: rgba(255, 255, 255, 0.14);
	border: 1px solid rgba(255, 255, 255, 0.14);
}
.phone-ebay.ebay-app .ebay-badge.delivered {
	background: rgba(0, 255, 160, 0.16);
	border-color: rgba(0, 255, 160, 0.18);
}
.phone-ebay.ebay-app .ebay-badge.shipping {
	background: rgba(255, 200, 0, 0.16);
	border-color: rgba(255, 200, 0, 0.18);
}
.phone-ebay.ebay-app .ebay-eta,
.phone-ebay.ebay-app .ebay-qty {
	opacity: 0.9;
	font-size: 10px;
}


/* --- eBay "real app" look (grid + thumbs + search) --- */
.phone-ebay.ebay-app {
	--ebayCardBg: rgba(255, 255, 255, 0.08);
	--ebayCardBorder: rgba(255, 255, 255, 0.12);
}
.phone-ebay.ebay-app .ebay-brandlogo {
	font-weight: 950;
	font-size: 18px;
	letter-spacing: -0.5px;
	line-height: 1;
}
.phone-ebay.ebay-app .ebay-brandlogo span { display: inline-block; }
.phone-ebay.ebay-app .ebay-brandlogo .l1 { color: #ff4d4d; }
.phone-ebay.ebay-app .ebay-brandlogo .l2 { color: #4da3ff; }
.phone-ebay.ebay-app .ebay-brandlogo .l3 { color: #ffd24d; }
.phone-ebay.ebay-app .ebay-brandlogo .l4 { color: #45d07a; }

.phone-ebay.ebay-app .ebay-top-actions {
	display: flex;
	align-items: center;
	gap: 8px;
}
.phone-ebay.ebay-app .ebay-cash {
	font-size: 10px;
	opacity: 0.95;
	padding: 4px 8px;
	border-radius: 999px;
	background: rgba(255,255,255,0.08);
	border: 1px solid rgba(255,255,255,0.10);
}
.phone-ebay.ebay-app .ebay-iconbtn {
	position: relative;
}

.phone-ebay.ebay-app .ebay-badge {
	position: absolute;
	top: -6px;
	right: -6px;
	min-width: 16px;
	height: 16px;
	padding: 0 4px;
	border-radius: 999px;
	font-size: 10px;
	font-weight: 800;
	line-height: 16px;
	text-align: center;
	background: rgba(255, 80, 80, 0.95);
	color: #111;
	border: 1px solid rgba(255,255,255,0.22);
}

.phone-ebay.ebay-app .ebay-search-row {
	display: flex;
	align-items: center;
	gap: 8px;
	margin: 8px 0 10px;
}
.phone-ebay.ebay-app .ebay-search {
	flex: 1;
	min-width: 0;
	padding: 8px 10px;
	border-radius: 16px;
	background: rgba(255,255,255,0.10);
	border: 1px solid rgba(255,255,255,0.12);
	color: #fff;
	font-size: 12px;
	outline: none;
}
.phone-ebay.ebay-app .ebay-search::placeholder {
	color: rgba(255,255,255,0.55);
}
.phone-ebay.ebay-app .ebay-clear {
	width: 34px;
	height: 34px;
	border-radius: 16px;
	background: rgba(255,255,255,0.10);
	border: 1px solid rgba(255,255,255,0.12);
	color: rgba(255,255,255,0.85);
	font-weight: 900;
}

.phone-ebay.ebay-app .ebay-chips {
	display: flex;
	align-items: center;
	gap: 6px;
	overflow-x: auto;
	padding-bottom: 2px;
	margin-bottom: 10px;
}
.phone-ebay.ebay-app .ebay-chip {
	white-space: nowrap;
	padding: 6px 10px;
	border-radius: 999px;
	background: rgba(255,255,255,0.07);
	border: 1px solid rgba(255,255,255,0.10);
	color: rgba(255,255,255,0.92);
	font-size: 11px;
}
.phone-ebay.ebay-app .ebay-chip.is-active {
	background: rgba(255,255,255,0.14);
	border-color: rgba(255,255,255,0.18);
}

.phone-ebay.ebay-app .ebay-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10px;
}
.phone-ebay.ebay-app .ebay-prod {
	background: var(--ebayCardBg);
	border: 1px solid var(--ebayCardBorder);
	border-radius: 18px;
	overflow: hidden;
	display: flex;
	flex-direction: column;
	cursor: pointer;
}
.phone-ebay.ebay-app .ebay-thumbwrap {
	width: 100%;
	aspect-ratio: 1 / 1;
	background: rgba(255,255,255,0.06);
}
.phone-ebay.ebay-app .ebay-thumb {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}
.phone-ebay.ebay-app .ebay-prod-body {
	padding: 10px;
	display: flex;
	flex-direction: column;
	gap: 6px;
	min-height: 118px;
}
.phone-ebay.ebay-app .ebay-prod-title {
	font-weight: 900;
	font-size: 12px;
	line-height: 1.15;
}
.phone-ebay.ebay-app .ebay-prod-desc {
	font-size: 10px;
	opacity: 0.85;
	line-height: 1.25;
}
.phone-ebay.ebay-app .ebay-prod-price {
	font-weight: 950;
	font-size: 13px;
	margin-top: 2px;
}
.phone-ebay.ebay-app .ebay-prod-meta {
	font-size: 10px;
	opacity: 0.8;
}
.phone-ebay.ebay-app .ebay-prod-actions {
	display: flex;
	gap: 6px;
	margin-top: auto;
}
.phone-ebay.ebay-app .ebay-mini-btn {
	flex: 1;
	padding: 7px 8px;
	border-radius: 14px;
	font-size: 11px;
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.08);
	color: rgba(255,255,255,0.92);
}
.phone-ebay.ebay-app .ebay-mini-primary {
	background: rgba(255,255,255,0.16);
	border-color: rgba(255,255,255,0.18);
	font-weight: 900;
}


.phone-ebay.ebay-app .ebay-mini-btn[disabled],
.phone-ebay.ebay-app .phone-btn[disabled] {
	opacity: 0.55;
	cursor: not-allowed;
	filter: saturate(0.8);
}

.phone-ebay.ebay-app .ebay-item-hero {
	border-radius: 18px;
	overflow: hidden;
	background: rgba(255,255,255,0.06);
	border: 1px solid rgba(255,255,255,0.10);
	margin-bottom: 10px;
}
.phone-ebay.ebay-app .ebay-item-img {
	width: 100%;
	display: block;
	aspect-ratio: 1 / 1;
	object-fit: cover;
}
.phone-ebay.ebay-app .ebay-item-title {
	font-weight: 950;
	font-size: 14px;
	margin-bottom: 6px;
}
.phone-ebay.ebay-app .ebay-item-price {
	font-weight: 950;
	font-size: 16px;
	margin: 10px 0 6px;
}
.phone-ebay.ebay-app .ebay-item-actions {
	display: flex;
	gap: 8px;
	margin: 10px 0 10px;
}
.phone-ebay.ebay-app .ebay-item-actions .phone-btn {
	flex: 1;
}
.phone-ebay.ebay-app .ebay-item-note {
	padding: 10px;
	border-radius: 16px;
	background: rgba(255,255,255,0.06);
	border: 1px solid rgba(255,255,255,0.10);
	font-size: 10px;
	opacity: 0.92;
}
.phone-ebay.ebay-app .ebay-note-row { margin-bottom: 6px; }
.phone-ebay.ebay-app .ebay-note-row:last-child { margin-bottom: 0; }

.phone-ebay.ebay-app .ebay-orders-head {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 10px;
	margin-bottom: 6px;
}
.phone-ebay.ebay-app .ebay-orders-title {
	font-weight: 950;
	font-size: 14px;
}
.phone-ebay.ebay-app .ebay-orders-count {
	font-size: 10px;
	opacity: 0.85;
}
.phone-ebay.ebay-app .ebay-orders-list {
	display: flex;
	flex-direction: column;
	gap: 8px;
}
.phone-ebay.ebay-app .ebay-order-row {
	display: flex;
	align-items: center;
	gap: 10px;
	padding: 10px;
	border-radius: 16px;
	background: var(--ebayCardBg);
	border: 1px solid var(--ebayCardBorder);
}
.phone-ebay.ebay-app .ebay-order-thumb {
	width: 46px;
	height: 46px;
	border-radius: 14px;
	overflow: hidden;
	background: rgba(255,255,255,0.06);
	flex: 0 0 auto;
	border: 1px solid rgba(255,255,255,0.10);
}
.phone-ebay.ebay-app .ebay-order-thumb img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}
.phone-ebay.ebay-app .ebay-order-title {
	font-weight: 900;
	font-size: 12px;
	line-height: 1.15;
}
.phone-ebay.ebay-app .ebay-order-qty {
	opacity: 0.85;
	font-weight: 800;
	font-size: 11px;
}
.phone-ebay.ebay-app .ebay-order-meta {
	font-size: 10px;
	opacity: 0.85;
	margin-top: 4px;
}



/* =========================================================
   Phone: Inventory app styles
   ========================================================= */
.phone-inv.inv-app .inv-topbar {
	display: flex;
	flex-direction: column;
	gap: 2px;
	margin-bottom: 8px;
}
.phone-inv.inv-app .inv-title {
	font-weight: 900;
	letter-spacing: 0.2px;
	font-size: 14px;
}
.phone-inv.inv-app .inv-meta {
	font-size: 11px;
	opacity: 0.85;
}

.phone-inv.inv-app .inv-subbar {
	margin-bottom: 8px;
}
.phone-inv.inv-app .inv-search {
	width: 100%;
	border: 1px solid rgba(0,0,0,0.12);
	background: rgba(255,255,255,0.9);
	border-radius: 10px;
	padding: 8px 10px;
	font-size: 12px;
	outline: none;
}
.phone-inv.inv-app .inv-search:focus {
	border-color: rgba(0,0,0,0.22);
}

.phone-inv.inv-app .inv-chips {
	display: flex;
	gap: 6px;
	flex-wrap: wrap;
	margin-bottom: 10px;
}
.phone-inv.inv-app .inv-chip {
	border: 1px solid rgba(0,0,0,0.12);
	background: rgba(255,255,255,0.85);
	color: rgba(0,0,0,0.85);
	border-radius: 999px;
	padding: 5px 9px;
	font-size: 11px;
	cursor: pointer;
}
.phone-inv.inv-app .inv-chip.active {
	background: rgba(0,0,0,0.88);
	color: #fff;
	border-color: rgba(0,0,0,0.88);
}

.phone-inv.inv-app .inv-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 10px;
}
.phone-inv.inv-app .inv-card {
	border: 1px solid rgba(0,0,0,0.10);
	background: rgba(255,255,255,0.92);
	border-radius: 14px;
	overflow: hidden;
	box-shadow: 0 6px 18px rgba(0,0,0,0.06);
	cursor: pointer;
}
.phone-inv.inv-app .inv-thumb {
	width: 100%;
	height: 92px;
	background-size: cover;
	background-position: center;
	background-color: rgba(0,0,0,0.08);
}
.phone-inv.inv-app .inv-card-body {
	padding: 8px 9px;
}
.phone-inv.inv-app .inv-card-title {
	font-weight: 800;
	font-size: 12px;
	line-height: 1.2;
	margin-bottom: 4px;
}
.phone-inv.inv-app .inv-card-desc {
	font-size: 10px;
	opacity: 0.78;
	line-height: 1.25;
	height: 26px;
	overflow: hidden;
}
.phone-inv.inv-app .inv-card-foot {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-top: 8px;
}
.phone-inv.inv-app .inv-qty {
	font-size: 11px;
	font-weight: 900;
	opacity: 0.9;
}
.phone-inv.inv-app .inv-actions {
	display: flex;
	align-items: center;
	gap: 6px;
}
.phone-inv.inv-app .inv-iconbtn {
	border: none;
	background: rgba(0,0,0,0.06);
	color: rgba(0,0,0,0.9);
	border-radius: 10px;
	padding: 6px 8px;
	font-size: 13px;
	line-height: 1;
	cursor: pointer;
}
.phone-inv.inv-app .inv-iconbtn:hover {
	background: rgba(0,0,0,0.10);
}

.phone-inv.inv-app .inv-empty {
	padding: 16px 10px;
	text-align: center;
	font-size: 12px;
	opacity: 0.8;
}

/* Item screen */
.phone-inv.inv-app .inv-item-hero {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;
	margin-bottom: 10px;
}
.phone-inv.inv-app .inv-item-img {
	width: 100%;
	height: 150px;
	border-radius: 14px;
	background-size: cover;
	background-position: center;
	background-color: rgba(0,0,0,0.08);
	border: 1px solid rgba(0,0,0,0.10);
}
.phone-inv.inv-app .inv-item-title {
	font-weight: 900;
	font-size: 14px;
}
.phone-inv.inv-app .inv-item-meta {
	font-size: 11px;
	opacity: 0.85;
}
.phone-inv.inv-app .inv-item-desc {
	font-size: 12px;
	line-height: 1.35;
	opacity: 0.92;
	margin-bottom: 12px;
}
.phone-inv.inv-app .inv-item-actions {
	display: flex;
	gap: 8px;
}
.phone-inv.inv-app .inv-item-actions .phone-btn {
	flex: 1;
}

/* Gift NPC list */
.phone-inv.inv-app .inv-gift-head {
	margin-bottom: 10px;
}
.phone-inv.inv-app .inv-gift-title {
	font-weight: 900;
	font-size: 13px;
	margin-bottom: 3px;
}
.phone-inv.inv-app .inv-gift-meta {
	font-size: 11px;
	opacity: 0.85;
}
.phone-inv.inv-app .inv-npc-list {
	display: flex;
	flex-direction: column;
	gap: 8px;
}
.phone-inv.inv-app .inv-npc {
	display: flex;
	align-items: center;
	gap: 10px;
	border: 1px solid rgba(0,0,0,0.10);
	background: rgba(255,255,255,0.92);
	border-radius: 14px;
	padding: 8px 10px;
	cursor: pointer;
}
.phone-inv.inv-app .inv-npc-icon {
	width: 36px;
	height: 36px;
	border-radius: 12px;
	object-fit: cover;
	border: 1px solid rgba(0,0,0,0.10);
	background: rgba(0,0,0,0.06);
}
.phone-inv.inv-app .inv-npc-name {
	font-weight: 900;
	font-size: 12px;
}
.phone-inv.inv-app .inv-npc-sub {
	font-size: 10px;
	opacity: 0.75;
	margin-top: 2px;
}


/* =========================================================
   Phone: Fans + Match app styles
   ========================================================= */
.phone-fans .phone-fans-top {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	margin-bottom: 10px;
}

.phone-fans-balance {
	font-size: 12px;
	opacity: 0.9;
}

.phone-fans-addcoins {
	border: 1px solid rgba(255,255,255,0.18);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	padding: 6px 10px;
	border-radius: 12px;
	font-size: 12px;
	cursor: pointer;
}

.phone-fans-blocktitle {
	font-size: 12px;
	letter-spacing: 0.02em;
	text-transform: uppercase;
	opacity: 0.65;
	margin: 10px 0 8px;
}

.phone-fans-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 8px;
}

.phone-fans-creator {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	color: rgba(255,255,255,0.92);
	padding: 8px 6px;
	border-radius: 14px;
	cursor: pointer;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;
}

.phone-fans-avatar {
	width: 44px;
	height: 44px;
	border-radius: 14px;
	background-size: cover;
	background-position: center;
	border: 1px solid rgba(255,255,255,0.12);
}

.phone-fans-name { font-size: 12px; font-weight: 700; text-align: center; }
.phone-fans-handle { font-size: 11px; opacity: 0.72; text-align: center; }
.phone-fans-price { font-size: 11px; opacity: 0.8; margin-top: 2px; }

.phone-fans-profile {
	display: flex;
	gap: 10px;
	align-items: center;
	margin-bottom: 10px;
}

.phone-fans-avatar-lg {
	width: 56px;
	height: 56px;
	border-radius: 18px;
	background-size: cover;
	background-position: center;
	border: 1px solid rgba(255,255,255,0.12);
	flex: 0 0 auto;
}

.phone-fans-name-lg { font-size: 14px; font-weight: 800; }
.phone-fans-handle-lg { font-size: 12px; opacity: 0.72; }
.phone-fans-coins { font-size: 12px; opacity: 0.85; margin-top: 4px; }

.phone-fans-actions, .phone-fans-actions2 {
	display: flex;
	gap: 8px;
	margin: 10px 0 12px;
}

.phone-fans-subbtn, .phone-fans-msgbtn, .phone-fans-unlock, .phone-fans-tip, .phone-fans-backcreator {
	flex: 1;
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	padding: 10px 12px;
	border-radius: 14px;
	font-size: 12px;
	cursor: pointer;
}

.phone-fans-postlist {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 10px;
}

.phone-fans-post {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	border-radius: 14px;
	overflow: hidden;
	cursor: pointer;
}

.phone-fans-thumb {
	height: 120px;
	background-size: cover;
	background-position: var(--pos, 50% 50%);
	position: relative;
}

.phone-fans-lock {
	position: absolute;
	left: 8px;
	bottom: 8px;
	padding: 4px 8px;
	border-radius: 999px;
	font-size: 11px;
	background: rgba(0,0,0,0.55);
	border: 1px solid rgba(255,255,255,0.18);
}

.phone-fans-meta {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 8px 10px;
}

.phone-fans-ts { font-size: 11px; opacity: 0.7; }
.phone-fans-like {
	font-size: 14px;
	line-height: 1;
	opacity: 0.9;
	cursor: pointer;
}

.phone-fans-postview .phone-fans-posthead {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 10px;
}

.phone-fans-posttitle { font-size: 14px; font-weight: 800; }

.phone-fans-media {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	border-radius: 16px;
	overflow: hidden;
	background-size: cover;
	background-position: var(--pos, 50% 50%);
	position: relative;
	margin-bottom: 10px;
}

.phone-fans-media--h { height: 180px; }
.phone-fans-media--v { height: 240px; }

.phone-fans-media-lock {
	position: absolute;
	inset: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(0,0,0,0.55);
	font-weight: 800;
	letter-spacing: 0.02em;
}

.phone-fans-text {
	font-size: 12px;
	line-height: 1.4;
	opacity: 0.92;
	margin-bottom: 12px;
}

/* =========================================================
   Phone app: Match (swipe) — this chat
   ========================================================= */
.phone-match .phone-match-top {
	display: flex;
	justify-content: center;
	margin-bottom: 12px;
}

.phone-match-start {
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	padding: 12px 14px;
	border-radius: 16px;
	font-size: 12px;
	cursor: pointer;
	width: 100%;
}

.phone-match-blocktitle {
	font-size: 12px;
	letter-spacing: 0.02em;
	text-transform: uppercase;
	opacity: 0.65;
	margin: 10px 0 8px;
}

.phone-match-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 8px;
}

.phone-match-item {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	color: rgba(255,255,255,0.92);
	padding: 8px 6px;
	border-radius: 14px;
	cursor: pointer;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;
}

.phone-match-avatar {
	width: 44px;
	height: 44px;
	border-radius: 14px;
	background-size: cover;
	background-position: center;
	border: 1px solid rgba(255,255,255,0.12);
}

.phone-match-name { font-size: 12px; font-weight: 700; text-align: center; }

.phone-match-card {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	border-radius: 18px;
	overflow: hidden;
}

.phone-match-photo {
	height: 260px;
	background-size: cover;
	background-position: center;
}

.phone-match-cardtext {
	padding: 12px 12px 10px;
}

.phone-match-name-lg {
	font-size: 16px;
	font-weight: 900;
	margin-bottom: 4px;
}

.phone-match-title { font-size: 12px; opacity: 0.75; margin-bottom: 8px; }
.phone-match-bio { font-size: 12px; opacity: 0.92; line-height: 1.35; margin-bottom: 10px; }

.phone-match-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
}

.phone-match-tag {
	font-size: 11px;
	opacity: 0.82;
	padding: 3px 8px;
	border-radius: 999px;
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.03);
}

.phone-match-swipebar {
	display: flex;
	gap: 10px;
	justify-content: center;
	margin-top: 12px;
}

.phone-match-btn {
	width: 56px;
	height: 56px;
	border-radius: 18px;
	border: 1px solid rgba(255,255,255,0.16);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	cursor: pointer;
	font-size: 20px;
}

.phone-match-btn.like { font-size: 22px; }



/* =========================================================
   Fans tiers + tips + PPV
   ========================================================= */
.phone-fans .phone-fans-planrow {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
	margin-bottom: 10px;
}
.phone-fans .phone-fans-planbtn {
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	padding: 10px 12px;
	border-radius: 14px;
	font-size: 12px;
	cursor: pointer;
	flex: 1 1 140px;
	text-align: left;
}
.phone-fans .phone-fans-planbtn.is-active {
	background: rgba(255,255,255,0.10);
	border-color: rgba(255,255,255,0.22);
}
.phone-fans .phone-fans-actionrow {
	display: flex;
	gap: 10px;
}
.phone-fans .phone-fans-unsubbtn {
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.04);
	color: rgba(255,255,255,0.85);
	padding: 10px 12px;
	border-radius: 14px;
	font-size: 12px;
	cursor: pointer;
	flex: 1;
}
.phone-fans .phone-fans-tiprow {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 8px;
	margin-top: 10px;
}
.phone-fans .phone-fans-tiplabel {
	opacity: 0.75;
	font-size: 12px;
	margin-right: 2px;
}
.phone-fans .phone-fans-tipbtn {
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	padding: 8px 10px;
	border-radius: 14px;
	font-size: 12px;
	cursor: pointer;
}
.phone-fans .phone-fans-tipped {
	margin-left: auto;
	opacity: 0.78;
	font-size: 12px;
}

.phone-fans .phone-fans-ppvlist {
	display: grid;
	gap: 10px;
}
.phone-fans .phone-fans-ppvthumb {
	width: 54px;
	height: 54px;
	border-radius: 14px;
	background-size: cover;
	background-position: center;
	border: 1px solid rgba(255,255,255,0.10);
	flex: 0 0 54px;
}

.phone-fans .phone-fans-ppvitem {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	border-radius: 16px;
	padding: 10px 12px;
	display: flex;
	align-items: center;
	gap: 10px;
}
.phone-fans .phone-fans-ppvtext {
	flex: 1;
	font-size: 12px;
	opacity: 0.92;
}
.phone-fans .phone-fans-ppvbtn {
	border: 1px solid rgba(255,255,255,0.14);
	background: rgba(255,255,255,0.06);
	color: rgba(255,255,255,0.92);
	padding: 8px 10px;
	border-radius: 14px;
	font-size: 12px;
	cursor: pointer;
	white-space: nowrap;
}
.phone-fans .phone-fans-ppvok {
	opacity: 0.7;
	font-size: 12px;
	white-space: nowrap;
}

/* Paywall block on post page */
.phone-fans .phone-fans-paywall {
	border: 1px solid rgba(255,255,255,0.10);
	background: rgba(255,255,255,0.04);
	border-radius: 18px;
	padding: 12px;
}
.phone-fans .phone-fans-paywalltitle {
	font-size: 14px;
	font-weight: 700;
	margin-bottom: 6px;
}
.phone-fans .phone-fans-paywallsub {
	opacity: 0.8;
	font-size: 12px;
	margin-bottom: 10px;
}

/* =========================================================
   Match: limits + superlike button
   ========================================================= */
.phone-match .phone-match-counters,
.phone-match .phone-match-counters2 {
	text-align: center;
	opacity: 0.8;
	font-size: 12px;
	margin-bottom: 10px;
}
.phone-match .phone-match-btn.super {
	font-size: 18px;
}
.phone-match .phone-match-btn.disabled {
	opacity: 0.45;
	cursor: not-allowed;
}


/* =====================================================================
   PHONE CHAT: media previews + PPV (Fans)
   ---------------------------------------------------------------------
   - media preview inside chat bubbles uses .sc-media.phone-chat-media
   - PPV locked/unlocked card styles
   ===================================================================== */

.phone-chat-header-right {
	margin-left: auto;
	display: flex;
	align-items: center;
	gap: 8px;
}

.phone-fans-coins {
	font-size: 12px;
	opacity: 0.95;
	padding: 4px 8px;
	border-radius: 999px;
	background: rgba(0,0,0,0.18);
	backdrop-filter: blur(6px);
}

/* Chat attachment (small) */
.phone-chat-bubble .sc-media.phone-chat-media {
	margin-top: 6px;
	max-width: 100%;
}

.phone-chat-bubble .sc-media.phone-chat-media .sc-media__frame {
	border-radius: 12px;
	overflow: hidden;
}

/* Horizontal / vertical preview sizing inside chat */
.phone-chat-bubble .sc-media.phone-chat-media.sc-media--h .sc-media__frame {
	width: 220px;
	height: 120px;
}

.phone-chat-bubble .sc-media.phone-chat-media.sc-media--v .sc-media__frame {
	width: 160px;
	height: 210px;
}

.phone-chat-bubble .sc-media.phone-chat-media .sc-media__el {
	width: 100%;
	height: 100%;
}

/* PPV block */
.phone-chat-ppv {
	margin-top: 6px;
	padding: 10px;
	border-radius: 12px;
	background: rgba(0,0,0,0.10);
}

.phone-chat-ppv-title {
	font-weight: 700;
	font-size: 12px;
	letter-spacing: 0.02em;
	opacity: 0.95;
	margin-bottom: 6px;
}

.phone-chat-ppv-preview {
	font-size: 13px;
	opacity: 0.95;
}

.phone-chat-ppv-thumb {
	margin-top: 8px;
	height: 110px;
	border-radius: 10px;
	background-size: cover;
	background-position: center;
	filter: blur(5px);
	opacity: 0.9;
	position: relative;
	overflow: hidden;
}

.phone-chat-ppv-thumb::after {
	content: "🔒";
	position: absolute;
	inset: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28px;
	background: rgba(0,0,0,0.25);
}

.phone-chat-ppv-unlock {
	margin-top: 10px;
	width: 100%;
}


/* =========================================================
   APP SKINS: Fans (OnlyFans-like) + Match (Tinder-like)
   (non-destructive overrides; keep logic/data attributes)
   ========================================================= */

#phone-overlay-screen-content[data-phone-app="fans"] .phone-ui-statusbar {
	background: #ffffff;
	color: #111;
	border-bottom: 1px solid rgba(0,0,0,0.08);
}
#phone-overlay-screen-content[data-phone-app="fans"] .phone-ui-title { color: #111; }
#phone-overlay-screen-content[data-phone-app="fans"] .phone-nav-back {
	color: #00AFF0;
	border: 0;
	background: transparent;
}

#phone-overlay-screen-content[data-phone-app="match"] .phone-ui-statusbar {
	background: linear-gradient(160deg, #ff416c, #ff4b2b);
	color: #fff;
	border-bottom: 1px solid rgba(255,255,255,0.18);
}
#phone-overlay-screen-content[data-phone-app="match"] .phone-ui-title { color: #fff; }
#phone-overlay-screen-content[data-phone-app="match"] .phone-nav-back {
	color: #fff;
	border: 0;
	background: transparent;
}

.phone-section.phone-fans.fans-app {
	background: #fff;
	color: #111;
	border-radius: 18px;
	padding: 14px 12px;
}
.phone-section.phone-match.match-app {
	background: linear-gradient(160deg, #ff416c, #ff4b2b);
	color: #fff;
	border-radius: 18px;
	padding: 14px 12px;
}

/* ---------- Fans ---------- */
.fans-topbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 10px;
}
.fans-brand { display:flex; align-items:center; gap:8px; }
.fans-brand-dot {
	width: 10px; height: 10px; border-radius: 50%;
	background: #00AFF0;
	box-shadow: 0 0 0 4px rgba(0,175,240,0.15);
}
.fans-brand-text {
	font-weight: 900;
	letter-spacing: 0.3px;
	font-size: 16px;
}
.fans-top-actions { display:flex; align-items:center; gap:8px; }
.fans-coins {
	background: rgba(0,0,0,0.06);
	border: 1px solid rgba(0,0,0,0.08);
	padding: 6px 10px;
	border-radius: 999px;
	font-size: 12px;
}
.fans-iconbtn{
	width: 34px; height: 34px;
	border-radius: 10px;
	border: 1px solid rgba(0,0,0,0.10);
	background: #fff;
	cursor: pointer;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	font-size: 16px;
	line-height: 1;
	color: #111;
}
.fans-iconbtn:hover { background: rgba(0,0,0,0.04); }
.fans-iconbtn[data-fans-coins-shop]{
	background: #00AFF0;
	border-color: rgba(0,175,240,0.55);
	color: #fff;
	font-weight: 900;
}
.fans-iconbtn[data-fans-coins-shop]:hover{
	background: #0096cf;
}

/* ---------- Fans Coins screen (uses eBay UI blocks) ---------- */
.phone-section.phone-fans.fans-app .ebay-subbar{
	background: rgba(0,0,0,0.06);
	border: 1px solid rgba(0,0,0,0.10);
	border-radius: 16px;
}
.phone-section.phone-fans.fans-app .ebay-subbar-left{
	display:inline-flex;
	align-items:center;
	gap:8px;
	padding: 6px 12px;
	border-radius: 999px;
	background: #00AFF0;
	color: #fff;
	font-weight: 900;
	letter-spacing: 0.2px;
}
.phone-section.phone-fans.fans-app .ebay-subbar-right{
	padding: 0 2px;
	color: #111;
	opacity: 0.95;
}
.phone-section.phone-fans.fans-app .ebay-subbar-right b{
	font-weight: 900;
}

/* Make coin pack cards visible on light background */
.phone-section.phone-fans.fans-app .ebay-card{
	background: #fff;
	border: 1px solid rgba(0,0,0,0.10);
	box-shadow: 0 10px 18px rgba(0,0,0,0.06);
}
.phone-section.phone-fans.fans-app .ebay-card-title{
	font-size: 14px;
}
.phone-section.phone-fans.fans-app .ebay-card-desc,
.phone-section.phone-fans.fans-app .ebay-card-meta{
	font-size: 11px;
	opacity: 0.92;
}

/* Primary buttons should be readable in Fans (not translucent white) */
.phone-section.phone-fans.fans-app .phone-btn-primary{
	background: #00AFF0;
	border: 1px solid rgba(0,175,240,0.55);
	color: #fff;
}
.phone-section.phone-fans.fans-app .phone-btn-primary:hover{
	background: #0096cf;
}
.phone-section.phone-fans.fans-app .ebay-card .phone-btn{
	font-size: 12px;
	padding: 8px 12px;
}


.fans-search {
	display:flex; align-items:center; gap:8px;
	border: 1px solid rgba(0,0,0,0.10);
	border-radius: 12px;
	padding: 8px 10px;
	margin: 6px 0 12px;
	background: rgba(0,0,0,0.02);
}
.fans-search-ico{ opacity:0.6; font-size: 12px; }
.fans-search-input{
	border: 0; outline: 0; width: 100%;
	background: transparent;
	font-size: 13px;
	opacity: 0.7;
}

.fans-section-title{
	font-size: 12px;
	font-weight: 900;
	letter-spacing: 0.6px;
	text-transform: uppercase;
	margin: 10px 2px 8px;
	color: rgba(0,0,0,0.55);
}
.fans-creator-list { display:flex; flex-direction:column; gap:8px; }
.fans-creator-row{
	display:flex; align-items:center; gap:10px;
	width: 100%;
	border: 1px solid rgba(0,0,0,0.10);
	background: #fff;
	border-radius: 14px;
	padding: 10px;
	cursor: pointer;
	text-align: left;
}
.fans-creator-row:hover{ background: rgba(0,0,0,0.03); }
.fans-creator-avatar{
	width: 46px; height: 46px; border-radius: 14px;
	background-size: cover; background-position: center;
	box-shadow: 0 4px 10px rgba(0,0,0,0.10);
	flex: 0 0 auto;
}
.fans-creator-main{ flex: 1 1 auto; min-width: 0; }
.fans-creator-name{ font-weight: 900; font-size: 14px; line-height: 1.1; }
.fans-creator-handle{ font-size: 12px; opacity: 0.65; margin-top: 2px; white-space: nowrap; overflow:hidden; text-overflow: ellipsis; }
.fans-creator-pill{
	flex: 0 0 auto;
	font-size: 11px;
	padding: 6px 10px;
	border-radius: 999px;
	border: 1px solid rgba(0,0,0,0.10);
	background: rgba(0,175,240,0.10);
	color: #055b7b;
	max-width: 45%;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Fans profile */
.fans-profile-hero{
	position: relative;
	border-radius: 18px;
	overflow: hidden;
	min-height: 120px;
	background-size: cover;
	background-position: center;
	margin-bottom: 10px;
}
.fans-hero-overlay{
	position:absolute; inset:0;
	background: linear-gradient(180deg, rgba(0,0,0,0.35), rgba(0,0,0,0.70));
}
.fans-profile-header{
	position: relative;
	display:flex; align-items:flex-end; gap:12px;
	padding: 12px;
}
.fans-profile-avatar{
	width: 68px; height: 68px;
	border-radius: 20px;
	border: 2px solid rgba(255,255,255,0.85);
	background-size: cover; background-position: center;
	box-shadow: 0 6px 16px rgba(0,0,0,0.25);
	flex: 0 0 auto;
}
.fans-profile-meta{ color: #fff; min-width: 0; }
.fans-profile-name{ font-weight: 950; font-size: 16px; line-height:1.1; }
.fans-profile-handle{ font-size: 12px; opacity: 0.9; margin-top: 2px; }
.fans-profile-bio{ font-size: 12px; opacity: 0.95; margin-top: 6px; }

.fans-card{
	border: 1px solid rgba(0,0,0,0.10);
	border-radius: 18px;
	background: #fff;
	padding: 12px;
	margin: 10px 0;
}
.fans-card-actions{ margin-top: 0; }
.fans-subline{ font-size: 12px; margin-bottom: 10px; }
.fans-subline.muted{ opacity: 0.65; }
.fans-sub-dot{
	display:inline-block; width:8px; height:8px; border-radius:50%;
	background:#00AFF0; margin-right:6px;
}
.fans-plan-chips{ display:flex; flex-wrap:wrap; gap:8px; margin: 8px 0 10px; }
.fans-plan-chip{
	border: 1px solid rgba(0,0,0,0.12);
	background: rgba(0,0,0,0.02);
	border-radius: 999px;
	padding: 7px 10px;
	font-size: 12px;
	cursor: pointer;
}
.fans-plan-chip.is-active{
	border-color: rgba(0,175,240,0.55);
	background: rgba(0,175,240,0.12);
	color: #055b7b;
	font-weight: 800;
}
.fans-primary-row{ display:flex; gap:8px; }
.fans-btn{
	border-radius: 14px;
	padding: 10px 12px;
	border: 1px solid rgba(0,0,0,0.12);
	background: #fff;
	cursor: pointer;
	font-weight: 800;
}
.fans-btn.primary{
	background: #00AFF0;
	color: #fff;
	border-color: rgba(0,175,240,0.65);
}
.fans-btn.ghost{
	background: rgba(0,0,0,0.02);
}
.fans-btn:hover{ filter: brightness(0.98); }
.fans-tip-row{ display:flex; align-items:center; gap:8px; margin-top: 10px; flex-wrap: wrap; }
.fans-tip-label{ font-size: 12px; opacity: 0.75; margin-right: 2px; }
.fans-tip-btn{
	border-radius: 999px;
	padding: 6px 10px;
	border: 1px solid rgba(0,0,0,0.12);
	background: rgba(0,0,0,0.02);
	cursor:pointer;
	font-weight: 800;
}
.fans-tip-total{ margin-left:auto; font-size: 12px; opacity: 0.75; }

.fans-posts-title{ font-weight: 950; margin-bottom: 10px; }
.fans-post-grid{
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 8px;
}
.fans-post{
	position: relative;
	border: 0;
	background: transparent;
	padding: 0;
	cursor: pointer;
	border-radius: 16px;
	overflow: hidden;
}
.fans-post-thumb{
	width: 100%;
	aspect-ratio: 1 / 1;
	background-size: cover;
	background-position: center;
}
.fans-post-shade{
	position:absolute; inset:0;
	background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.35));
	opacity: 0.75;
}
.fans-post-badge{
	position:absolute; top: 10px; left: 10px;
	font-size: 11px;
	padding: 5px 8px;
	border-radius: 999px;
	font-weight: 900;
	color: #fff;
	background: rgba(0,0,0,0.55);
	border: 1px solid rgba(255,255,255,0.22);
}
.fans-post-badge.lock{ background: rgba(0,175,240,0.85); }
.fans-post-badge.req{ background: rgba(0,0,0,0.55); }

.fans-postview .fans-post-head{
	display:flex; justify-content:space-between; align-items:center;
	margin-bottom: 10px;
}
.fans-post-author{ font-weight: 950; }
.fans-post-ts{ font-size: 12px; opacity: 0.65; }
.fans-paywall{ border: 1px dashed rgba(0,0,0,0.18); border-radius: 16px; padding: 12px; background: rgba(0,0,0,0.02); }
.fans-paywall-title{ font-weight: 950; margin-bottom: 6px; }
.fans-paywall-text{ font-size: 12px; opacity: 0.75; margin-bottom: 8px; }
.fans-post-media{
	border-radius: 16px;
	overflow: hidden;
	border: 1px solid rgba(0,0,0,0.10);
	background: #eee;
}
.fans-post-media::before{
	content: "";
	display:block;
	aspect-ratio: 16 / 9;
	background-image: var(--bg);
	background-size: cover;
	background-position: var(--pos);
}
.fans-post-media--v::before{ aspect-ratio: 9 / 16; }

/* Unlocked Fans post media uses sc-media (fullscreen + gallery). Tweak look inside Fans cards. */
.fans-post-media-wrap .sc-media{
	margin: 0;
	border-radius: 16px;
	box-shadow: none;
}
.fans-post-media-wrap .sc-media--h,
.fans-post-media-wrap .sc-media--v{
	max-width: 100%;
}
.fans-postview .fans-post-media-wrap{ margin-top: 8px; }

.fans-post-lock{
	position:absolute;
	margin-top: 10px;
	display:inline-block;
}
.fans-post-lock{
	position: relative;
	transform: translate(10px, -60px);
	display:inline-flex;
	align-items:center;
	gap: 6px;
	padding: 8px 10px;
	border-radius: 999px;
	background: rgba(0,0,0,0.55);
	color: #fff;
	border: 1px solid rgba(255,255,255,0.22);
	font-weight: 900;
	font-size: 12px;
}
.fans-post-text{ margin-top: 10px; font-size: 13px; line-height: 1.35; }
.fans-post-actions{ display:flex; gap:8px; margin-top: 12px; align-items:center; }
.fans-likebtn{
	border-radius: 999px;
	padding: 8px 12px;
	border: 1px solid rgba(0,0,0,0.12);
	background: rgba(0,0,0,0.02);
	cursor: pointer;
	font-weight: 900;
}
.fans-likebtn.is-on{
	background: rgba(255, 0, 90, 0.12);
	border-color: rgba(255, 0, 90, 0.25);
	color: #a8003a;
}
.fans-inbox-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px; }
.fans-inbox-title{ font-weight: 950; }

/* Fans Inbox rows */
.fans-chat-list{ display:flex; flex-direction:column; gap:8px; }
.fans-chat-row{
	display:flex; align-items:center; gap:10px;
	width:100%;
	text-align:left;
	border-radius: 16px;
	border: 1px solid rgba(0,0,0,0.10);
	background: rgba(0,0,0,0.02);
	padding: 10px;
	cursor: pointer;
}
.fans-chat-avatar{
	width: 46px; height: 46px; border-radius: 14px;
	background-size: cover; background-position: center;
	flex: 0 0 auto;
}
.fans-chat-main{ flex:1 1 auto; min-width: 0; }
.fans-chat-name{ font-weight: 900; }
.fans-chat-snippet{ font-size: 12px; opacity: 0.7; margin-top: 2px; white-space: nowrap; overflow:hidden; text-overflow: ellipsis; }
.fans-chat-unread{
	flex:0 0 auto;
	min-width: 22px; height: 22px;
	padding: 0 6px;
	border-radius: 999px;
	background: #00AFF0;
	color: #fff;
	display:flex; align-items:center; justify-content:center;
	font-size: 12px;
	font-weight: 900;
}

/* ---------- Match (Tinder-ish) ---------- */
.match-topbar{
	display:flex;
	align-items:center;
	justify-content: space-between;
	margin-bottom: 10px;
}
.match-brand{ font-weight: 950; font-size: 16px; letter-spacing: 0.2px; }
.match-iconbtn{
	width: 36px; height: 36px;
	border-radius: 12px;
	border: 1px solid rgba(255,255,255,0.25);
	background: rgba(255,255,255,0.14);
	color: #fff;
	cursor:pointer;
}
.match-iconbtn:hover{ background: rgba(255,255,255,0.20); }

.match-cta{
	border: 1px solid rgba(255,255,255,0.22);
	background: rgba(255,255,255,0.10);
	border-radius: 18px;
	padding: 12px;
	margin-bottom: 12px;
}
.match-counters, .match-counters2{
	font-size: 12px;
	opacity: 0.95;
	margin-bottom: 10px;
}
.match-primary{
	width: 100%;
	border-radius: 18px;
	padding: 12px 14px;
	border: 0;
	background: rgba(255,255,255,0.92);
	color: #ff416c;
	font-weight: 950;
	cursor:pointer;
}
.match-primary:hover{ filter: brightness(0.98); }
.match-subtitle{ font-size: 12px; font-weight: 950; letter-spacing: 0.6px; text-transform: uppercase; opacity: 0.9; margin: 10px 2px 8px; }
.match-muted{ opacity: 0.9; font-size: 13px; }

.match-matches-row{
	display:flex;
	gap: 10px;
	overflow-x: auto;
	padding-bottom: 6px;
}
.match-matchchip{
	flex: 0 0 auto;
	border: 1px solid rgba(255,255,255,0.22);
	background: rgba(255,255,255,0.10);
	border-radius: 18px;
	padding: 8px;
	cursor: pointer;
	text-align:center;
	width: 92px;
	color: #fff;
}
.match-match-avatar{
	width: 56px; height: 56px;
	border-radius: 16px;
	background-size: cover;
	background-position: center;
	margin: 0 auto 6px;
	box-shadow: 0 8px 18px rgba(0,0,0,0.25);
}
.match-match-name{
	font-size: 12px;
	font-weight: 900;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.match-card{
	position: relative;
	border-radius: 22px;
	overflow: hidden;
	border: 1px solid rgba(255,255,255,0.20);
	box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}
.match-photo{
	height: 360px;
	background-size: cover;
	background-position: center;
	transform: scale(1.02);
}
.match-gradient{
	position:absolute; inset:0;
	background: linear-gradient(180deg, rgba(0,0,0,0.0) 40%, rgba(0,0,0,0.75) 92%);
}
.match-cardtext{
	position:absolute;
	left: 14px;
	right: 14px;
	bottom: 14px;
}
.match-name-lg{ font-size: 20px; font-weight: 950; }
.match-title{ font-size: 13px; opacity: 0.9; margin-top: 2px; }
.match-bio{ font-size: 12px; opacity: 0.9; margin-top: 8px; line-height: 1.35; }
.match-tags{ display:flex; flex-wrap:wrap; gap:6px; margin-top: 8px; }
.match-tag{
	font-size: 11px;
	padding: 6px 10px;
	border-radius: 999px;
	border: 1px solid rgba(255,255,255,0.20);
	background: rgba(255,255,255,0.12);
}

.match-buttons{
	display:flex;
	justify-content: space-evenly;
	align-items:center;
	margin-top: 12px;
}
.match-btn{
	width: 64px; height: 64px;
	border-radius: 50%;
	border: 0;
	cursor:pointer;
	font-size: 22px;
	box-shadow: 0 10px 22px rgba(0,0,0,0.25);
}
.match-btn.pass{
	background: rgba(255,255,255,0.92);
	color: #ff416c;
}
.match-btn.like{
	background: rgba(255,255,255,0.92);
	color: #ff4b2b;
}
.match-btn.super{
	background: rgba(255,255,255,0.92);
	color: #3aa5ff;
}
.match-btn.disabled{
	opacity: 0.45;
	pointer-events: none;
	box-shadow: none;
}

.match-inbox-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px; }
.match-inbox-title{ font-weight: 950; }
.match-chatlist{ display:flex; flex-direction:column; gap:10px; }
.match-chat-row{
	display:flex; align-items:center; gap:10px;
	width:100%;
	text-align:left;
	border-radius: 18px;
	border: 1px solid rgba(255,255,255,0.22);
	background: rgba(255,255,255,0.10);
	padding: 10px;
	cursor:pointer;
	color:#fff;
}
.match-chat-avatar{
	width: 46px; height: 46px;
	border-radius: 16px;
	background-size: cover; background-position:center;
	flex: 0 0 auto;
}
.match-chat-main{ flex:1 1 auto; min-width:0; }
.match-chat-name{ font-weight: 950; }
.match-chat-snippet{ font-size: 12px; opacity: 0.9; margin-top: 2px; white-space: nowrap; overflow:hidden; text-overflow: ellipsis; }
.match-chat-unread{
	min-width: 22px; height: 22px;
	padding: 0 6px;
	border-radius: 999px;
	background: rgba(255,255,255,0.92);
	color: #ff416c;
	display:flex; align-items:center; justify-content:center;
	font-size: 12px;
	font-weight: 950;
}

/* =========================================================
   Phone polish: app icons + transitions + Match swipe + It's a Match
   ========================================================= */

/* Screen enter animation (re-renders trigger it naturally) */
.phone-ui-body {
	animation: phoneSlideIn 160ms ease;
}
@keyframes phoneSlideIn {
	from { transform: translateY(8px); opacity: 0; }
	to   { transform: translateY(0); opacity: 1; }
}
#phone-overlay-screen-content[data-phone-app="match"] .phone-ui-body {
	animation: phoneSlideInMatch 160ms ease;
}
@keyframes phoneSlideInMatch {
	from { transform: translateX(10px); opacity: 0; }
	to   { transform: translateX(0); opacity: 1; }
}

/* Home icons: Fans + Match (no external assets needed) */
#phone-overlay-screen-content .phone-app-icon-inner.app-fans,
#phone-overlay-screen-content .phone-app-icon-inner.app-match {
	position: relative;
	overflow: hidden;
}
#phone-overlay-screen-content .phone-app-icon-inner.app-fans {
	background: radial-gradient(120% 120% at 30% 20%, #2ad0ff 0%, #00aff0 45%, #0077b5 100%) !important;
}
#phone-overlay-screen-content .phone-app-icon-inner.app-fans::before {
	content: "";
	position: absolute;
	inset: 0;
	background-image: url("data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2064%2064%22%3E%0A%3Cpath%20fill%3D%22white%22%20d%3D%22M32%206c-9.4%200-17%207.6-17%2017v7h-2.5C10.6%2030%209%2031.6%209%2033.5v16C9%2054.7%2012.3%2058%2016.5%2058h31C51.7%2058%2055%2054.7%2055%2049.5v-16C55%2031.6%2053.4%2030%2051.5%2030H49v-7C49%2013.6%2041.4%206%2032%206zm-11%2017c0-6.1%204.9-11%2011-11s11%204.9%2011%2011v7H21v-7zm11%2013c3.3%200%206%202.7%206%206%200%202.2-1.2%204.1-3%205.1V52c0%201.7-1.3%203-3%203s-3-1.3-3-3v-4.9c-1.8-1-3-2.9-3-5.1%200-3.3%202.7-6%206-6z%22/%3E%0A%3C/svg%3E");
	background-repeat: no-repeat;
	background-position: center;
	background-size: 58%;
	filter: drop-shadow(0 10px 16px rgba(0,0,0,0.25));
}
#phone-overlay-screen-content .phone-app-icon-inner.app-match {
	background: radial-gradient(140% 140% at 30% 20%, #ff8a8a 0%, #ff416c 35%, #ff4b2b 100%) !important;
}
#phone-overlay-screen-content .phone-app-icon-inner.app-match::before {
	content: "";
	position: absolute;
	inset: 0;
	background-image: url("data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2064%2064%22%3E%0A%3Cpath%20fill%3D%22white%22%20d%3D%22M38.7%206c-2.2%208.9-7.6%2014.9-15.6%2018.8-7.9%203.9-12.5%2010.2-12.5%2018.2C10.6%2055%2020.3%2062%2032.5%2062c11.2%200%2020.9-7%2020.9-19.1%200-10-6.8-17.2-14.6-21.1.7%203.7%200%207-2%209.7-2.1-4.4-5.6-8.1-10.1-10.5%202.4%207.5%201.2%2012.8-4.6%2018.2%200%204.9%204.2%208.7%2010%208.7%205.9%200%2010.6-4%2010.6-10%200-5.2-3.2-9.5-6.3-11.9%201.3%204.6.4%207.7-3.2%209.9.2-5.8-3.4-12.2-10.4-16.7%201.4%208-2%2013.2-6.9%2017.7%201.2-2.6%201.7-5.2%201.3-8-3.2%202.8-5%206.4-5%2010.7%200%209.8%208.2%2016.8%2019.3%2016.8%2010.4%200%2018.3-6.7%2018.3-17.3%200-7.6-4.3-13.5-9.9-16.7z%22/%3E%0A%3C/svg%3E");
	background-repeat: no-repeat;
	background-position: center;
	background-size: 58%;
	filter: drop-shadow(0 10px 16px rgba(0,0,0,0.25));
}


/* eBay icon polish */
#phone-overlay-screen-content .phone-app-icon-inner.app-ebay {
	position: relative;
	overflow: hidden;
	background: radial-gradient(120% 120% at 30% 20%, #ffcf33 0%, #ff6a00 45%, #d81b60 100%) !important;
}
#phone-overlay-screen-content .phone-app-icon-inner.app-ebay::before {
	content: "e";
	position: absolute;
	inset: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	font-weight: 900;
	font-size: 24px;
	color: #fff;
	text-shadow: 0 2px 10px rgba(0,0,0,0.35);
}


/* Match: swipe drag polish */
.match-card {
	will-change: transform;
	transition: transform 180ms ease;
	touch-action: none;
}
.match-card.dragging {
	transition: none;
}
.match-swipe-badge {
	position: absolute;
	top: 16px;
	left: 16px;

	padding: 8px 12px;
	border-radius: 12px;
	border: 3px solid rgba(255,255,255,0.92);

	font-weight: 950;
	font-size: 14px;
	letter-spacing: 0.12em;

	background: rgba(0,0,0,0.18);
	backdrop-filter: blur(6px);

	opacity: 0;
	transform: rotate(-12deg) scale(0.96);
	transition: opacity 80ms ease, transform 80ms ease;
	pointer-events: none;
}
.match-swipe-badge.show {
	opacity: 1;
	transform: rotate(-12deg) scale(1);
}
.match-swipe-badge.like {
	left: auto;
	right: 16px;
	border-color: rgba(0,255,170,0.95);
	color: rgba(0,255,170,0.95);
	transform: rotate(12deg) scale(0.96);
}
.match-swipe-badge.like.show {
	transform: rotate(12deg) scale(1);
}
.match-swipe-badge.nope {
	border-color: rgba(255,90,120,0.95);
	color: rgba(255,90,120,0.95);
}
.match-swipe-badge.super {
	top: auto;
	bottom: 18px;
	left: 50%;
	transform: translateX(-50%) scale(0.96);
	border-color: rgba(80,180,255,0.95);
	color: rgba(80,180,255,0.95);
}
.match-swipe-badge.super.show {
	transform: translateX(-50%) scale(1);
}

/* Match: "It's a Match!" screen */
.match-itsamatch-screen {
	padding: 0 !important;
}
.match-itsamatch-wrap {
	position: relative;
	height: 100%;
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
}
.match-itsamatch-heart-bg {
	position: absolute;
	inset: -40px;
	background:
		radial-gradient(120px 120px at 20% 20%, rgba(255,255,255,0.22), rgba(255,255,255,0) 60%),
		radial-gradient(160px 160px at 80% 30%, rgba(255,255,255,0.18), rgba(255,255,255,0) 60%),
		radial-gradient(220px 220px at 50% 90%, rgba(255,255,255,0.12), rgba(255,255,255,0) 65%);
	opacity: 0.9;
	filter: blur(0px);
	animation: matchPulse 1.8s ease-in-out infinite;
}
@keyframes matchPulse {
	0%   { transform: scale(1); opacity: 0.78; }
	50%  { transform: scale(1.05); opacity: 0.92; }
	100% { transform: scale(1); opacity: 0.78; }
}
.match-itsamatch-card {
	position: relative;
	width: calc(100% - 28px);
	max-width: 292px;

	background: rgba(0,0,0,0.35);
	border: 1px solid rgba(255,255,255,0.18);
	border-radius: 22px;

	padding: 18px 14px;
	text-align: center;

	backdrop-filter: blur(10px);
	box-shadow: 0 14px 30px rgba(0,0,0,0.35);
	animation: matchPop 180ms ease;
}
@keyframes matchPop {
	from { transform: translateY(10px) scale(0.98); opacity: 0; }
	to   { transform: translateY(0) scale(1); opacity: 1; }
}
.match-itsamatch-title {
	font-size: 26px;
	font-weight: 950;
	letter-spacing: 0.01em;
	line-height: 1.1;
}
.match-itsamatch-sub {
	margin-top: 8px;
	font-size: 12px;
	opacity: 0.92;
	line-height: 1.35;
}
.match-itsamatch-avatars {
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 12px;
	margin-top: 14px;
}
.match-itsamatch-avatar {
	width: 96px;
	height: 96px;
	border-radius: 50%;
	background-size: cover;
	background-position: center;
	border: 3px solid rgba(255,255,255,0.85);
	box-shadow: 0 10px 20px rgba(0,0,0,0.25);
}
.match-itsamatch-avatar.me {
	display: flex;
	align-items: center;
	justify-content: center;
	background: radial-gradient(130% 130% at 30% 20%, rgba(255,255,255,0.26), rgba(255,255,255,0.08));
}
.match-itsamatch-avatar.me span {
	font-size: 12px;
	font-weight: 950;
	letter-spacing: 0.14em;
	opacity: 0.92;
}
.match-itsamatch-btn {
	margin-top: 12px;
	width: 100%;
	border: 0;
	border-radius: 999px;
	padding: 10px 12px;
	font-weight: 900;
	cursor: pointer;
}
.match-itsamatch-btn.primary {
	background: rgba(255,255,255,0.92);
	color: #ff416c;
}
.match-itsamatch-btn:not(.primary) {
	margin-top: 8px;
	background: rgba(255,255,255,0.18);
	color: rgba(255,255,255,0.96);
}
.match-itsamatch-btn:hover {
	filter: brightness(1.03);
}


/* --- FIX: Fans Coins pack Buy buttons were visually "empty" on light background --- */
.phone-section.phone-fans.fans-app button[data-fans-buy-coins],
.phone-section.phone-fans.fans-app .ebay-card-actions .phone-btn-primary{
	background: #00AFF0 !important;
	border: 1px solid rgba(0,175,240,0.70) !important;
	color: #fff !important;
	font-weight: 900;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 74px;
}
.phone-section.phone-fans.fans-app button[data-fans-buy-coins]:hover,
.phone-section.phone-fans.fans-app .ebay-card-actions .phone-btn-primary:hover{
	background: #0096cf !important;
}

/* Inventory: use-qty chips */
.inv-useqty-title{margin-top:10px;opacity:.8;font-size:12px;}
.inv-use-chips{margin-top:6px;}


/* ======================================================
   WhatsApp-like theme (core Messages app)
   Scope: #phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"]
   ====================================================== */

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .phone-ui-statusbar {
	background: rgba(7, 94, 84, 0.98);
	border-bottom: none;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .phone-ui-statusbar * {
	color: #fff;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .phone-nav-back {
	background: transparent;
	border: none;
	box-shadow: none;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .phone-ui-title {
	font-weight: 700;
	letter-spacing: 0.2px;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .phone-ui-body {
	padding: 10px 10px 14px;
	background: #e9eef0;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-searchbar {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 8px 10px;
	background: #fff;
	border-radius: 14px;
	box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-search-ico {
	font-size: 14px;
	opacity: 0.7;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-search-input {
	flex: 1;
	border: none;
	outline: none;
	background: transparent;
	font-size: 13px;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-search-clear {
	border: none;
	background: transparent;
	font-size: 18px;
	line-height: 18px;
	padding: 0 2px;
	opacity: 0.55;
	cursor: pointer;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-chatlist {
	margin-top: 10px;
	background: #fff;
	border-radius: 14px;
	overflow: hidden;
	box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-chatrow {
	width: 100%;
	display: flex;
	gap: 10px;
	align-items: center;
	padding: 10px 10px;
	border: none;
	background: transparent;
	cursor: pointer;
	text-align: left;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-chatrow + .wa-chatrow {
	border-top: 1px solid rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-avatar {
	width: 46px;
	height: 46px;
	border-radius: 50%;
	background-size: cover;
	background-position: center;
	flex: 0 0 auto;
	box-shadow: 0 1px 0 rgba(0,0,0,0.08) inset;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-chatmain {
	flex: 1;
	min-width: 0;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-row1 {
	display: flex;
	justify-content: space-between;
	gap: 10px;
	align-items: baseline;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-name {
	font-weight: 700;
	font-size: 13px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-time {
	font-size: 11px;
	opacity: 0.6;
	flex: 0 0 auto;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-row2 {
	display: flex;
	justify-content: space-between;
	gap: 10px;
	align-items: center;
	margin-top: 2px;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-preview {
	font-size: 12px;
	opacity: 0.72;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	min-width: 0;
	display: flex;
	gap: 6px;
	align-items: center;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-preview--typing {
	opacity: 1;
	color: #128C7E;
	font-weight: 600;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-unread {
	background: #25D366;
	color: #fff;
	border-radius: 999px;
	min-width: 20px;
	height: 20px;
	padding: 0 6px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	font-size: 12px;
	font-weight: 700;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messages"] .wa-empty {
	padding: 14px 12px;
	text-align: center;
	opacity: 0.7;
	font-size: 12px;
}

/* ticks (list + chat) */
#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .wa-ticks {
	font-size: 12px;
	line-height: 12px;
	opacity: 0.7;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .wa-ticks--sent {
	opacity: 0.55;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .wa-ticks--delivered {
	opacity: 0.75;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen^="messages"] .wa-ticks--read {
	opacity: 1;
	color: #34B7F1;
}

/* -------- Chat screen -------- */

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-ui-body {
	padding: 0;
	display: flex;
	flex-direction: column;
	background: #e5ddd5;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat {
	display: flex;
	flex-direction: column;
	height: 100%;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 8px;
	padding: 10px 10px;
	background: rgba(7, 94, 84, 0.98);
	color: #fff;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-left {
	display: flex;
	align-items: center;
	gap: 10px;
	min-width: 0;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-avatar {
	width: 34px;
	height: 34px;
	border-radius: 50%;
	background-size: cover;
	background-position: center;
	flex: 0 0 auto;
	box-shadow: 0 1px 0 rgba(0,0,0,0.14) inset;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-title {
	min-width: 0;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-name {
	font-weight: 800;
	font-size: 13px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-status {
	font-size: 11px;
	opacity: 0.85;
	height: 13px; /* reserve space */
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chat-actions {
	display: flex;
	gap: 4px;
	flex: 0 0 auto;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-icon-btn {
	border: none;
	background: transparent;
	color: #fff;
	font-size: 18px;
	line-height: 18px;
	padding: 6px 6px;
	border-radius: 10px;
	opacity: 0.9;
	cursor: default;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-icon-btn:disabled {
	opacity: 0.75;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubbles {
	flex: 1;
	overflow: auto;
	padding: 10px 10px 12px;
	display: flex;
	flex-direction: column;
	gap: 6px;
	background:
		radial-gradient(circle at 15px 15px, rgba(0,0,0,0.05) 0 2px, transparent 3px) 0 0/40px 40px,
		radial-gradient(circle at 30px 30px, rgba(0,0,0,0.03) 0 2px, transparent 3px) 0 0/40px 40px,
		#e5ddd5;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-day-sep {
	align-self: center;
	background: rgba(255,255,255,0.7);
	padding: 4px 10px;
	border-radius: 999px;
	font-size: 11px;
	opacity: 0.8;
	margin: 6px 0 2px;
	box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble {
	max-width: 82%;
	padding: 7px 9px 18px 9px;
	border-radius: 8px;
	position: relative;
	box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble.them {
	align-self: flex-start;
	background: #fff;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble.me {
	align-self: flex-end;
	background: #dcf8c6;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble.them:after,
#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble.me:after {
	content: "";
	position: absolute;
	bottom: 0;
	width: 0;
	height: 0;
	border: 8px solid transparent;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble.them:after {
	left: -6px;
	border-right-color: #fff;
	border-left: 0;
	border-bottom: 0;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-bubble.me:after {
	right: -6px;
	border-left-color: #dcf8c6;
	border-right: 0;
	border-bottom: 0;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-msg-text {
	font-size: 13px;
	line-height: 1.35;
	color: #111;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-meta {
	position: absolute;
	right: 8px;
	bottom: 4px;
	display: inline-flex;
	gap: 6px;
	align-items: center;
	font-size: 11px;
	opacity: 0.65;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-time {
	white-space: nowrap;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .phone-chat-media {
	margin-top: 8px;
}

/* typing bubble */
#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-typing-row {
	display: flex;
	justify-content: flex-start;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-typing-bubble {
	background: #fff;
	border-radius: 999px;
	padding: 8px 10px;
	display: inline-flex;
	gap: 5px;
	align-items: center;
	box-shadow: 0 1px 0 rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-dot {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: rgba(0,0,0,0.45);
	animation: waTypingDot 1.1s infinite ease-in-out;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-dot:nth-child(2) { animation-delay: 0.15s; }
#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-dot:nth-child(3) { animation-delay: 0.30s; }

@keyframes waTypingDot {
	0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
	40% { transform: translateY(-2px); opacity: 0.9; }
}

/* quick replies (chips) */
#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-quickreplies {
	padding: 8px 10px;
	overflow-x: auto;
	white-space: nowrap;
	display: flex;
	gap: 8px;
	background: rgba(255,255,255,0.85);
	border-top: 1px solid rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-quickreplies--empty {
	padding: 0;
	border-top: none;
	background: transparent;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-chip {
	border: 1px solid rgba(0,0,0,0.14);
	background: #fff;
	border-radius: 999px;
	padding: 7px 10px;
	font-size: 12px;
	cursor: pointer;
	flex: 0 0 auto;
}

/* input bar (visual only) */
#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-inputbar {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 8px 10px;
	background: #f0f0f0;
	border-top: 1px solid rgba(0,0,0,0.06);
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-input-ico {
	width: 30px;
	height: 30px;
	border-radius: 50%;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	opacity: 0.85;
}

#phone-overlay-screen-content[data-phone-app="core"][data-phone-screen="messagesChat"] .wa-input-fake {
	flex: 1;
	background: #fff;
	border-radius: 999px;
	padding: 8px 12px;
	font-size: 13px;
	opacity: 0.7;
}




/* ------------------------------------------------------
   Gallery mini-details (Recent strip / badges / zoom)
   ------------------------------------------------------ */
.phone-gallery-recent {
	margin: 10px 0 6px;
}

.phone-gallery-recent-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0 2px 6px;
}

.phone-gallery-recent-title {
	font-size: 11px;
	opacity: 0.9;
}

.phone-gallery-recent-strip {
	display: flex;
	gap: 8px;
	overflow-x: auto;
	padding-bottom: 6px;
	-webkit-overflow-scrolling: touch;
}

.phone-recent-item {
	position: relative;
	border: none;
	background: transparent;
	padding: 0;
	margin: 0;
	cursor: pointer;
	border-radius: 12px;
	overflow: hidden;
	min-width: 62px;
	width: 62px;
}

.phone-recent-thumb {
	width: 100%;
	padding-top: 100%;
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
}

.phone-media-badges {
	position: absolute;
	left: 6px;
	top: 6px;
	display: flex;
	gap: 4px;
	align-items: center;
}

.phone-media-badge {
	font-size: 9px;
	line-height: 1;
	padding: 2px 6px;
	border-radius: 999px;
	background: rgba(0,0,0,0.62);
	color: #fff;
	backdrop-filter: blur(8px);
	-webkit-backdrop-filter: blur(8px);
}

.phone-media-badge--video {
	padding: 2px 5px;
}

.phone-media-badge--wp {
	padding: 2px 5px;
}

.phone-chip--ghost {
	background: rgba(255,255,255,0.06);
	border: 1px solid rgba(255,255,255,0.12);
}

/* zoom viewer */
.phone-gallery-view-img {
	background-size: contain;
	background-position: 50% 50%;
	background-repeat: no-repeat;
}

.phone-gallery-view.zoomed .phone-gallery-view-img {
	background-size: 220%;
	cursor: grab;
}

.phone-gallery-view.zoomed .phone-gallery-view-img:active {
	cursor: grabbing;
}


/* Dynamic Events slot (injected scenes) */
.dyn-events-slot {
  margin-top: 12px;
}
.dyn-events-slot:empty {
  display: none;
}

.dyn-log {
  margin: 10px 0 0;
  padding: 8px 10px;
  border-radius: 10px;
  background: rgba(0,0,0,0.15);
  max-height: 220px;
  overflow: auto;
  font-size: 12px;
  line-height: 1.35;
  white-space: pre-wrap;
}



/* ==================================================
   MINIPHONEPLUS - micro animations + small UX
   ================================================== */

/* Make mini-app badge row clickable (deep-links) */
#custom-ui-phone-appbadges { pointer-events: auto; }
#custom-ui-phone-appbadges .mini-app-badge-item { pointer-events: auto; }

/* Badge pulse (numbers) */
@keyframes scBadgePulse {
	0%   { transform: scale(1); }
	35%  { transform: scale(1.22); }
	65%  { transform: scale(0.98); }
	100% { transform: scale(1); }
}

#custom-ui-phone-badge.pulse,
#custom-ui-phone-appbadges .mini-app-badge.pulse {
	animation: scBadgePulse 0.42s cubic-bezier(.2,.9,.2,1);
	transform-origin: center;
}

/* Icon bounce when unread increases */
@keyframes scIconBounce {
	0%   { transform: translateY(0) scale(1); }
	30%  { transform: translateY(-2px) scale(1.14); }
	55%  { transform: translateY(1px) scale(0.98); }
	100% { transform: translateY(0) scale(1); }
}

.mini-app-badge-item.bump .mini-app-icon {
	animation: scIconBounce 0.46s cubic-bezier(.2,.9,.2,1);
	transform-origin: 50% 65%;
}

/* Banner: blur + slide in/out (more iOS-feel) */
#custom-ui-phone-banner {
	will-change: transform, opacity, filter;
}

#custom-ui-phone-banner.visible {
	display: block;
}

#custom-ui-phone-banner.visible:not(.hiding) {
	animation: scMiniBannerIn 0.26s cubic-bezier(.2,.9,.2,1);
}

#custom-ui-phone-banner.visible.hiding {
	animation: scMiniBannerOut 0.22s ease-in;
}

@keyframes scMiniBannerIn {
	0%   { transform: translateX(-50%) translateY(-12px); opacity: 0; filter: blur(7px); }
	100% { transform: translateX(-50%) translateY(0);     opacity: 1; filter: blur(0); }
}

@keyframes scMiniBannerOut {
	0%   { transform: translateX(-50%) translateY(0);     opacity: 1; filter: blur(0); }
	100% { transform: translateX(-50%) translateY(-10px); opacity: 0; filter: blur(7px); }
}

/* Bubble "pop" only for newly appeared thread */
@keyframes scBubblePop {
	0%   { transform: translateY(6px) scale(0.98); opacity: 0; }
	100% { transform: translateY(0)  scale(1);     opacity: 1; }
}

#custom-ui-phone-bubbles .phone-bubble.is-new {
	animation: scBubblePop 0.30s ease-out;
}


/* Minimal inbox filters */
.phone-chips {
	display: flex;
	gap: 6px;
	padding: 6px 10px 2px 10px;
	flex-wrap: wrap;
}
.phone-chip {
	padding: 6px 10px;
	border-radius: 999px;
	border: 1px solid rgba(255,255,255,0.18);
	background: rgba(255,255,255,0.10);
	color: rgba(255,255,255,0.92);
	font-size: 12px;
	line-height: 12px;
	cursor: pointer;
}
.phone-chip:hover {
	background: rgba(255,255,255,0.14);
}
.phone-chip.active {
	background: rgba(255,255,255,0.22);
	border-color: rgba(255,255,255,0.28);
}

/* Typing state (Fans/Match) */
.phone-chat-header-sub {
	font-size: 11px;
	line-height: 11px;
	opacity: 0.75;
	margin-top: 2px;
}
.phone-chat-bubble.phone-typing {
	opacity: 0.72;
	font-style: italic;
}

/* Inventory tag label */
.inv-new {
	display: inline-block;
	margin-left: 6px;
	padding: 2px 6px;
	border-radius: 999px;
	font-size: 10px;
	line-height: 10px;
	vertical-align: middle;
	background: rgba(255,255,255,0.18);
	border: 1px solid rgba(255,255,255,0.20);
	opacity: 0.9;
}

:: Patch_Messages_StampFix [script]
/*
  Patch v8 (WhatsApp-like Messages): stable per-message stamp/id.
  Why: old sorting used coarse "stamp" (day*10+tod), so chat list might not reorder correctly
       when multiple chats update within the same time-of-day. We add msgStamp + id for every message.
  Safe: wrappers call original functions, then decorate last message if missing.
*/

(function () {
  window.setup = window.setup || {};

  // Monotonic stamp (persistent across saves)
  setup._msgStamp = function () {
    var sv = State.variables || {};
    if (typeof sv._msgCounter !== "number") sv._msgCounter = 0;
    sv._msgCounter += 1;

    var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;
    var tod = (typeof sv.timeOfDayIndex === "number") ? sv.timeOfDayIndex : 0;

    // day and tod ensure stamps roughly follow game time; counter guarantees uniqueness
    return (day * 1000000) + (tod * 100000) + sv._msgCounter;
  };

  setup._msgId = function (prefix) {
    prefix = prefix || "msg";
    return prefix + "_" + setup._msgStamp();
  };

  function decorateLastMessage(thread, prefix) {
    if (!thread || !thread.length) return null;
    var m = thread[thread.length - 1];
    if (!m) return null;
    if (!m.msgStamp) m.msgStamp = setup._msgStamp();
    if (!m.id) m.id = setup._msgId(prefix || "msg");
    return m;
  }

  // ---- Phone / Messages ----
  if (typeof setup._phoneAddNpcMessage === "function" && !setup._phoneAddNpcMessage__v8wrapped) {
    setup._phoneAddNpcMessage__v8wrapped = true;
    var _oldPhoneNpc = setup._phoneAddNpcMessage;
    setup._phoneAddNpcMessage = function (npcId, text, opts) {
      _oldPhoneNpc(npcId, text, opts);
      var sv = State.variables;
      var st = sv && sv.messages && sv.messages[npcId];
      if (st && st.thread) decorateLastMessage(st.thread, "m");
    };
  }

  if (typeof setup.phoneChoosePlayerReply === "function" && !setup.phoneChoosePlayerReply__v8wrapped) {
    setup.phoneChoosePlayerReply__v8wrapped = true;
    var _oldChoose = setup.phoneChoosePlayerReply;
    setup.phoneChoosePlayerReply = function (npcId, choiceId) {
      _oldChoose(npcId, choiceId);
      var sv = State.variables;
      var st = sv && sv.messages && sv.messages[npcId];
      if (st && st.thread) decorateLastMessage(st.thread, "me");
    };
  }

  // ---- Fans ----
  if (typeof setup._fansAddNpcMessage === "function" && !setup._fansAddNpcMessage__v8wrapped) {
    setup._fansAddNpcMessage__v8wrapped = true;
    var _oldFansNpc = setup._fansAddNpcMessage;
    setup._fansAddNpcMessage = function (npcId, text, opts) {
      _oldFansNpc(npcId, text, opts);
      var sv = State.variables;
      var dm = sv && sv.fansApp && sv.fansApp.dm && sv.fansApp.dm[npcId];
      if (dm && dm.thread) decorateLastMessage(dm.thread, "fans");
    };
  }

  if (typeof setup.fansChoosePlayerReply === "function" && !setup.fansChoosePlayerReply__v8wrapped) {
    setup.fansChoosePlayerReply__v8wrapped = true;
    var _oldFansChoose = setup.fansChoosePlayerReply;
    setup.fansChoosePlayerReply = function (npcId, choiceId) {
      _oldFansChoose(npcId, choiceId);
      var sv = State.variables;
      var dm = sv && sv.fansApp && sv.fansApp.dm && sv.fansApp.dm[npcId];
      if (dm && dm.thread) decorateLastMessage(dm.thread, "fans_me");
    };
  }

  // ---- Match ----
  if (typeof setup._matchAddNpcMessage === "function" && !setup._matchAddNpcMessage__v8wrapped) {
    setup._matchAddNpcMessage__v8wrapped = true;
    var _oldMatchNpc = setup._matchAddNpcMessage;
    setup._matchAddNpcMessage = function (npcId, text, opts) {
      _oldMatchNpc(npcId, text, opts);
      var sv = State.variables;
      var dm = sv && sv.matchApp && sv.matchApp.dm && sv.matchApp.dm[npcId];
      if (dm && dm.thread) decorateLastMessage(dm.thread, "match");
    };
  }

  if (typeof setup.matchChoosePlayerReply === "function" && !setup.matchChoosePlayerReply__v8wrapped) {
    setup.matchChoosePlayerReply__v8wrapped = true;
    var _oldMatchChoose = setup.matchChoosePlayerReply;
    setup.matchChoosePlayerReply = function (npcId, choiceId) {
      _oldMatchChoose(npcId, choiceId);
      var sv = State.variables;
      var dm = sv && sv.matchApp && sv.matchApp.dm && sv.matchApp.dm[npcId];
      if (dm && dm.thread) decorateLastMessage(dm.thread, "match_me");
    };
  }
})();

:: Patch_Messages_Autoscroll_Queue_HistoryLimit [script]
/*
  v9 patch
  - WhatsApp-like autoscroll in chats (core Messages + Fans + Match)
  - Scheduled incoming messages queue (by day / time-of-day step)
  - Thread history limit (save-size protection)

  Notes:
  - Time model is your existing 4-step cycle: morning/day/evening/night.
  - Queue delivers messages on initGameState and after each advanceTime().
  - History trimming keeps recent messages and (optionally) keeps locked PPV items in Fans.
*/
(function () {
  window.setup = window.setup || {};

  /* ------------------------------------------------------
     CONFIG
     ------------------------------------------------------ */
  // You can tune these limits later; they affect save size the most.
  // core = Messages app, fans = Fans DM, match = Match chat
  setup.chatHistoryLimit = setup.chatHistoryLimit || {
    core : 220,
    fans : 260,
    match: 220
  };

  // When trimming Fans history, keep locked PPV messages so the player can still unlock them.
  if (typeof setup.chatHistoryKeepLockedPPV !== "boolean") {
    setup.chatHistoryKeepLockedPPV = true;
  }


  /* ------------------------------------------------------
     HISTORY LIMIT (thread trimming)
     ------------------------------------------------------ */
  setup._trimThreadSmart = function (thread, limit, keepFn) {
    if (!Array.isArray(thread)) return;
    limit = parseInt(limit, 10);
    if (!Number.isFinite(limit) || limit < 1) return;
    if (thread.length <= limit) return;

    keepFn = (typeof keepFn === "function") ? keepFn : function () { return false; };

    var must = [];
    for (var i = 0; i < thread.length; i++) {
      if (keepFn(thread[i])) must.push(i);
    }

    // If too many must-keep items, keep only the most recent ones.
    if (must.length > limit) {
      must = must.slice(must.length - limit);
    }

    var keepSet = {};
    must.forEach(function (idx) { keepSet[idx] = true; });

    var remaining = limit - must.length;
    if (remaining < 0) remaining = 0;

    // Add newest non-must messages until we reach the limit
    for (var j = thread.length - 1; j >= 0 && remaining > 0; j--) {
      if (keepSet[j]) continue;
      keepSet[j] = true;
      remaining--;
    }

    // Rebuild in original order
    var kept = [];
    for (var k = 0; k < thread.length; k++) {
      if (keepSet[k]) kept.push(thread[k]);
    }

    thread.length = 0;
    Array.prototype.push.apply(thread, kept);
  };

  setup._clampUnread = function (obj, threadProp) {
    if (!obj) return;
    var t = obj[threadProp] || obj.thread;
    if (!Array.isArray(t)) return;
    if (typeof obj.unread === "number") {
      if (obj.unread < 0) obj.unread = 0;
      if (obj.unread > t.length) obj.unread = t.length;
    }
  };

  setup.trimChatForNpc = function (app, npcId) {
    var sv = State.variables;
    var lim = setup.chatHistoryLimit || {};

    if (app === "core") {
      if (!sv.messages || !sv.messages[npcId]) return;
      var st = sv.messages[npcId];
      setup._trimThreadSmart(st.thread, lim.core, function (m) { return !!(m && (m.keep || m.pinned)); });
      setup._clampUnread(st, "thread");
      return;
    }

    if (app === "fans") {
      if (!sv.fansApp || !sv.fansApp.dm || !sv.fansApp.dm[npcId]) return;
      var dmF = sv.fansApp.dm[npcId];
      setup._trimThreadSmart(dmF.thread, lim.fans, function (m) {
        if (!m) return false;
        if (m.keep || m.pinned) return true;
        if (setup.chatHistoryKeepLockedPPV && m.type === "ppv" && m.ppv && !m.ppv.unlocked) return true;
        return false;
      });
      setup._clampUnread(dmF, "thread");
      return;
    }

    if (app === "match") {
      if (!sv.matchApp || !sv.matchApp.dm || !sv.matchApp.dm[npcId]) return;
      var dmM = sv.matchApp.dm[npcId];
      setup._trimThreadSmart(dmM.thread, lim.match, function (m) { return !!(m && (m.keep || m.pinned)); });
      setup._clampUnread(dmM, "thread");
      return;
    }
  };

  setup.trimAllChats = function () {
    var sv = State.variables;
    var lim = setup.chatHistoryLimit || {};

    if (sv.messages && typeof sv.messages === "object") {
      Object.keys(sv.messages).forEach(function (npcId) {
        if (!sv.messages[npcId]) return;
        setup._trimThreadSmart(sv.messages[npcId].thread, lim.core, function (m) { return !!(m && (m.keep || m.pinned)); });
        setup._clampUnread(sv.messages[npcId], "thread");
      });
    }

    if (sv.fansApp && sv.fansApp.dm) {
      Object.keys(sv.fansApp.dm).forEach(function (npcId) {
        var dm = sv.fansApp.dm[npcId];
        if (!dm) return;
        setup._trimThreadSmart(dm.thread, lim.fans, function (m) {
          if (!m) return false;
          if (m.keep || m.pinned) return true;
          if (setup.chatHistoryKeepLockedPPV && m.type === "ppv" && m.ppv && !m.ppv.unlocked) return true;
          return false;
        });
        setup._clampUnread(dm, "thread");
      });
    }

    if (sv.matchApp && sv.matchApp.dm) {
      Object.keys(sv.matchApp.dm).forEach(function (npcId) {
        var dm2 = sv.matchApp.dm[npcId];
        if (!dm2) return;
        setup._trimThreadSmart(dm2.thread, lim.match, function (m) { return !!(m && (m.keep || m.pinned)); });
        setup._clampUnread(dm2, "thread");
      });
    }
  };

  // Hook trimming into message add / player reply points (safe wrappers)
  function wrapTrim(fnName, getThread, app, npcArgIndex) {
    if (typeof setup[fnName] !== "function") return;
    var flag = fnName + "__v9trimwrapped";
    if (setup[flag]) return;
    setup[flag] = true;

    var old = setup[fnName];
    setup[fnName] = function () {
      var res = old.apply(this, arguments);
      try {
        var npcId = arguments[npcArgIndex || 0];
        if (npcId) setup.trimChatForNpc(app, npcId);
      } catch (e) {}
      return res;
    };
  }

  wrapTrim("_phoneAddNpcMessage", function (npcId) {
    var sv = State.variables;
    return sv && sv.messages && sv.messages[npcId] && sv.messages[npcId].thread;
  }, "core", 0);

  wrapTrim("phoneChoosePlayerReply", null, "core", 0);

  wrapTrim("_fansAddNpcMessage", null, "fans", 0);
  wrapTrim("fansChoosePlayerReply", null, "fans", 0);

  wrapTrim("_matchAddNpcMessage", null, "match", 0);
  wrapTrim("matchChoosePlayerReply", null, "match", 0);


  /* ------------------------------------------------------
     INCOMING QUEUE (by day/time-of-day)
     ------------------------------------------------------ */
  setup.ensureMsgQueueState = function () {
    var sv = State.variables;
    if (!sv.msgQueue || typeof sv.msgQueue !== "object" || Array.isArray(sv.msgQueue)) {
      sv.msgQueue = { core: [], fans: [], match: [] };
    }
    if (!Array.isArray(sv.msgQueue.core)) sv.msgQueue.core = [];
    if (!Array.isArray(sv.msgQueue.fans)) sv.msgQueue.fans = [];
    if (!Array.isArray(sv.msgQueue.match)) sv.msgQueue.match = [];

    if (typeof sv._msgQueueCounter !== "number") sv._msgQueueCounter = 0;
  };

  setup._nowStep = function () {
    var sv = State.variables;
    var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;
    var ti  = (typeof sv.timeOfDayIndex === "number") ? sv.timeOfDayIndex : 0; // 0..3
    return { day: day, timeIndex: ti };
  };

  setup._stepToStamp = function (day, timeIndex) {
    // Use the same 1..4 time slot encoding as phoneGetStamp() to stay consistent
    return (day * 10) + (timeIndex + 1);
  };

  setup._addSteps = function (day, timeIndex, steps) {
    steps = parseInt(steps, 10);
    if (!Number.isFinite(steps)) steps = 0;

    var len = (Array.isArray(setup.timeOfDayKeys) && setup.timeOfDayKeys.length) ? setup.timeOfDayKeys.length : 4;
    var t = timeIndex + steps;
    if (t < 0) t = 0;

    var dAdd = Math.floor(t / len);
    var t2 = t % len;

    return { day: day + dAdd, timeIndex: t2 };
  };

  setup._timeKeyToIndex = function (timeKey) {
    if (!timeKey) return null;
    if (typeof timeKey === "number" && Number.isFinite(timeKey)) return timeKey;
    if (!Array.isArray(setup.timeOfDayKeys)) return null;
    var idx = setup.timeOfDayKeys.indexOf(String(timeKey));
    return (idx >= 0) ? idx : null;
  };

  /**
   * Enqueue an incoming message.
   * payload examples:
   *   { type:'text', text:'hi' }
   *   { type:'media', text:'📷 Photo', media:{id:'m1', thumb:'...', full:'...', canWallpaper:true} }
   *   Fans PPV: { type:'ppv', text:'🔒 Locked message', ppv:{ id:'ppv1', price:10, text:'full', media:{...} } }
   *
   * opts:
   *   { inSteps: 1 }                 // after 1 time step
   *   { inDays: 2, atTime:'evening'} // in 2 days, at evening
   *   { atDay: 10, atTimeIndex: 0 }  // absolute
   */
  setup.queueIncomingMessage = function (app, npcId, payload, opts) {
    setup.ensureMsgQueueState();
    var sv = State.variables;

    app = (app === "fans" || app === "match") ? app : "core";
    if (!npcId) return null;
    payload = payload || {};
    opts = opts || {};

    var now = setup._nowStep();
    var day = now.day;
    var ti  = now.timeIndex;

    // relative steps (strongest)
    if (typeof opts.inSteps === "number" && Number.isFinite(opts.inSteps)) {
      var r = setup._addSteps(day, ti, opts.inSteps);
      day = r.day;
      ti  = r.timeIndex;
    }

    // relative days
    if (typeof opts.inDays === "number" && Number.isFinite(opts.inDays)) {
      day = day + opts.inDays;
    }

    // absolute overrides
    if (typeof opts.atDay === "number" && Number.isFinite(opts.atDay)) {
      day = opts.atDay;
    }

    if (typeof opts.atTimeIndex === "number" && Number.isFinite(opts.atTimeIndex)) {
      ti = Math.max(0, Math.min(3, opts.atTimeIndex));
    }

    if (typeof opts.atTime === "string" && opts.atTime) {
      var idx = setup._timeKeyToIndex(opts.atTime);
      if (typeof idx === "number") ti = idx;
    }

    // direct stamp override (rare)
    var dueStamp = (typeof opts.atStamp === "number" && Number.isFinite(opts.atStamp))
      ? opts.atStamp
      : setup._stepToStamp(day, ti);

    sv._msgQueueCounter += 1;

    var item = {
      id      : "mq_" + dueStamp + "_" + sv._msgQueueCounter,
      npcId   : npcId,
      app     : app,
      dueDay  : day,
      dueTimeIndex: ti,
      dueStamp: dueStamp,
      payload : payload
    };

    sv.msgQueue[app].push(item);

    // stable ordering
    sv.msgQueue[app].sort(function (a, b) {
      if (a.dueStamp !== b.dueStamp) return a.dueStamp - b.dueStamp;
      return String(a.id).localeCompare(String(b.id));
    });

    return item.id;
  };

  // Convenience helpers (core)
  setup.queueCoreText = function (npcId, text, opts) {
    return setup.queueIncomingMessage("core", npcId, { type: "text", text: text || "" }, opts);
  };
  setup.queueCoreMedia = function (npcId, text, media, opts) {
    return setup.queueIncomingMessage("core", npcId, { type: "media", text: text || "📷 Photo", media: media || {} }, opts);
  };

  // Fans
  setup.queueFansText = function (npcId, text, opts) {
    return setup.queueIncomingMessage("fans", npcId, { type: "text", text: text || "" }, opts);
  };
  setup.queueFansMedia = function (npcId, text, media, opts) {
    return setup.queueIncomingMessage("fans", npcId, { type: "media", text: text || "📷 Photo", media: media || {} }, opts);
  };
  setup.queueFansPPV = function (npcId, previewText, ppv, opts) {
    return setup.queueIncomingMessage("fans", npcId, { type: "ppv", text: previewText || "🔒 PPV", ppv: ppv || {} }, opts);
  };

  // Match
  setup.queueMatchText = function (npcId, text, opts) {
    return setup.queueIncomingMessage("match", npcId, { type: "text", text: text || "" }, opts);
  };
  setup.queueMatchMedia = function (npcId, text, media, opts) {
    return setup.queueIncomingMessage("match", npcId, { type: "media", text: text || "📷 Photo", media: media || {} }, opts);
  };

  setup.processMsgQueue = function () {
    setup.ensureMsgQueueState();
    var sv = State.variables;
    var now = setup._nowStep();
    var nowStamp = setup._stepToStamp(now.day, now.timeIndex);

    function deliver(app) {
      var q = sv.msgQueue[app];
      if (!Array.isArray(q) || !q.length) return;

      var keep = [];
      for (var i = 0; i < q.length; i++) {
        var it = q[i];
        if (!it || typeof it.dueStamp !== "number") continue;
        if (it.dueStamp > nowStamp) {
          keep.push(it);
          continue;
        }

        // DUE -> deliver
        var p = it.payload || {};
        var npcId = it.npcId;

        try {
          if (app === "core") {
            if (typeof setup._phoneAddNpcMessage === "function") {
              if (p.type === "media" && p.media) {
                setup._phoneAddNpcMessage(npcId, p.text || "📷 Photo", { type: "media", media: p.media });
              } else {
                setup._phoneAddNpcMessage(npcId, p.text || "", { type: "text" });
              }
            }
          }
          else if (app === "fans") {
            if (p.type === "ppv" && typeof setup._fansAddNpcMessage === "function") {
              setup._fansAddNpcMessage(npcId, p.text || "🔒 PPV", { type: "ppv", ppv: p.ppv || {} });
            }
            else if (p.type === "media" && typeof setup._fansAddNpcMessage === "function") {
              setup._fansAddNpcMessage(npcId, p.text || "📷 Photo", { type: "media", media: p.media || {} });
            }
            else if (typeof setup._fansAddNpcMessage === "function") {
              setup._fansAddNpcMessage(npcId, p.text || "", { type: "text" });
            }
          }
          else if (app === "match") {
            if (p.type === "media" && typeof setup._matchAddNpcMessage === "function") {
              setup._matchAddNpcMessage(npcId, p.text || "📷 Photo", { type: "media", media: p.media || {} });
            }
            else if (typeof setup._matchAddNpcMessage === "function") {
              setup._matchAddNpcMessage(npcId, p.text || "", { type: "text" });
            }
          }
        } catch (e) {
          // If delivery fails, keep it (so it doesn't disappear silently)
          keep.push(it);
        }
      }

      sv.msgQueue[app] = keep;
    }

    deliver("core");
    deliver("fans");
    deliver("match");

    // Keep threads tidy after bulk delivery (just in case)
    setup.trimAllChats();
  };

  // Hook queue processing into initGameState and advanceTime
  if (typeof setup.initGameState === "function" && !setup.initGameState__v9queueHook) {
    setup.initGameState__v9queueHook = true;
    var _oldInit = setup.initGameState;
    setup.initGameState = function () {
      var res = _oldInit.apply(this, arguments);
      try {
        setup.ensureMsgQueueState();
        setup.processMsgQueue();
      } catch (e) {}
      return res;
    };
  }

  if (typeof setup.advanceTime === "function" && !setup.advanceTime__v9queueHook) {
    setup.advanceTime__v9queueHook = true;
    var _oldAdv = setup.advanceTime;
    setup.advanceTime = function (steps) {
      var res = _oldAdv.apply(this, arguments);
      try {
        setup.processMsgQueue();
      } catch (e) {}
      return res;
    };
  }


  /* ------------------------------------------------------
     WHATSAPP-LIKE AUTOSCROLL
     ------------------------------------------------------ */
  setup.ensureChatScrollState = function () {
    var sv = State.variables;
    if (!sv.chatScroll || typeof sv.chatScroll !== "object" || Array.isArray(sv.chatScroll)) {
      sv.chatScroll = { core: {}, fans: {}, match: {} };
    }
    if (!sv.chatScroll.core) sv.chatScroll.core = {};
    if (!sv.chatScroll.fans) sv.chatScroll.fans = {};
    if (!sv.chatScroll.match) sv.chatScroll.match = {};
  };

  setup._getActiveChatKey = function () {
    var sv = State.variables;
    if (!sv || !sv.phoneScreen) return null;

    var npcId = sv.phoneScreenData && sv.phoneScreenData.npcId;
    if (!npcId) return null;

    if (sv.phoneScreen === "messagesChat") return { app: "core", npcId: npcId };
    if (sv.phoneScreen === "fansChat") return { app: "fans", npcId: npcId };
    if (sv.phoneScreen === "matchChat") return { app: "match", npcId: npcId };

    return null;
  };

  setup.phoneChatAfterRender = function () {
    if (!$("#phone-overlay").hasClass("visible")) return;

    var key = setup._getActiveChatKey();
    if (!key) return;

    setup.ensureChatScrollState();
    var sv = State.variables;

    if (!sv.chatScroll[key.app][key.npcId]) {
      sv.chatScroll[key.app][key.npcId] = { lock: false, scrollTop: 0 };
    }

    var st = sv.chatScroll[key.app][key.npcId];

    var $box = $("#phone-overlay-screen-content").find(".phone-chat-bubbles").first();
    if (!$box.length) return;

    // One handler per render (replace old)
    $box.off("scroll.v9chat").on("scroll.v9chat", function () {
      var el = this;
      var atBottom = (el.scrollHeight - (el.scrollTop + el.clientHeight)) <= 24;
      st.lock = !atBottom;
      st.scrollTop = el.scrollTop;
      st.atBottom = atBottom;
    });

    // Restore / autoscroll after DOM settles
    window.setTimeout(function () {
      var el = $box.get(0);
      if (!el) return;

      // If user isn't reading older messages -> stay at bottom.
      if (!st.lock) {
        el.scrollTop = el.scrollHeight;
        st.scrollTop = el.scrollTop;
        st.atBottom = true;
        return;
      }

      // User scrolled up -> preserve their scrollTop as best as possible.
      var maxTop = Math.max(0, el.scrollHeight - el.clientHeight);
      el.scrollTop = Math.max(0, Math.min(maxTop, st.scrollTop || 0));

      var atBottom2 = (el.scrollHeight - (el.scrollTop + el.clientHeight)) <= 24;
      st.atBottom = atBottom2;
    }, 0);
  };

  // Wrap phoneRender so every re-render reapplies WA autoscroll rules.
  if (typeof setup.phoneRender === "function" && !setup.phoneRender__v9autoscroll) {
    setup.phoneRender__v9autoscroll = true;
    var _oldPhoneRender = setup.phoneRender;
    setup.phoneRender = function () {
      var res = _oldPhoneRender.apply(this, arguments);
      try { setup.phoneChatAfterRender(); } catch (e) {}
      return res;
    };
  }

})();

:: Patch_Messages_InboxOrderFix [script]
/*
  v9.1 mini-fix
  - Messages inbox ordering uses lastMsg.msgStamp (monotonic) when available.
    This prevents ties when several chats receive messages within the same time-of-day slot.
*/
(function () {
  window.setup = window.setup || {};

  if (typeof setup.phoneRenderMessages !== "function" || setup.phoneRenderMessages__v91orderFix) {
    return;
  }
  setup.phoneRenderMessages__v91orderFix = true;

  setup.phoneRenderMessages = function () {
    setup.ensureMessagesState();
    var sv = State.variables;

    var q = (typeof sv.messagesSearch === "string") ? sv.messagesSearch : "";

    // Collect chats (only unlocked + phoneUnlocked)
    var rows = [];

    setup.npcDefinitions.forEach(function (def) {
      var npcState = sv.npcs && sv.npcs[def.id];
      if (!npcState || !npcState.unlocked || !npcState.phoneUnlocked) return;

      var msgState = sv.messages[def.id];
      if (!msgState) return;

      var name = (typeof def.name === "function") ? def.name() : (def.name || def.id);
      var avatar = def.icon || def.avatarMini || def.avatar || "src/icon/avatar.png";

      var lastMsg = (msgState.thread && msgState.thread.length)
        ? msgState.thread[msgState.thread.length - 1]
        : null;

      // preview: typing > explicit previewText > lastMsg
      var preview = "";
      if (msgState.typing) {
        preview = "typing…";
      } else if (msgState.previewText) {
        preview = msgState.previewText;
      } else if (lastMsg && lastMsg.text) {
        preview = lastMsg.text;
      } else if (lastMsg && lastMsg.media) {
        preview = "📷 Photo";
      }

      // time label
      var timeLabel = "";
      if (lastMsg) {
        var d = (typeof lastMsg.day === "number") ? lastMsg.day : null;
        if (d !== null && d !== setup.phoneGetDayCounter()) {
          timeLabel = setup.phoneDayLabel(d);
        } else {
          timeLabel = lastMsg.time || lastMsg.timeLabel || "";
        }
      }

      // sorting stamp (prefer monotonic msgStamp when available)
      var stamp = 0;
      if (lastMsg && typeof lastMsg.msgStamp === "number") {
        stamp = lastMsg.msgStamp;
      } else if (lastMsg && typeof lastMsg.stamp === "number") {
        stamp = (lastMsg.stamp * 100000); // widen to reduce ties
      } else {
        stamp = (msgState.thread ? msgState.thread.length : 0);
      }

      var hay = (String(name) + " " + String(preview)).toLowerCase();

      rows.push({
        id       : def.id,
        name     : name,
        avatar   : avatar,
        msgState : msgState,
        lastMsg  : lastMsg,
        preview  : preview,
        timeLabel: timeLabel,
        stamp    : stamp,
        hay      : hay
      });
    });

    // Sort newest first; tie-breaker by name for stability
    rows.sort(function (a, b) {
      var da = (a.stamp || 0);
      var db = (b.stamp || 0);
      if (db !== da) return db - da;
      return String(a.name).localeCompare(String(b.name));
    });

    var html = '';
    html += '<div class="wa-messages">';
    html += '  <div class="wa-searchbar">';
    html += '    <span class="wa-search-ico">🔍</span>';
    html += '    <input class="wa-search-input" type="text" placeholder="Search" data-msg-search="1" value="' + setup.escapeHtml(q) + '">';
    html += '    <button class="wa-search-clear" data-msg-search-clear="1" title="Clear">×</button>';
    html += '  </div>';

    html += '  <div class="wa-chatlist">';

    rows.forEach(function (r) {
      var unread = Number(r.msgState.unread) || 0;

      // ticks (only if last msg from player)
      var ticks = "";
      if (r.lastMsg && r.lastMsg.from === "player") {
        var st = r.lastMsg.status || "sent";
        if (st === "read") {
          ticks = '<span class="wa-ticks wa-ticks--read">✓✓</span>';
        } else if (st === "delivered") {
          ticks = '<span class="wa-ticks wa-ticks--delivered">✓✓</span>';
        } else {
          ticks = '<span class="wa-ticks wa-ticks--sent">✓</span>';
        }
      }

      html += ''
        + '<button class="wa-chatrow phone-chat-list-item" '
        + 'data-chat-id="' + setup.escapeHtml(r.id) + '" '
        + 'data-search="' + setup.escapeHtml(r.hay) + '">' 
        + '  <div class="wa-avatar" style="background-image:url(\'' + setup.escapeHtml(r.avatar) + '\')"></div>'
        + '  <div class="wa-chatmain">'
        + '    <div class="wa-row1">'
        + '      <div class="wa-name">' + setup.escapeHtml(r.name) + '</div>'
        + '      <div class="wa-time">' + setup.escapeHtml(r.timeLabel || "") + '</div>'
        + '    </div>'
        + '    <div class="wa-row2">'
        + '      <div class="wa-preview ' + (r.msgState.typing ? 'wa-preview--typing' : '') + '">' + ticks + setup.escapeHtml(r.preview || "") + '</div>'
        + (unread > 0 ? '      <div class="wa-unread">' + unread + '</div>' : '')
        + '    </div>'
        + '  </div>'
        + '</button>';
    });

    if (!rows.length) {
      html += '<div class="wa-empty">No chats yet.</div>';
    }

    // empty state for search
    html += '<div class="wa-empty wa-empty-search" style="display:none;">No matches.</div>';

    html += '  </div>';
    html += '</div>';

    return html;
  };
})();

