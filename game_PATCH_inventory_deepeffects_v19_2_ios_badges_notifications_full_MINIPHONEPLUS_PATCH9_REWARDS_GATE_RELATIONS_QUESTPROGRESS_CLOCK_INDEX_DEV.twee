	// ------------------------------
	// WORLD CLOCK + dayChanged
	// ------------------------------
	setup.getDay = function () { return (typeof setup._nowDay === "function") ? setup._nowDay() : 0; };
	setup.setDay = function (newDay) {
		var sv = State.variables;
		var oldDay = setup.getDay();
		newDay = Number(newDay || 0);
		if (!isFinite(newDay)) newDay = oldDay;
		if (typeof sv.dayCounter === "number") sv.dayCounter = newDay;
		else if (typeof sv.day === "number") sv.day = newDay;
		else sv.dayCounter = newDay;

		if (newDay !== oldDay) {
			if (typeof setup.emitGameEvent === "function") {
				try { setup.emitGameEvent("dayChanged", { from: oldDay, to: newDay }); } catch (e) {}
			}
			if (typeof setup.questEvent === "function") {
				try { setup.questEvent("dayChanged", { from: oldDay, to: newDay, day: newDay }); } catch (e) {}
			}
		}
		return newDay;
	};
	setup.addDays = function (delta) {
		delta = Number(delta || 0);
		if (!isFinite(delta) || delta === 0) delta = 1;
		return setup.setDay(setup.getDay() + delta);
	};

	// Macro: <<addDays 1>>
	if (typeof Macro !== "undefined" && Macro && Macro.add && !Macro.has("addDays")) {
		Macro.add("addDays", {
			handler: function () {
				var n = (this.args.length ? Number(this.args[0]) : 1);
				if (!isFinite(n) || n === 0) n = 1;
				setup.addDays(n);
			}
		});
	}

	// ------------------------------
	// Save schema bump (patch9 aware)
	// ------------------------------
	try {
		if (typeof setup.SCHEMA_VERSION === "number") setup.SCHEMA_VERSION = Math.max(setup.SCHEMA_VERSION, 9);
	} catch (e) {}

	// ------------------------------
	// Devtools bindings extension
	// ------------------------------
	if (!setup.__phoneBindCheatsHandlers_v9 && typeof setup.phoneBindCheatsHandlers === "function") {
		setup.__phoneBindCheatsHandlers_v9 = setup.phoneBindCheatsHandlers;
		setup.phoneBindCheatsHandlers = function ($content) {
			setup.__phoneBindCheatsHandlers_v9.apply(this, arguments);
			try {
				var $c = $content;
				if (!$c || !$c.find) return;

				// Relations: recompute
				$c.find("[data-cheats-rel-recalc]").off("click.cheatsRel").on("click.cheatsRel", function () {
					var sv = State.variables;
					if (typeof setup.updateAllNpcRelationLevels === "function") setup.updateAllNpcRelationLevels();
					if (setup.toast) setup.toast("Recomputed relation levels", "info", 1600);
					setup.phoneRender();
				});

				// Dev mode toggle
				$c.find("[data-cheats-dev-toggle]").off("click.cheatsDevToggle").on("click.cheatsDevToggle", function () {
					var v = !setup.isDev();
					setup.setDevMode(v);
					if (setup.toast) setup.toast("Dev mode: " + (v ? "ON" : "OFF"), "info", 1600);
					setup.phoneRender();
				});

				// Rebuild indexes
				$c.find("[data-cheats-rebuild-index]").off("click.cheatsIdx").on("click.cheatsIdx", function () {
					setup.rebuildIndexes(true);
					if (setup.toast) setup.toast("Indexes rebuilt", "info", 1600);
					setup.phoneRender();
				});

			} catch (e) {}
		};
	}

})();


setup.phoneRenderQuests = function () {
	setup.ensureQuestSystem();
	var sv = State.variables;
	var data = sv.phoneScreenData || {};
	var view = data.view || "list"; // list | detail
	var tab  = data.tab || "active"; // active | completed

	var esc = setup.escapeHtml;
	var ids = Object.keys(setup.questDefs || {});

	function getStatus(id) {
		var st = sv.questState && sv.questState[id];
		return st ? st.status : "locked";
	}

	function getVisibleIds() {
		return ids.filter(function (id) {
			var s = getStatus(id);
			if (tab === "completed") return (s === "completed");
			return (s === "active");
		});
	}

	function renderTabs() {
		var a = (tab === "active") ? " active" : "";
		var c = (tab === "completed") ? " active" : "";
		return '' +
			'<div class="q-tabs">' +
			'  <button class="q-tab' + a + '" data-quest-tab="active">Active</button>' +
			'  <button class="q-tab' + c + '" data-quest-tab="completed">Completed</button>' +
			'</div>';
	}

	function progressPct(id) {
		var def = setup.questDefs[id] || {};
		var st  = sv.questState[id] || {};
		var total = (def.steps && def.steps.length) ? def.steps.length : 1;
		var cur = Number(st.step || 0);
		if (!isFinite(cur) || cur < 0) cur = 0;
		if (cur > total) cur = total;
		return Math.round((cur / total) * 100);
	}

	function currentStepText(id) {
		var def = setup.questDefs[id] || {};
		var st  = sv.questState[id] || {};
		var idx = Number(st.step || 0);
		if (!def.steps || !def.steps.length) return "";
		if (idx >= def.steps.length) idx = def.steps.length - 1;
		var step = def.steps[idx];
		var txt = step ? (step.text || "") : "";
		return (typeof setup.questFormatStepText === "function") ? setup.questFormatStepText(id, idx, txt, step, st) : txt;
	}

	function currentStepHint(id) {
		var def = setup.questDefs[id] || {};
		var st  = sv.questState[id] || {};
		var idx = Number(st.step || 0);
		if (!def.steps || !def.steps.length) return "";
		if (idx >= def.steps.length) idx = def.steps.length - 1;
		var step = def.steps[idx];
		return step ? (step.hint || "") : "";
	}

	// Detail view
	if (view === "detail") {
		var qid = String(data.questId || "");
		var def = setup.questDefs[qid];
		if (!def) {
			return '<div class="phone-section"><div class="phone-ui-placeholder">Quest not found</div></div>';
		}
		var st = setup.questGetState(qid);
		var pct = progressPct(qid);
		var status = st.status || "locked";
		var statusLabel = (status === "active") ? "ACTIVE" : (status === "completed") ? "COMPLETED" : (status === "failed") ? "FAILED" : "LOCKED";
		var tracked = st.tracked ? " tracked" : "";

		var html = '' +
		'<div class="phone-section q-detail">' +
		'  <div class="q-head">' +
		'    <div class="q-ico">' + esc(def.icon || "📜") + '</div>' +
		'    <div class="q-meta">' +
		'      <div class="q-title">' + esc(def.title || qid) + '</div>' +
		'      <div class="q-sub">' + esc(def.desc || "") + '</div>' +
		'    </div>' +
		'    <div class="q-pill q-pill--' + esc(status) + '">' + esc(statusLabel) + '</div>' +
		'  </div>' +
		'  <div class="q-progress"><div class="q-bar"><div class="q-bar-fill" style="width:' + pct + '%"></div></div><div class="q-pct">' + pct + '%</div></div>' +
		'  <div class="q-actions">' +
		'    <button class="q-btn' + tracked + '" data-quest-track="' + esc(qid) + '">' + (tracked ? '📌 Tracked' : '📌 Track') + '</button>' +
		'    <button class="q-btn" data-quest-hint="' + esc(qid) + '">' + (st.showHint ? '🙈 Hide hint' : '👁 Show hint') + '</button>' +
		(status === "active" ? ('    <button class="q-btn q-btn--danger" data-quest-abandon="' + esc(qid) + '">⛔ Abandon</button>') : '') +
		'  </div>';

		// steps
		if (Array.isArray(def.steps) && def.steps.length) {
			html += '<div class="q-steps">';
			for (var i = 0; i < def.steps.length; i++) {
				var s = def.steps[i];
				var done = (i < (st.step||0));
				var cur = (i === (st.step||0));
				html += '<div class="q-step' + (done ? ' done' : '') + (cur ? ' cur' : '') + '">' +
					'<div class="q-step-dot">' + (done ? '✓' : (cur ? '•' : '')) + '</div>' +
					'<div class="q-step-txt">' + esc((typeof setup.questFormatStepText === "function") ? setup.questFormatStepText(qid, i, (s.text||""), s, st) : (s.text||"")) + '</div>' +
				'</div>';
				if (cur && st.showHint && s.hint) {
					html += '<div class="q-hint">💡 ' + esc(s.hint) + '</div>';
				}
			}
			html += '</div>';
		}

		html += '</div>';
		return html;
	}

	// List view
	var vis = getVisibleIds();
	var html2 = '' +
	'<div class="phone-section">' +
	'  <div class="phone-section-title">Quests</div>' +
		renderTabs() +
	'  <div class="q-list">';

	if (!vis.length) {
		html2 += '<div class="q-empty">No quests here yet.</div>';
	} else {
		vis.forEach(function (qid) {
			var def = setup.questDefs[qid] || {};
			var st = setup.questGetState(qid);
			var pct = progressPct(qid);
			var stepTxt = currentStepText(qid);
			var stepHint = currentStepHint(qid);
			html2 += '' +
			'<div class="q-card" data-quest-open="' + esc(qid) + '">' +
			'  <div class="q-card-ico">' + esc(def.icon || "📜") + '</div>' +
			'  <div class="q-card-main">' +
			'    <div class="q-card-title">' + esc(def.title || qid) + (st.tracked ? ' <span class="q-pin">📌</span>' : '') + '</div>' +
			'    <div class="q-card-step">' + esc(stepTxt || def.desc || "") + '</div>' +
			(st.showHint && stepHint ? ('    <div class="q-card-hint">💡 ' + esc(stepHint) + '</div>') : '') +
			'    <div class="q-card-bar"><div class="q-bar"><div class="q-bar-fill" style="width:' + pct + '%"></div></div><div class="q-pct">' + pct + '%</div></div>' +
			'  </div>' +
			'</div>';
		});
	}

	html2 += '  </div></div>';
	return html2;
};

setup.phoneRenderCheats = function () {
		var sv = State.variables;
		if (typeof setup.migrateSaveIfNeeded === "function") setup.migrateSaveIfNeeded();
		if (!sv.cheatsState || typeof sv.cheatsState !== "object" || Array.isArray(sv.cheatsState)) {
			sv.cheatsState = { tab: "validation", giftNpcId: "", giftItemId: "", giftQty: 1, dynShowLog: true, relNpcId: "" };
		}

		var tab = String(sv.cheatsState.tab || "validation");

		var dev = (typeof setup.isDev === "function") ? setup.isDev() : true;

		var html = '';
		html += '<div class="phone-section phone-cheats">';
		html += '  <div class="phone-section-title">Dev Tools</div>';

		// Tabs
		html += '  <div class="phone-chips phone-cheats-tabs">';
		function chip(key, label) {
			html += '    <button class="phone-chip' + (tab === key ? ' active' : '') + '" data-cheats-tab="' + key + '">' + label + '</button>';
		}
		chip("validation", "Validation");
		chip("gift", "Gift tester");
		chip("dyn", "Dynamic events");
			chip("relations", "Relations");
			chip("settings", "Settings");
		html += '  </div>';

		// ---------------- Validation tab ----------------
		if (tab === "validation") {
			var last = sv.cheatsValidation || null;
			html += '  <div class="phone-cheats-panel">';
			html += '    <div class="phone-cheats-actions">';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-validate="1">Run validation</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-refresh="1">Refresh</button>';
			html += '    </div>';

			if (last && last.time) {
				var t = new Date(Number(last.time) || Date.now());
				html += '    <div class="phone-cheats-meta">Last run: ' + setup._cheatsEscape(t.toLocaleString()) + '</div>';
				html += '    <div class="phone-cheats-summary ' + (last.ok ? 'ok' : 'bad') + '">';
				html += '      ' + (last.ok ? 'OK' : 'Issues found') + ' — Errors: ' + (last.errors ? last.errors.length : 0) + ', Warnings: ' + (last.warnings ? last.warnings.length : 0);
				html += '    </div>';

				function renderList(title, arr, cls) {
					if (!arr || !arr.length) return;
					html += '    <div class="phone-cheats-subtitle">' + title + '</div>';
					html += '    <div class="phone-cheats-list ' + cls + '">';
					for (var i = 0; i < arr.length; i++) {
						var it = arr[i];
						html += '      <div class="phone-cheats-row">' + setup._cheatsEscape(it.msg) + '</div>';
					}
					html += '    </div>';
				}
				renderList("Errors", last.errors, "errs");
				renderList("Warnings", last.warnings, "warns");
			} else {
				html += '    <div class="phone-cheats-muted">Run validation to check items/offers/rules/events.</div>';
			}

			html += '  </div>';
		}

		// ---------------- Gift tester tab ----------------
		if (tab === "gift") {
			setup.ensureGiftState();
			var npcId = String(sv.cheatsState.giftNpcId || "");
			var itemId = String(sv.cheatsState.giftItemId || "");
			var qty = Number(sv.cheatsState.giftQty || 1);
			if (!isFinite(qty) || qty < 1) qty = 1;

			// Defaults: first unlocked npc + first item
			var npcKeys = (sv.npcs && typeof sv.npcs === "object") ? Object.keys(sv.npcs) : [];
			npcKeys.sort(function (a, b) {
				var na = (sv.npcs[a] && sv.npcs[a].name) ? sv.npcs[a].name : a;
				var nb = (sv.npcs[b] && sv.npcs[b].name) ? sv.npcs[b].name : b;
				return String(na).localeCompare(String(nb));
			});

			if (!npcId && npcKeys.length) npcId = npcKeys[0];
			if (!itemId && Array.isArray(setup.shopItems) && setup.shopItems.length) itemId = String(setup.shopItems[0].id || "");

			html += '  <div class="phone-cheats-panel">';
			html += '    <div class="phone-cheats-subtitle">Test gift rule matching</div>';

			// Controls
			html += '    <div class="phone-cheats-form">';
			html += '      <div class="phone-cheats-field"><div class="lbl">NPC</div><select class="phone-cheats-select" data-cheats-gift-npc="1">';
			for (var i = 0; i < npcKeys.length; i++) {
				var id = npcKeys[i];
				var nm = (sv.npcs[id] && sv.npcs[id].name) ? sv.npcs[id].name : id;
				html += '<option value="' + setup._cheatsEscape(id) + '"' + (id === npcId ? ' selected' : '') + '>' + setup._cheatsEscape(nm + ' (' + id + ')') + '</option>';
			}
			html += '      </select></div>';

			html += '      <div class="phone-cheats-field"><div class="lbl">Item</div><select class="phone-cheats-select" data-cheats-gift-item="1">';
			var items = Array.isArray(setup.shopItems) ? setup.shopItems.slice() : [];
			items.sort(function (a, b) { return String(a.name || a.id).localeCompare(String(b.name || b.id)); });
			for (var j = 0; j < items.length; j++) {
				var it = items[j];
				if (!it || !it.id) continue;
				html += '<option value="' + setup._cheatsEscape(it.id) + '"' + (String(it.id) === itemId ? ' selected' : '') + '>' + setup._cheatsEscape((it.name || it.id) + ' (' + it.id + ')') + '</option>';
			}
			html += '      </select></div>';

			html += '      <div class="phone-cheats-field small"><div class="lbl">Qty</div><input class="phone-cheats-input" type="number" min="1" max="999" step="1" value="' + qty + '" data-cheats-gift-qty="1"></div>';
			html += '      <div class="phone-cheats-field"><button class="phone-btn phone-btn-small" data-cheats-gift-run="1">Run</button></div>';
			html += '    </div>';

			// Output
			var list = setup.cheatsListGiftRules(npcId, itemId, qty);
			if (!list.length) {
				html += '    <div class="phone-cheats-muted">No matching gift rules for this NPC+item.</div>';
			} else {
				html += '    <div class="phone-cheats-subtitle">Matched rules (by priority)</div>';
				html += '    <div class="phone-cheats-list">';
				list.forEach(function (r) {
					var lines = setup._cheatsEffectLines(r.effects);
					html += '      <div class="phone-cheats-card">';
					html += '        <div class="row1"><span class="id">' + setup._cheatsEscape(r.id || "(no id)") + '</span><span class="meta">pr:' + (r.priority || 0) + (r.stop ? ' • stop' : '') + '</span></div>';
					html += '        <div class="row2 ' + (r.canFire ? 'ok' : 'bad') + '">' + (r.canFire ? 'Will fire now' : 'Blocked by once/cooldown') + (r.chance != null ? (' • chance ' + r.chance) : '') + '</div>';
					if (lines.length) {
						html += '        <div class="effects">';
						lines.slice(0, 10).forEach(function (ln) { html += '<div class="eff">' + setup._cheatsEscape(ln) + '</div>'; });
						if (lines.length > 10) html += '<div class="eff">…</div>';
						html += '        </div>';
					} else {
						html += '        <div class="effects"><div class="eff muted">(no effects)</div></div>';
					}
					html += '      </div>';
				});
				html += '    </div>';
			}
			html += '  </div>';
		}

		// ---------------- Dynamic events tab ----------------
		if (tab === "dyn") {
			setup.ensureDynamicEvents();
			var st = State.variables.dynEventState;
			var auto = !!State.variables.dynEventsAuto;

			html += '  <div class="phone-cheats-panel">';
			html += '    <div class="phone-cheats-subtitle">Dynamic Events</div>';

			html += '    <div class="phone-cheats-actions">';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-dyn-auto="1">' + (auto ? 'Auto: ON' : 'Auto: OFF') + '</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-dyn-tick="1">Tick (manual)</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-dyn-clearlog="1">Clear log</button>';
			html += '      <button class="phone-btn phone-btn-small" data-cheats-refresh="1">Refresh</button>';
			html += '    </div>';

			// Log
			if (sv.cheatsState.dynShowLog) {
				html += '    <div class="phone-cheats-subtitle">Debug log</div>';
				html += '    <div class="phone-cheats-list log">';
				var log = (st && Array.isArray(st.log)) ? st.log : [];
				var start = Math.max(0, log.length - 20);
				for (var i2 = log.length - 1; i2 >= start; i2--) {
					html += '      <div class="phone-cheats-row muted">' + setup._cheatsEscape(log[i2]) + '</div>';
				}
				if (!log.length) html += '      <div class="phone-cheats-row muted">(empty)</div>';
				html += '    </div>';
			}

			// Events list
			var defs = setup.dynamicEventDefs || {};
			var keys = Object.keys(defs);
			keys.sort();
			html += '    <div class="phone-cheats-subtitle">Events</div>';
			if (!keys.length) {
				html += '    <div class="phone-cheats-muted">No dynamic events defined.</div>';
			} else {
				html += '    <div class="phone-cheats-list">';
				keys.forEach(function (id) {
					var def = defs[id];
					if (!def) return;
					def.id = String(def.id || id);

					var eligible = (typeof setup._dynEligible === "function") ? setup._dynEligible(def, {}, false) : false;
					var reasons = eligible ? [] : setup.dynExplainIneligible(def, false);
					var chance = (def.chance == null ? null : Number(def.chance));
					var pr = (typeof def.priority === "number") ? def.priority : 0;

					// last fired
					var cdKey = def.cooldownKey ? String(def.cooldownKey) : String(def.onceKey || def.id);
					var last = st && st.last ? st.last[cdKey] : null;

					html += '      <div class="phone-cheats-card">';
					html += '        <div class="row1"><span class="id">' + setup._cheatsEscape(def.id) + '</span><span class="meta">pr:' + pr + (chance != null ? (' • chance ' + chance) : '') + '</span></div>';
					html += '        <div class="row2 ' + (eligible ? 'ok' : 'bad') + '">' + (eligible ? 'Eligible now' : ('Not eligible: ' + setup._cheatsEscape(reasons.slice(0, 2).join(", ") || "blocked"))) + '</div>';
					html += '        <div class="row3 muted">scene: ' + setup._cheatsEscape(def.sceneId || "(none)") + (last && typeof last.day === "number" ? (' • last: day ' + last.day + ' @ ' + (last.passage || "?")) : '') + '</div>';
					html += '        <div class="row4 actions"><button class="phone-btn phone-btn-small" data-cheats-dyn-fire="' + setup._cheatsEscape(def.id) + '"' + (dev ? '' : ' disabled') + '>' + (dev ? 'Fire now' : 'Dev only') + '</button></div>';
					html += '      </div>';
				});
				html += '    </div>';
			}

			html += '  </div>';
		}


		} else if (tab === "relations") {
			html += '  <div class="phone-cheats-pane">';
			html += '    <div class="phone-cheats-subtitle">NPC Relations</div>';
			html += '    <div class="phone-cheats-meta">Shows current relation status/level + core stats. Use this to debug auto transitions.</div>';

			// Controls
			html += '    <div class="phone-cheats-actions">';
			html += '      <button class="phone-btn" data-cheats-rel-recalc="1">Recompute all levels</button>';
			html += '    </div>';

			var sv2 = State.variables;
			var npcs = (sv2 && sv2.npcs) ? sv2.npcs : {};
			var ids2 = Object.keys(npcs || {});
			ids2.sort();

			if (!ids2.length) {
				html += '    <div class="phone-cheats-empty">No NPCs in save yet.</div>';
			} else {
				html += '    <div class="phone-cheats-list">';
				for (var ri = 0; ri < ids2.length; ri++) {
					var nid = ids2[ri];
					var npc = npcs[nid] || {};
					var stats = npc.stats || {};
					var love = (typeof stats.love === "number") ? stats.love : (Number(stats.love) || 0);
					var trust = (typeof stats.trust === "number") ? stats.trust : (Number(stats.trust) || 0);
					var statusKey = (typeof setup.getNpcRelationStatus === "function") ? setup.getNpcRelationStatus(nid) : (npc.relationStatus || "neutral");
					var statusTitle = (typeof setup.getNpcRelationStatusTitle === "function") ? setup.getNpcRelationStatusTitle(nid) : statusKey;
					var lvlKey = (typeof setup.getNpcRelationLevel === "function") ? setup.getNpcRelationLevel(nid) : (npc.relationLevel || "none");
					var lvlTitle = (typeof setup.getNpcRelationLevelTitle === "function") ? setup.getNpcRelationLevelTitle(nid) : lvlKey;

					html += '      <div class="phone-cheats-row">';
					html += '        <div class="row1"><b>' + setup._cheatsEscape(nid) + '</b></div>';
					html += '        <div class="row2">Status: ' + setup._cheatsEscape(statusTitle) + ' • Level: ' + setup._cheatsEscape(lvlTitle) + '</div>';
					html += '        <div class="row3">love: ' + setup._cheatsEscape(String(love)) + ' • trust: ' + setup._cheatsEscape(String(trust)) + '</div>';
					html += '      </div>';
				}
				html += '    </div>';
			}

			html += '  </div>';

		} else if (tab === "settings") {
			html += '  <div class="phone-cheats-pane">';
			html += '    <div class="phone-cheats-subtitle">Developer settings</div>';
			html += '    <div class="phone-cheats-meta">These toggles affect debugging tools only.</div>';

			var isDevNow = dev;
			html += '    <div class="phone-cheats-actions">';
			html += '      <button class="phone-btn" data-cheats-dev-toggle="1">' + (isDevNow ? 'Disable dev mode' : 'Enable dev mode') + '</button>';
			html += '      <button class="phone-btn" data-cheats-rebuild-index="1">Rebuild indexes</button>';
			html += '    </div>';

			html += '    <div class="phone-cheats-meta">Dev mode: <b>' + (isDevNow ? 'ON' : 'OFF') + '</b></div>';

			html += '  </div>';

		html += '</div>';
		return html;
	};
