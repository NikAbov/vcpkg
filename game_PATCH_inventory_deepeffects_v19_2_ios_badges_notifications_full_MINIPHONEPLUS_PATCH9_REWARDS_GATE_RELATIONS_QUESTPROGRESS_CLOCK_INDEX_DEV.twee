		ids.sort(function (a, b) {
			var da = setup.planDefs[a], db = setup.planDefs[b];
			return (_num(db.priority, 0) - _num(da.priority, 0)) || (_num(db.weight, 1) - _num(da.weight, 1));
		});

		var fired = 0;

		for (var i = 0; i < ids.length; i++) {
			var def = setup.planDefs[ids[i]];
			if (!def) continue;

			var st = sv.planState[def.id] || (sv.planState[def.id] = {});
			var ctx = { kind: "plan", planId: def.id, app: def.app, npcId: def.npcId, reason: reason || "tick" };

			if (!setup.planIsDue(def, st, ctx)) continue;

			// mark fired
			st.lastDay = _nowDay();
			st.count = _num(st.count, 0) + 1;
			if (st._nextStamp) { st.lastStamp = st._nextStamp; delete st._nextStamp; }

			// execute
			if (Array.isArray(def.effects) && typeof setup.applyEffects === "function") {
				setup.applyEffects(def.effects, ctx);
			}

			fired++;
		}

		return fired;
	};

	// Hook planner into time flow (step-by-step, so plans tied to timeOfDay won't be skipped on advanceTime 2+)
	$(document).on(":storyready", function () {
		if (!setup.__advanceTime_v1 && typeof setup.advanceTime === "function") {
			setup.__advanceTime_v1 = setup.advanceTime;
			setup.advanceTime = function (steps) {
				steps = Math.max(1, Math.floor(_num(steps, 1)));
				var firedTotal = 0;
				for (var i = 0; i < steps; i++) {
					setup.__advanceTime_v1(1);
					firedTotal += setup.plannerTick("advanceTime");
				}
				return firedTotal;
			};
		}
	});

})();

