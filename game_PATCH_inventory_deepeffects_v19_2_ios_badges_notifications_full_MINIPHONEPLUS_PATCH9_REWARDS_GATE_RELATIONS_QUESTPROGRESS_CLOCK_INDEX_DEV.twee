	// ------------------------------
	// REWARD ENGINE
	// ------------------------------
	setup.applyRewards = function (rewards, ctx) {
		ctx = (ctx && typeof ctx === "object") ? ctx : {};
		if (!rewards) return { ok: true, applied: 0, errors: [] };

		var list = Array.isArray(rewards) ? rewards : [rewards];
		var applied = 0;
		var errors = [];

		function safe(fn, label) {
			try { fn(); applied++; }
			catch (e) { errors.push(String(label || "reward") + ": " + e); }
		}

		for (var i = 0; i < list.length; i++) {
			var r = list[i];
			if (!r) continue;

			// shorthand: { money: +10 } / { item: "rose", qty: 1 }
			if (typeof r.money === "number") {
				var d = Number(r.money || 0);
				if (!isFinite(d) || d === 0) continue;
				safe(function () {
					if (typeof setup.addMoney === "function") setup.addMoney(d);
					else {
						var sv = State.variables;
						sv.money = Number(sv.money || 0) + d;
					}
				}, "money");
				continue;
			}

			if (r.itemId || r.item) {
				var itemId = String(r.itemId || r.item || "");
				var qty = Number(r.qty == null ? 1 : r.qty);
				if (!isFinite(qty) || qty === 0) qty = 1;
				safe(function () {
					if (typeof setup.shopAddToInventory === "function") setup.shopAddToInventory(itemId, qty);
				}, "item");
				continue;
			}

			if (r.unlockId || r.unlock) {
				var uid = String(r.unlockId || r.unlock || "");
				safe(function () {
					if (typeof setup.unlock === "function") setup.unlock(uid, Object.assign({ from: ctx.kind || "reward" }, (r.meta || {})));
				}, "unlock");
				continue;
			}

			if (r.featureOn || r.featureOff) {
				var fo = (r.featureOn ? String(r.featureOn) : "");
				var ff = (r.featureOff ? String(r.featureOff) : "");
				safe(function () {
					if (fo) setup.enableFeature(fo);
					if (ff) setup.disableFeature(ff);
