  // --- Relationship status config (English names) ---
// setup.relationStatusConfig is derived from AUTOGEN npcRelationStatus.statuses



	/* ------------------------------------------------------------
	   Иерархия локаций + утилиты регистрации
	   ------------------------------------------------------------ */

	// Хранилище: parent -> [children...]
	setup.locationTree = setup.locationTree || Object.create(null);

	// Зарегистрировать связь "child находится внутри parent"
	setup.registerLocationParent = function (childId, parentId) {
		if (!childId || !parentId) {
			return;
		}
		var tree = setup.locationTree;

		if (!tree[parentId]) {
			tree[parentId] = [];
		}
		// Не добавляем дубликаты
		if (tree[parentId].indexOf(childId) === -1) {
			tree[parentId].push(childId);
		}
	};

	// Зарегистрировать цепочку локаций снизу вверх:
	// пример:
	//   setup.registerLocationChain(
	//       "kitchen-home-apartment building",
	//       "home-apartment building",
	//       "apartment building"
	//   );
	//
	// даст:
	//   apartment building -> [home-apartment building]
	//   home-apartment building -> [kitchen-home-apartment building]
	setup.registerLocationChain = function () {
		var ids;

		if (arguments.length === 1 && Array.isArray(arguments[0])) {
			ids = arguments[0];
		} else {
			ids = Array.prototype.slice.call(arguments);
		}

		for (var i = 0; i < ids.length - 1; i++) {
			var child  = ids[i];
			var parent = ids[i + 1];
			setup.registerLocationParent(child, parent);
		}
	};

	// Разворачиваем дерево: все id, входящие в "зону" rootId (сам + дети + дети детей...)
	setup.expandLocationIds = function (rootId) {
		var result = [];
		var stack = [rootId];
		var seen = Object.create(null);

		while (stack.length > 0) {
			var id = stack.pop();
			if (!id || seen[id]) {
				continue;
			}
			seen[id] = true;
			result.push(id);

			var children = setup.locationTree[id];
			if (Array.isArray(children)) {
				children.forEach(function (childId) {
					if (!seen[childId]) {
						stack.push(childId);
					}
				});
			}
		}

		return result;
	};

	// Собираем NPC для rootId + всех его "вложенных" локаций,
	// используя уже существующий setup.getNpcsAtLocation.
	setup.getNpcsDeep = function (rootId) {
		var result = [];
		var seen = Object.create(null);

		if (typeof setup.getNpcsAtLocation !== "function" || !rootId) {
			return result;
		}

		var ids = setup.expandLocationIds(rootId);

		ids.forEach(function (locId) {
			var list = setup.getNpcsAtLocation(locId) || [];
			list.forEach(function (npc) {
				// Идентифицируем NPC по id или имени
				var key = npc.id || npc.name || JSON.stringify(npc);
				if (seen[key]) {
					return;
				}
				seen[key] = true;
				result.push(npc);
			});
		});

		return result;
	};



		// ------------------------------------------------------------
	// Регистрация цепочек локаций (примеры)

	// ------------------------------------------------------------
	// Дополнительные связи локаций для квартиры и комнат
	// ------------------------------------------------------------
	// Квартира как часть apartment building
	setup.registerLocationParent("home", "apartment building");

	// Комнаты внутри home
	setup.registerLocationParent("girlsroom", "home");
	setup.registerLocationParent("kitchen", "home");
	setup.registerLocationParent("livingroom", "home");
	setup.registerLocationParent("bathroom", "home");
	setup.registerLocationParent("mcroom", "home");

	// Вверх по дому — напрямую в apartment building
	setup.registerLocationParent("ubathroom", "apartment building");
	setup.registerLocationParent("ukitchen", "apartment building");
	setup.registerLocationParent("ulivingroom", "apartment building");
	setup.registerLocationParent("ubedroom", "apartment building");
	setup.registerLocationParent("brotherhome", "apartment building");
	setup.registerLocationParent("sisterhome", "apartment building");
	setup.registerLocationParent("unclehome", "apartment building");

	// ------------------------------------------------------------

	// kitchen-home-apartment building -> home-apartment building -> apartment building
	setup.registerLocationChain(
		"kitchen-home-apartment building",
		"home-apartment building",
		"apartment building"
	);

	// bathroom-home-apartment building -> home-apartment building -> apartment building
	setup.registerLocationChain(
		"bathroom-home-apartment building",
		"home-apartment building",
		"apartment building"
	);

	// living-home-apartment building -> home-apartment building -> apartment building
	setup.registerLocationChain(
		"living-home-apartment building",
		"home-apartment building",
		"apartment building"
	);

	// bedroom-home-apartment building -> home-apartment building -> apartment building
	setup.registerLocationChain(
		"bedroom-home-apartment building",
		"home-apartment building",
		"apartment building"
	);




	// Обновить общий верхний бар с иконками NPC
	setup.updateNpcHoverBar = function (npcList) {
	var html = "";

	if (Array.isArray(npcList) && npcList.length > 0 && typeof setup.renderNpcIconRow === "function") {
		// Используем уже существующий рендер иконок
		html = setup.renderNpcIconRow(npcList, "npc-icon-row-hover");
	}

	// 1) Если открыт оверлей карты — выводим иконки рядом с "Сейчас: пассаж"
	var $mapIcons = jQuery("#map-overlay .map-screen-current-npc-icons");
	if ($mapIcons.length) {
		$mapIcons.html(html);
	}

	// 2) Если мы в пассаже с сеткой комнат — выводим иконки в бар над кнопками
	var $aptBar = jQuery(".apartment-room-npcbar");
	if ($aptBar.length) {
		$aptBar.html(html);
	}
};

	// Наведение на карту.
	// ВАЖНО: тут класс ".map-pin" нужно подогнать под тот, что реально стоит на твоих точках карты.
	// Если у тебя, например, ".map-location" — замени ".map-pin" на ".map-location".
	jQuery(document).on("mouseenter", ".map-pin", function () {
		var locId = jQuery(this).attr("data-map-id") || jQuery(this).attr("data-loc-id") || jQuery(this).data("locId");

		if (!locId) {
			setup.updateNpcHoverBar([]);
			return;
		}

		var list = setup.getNpcsDeep(locId);
		setup.updateNpcHoverBar(list);
	});

	jQuery(document).on("mouseleave", ".map-pin", function () {
		setup.updateNpcHoverBar([]);
	});

	// Наведение на кнопки комнат (apartmentRoomGrid)
	jQuery(document).on("mouseenter", ".apartment-room-button", function () {
		var locId = jQuery(this).attr("data-loc-id");

		if (!locId) {
			setup.updateNpcHoverBar([]);
			return;
		}

		var list = setup.getNpcsDeep(locId);
		setup.updateNpcHoverBar(list);
	});

	jQuery(document).on("mouseleave", ".apartment-room-button", function () {
		setup.updateNpcHoverBar([]);
	});




/* возможные статусы отношений */
/* инициализация динамического состояния NPC */
setup.initNpcState = function () {
    var sv = State.variables;

    if (typeof sv.npcs !== "object" || !sv.npcs) {
        sv.npcs = {};
    }

    var realNpcIndex = 0;

    setup.npcDefinitions.forEach(function (def) {
        // если контент запрещён — просто не создаём этого NPC
        if (!setup.isContentAllowed(def.contentTags)) {
            return;
        }

        if (def.roleKey === "player") {
            return;
        }

        var isFirstNpc = (realNpcIndex === 0);
        realNpcIndex++;

        if (!sv.npcs[def.id]) {
            var cfgList = Array.isArray(setup.npcStatConfig) ? setup.npcStatConfig : [];
            var stats = {};

            // seed defaults from config
            cfgList.forEach(function (cfg) {
                if (cfg && typeof cfg.key === "string" && cfg.key) {
                    stats[cfg.key] = 0;
                }
            });

            // overlay startStats
            if (def.startStats && typeof def.startStats === "object") {
                Object.keys(def.startStats).forEach(function (k) {
                    stats[k] = Number(def.startStats[k] || 0);
                    if (isNaN(stats[k])) stats[k] = 0;
                });
            }

            // clamp by min/max from config if present
            cfgList.forEach(function (cfg) {
                if (!cfg || typeof cfg.key !== "string") return;
                var k = cfg.key;
                var v = stats[k];
                if (typeof v !== "number" || isNaN(v)) v = 0;
                if (typeof cfg.min === "number" && !isNaN(cfg.min) && v < cfg.min) v = cfg.min;
                if (typeof cfg.max === "number" && !isNaN(cfg.max) && v > cfg.max) v = cfg.max;
                stats[k] = v;
            });

            sv.npcs[def.id] = {
                unlocked    : isFirstNpc,
              	phoneUnlocked    : !!def.startHasPhone, // <--- НОВЫЙ ФЛАГ: есть ли контакт в телефоне
                apps        : {
                    // флаги приложений телефона (можно включать/выключать во время игры)
                    fans  : !!(def.apps && def.apps.fans) || !!def.fansApp || false,
                    match : !!(def.apps && def.apps.match) || !!def.matchApp || false
                },
                relationKey : def.startRelationKey || def.roleKey || "acquaintance",
                stats       : stats,
                gallery     : [
                    {
                        id          : def.id + "_wall1",
                        thumb       : def.avatar,
                        full        : def.avatar,
                        canWallpaper: true
                    }
                ],
                messagesMedia: [],
              // новый поле статус отношений (ключ: "neutral", "likes", "hates" и т.п.)
                relationStatus: null
         
            };
          
          // сразу посчитать стартовый статус отношений по стартовым статам
            sv.npcs[def.id].relationStatus = 				        			setup.calcNpcRelationStatus(stats);
          
        }
    });
};

/* =========================================================
   NPC Phone App Flags (Fans / Match)
   ---------------------------------------------------------
   NPC появляется в приложении только если включён флаг.

   Хранение:
     State.variables.npcs[npcId].apps = { fans:boolean, match:boolean }

   Управление:
     setup.npcHasAppFlag(npcId, "fans"|"match")
     setup.npcSetAppFlag(npcId, "fans"|"match", true/false)

   Макрос:
     <<npcAppFlag "npc_alice" "fans" true>>
     <<npcAppFlag "npc_alice" "match" true>>
========================================================= */
(function () {
	"use strict";

	setup.npcHasAppFlag = function (npcId, appKey) {
		var sv = State.variables;
		if (!sv.npcs || !sv.npcs[npcId] || !sv.npcs[npcId].apps) return false;
		return !!sv.npcs[npcId].apps[appKey];
	};

	setup.npcSetAppFlag = function (npcId, appKey, value) {
		var sv = State.variables;
		if (!sv.npcs || !sv.npcs[npcId]) return false;
		if (!sv.npcs[npcId].apps) sv.npcs[npcId].apps = {};
		sv.npcs[npcId].apps[appKey] = !!value;

		// Match: пересобрать очередь, чтобы новые профили появились сразу
		if (appKey === "match" && typeof setup.matchRebuildQueue === "function") {
			setup.matchRebuildQueue();
		}

		// Refresh phone UI if open
		if ($("#phone-overlay").hasClass("visible") && typeof setup.phoneRender === "function") {
			setup.phoneRender();
		}
		return true;
	};

	if (!Macro.has("npcAppFlag")) Macro.add("npcAppFlag", {
		handler : function () {
			if (this.args.length < 3) return;
			var npcId = String(this.args[0] || "");
			var appKey = String(this.args[1] || "");
			var v = this.args[2];

			if (typeof v === "string") {
				var s = v.trim().toLowerCase();
				if (s === "on") v = true;
				if (s === "off") v = false;
			}
			setup.npcSetAppFlag(npcId, appKey, !!v);
		}
	});
})();


  
  
  
  // --- Relationship status calculation based on NPC stats ---


// --- Relationship status calculation based on NPC stats (ordered rules DSL) ---

setup.evalNpcRelationCond = setup.evalNpcRelationCond || function (cond, stats) {
    if (!cond || typeof cond !== "object" || Array.isArray(cond)) {
        return false;
    }

    // AND
    if (Object.prototype.hasOwnProperty.call(cond, "all")) {
        if (!Array.isArray(cond.all) || cond.all.length === 0) {
            return false;
        }
        for (var i = 0; i < cond.all.length; i++) {
            if (!setup.evalNpcRelationCond(cond.all[i], stats)) {
                return false;
            }
        }
        return true;
    }

    // OR
    if (Object.prototype.hasOwnProperty.call(cond, "any")) {
        if (!Array.isArray(cond.any) || cond.any.length === 0) {
            return false;
        }
        for (var j = 0; j < cond.any.length; j++) {
            if (setup.evalNpcRelationCond(cond.any[j], stats)) {
                return true;
            }
        }
        return false;
    }

    // Leaf: { statKey: { op: number, ... } }
    var keys = Object.keys(cond);
    if (keys.length !== 1) {
        return false;
    }
    var statKey = keys[0];
    var cmp = cond[statKey];
    if (!cmp || typeof cmp !== "object" || Array.isArray(cmp)) {
        return false;
    }

    var v = 0;
    if (stats && typeof stats[statKey] === "number") {
        v = stats[statKey];
    } else if (stats && stats[statKey] != null) {
        v = Number(stats[statKey]);
        if (isNaN(v)) v = 0;
    }

    var cmpKeys = Object.keys(cmp);
    if (cmpKeys.length === 0) {
        return false;
    }

    for (var k = 0; k < cmpKeys.length; k++) {
        var op = cmpKeys[k];
        var n = Number(cmp[op]);
        if (isNaN(n)) {
            return false;
        }
        switch (op) {
            case "gte": if (!(v >= n)) return false; break;
            case "lte": if (!(v <= n)) return false; break;
            case "gt":  if (!(v >  n)) return false; break;
            case "lt":  if (!(v <  n)) return false; break;
            case "eq":  if (!(v === n)) return false; break;
            case "neq": if (!(v !== n)) return false; break;
            default: return false;
        }
    }

    return true;
};

setup.calcNpcRelationStatus = function (stats) {
    if (!stats) {
        stats = {};
    }

    // Prefer AUTOGEN DSL if present
    var rs = setup.npcRelationStatus;
    if (rs && Array.isArray(rs.rules) && rs.rules.length > 0 && rs.statuses && typeof rs.statuses === "object") {
        for (var i = 0; i < rs.rules.length; i++) {
            var rule = rs.rules[i];
            if (!rule || typeof rule !== "object") {
                continue;
            }
            if (setup.evalNpcRelationCond(rule.if, stats)) {
                var sk = String(rule.status || "").trim();
                if (sk && rs.statuses[sk]) {
                    return sk;
                }
                if (sk) {
                    return sk; // allow non-listed keys, but IDE should validate
                }
            }
        }

        var fb = String(rs.fallback || "neutral").trim();
        if (fb) {
            return fb;
        }
        return "neutral";
    }

    // --- Legacy fallback (kept for backward compatibility) ---
    if (!stats) {
        stats = {};
    }

    var love  = Number(stats.love  || 0);
    var lust  = Number(stats.lust  || 0);
    var trust = Number(stats.trust || 0);
    var jeal  = Number(stats.jeal  || 0);
    var obed  = Number(stats.obed  || 0);

    // 1) Addicted – самая сильная стадия
    if (love >= 90 && trust >= 85 && (lust >= 80 || obed >= 75)) {
        return "addicted";
    }

    // 2) Adores – очень высокая любовь и доверие
    if (love >= 80 && trust >= 75 && (lust >= 60 || obed >= 60)) {
        return "adores";
    }

    // 3) Respects – высокий trust + уважение/послушание, любовь есть, но не обязательно огромная
    if (trust >= 70 && (love >= 50 || obed >= 60)) {
        return "respects";
    }

    // 4) Curious – явный интерес (романтика+доверие или высокая страсть)
    if ((love >= 55 && trust >= 50) || lust >= 70) {
        return "curious";
    }

    // 5) Likes – просто симпатизирует
    if (love >= 40 && trust >= 40) {
        return "likes";
    }

    // 6) Hates – откровенно плохое отношение (очень мало любви и доверия)
    if (trust <= 10 && love <= 10) {
        return "hates";
    }

    // 7) Иначе – обычное / слегка положительное
    return "neutral";
};

  
  
// Recalculate relationStatus for a single NPC
setup.updateNpcRelationStatus = function (npcId) {
    var sv = State.variables;
    if (!sv || !sv.npcs || !sv.npcs[npcId]) {
        return;
    }

    var npc = sv.npcs[npcId];
    var newStatus = setup.calcNpcRelationStatus(npc.stats);

    npc.relationStatus = newStatus;
};

// Recalculate relationStatus for all NPCs
setup.updateAllNpcRelationStatuses = function () {
    var sv = State.variables;
    if (!sv || !sv.npcs) {
        return;
    }

    Object.keys(sv.npcs).forEach(function (npcId) {
        setup.updateNpcRelationStatus(npcId);
    });
};

// Get status key for NPC ("likes", "hates", etc.)
setup.getNpcRelationStatus = function (npcId) {
    var sv = State.variables;
    if (!sv || !sv.npcs || !sv.npcs[npcId]) {
        return "neutral";
    }
    return sv.npcs[npcId].relationStatus || "neutral";
};

// Get human-readable English title ("Likes you", "Hates you", etc.)
setup.getNpcRelationStatusTitle = function (npcId) {
    var key = setup.getNpcRelationStatus(npcId);
    var cfg = setup.relationStatusConfig && setup.relationStatusConfig[key];
    return cfg ? cfg.title : key;
};

// Safe helper to change one stat and automatically update relationStatus
setup.addNpcStat = function (npcId, statName, delta) {
    var sv = State.variables;
    if (!sv || !sv.npcs || !sv.npcs[npcId]) {
        return;
    }

    var npc = sv.npcs[npcId];
    if (!npc.stats) {
        npc.stats = {};
    }

    // ensure all configured stats exist
    var __cfgList = Array.isArray(setup.npcStatConfig) ? setup.npcStatConfig : [];
    __cfgList.forEach(function (cfg) {
        if (cfg && typeof cfg.key === "string" && cfg.key) {
            if (npc.stats[cfg.key] === undefined) npc.stats[cfg.key] = 0;
        }
    });


    var oldVal = Number(npc.stats[statName] || 0);
    var newVal = oldVal + Number(delta || 0);
    // Clamp by npcStatConfig bounds if present
    var __bounds = null;
    for (var bi = 0; bi < __cfgList.length; bi++) {
        if (__cfgList[bi] && __cfgList[bi].key === statName) {
            __bounds = __cfgList[bi];
            break;
        }
    }
    if (__bounds) {
        if (typeof __bounds.max === "number" && !isNaN(__bounds.max) && newVal > __bounds.max) newVal = __bounds.max;
        if (typeof __bounds.min === "number" && !isNaN(__bounds.min) && newVal < __bounds.min) newVal = __bounds.min;
    }

    npc.stats[statName] = newVal;

    // И всегда пересчитываем статус отношений
    setup.updateNpcRelationStatus(npcId);
};

// =====================================================
// HERO (Player) STATS (from AUTOGEN)
// =====================================================

// Build a fast lookup index from setup.heroStatConfig
setup.getHeroStatIndex = function () {
    if (setup.__heroStatIndex && setup.__heroStatIndex._src === setup.heroStatConfig) {
        return setup.__heroStatIndex;
    }

    var list = Array.isArray(setup.heroStatConfig) ? setup.heroStatConfig : [];
    var byKey = {};
    var keys = [];

    for (var i = 0; i < list.length; i++) {
        var cfg = list[i];
        if (!cfg || typeof cfg.key !== "string") continue;
        var k = String(cfg.key || "").trim();
        if (!k) continue;

        var min = Number(cfg.min);
        var max = Number(cfg.max);
        var step = Number(cfg.step);
        if (isNaN(min) || !isFinite(min)) min = 0;
        if (isNaN(max) || !isFinite(max)) max = 100;
        if (isNaN(step) || !isFinite(step) || step <= 0) step = 1;

        byKey[k] = {
            key: k,
            label: (cfg.label ? String(cfg.label) : k),
            min: min,
            max: max,
            step: step
        };
        keys.push(k);
    }

    setup.__heroStatIndex = { _src: setup.heroStatConfig, byKey: byKey, keys: keys };
    return setup.__heroStatIndex;
};

setup.__clampHeroStat = function (key, value) {
    var n = Number(value);
    if (isNaN(n) || !isFinite(n)) n = 0;

    var idx = setup.getHeroStatIndex();
    var cfg = idx && idx.byKey ? idx.byKey[key] : null;
    if (!cfg) return n;

    if (typeof cfg.max === "number" && !isNaN(cfg.max) && n > cfg.max) n = cfg.max;
    if (typeof cfg.min === "number" && !isNaN(cfg.min) && n < cfg.min) n = cfg.min;
    return n;
};

setup.getHeroStat = function (key) {
    var sv = State.variables;
    if (!sv) return 0;
    var n = Number(sv[key]);
    if (isNaN(n) || !isFinite(n)) return 0;
    return n;
};

setup.setHeroStat = function (key, value) {
    var sv = State.variables;
    if (!sv) return;

    var out = setup.__clampHeroStat(key, value);
    sv[key] = out;

    // Wallet mirrors heroMoney
    if (key === "heroMoney" && typeof setup.syncWallet === "function") {
        setup.syncWallet();
    }

    return out;
};


/* =====================================================
   WALLET (mirrors heroMoney)
   ===================================================== */

setup.ensureWalletState = function () {
    var sv = State.variables;
    if (!sv) return;
    if (typeof sv.wallet !== "object" || !sv.wallet) {
        sv.wallet = {};
    }
    if (typeof sv.wallet.cash !== "number" || isNaN(sv.wallet.cash) || !isFinite(sv.wallet.cash)) {
        sv.wallet.cash = 0;
    }
};

// Keep wallet.cash always equal to heroMoney
setup.syncWallet = function () {
    var sv = State.variables;
    if (!sv) return 0;
    setup.ensureWalletState();

    var cash = Number(sv.heroMoney);
    if (isNaN(cash) || !isFinite(cash)) cash = 0;

    sv.wallet.cash = cash;
    return cash;
};

// Recommended helpers for future economy code
setup.addMoney = function (delta) {
    delta = Number(delta || 0);
    var cur = setup.getHeroStat("heroMoney");
    return setup.setHeroStat("heroMoney", cur + delta);
};

setup.spendMoney = function (cost) {
    cost = Number(cost || 0);
    if (isNaN(cost) || !isFinite(cost) || cost <= 0) return true;

    var cur = setup.getHeroStat("heroMoney");
    if (cur < cost) return false;

    setup.setHeroStat("heroMoney", cur - cost);
    return true;
};


/* =====================================================
   SHOP / PURCHASE SYSTEM
   - cash source: heroMoney (wallet mirrors it)
   - supports vendors: app_ebay, app_fans_coins (and future shops)
   ===================================================== */

setup.ensureShopState = function () {
	var sv = State.variables;
	if (!sv) return;

	// progression flags for offers/items
	if (!sv.shopFlags || typeof sv.shopFlags !== "object" || Array.isArray(sv.shopFlags)) {
		sv.shopFlags = {};
	}

	// inventory: itemId -> qty
	if (!sv.inv || typeof sv.inv !== "object" || Array.isArray(sv.inv)) {
		sv.inv = {};
	}

	// inventory meta: itemId -> { acquiredDay, lastChangeDay, lastDelta }
	if (!sv.invMeta || typeof sv.invMeta !== "object" || Array.isArray(sv.invMeta)) {
		sv.invMeta = {};
	}

	// orders for shipping
	if (!Array.isArray(sv.orders)) {
		sv.orders = [];
	}

	// per-offer runtime state (stock, purchase count, etc.)
	if (!sv.shopOfferState || typeof sv.shopOfferState !== "object" || Array.isArray(sv.shopOfferState)) {
		sv.shopOfferState = {};
	}

	// eBay UI state
	if (typeof sv.ebaySearch !== "string") sv.ebaySearch = "";
	if (typeof sv.ebayCat !== "string") sv.ebayCat = "all";
	if (typeof sv.ebayOrdersFilter !== "string") sv.ebayOrdersFilter = "all";

	// demo catalog (если автор не задал своё)
	if (!Array.isArray(setup.shopItems)) {
		setup.shopItems = [
			{ id: "ring_light", name: "Ring Light", desc: "A basic ring light for better photos and videos.", type: "gear", stackable: false, giftable: true },
			{ id: "phone_case_red", name: "Red Phone Case", desc: "Protects your phone. Looks cute.", type: "accessory", stackable: false, giftable: true },
			{ id: "vanilla_perfume", name: "Vanilla Perfume", desc: "Sweet smell. Perfect as a gift.", type: "gift", stackable: true, giftable: true },
			{ id: "mystery_box", name: "Mystery Box", desc: "Nobody knows what's inside. Risky.", type: "misc", stackable: true, giftable: false }
		];
	}

	if (!Array.isArray(setup.shopOffers)) {
		setup.shopOffers = [
			// eBay listings (часть залочена флагами)
			{ id: "ebay_ring_light", vendorId: "app_ebay", itemId: "ring_light", price: 450, currency: "cash", deliveryMode: "shipping", etaDays: 1, stockMode: "stock", initialStock: 3, hideWhenSoldOut: false },
			{ id: "ebay_phone_case_red", vendorId: "app_ebay", itemId: "phone_case_red", price: 120, currency: "cash", deliveryMode: "shipping", etaDays: 1, requiresFlags: ["ebay_phone_case_unlocked"] },
			{ id: "ebay_vanilla_perfume", vendorId: "app_ebay", itemId: "vanilla_perfume", price: 300, currency: "cash", deliveryMode: "shipping", etaDays: 1, requiresFlags: ["ebay_perfume_unlocked"], stockMode: "stock", initialStock: 2, hideWhenSoldOut: false },
			{ id: "ebay_mystery_box", vendorId: "app_ebay", itemId: "mystery_box", price: 200, currency: "cash", deliveryMode: "shipping", etaDays: 2, requiresFlags: ["ebay_mystery_unlocked"], stockMode: "exclusive", initialStock: 1, hideWhenSoldOut: false },

			// Fans coin packs (digital)
			{ id: "fans_coins_25", vendorId: "app_fans_coins", price: 50,  currency: "cash", deliveryMode: "digital", grant: { fansCoins: 25 }, title: "+25 coins" },
			{ id: "fans_coins_100", vendorId: "app_fans_coins", price: 180, currency: "cash", deliveryMode: "digital", grant: { fansCoins: 100 }, title: "+100 coins", desc: "Best value." },
			{ id: "fans_coins_250", vendorId: "app_fans_coins", price: 400, currency: "cash", deliveryMode: "digital", grant: { fansCoins: 250 }, title: "+250 coins" }
		];
	}

	// индексы
	if (!setup._shopIndex || setup._shopIndex._itemsLen !== setup.shopItems.length || setup._shopIndex._offersLen !== setup.shopOffers.length) {
		setup._shopIndex = setup._shopIndex || {};
		setup._shopIndex.items = {};
		setup._shopIndex.offers = {};
		setup.shopItems.forEach(function (it) { if (it && it.id) setup._shopIndex.items[it.id] = it; });
		setup.shopOffers.forEach(function (of) { if (of && of.id) setup._shopIndex.offers[of.id] = of; });
		setup._shopIndex._itemsLen = setup.shopItems.length;
		setup._shopIndex._offersLen = setup.shopOffers.length;
	}
};

setup.getShopFlag = function (flag, defaultValue) {
	var sv = State.variables;
	if (!sv || !sv.shopFlags) return defaultValue;
	if (typeof sv.shopFlags[flag] === "undefined") return defaultValue;
	return !!sv.shopFlags[flag];
};

setup.setShopFlag = function (flag, value) {
	var sv = State.variables;
	if (!sv) return;
	setup.ensureShopState();
	var v = (arguments.length < 2) ? true : !!value;
	sv.shopFlags[flag] = v;

	// If this flag is used for restocks, apply immediately so the offer reappears without waiting for next day.
	if (v && typeof setup.shopRefreshAllVendors === "function") {
		setup.shopRefreshAllVendors();
	}
};

setup.shopGetItem = function (itemId) {
	setup.ensureShopState();
	return (setup._shopIndex && setup._shopIndex.items) ? setup._shopIndex.items[itemId] : null;
};

setup.shopGetThumbUrl = function (item) {
	item = item || {};
	var url = (typeof item.img === "string" && item.img.trim()) ? item.img.trim()
		: ((typeof item.image === "string" && item.image.trim()) ? item.image.trim() : "");
	if (url) return url;

	// SVG placeholder (no external files needed)
	var label = (item.name || item.id || "Item");
	label = String(label).trim();
	if (!label) label = "Item";
	if (label.length > 18) label = label.slice(0, 18) + "…";

	setup._shopThumbCache = setup._shopThumbCache || {};
	if (setup._shopThumbCache[label]) return setup._shopThumbCache[label];

	var safe = label
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;");

	var svg =
		'<svg xmlns="http://www.w3.org/2000/svg" width="240" height="240" viewBox="0 0 240 240">' +
		'<defs>' +
		'<linearGradient id="g" x1="0" y1="0" x2="1" y2="1">' +
		'<stop offset="0" stop-color="#1c2330"/>' +
		'<stop offset="1" stop-color="#0f1218"/>' +
		'</linearGradient>' +
		'</defs>' +
		'<rect width="240" height="240" rx="28" fill="url(#g)"/>' +
		'<rect x="18" y="18" width="204" height="204" rx="22" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.14)"/>' +
		'<g opacity="0.85">' +
		'<path d="M72 142l22-26 22 26 22-26 30 36H72z" fill="rgba(255,255,255,0.30)"/>' +
		'<circle cx="94" cy="92" r="12" fill="rgba(255,255,255,0.30)"/>' +
		'</g>' +
		'<text x="120" y="206" text-anchor="middle" font-family="system-ui, -apple-system, Segoe UI, Roboto, Arial" font-size="18" fill="rgba(255,255,255,0.92)">' +
		safe +
		'</text>' +
		'</svg>';

	var data = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
	setup._shopThumbCache[label] = data;
	return data;
};


setup.shopGetOffer = function (offerId) {
	setup.ensureShopState();
	return (setup._shopIndex && setup._shopIndex.offers) ? setup._shopIndex.offers[offerId] : null;
};

setup.shopNormalizeStockMode = function (offer) {
	// Supported:
	// - undefined / "unlimited" : infinite purchases (default)
	// - "stock"                : limited stock (initialStock)
	// - "exclusive" / "once"   : one-time stock=1 (until restocked by story)
	if (!offer) return "unlimited";

	var m = (offer.stockMode || offer.stock_mode || "").toString().trim().toLowerCase();
	if (m === "once") m = "exclusive";
	if (m === "one") m = "exclusive";
	if (m === "single") m = "exclusive";

	// backward compatibility: if author sets initialStock/stock without stockMode -> treat as stock
	if (!m) {
		if (typeof offer.initialStock === "number" || typeof offer.stock === "number") return "stock";
		return "unlimited";
	}

	if (m === "unlimited" || m === "infinite") return "unlimited";
	if (m === "stock" || m === "limited") return "stock";
	if (m === "exclusive") return "exclusive";
	return "unlimited";
};

setup.shopGetOfferState = function (offerId) {
	setup.ensureShopState();
	var sv = State.variables;
	if (!sv || !sv.shopOfferState) return null;
	if (!offerId) return null;

	var key = String(offerId);
	var st = sv.shopOfferState[key];
	if (!st || typeof st !== "object") {
		st = sv.shopOfferState[key] = { stock: null, purchasedCount: 0 };
	}

	// lazy-init stock from offer config
	if (st.stock === null || typeof st.stock !== "number" || !isFinite(st.stock)) {
		var offer = setup.shopGetOffer(key);
		var mode = setup.shopNormalizeStockMode(offer);

		if (mode === "unlimited") {
			st.stock = Infinity;
		} else if (mode === "exclusive") {
			st.stock = 1;
		} else {
			// stock
			var init = 1;
			if (offer) {
				if (typeof offer.initialStock !== "undefined") init = offer.initialStock;
				else if (typeof offer.stock !== "undefined") init = offer.stock;
			}
			init = Number(init);
			if (!isFinite(init) || init < 0) init = 0;
			st.stock = init;
		}
	}

	if (typeof st.purchasedCount !== "number" || !isFinite(st.purchasedCount) || st.purchasedCount < 0) {
		st.purchasedCount = 0;
	}

	return st;
};

setup.shopGetOfferStockInfo = function (offerId) {
	setup.ensureShopState();
	var offer = setup.shopGetOffer(offerId);
	if (!offer) return { mode: "unlimited", stock: 0, soldOut: false };

	var mode = setup.shopNormalizeStockMode(offer);
	if (mode === "unlimited") return { mode: "unlimited", stock: Infinity, soldOut: false };

	var st = setup.shopGetOfferState(offerId);
	var stock = (st && typeof st.stock === "number") ? st.stock : 0;
	if (!isFinite(stock)) stock = 0;
	return { mode: mode, stock: stock, soldOut: stock <= 0 };
};

setup.shopOfferCanBuy = function (offerId, qty) {
	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	var offer = setup.shopGetOffer(offerId);
	if (!offer) return false;

	// must be visible by flags
	if (!setup.shopOfferVisible(offer)) return false;

	var info = setup.shopGetOfferStockInfo(offerId);
	if (info.mode === "unlimited") return true;

	return info.stock >= qty;
};

setup.shopConsumeOfferStock = function (offerId, qty) {
	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	var offer = setup.shopGetOffer(offerId);
	if (!offer) return;

	var mode = setup.shopNormalizeStockMode(offer);
	if (mode === "unlimited") return;

	var st = setup.shopGetOfferState(offerId);
	if (!st) return;

	st.stock = Number(st.stock);
	if (!isFinite(st.stock)) st.stock = 0;

	st.stock -= qty;
	if (st.stock < 0) st.stock = 0;

	// Remember when the offer became sold out (for day-based restock rules)
	if (st.stock === 0) {
		var day = (typeof State !== "undefined" && State.variables && typeof State.variables.dayCounter === "number")
			? State.variables.dayCounter
			: null;
		if (day !== null && isFinite(day) && typeof st.soldOutDay !== "number") st.soldOutDay = day;
	}

	st.purchasedCount = (Number(st.purchasedCount) || 0) + qty;
};

setup.shopRestockOffer = function (offerId, amount) {
	// Story hook: make an offer available again.
	// Examples:
	//   <<run setup.shopRestockOffer("ebay_mystery_box", 1)>>
	//   <<run setup.shopRestockOffer("ebay_ring_light", 5)>>
	amount = Number(amount || 1);
	if (!isFinite(amount)) amount = 1;

	var offer = setup.shopGetOffer(offerId);
	if (!offer) return false;

	var mode = setup.shopNormalizeStockMode(offer);
	if (mode === "unlimited") return true;

	var st = setup.shopGetOfferState(offerId);
	if (!st) return false;

	st.stock = Number(st.stock);
	if (!isFinite(st.stock)) st.stock = 0;

	st.stock += amount;
	if (st.stock < 0) st.stock = 0;

	// If it is back in stock, clear sold-out marker
	if (st.stock > 0 && typeof st.soldOutDay !== "undefined") delete st.soldOutDay;

	return true;
};


/* -----------------------------------------------------
   SHOP HELPERS (Story-friendly API)
   -----------------------------------------------------
   - setup.shopGetOfferStock(offerId) -> number|Infinity
   - setup.shopSoldOut(offerId)       -> boolean
   - setup.shopSetOfferStock(offerId, n) -> sets current stock for non-unlimited offers
   - setup.shopMarkOfferSoldOut(offerId) -> convenience (stock=0)
   - setup.shopRefreshVendor(vendorId)   -> applies restock rules for offers of vendorId
   - setup.shopRefreshAllVendors()       -> applies restock rules for all offers
   Restock rules (optional, per offer):
     restockMode: "none" (default) | "flag" | "day"
     restockFlags: ["flagA","flagB"]   (for mode=flag)
     restockDays: 10                  (for mode=day; period)
     restockAmount: 1                 (how much to add when restocked)
   NOTE: We do NOT mutate sv.shopFlags to "consume" story flags.
         Instead we remember which flags were applied per offer in offerState.
----------------------------------------------------- */

setup.shopGetOfferStock = function (offerId) {
	var info = setup.shopGetOfferStockInfo(offerId);
	return info && typeof info.stock !== "undefined" ? info.stock : 0;
};

setup.shopSoldOut = function (offerId) {
	var info = setup.shopGetOfferStockInfo(offerId);
	return !!(info && info.mode !== "unlimited" && info.soldOut);
};

setup.shopSetOfferStock = function (offerId, stock) {
	setup.ensureShopState();
	var offer = setup.shopGetOffer(offerId);
	if (!offer) return false;

	var mode = setup.shopNormalizeStockMode(offer);
	if (mode === "unlimited") return true; // nothing to set

	var st = setup.shopGetOfferState(offerId);
	if (!st) return false;

	stock = Number(stock);
	if (!isFinite(stock) || stock < 0) stock = 0;
	st.stock = stock;

	// If it is back in stock, clear sold-out marker
	if (st.stock > 0 && typeof st.soldOutDay !== "undefined") delete st.soldOutDay;

	return true;
};

setup.shopMarkOfferSoldOut = function (offerId) {
	return setup.shopSetOfferStock(offerId, 0);
};

setup.shopTryRestockOffer = function (offerId) {
	setup.ensureShopState();
	var sv = State.variables;

	var offer = setup.shopGetOffer(offerId);
	if (!offer) return false;

	var mode = setup.shopNormalizeStockMode(offer);
	if (mode === "unlimited") return false;

	var st = setup.shopGetOfferState(offerId);
	if (!st) return false;

	// already in stock
	st.stock = Number(st.stock);
	if (!isFinite(st.stock)) st.stock = 0;
	if (st.stock > 0) return false;

	var restockMode = (offer.restockMode || offer.restock_mode || "none").toString().trim().toLowerCase();
	var amount = (typeof offer.restockAmount !== "undefined") ? offer.restockAmount : (offer.restock_amount);
	amount = Number(amount);
	if (!isFinite(amount) || amount <= 0) amount = 1;

	var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;

	// --- restock by day period
	if (restockMode === "day" || restockMode === "days") {
		var period = (typeof offer.restockDays !== "undefined") ? offer.restockDays : offer.restock_days;
		period = Number(period);
		if (!isFinite(period) || period <= 0) period = 1;

		var last = Number(st.lastRestockDay);
		if (!isFinite(last)) last = Number(st.soldOutDay);
		if (!isFinite(last)) last = day;

		if ((day - last) >= period) {
			st.stock = amount;
			st.lastRestockDay = day;
			return true;
		}
		return false;
	}

	// --- restock by story flags
	if (restockMode === "flag" || restockMode === "flags") {
		var flags = offer.restockFlags || offer.restock_flags || [];
		if (typeof flags === "string") flags = [flags];
		if (!Array.isArray(flags) || !flags.length) return false;

		if (!st.restockConsumedFlags || typeof st.restockConsumedFlags !== "object") st.restockConsumedFlags = {};

		for (var i = 0; i < flags.length; i++) {
			var f = String(flags[i] || "");
			if (!f) continue;

			// if story flag on and not consumed yet -> restock once
			if (setup.getShopFlag(f, false) && !st.restockConsumedFlags[f]) {
				st.restockConsumedFlags[f] = true;
				st.stock = amount;
				st.lastRestockDay = day;
				return true;
			}
		}
		return false;
	}

	// none
	return false;
};

setup.shopRefreshVendor = function (vendorId) {
	setup.ensureShopState();
	if (!vendorId) return 0;
	var offers = setup.shopGetOffersByVendor(vendorId, false);
	var n = 0;
	for (var i = 0; i < offers.length; i++) {
		var of = offers[i];
		if (!of || !of.id) continue;
		if (setup.shopTryRestockOffer(of.id)) n++;
	}
	return n;
};

setup.shopRefreshAllVendors = function () {
	setup.ensureShopState();
	if (!Array.isArray(setup.shopOffers)) return 0;
	var n = 0;
	for (var i = 0; i < setup.shopOffers.length; i++) {
		var of = setup.shopOffers[i];
		if (!of || !of.id) continue;
		if (setup.shopTryRestockOffer(of.id)) n++;
	}
	return n;
};


setup.shopOfferVisible = function (offer) {
	// Visible if:
	// - story flags allow it (requiresFlags)
	// - AND (optionally) sold-out items are not hidden
	if (!offer) return false;

	var flags = offer.requiresFlags;
	if (flags && Array.isArray(flags) && flags.length) {
		for (var i = 0; i < flags.length; i++) {
			if (!setup.getShopFlag(flags[i], false)) return false;
		}
	}

	// stock visibility
	var mode = setup.shopNormalizeStockMode(offer);
	if (mode === "unlimited") return true;

	var info = setup.shopGetOfferStockInfo(offer.id);
	if (!info.soldOut) return true;

	// default behavior: show "Sold out" instead of hiding
	if (offer.hideWhenSoldOut === true) return false;
	return true;
};
;

setup.shopGetOffersByVendor = function (vendorId, onlyVisible) {
	setup.ensureShopState();
	if (!Array.isArray(setup.shopOffers)) return [];
	var out = [];
	setup.shopOffers.forEach(function (o) {
		if (!o || o.vendorId !== vendorId) return;
		if (onlyVisible && !setup.shopOfferVisible(o)) return;
		out.push(o);
	});
	return out;
};

setup.shopAddToInventory = function (itemId, qty) {
	setup.ensureShopState();
	var sv = State.variables;
	if (!sv || !sv.inv || !itemId) return;

	qty = Number(qty || 0);
	if (!isFinite(qty) || qty === 0) return;

	// Ensure meta exists (used by Inventory UI: "recent" sorting, etc.)
	if (!sv.invMeta || typeof sv.invMeta !== "object" || Array.isArray(sv.invMeta)) {
		sv.invMeta = {};
	}

	var def = setup.shopGetItem(itemId) || {};
	var stackable = (def.stackable !== false);

	var prev = Number(sv.inv[itemId] || 0);
	if (!isFinite(prev) || prev < 0) prev = 0;

	// Apply delta
	var next = prev + qty;
	if (!isFinite(next) || next < 0) next = 0;

	// Non-stackable items behave like 0/1 (prevents accidental x2 of a unique item)
	if (!stackable && next > 1) next = 1;

	sv.inv[itemId] = next;

	// Meta timestamps (best-effort, works even if your project uses $day or $dayCounter)
	var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : ((typeof sv.day === "number") ? sv.day : null);

	if (!sv.invMeta[itemId] || typeof sv.invMeta[itemId] !== "object") sv.invMeta[itemId] = {};
	if (qty > 0 && prev <= 0 && typeof day === "number") {
		sv.invMeta[itemId].acquiredDay = day;
	}
	if (typeof day === "number") {
		sv.invMeta[itemId].lastChangeDay = day;
	}
	sv.invMeta[itemId].lastDelta = qty;

	// Quest event hook (obtain)
	if (qty > 0 && typeof setup.questEvent === "function") {
		setup.questEvent("obtain", { itemId: String(itemId), qty: qty });
	}
};



setup.shopCreateOrder = function (offer, qty) {
	setup.ensureShopState();
	var sv = State.variables;
	if (!sv || !offer) return null;

	var eta = Number(offer.etaDays || 1);
	if (!isFinite(eta) || eta < 0) eta = 1;

	var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;

	var ord = {
		id: "ord_" + Date.now() + "_" + Math.floor(Math.random() * 1e6),
		vendorId: offer.vendorId,
		offerId: offer.id,
		itemId: offer.itemId,
		qty: qty,
		placedDay: day,
		deliverDay: day + eta,
		delivered: false
	};
	sv.orders.push(ord);

	// Quest event hook (order created)
	if (typeof setup.questEvent === "function") {
		setup.questEvent("order", { orderId: String(ord.id), offerId: String(ord.offerId||""), vendorId: String(ord.vendorId||""), itemId: String(ord.itemId||""), qty: Number(ord.qty||1), deliverDay: ord.deliverDay });
	}
	return ord;
};

setup.shopProcessDeliveries = function () {
	setup.ensureShopState();
	var sv = State.variables;
	if (!sv || !Array.isArray(sv.orders)) return;

	var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : 0;
	var delivered = [];

	sv.orders.forEach(function (ord) {
		if (!ord || ord.delivered) return;
		if (typeof ord.deliverDay !== "number") return;
		if (ord.deliverDay > day) return;

		if (ord.itemId) setup.shopAddToInventory(ord.itemId, ord.qty || 1);
		ord.delivered = true;
		ord.deliveredDay = day;

		delivered.push(ord);

		// Quest event hook (delivered)
		if (typeof setup.questEvent === "function") {
			setup.questEvent("deliver", { orderId: String(ord.id||""), offerId: String(ord.offerId||""), vendorId: String(ord.vendorId||""), itemId: String(ord.itemId||""), qty: Number(ord.qty||1), deliveredDay: day });
		}
	});

	if (!delivered.length) return;

	// Toast
	if (setup.toast) {
		if (delivered.length === 1) setup.toast("📦 Order delivered!", "info", 2200);
		else setup.toast("📦 " + delivered.length + " orders delivered!", "info", 2400);
	}

	// Phone notification (mini banner + notification center)
	if (typeof setup.phoneMiniNotify === "function") {
		if (delivered.length === 1) {
			var o = delivered[0];
			var it = (o.itemId && setup.shopGetItem) ? (setup.shopGetItem(o.itemId) || {}) : {};
			var nm = it.name || o.itemId || "Order";
			var txt = nm + (o.qty && o.qty > 1 ? (" ×" + o.qty) : "");
			setup.phoneMiniNotify("ebay", "", "Delivery arrived", txt, { open: "ebay" });
		} else {
			setup.phoneMiniNotify("ebay", "", "Deliveries arrived", delivered.length + " orders delivered", { open: "ebay" });
		}
	}

	// Unified event hook (delivery)
	setup.emitGameEvent("delivery", { vendorId: "app_ebay", count: delivered.length, items: delivered.map(function (o) { return { offerId: String(o.offerId||""), itemId: String(o.itemId||""), qty: Number(o.qty||1) }; }) });

	// mini badge/bubbles refresh (in case phone open)
	if (typeof setup.phoneRefreshMiniBubbles === "function") setup.phoneRefreshMiniBubbles();
};

setup.shopPurchaseOffer = function (offerId, qty) {
	setup.ensureShopState();
	var sv = State.variables;

	var offer = setup.shopGetOffer(offerId);
	if (!offer) { if (setup.toast) setup.toast("Offer not found", "error", 2200); return false; }
	if (!setup.shopOfferVisible(offer)) { if (setup.toast) setup.toast("Not available yet", "warn", 2200); return false; }

	qty = Number(qty || 1);
	if (!isFinite(qty) || qty < 1) qty = 1;

	// stock check (for limited/exclusive)
	var stockInfo = setup.shopGetOfferStockInfo(offer.id);
	if (stockInfo.mode !== "unlimited" && stockInfo.stock < qty) {
		if (setup.toast) setup.toast("Sold out", "warn", 2200);
		return false;
	}

	var price = Number(offer.price || 0) * qty;
	if (!isFinite(price) || price < 0) price = 0;

	// only cash for now
	if (offer.currency && offer.currency !== "cash") { if (setup.toast) setup.toast("Unsupported currency", "error", 2200); return false; }

	if (!setup.spendMoney(price)) { if (setup.toast) setup.toast("Not enough cash", "warn", 2200); return false; }

	// ---- SUCCESS PATH (commit purchase) ----
	// consume offer stock AFTER payment succeeds
	setup.shopConsumeOfferStock(offer.id, qty);

	// Quest event hook (buy)
	if (typeof setup.questEvent === "function") {
		setup.questEvent("buy", { offerId: String(offer.id), vendorId: String(offer.vendorId||""), itemId: String(offer.itemId||""), qty: qty, price: price, deliveryMode: String(offer.deliveryMode||"instant"), currency: String(offer.currency||"cash") });
	}

	// Unified event hook (buy)
	setup.emitGameEvent("buy", { offerId: String(offer.id), vendorId: String(offer.vendorId||""), itemId: String(offer.itemId||""), qty: qty, price: price, currency: String(offer.currency||"cash"), delivery: String(offer.delivery||"") });

	// coins grant
	if (offer.grant && typeof offer.grant.fansCoins === "number") {
		setup.ensureFansAppState();
		sv.fansApp.coins += offer.grant.fansCoins * qty;
		if (setup.toast) setup.toast("Coins: +" + (offer.grant.fansCoins * qty), "info", 1600);
		return true;
	}

	// shipping
	if (offer.deliveryMode === "shipping") {
		var ord = setup.shopCreateOrder(offer, qty);
		var day = (typeof sv.dayCounter === "number") ? sv.dayCounter : null;
		var deliverDay = (ord && typeof ord.deliverDay === "number") ? ord.deliverDay : null;
		var msg = "Purchased!";
		if (day !== null && deliverDay !== null) {
			var left = deliverDay - day;
			if (left <= 0) {
				msg += " Arrives today (Day " + deliverDay + ").";
			} else {
				msg += " Arrives in " + left + " day(s) (Day " + deliverDay + ").";
			}
		} else {
			msg += " Shipping started.";
		}
		if (setup.toast) setup.toast(msg, "info", 2600);
		return true;
	}

	// instant -> inventory
	if (offer.itemId) {
		setup.shopAddToInventory(offer.itemId, qty);
		if (setup.toast) setup.toast("Added to inventory", "info", 1800);
		return true;
	}

	if (setup.toast) setup.toast("Purchased", "info", 1800);
	return true;
};
;




setup.addHeroStat = function (key, delta) {
    var cur = setup.getHeroStat(key);
    return setup.setHeroStat(key, cur + Number(delta || 0));
};

// Initialize hero stats using heroStartStats (one-time, safe for saves)
setup.initHeroStats = function () {
    var sv = State.variables;
    if (!sv) return;

    var idx = setup.getHeroStatIndex();
    if (!idx || !idx.keys || idx.keys.length === 0) {
        // Legacy fallback (keeps older games running if AUTOGEN does not have hero stats yet)
        if (typeof sv.heroMoney !== "number") sv.heroMoney = 2000;
        if (typeof sv.heroStr !== "number") sv.heroStr = 100;
        if (typeof sv.heroEnergy !== "number") sv.heroEnergy = 80;
        if (typeof sv.heroInt !== "number") sv.heroInt = 80;
        if (typeof sv.heroAut !== "number") sv.heroAut = 80;
        if (typeof sv.heroChar !== "number") sv.heroChar = 60;
        return;
    }

    var start = (setup.heroStartStats && typeof setup.heroStartStats === "object") ? setup.heroStartStats : {};
    for (var i = 0; i < idx.keys.length; i++) {
        var k = idx.keys[i];
        if (!k) continue;

        var v;
        if (typeof sv[k] === "number" && !isNaN(sv[k]) && isFinite(sv[k])) {
            v = sv[k];
        } else {
            v = Number(start[k]);
            if (isNaN(v) || !isFinite(v)) v = 0;
        }

        setup.setHeroStat(k, v);
    }
};

  
  
  
	// Инициализация переменных состояния (выполняется один раз при старте)
		setup.initGameState = function () {
		var sv = State.variables;

		// Контент-настройки (выбор в начале игры)
		if (typeof sv.contentSettings !== "object" || !sv.contentSettings) {
			sv.contentSettings = {};
		}
		if (typeof sv.contentLocked !== "boolean") {
			sv.contentLocked = false;
		}
		// дефолты по каталогу
		if (setup.contentCatalog) {
			Object.keys(setup.contentCatalog).forEach(function (k) {
				if (typeof sv.contentSettings[k] !== "boolean") {
					sv.contentSettings[k] = !!setup.contentCatalog[k].default;
				}
			});
		}


		// Время/дни
		if (typeof sv.timeOfDayIndex !== "number") {
			sv.timeOfDayIndex = 0; // 0 = morning
		}
		if (typeof sv.weekdayIndex !== "number") {
			sv.weekdayIndex = 0; // 0 = Monday
		}
		if (typeof sv.dayCounter !== "number") {
			sv.dayCounter = 0; // скрытый счётчик дней (не показываем игроку)
		}

        if (typeof sv.phonePlayerChoices !== "object" || !sv.phonePlayerChoices) {
	sv.phonePlayerChoices = {};
}

          
		// Телефон
		if (typeof sv.phoneWallpaper !== "string") {
			sv.phoneWallpaper = "src/img/agatha/wphone1.jpg";
		}
		if (typeof sv.phoneUnread !== "number") {
			sv.phoneUnread = 0;
		}

          
        // Телефон: внутренний экран и навигация
	if (typeof sv.phoneScreen !== "string") {
		sv.phoneScreen = "home"; // home, gallery, galleryNpc, contacts, contactNpc, messages, messagesChat, quests, achievements, cheats
	}
	if (!Array.isArray(sv.phoneHistory)) {
		sv.phoneHistory = [];
	}
	if (typeof sv.phoneScreenData !== "object" || !sv.phoneScreenData) {
		sv.phoneScreenData = {};
	}
         
             
       // 🖼 Фон UI-бара
		if (typeof sv.uiBarBg !== "string") {
			// поставь сюда свой дефолтный фон
			sv.uiBarBg = "src/img/ui.jpg";
		}
              
          
		// Герой
		if (typeof sv.heroName !== "string") {
			sv.heroName = ""; // можно поменять в любом пассаже через <<set $heroName = "..." >>
		}

		// Hero stats (clamped & defaults come from AUTOGEN: heroStatConfig + heroStartStats)
		setup.initHeroStats();
          
              
          
            
		
		// Wallet mirrors heroMoney
		if (typeof setup.syncWallet === "function") setup.syncWallet();
// Текущая локация на карте (для оверлея карты)
		if (typeof sv.currentLocationId !== "string") {
			sv.currentLocationId = "home";
		}


// NPC
	setup.initNpcState(); 
    setup.ensureMessagesState();
    setup.initQuestFlags();
		if (typeof setup.ensureShopState === "function") setup.ensureShopState();

	};


/* =====================================================
   Мини-пузыри уведомлений на мини-телефоне
   ===================================================== */

/* Список NPC с непрочитанными сообщениями */
setup.phoneGetUnreadNpcIds = function () {
	var sv = State.variables || {};
	var res = [];
	if (!sv.messages) return res;

	Object.keys(sv.messages).forEach(function (npcId) {
		var st = sv.messages[npcId];
		if (st && st.unread > 0) {
			res.push(npcId);
		}
	});

	return res;
};


/* iOS-like badges: format number (99+) */
setup.phoneFormatBadgeNumber = function (n) {
	n = Number(n || 0);
	if (!isFinite(n) || n <= 0) return "0";
	if (n > 99) return "99+";
	return String(Math.floor(n));
};

/* Total unread counters for phone apps (Messages + Fans + Match) */
setup.phoneGetAppUnreadCounts = function () {
	var sv = State.variables || {};

	// ensure DM states so sv.fansApp.unread / sv.matchApp.unread exist
	if (setup.ensureFansDmState) setup.ensureFansDmState();
	if (setup.ensureMatchDmState) setup.ensureMatchDmState();

	// Messages total unread: prefer sv.phoneUnread, fallback to sum by NPC
	var messages = 0;
	if (typeof sv.phoneUnread === "number") {
		messages = sv.phoneUnread;
	} else if (sv.messages) {
		Object.keys(sv.messages).forEach(function (npcId) {
			var st = sv.messages[npcId];
			if (st && st.unread) messages += Number(st.unread) || 0;
		});
	}

	var fans = sv.fansApp && typeof sv.fansApp.unread === "number" ? sv.fansApp.unread : 0;
	var match = sv.matchApp && typeof sv.matchApp.unread === "number" ? sv.matchApp.unread : 0;

	messages = Math.max(0, messages | 0);
	fans = Math.max(0, fans | 0);
	match = Math.max(0, match | 0);

	return {
		messages: messages,
		fans: fans,
		match: match,
		total: messages + fans + match
	};
};

/* Mini-phone: refresh badge + small app badges row (like iPhone) */
setup.phoneRefreshMiniNotifs = function () {
	var $badge = $("#custom-ui-phone-badge");
	var $apps  = $("#custom-ui-phone-appbadges");

	if ($badge.length === 0 && $apps.length === 0) return;

	var sv = State.variables || {};
	if (!sv._miniPrevCounts || typeof sv._miniPrevCounts !== "object") {
		sv._miniPrevCounts = { messages: 0, fans: 0, match: 0, total: 0 };
	}
	var prev = sv._miniPrevCounts;

	var c = (setup.phoneGetAppUnreadCounts ? setup.phoneGetAppUnreadCounts() : { messages: 0, fans: 0, match: 0, total: 0 });
	var total = Number(c.total || 0);

	function pulse($el) {
		if (!$el || !$el.length) return;
		$el.addClass("pulse");
		window.setTimeout(function () { $el.removeClass("pulse"); }, 520);
	}
	function bump($item) {
		if (!$item || !$item.length) return;
		$item.addClass("bump");
		window.setTimeout(function () { $item.removeClass("bump"); }, 520);
	}

	// total badge (top-right on mini-phone)
	if ($badge.length) {
		if (total > 0) {
			$badge.text(setup.phoneFormatBadgeNumber(total)).show();
			if (total > (Number(prev.total || 0))) pulse($badge);
		} else {
			$badge.hide();
		}
	}

	// small app badges row (Messages/Fans/Match)
	if ($apps.length) {
		function item(appKey, cls, num) {
			num = Number(num || 0);
			if (num <= 0) return "";
			return (
				'<div class="mini-app-badge-item" data-mini-app="' + appKey + '">' +
				'  <div class="phone-app-icon-inner ' + cls + ' mini-app-icon"></div>' +
				'  <div class="mini-app-badge"><span class="mini-app-badge-num">' + setup.phoneFormatBadgeNumber(num) + '</span></div>' +
				'</div>'
			);
		}

		var html = "";
		html += item("messages", "app-messages", c.messages);
		html += item("fans", "app-fans", c.fans);
		html += item("match", "app-match", c.match);

		if (html) {
			$apps.html(html).show();

			// pulse + icon bump on increase
			if (Number(c.messages || 0) > Number(prev.messages || 0)) {
				var $itM = $apps.find('.mini-app-badge-item[data-mini-app="messages"]');
				pulse($itM.find(".mini-app-badge"));
				bump($itM);
			}
			if (Number(c.fans || 0) > Number(prev.fans || 0)) {
				var $itF = $apps.find('.mini-app-badge-item[data-mini-app="fans"]');
				pulse($itF.find(".mini-app-badge"));
				bump($itF);
			}
			if (Number(c.match || 0) > Number(prev.match || 0)) {
				var $itT = $apps.find('.mini-app-badge-item[data-mini-app="match"]');
				pulse($itT.find(".mini-app-badge"));
				bump($itT);
			}
		} else {
			$apps.empty().hide();
		}
	}

	sv._miniPrevCounts = {
		messages: Number(c.messages || 0),
		fans: Number(c.fans || 0),
		match: Number(c.match || 0),
		total: Number(c.total || 0)
	};
};

/* Mini-phone + Notification Center helpers */
setup.phoneGetNpcDef = function (npcId) {
	if (!npcId || !setup.npcDefinitions || !setup.npcDefinitions.length) return null;
	for (var i = 0; i < setup.npcDefinitions.length; i++) {
		if (setup.npcDefinitions[i].id === npcId) return setup.npcDefinitions[i];
	}
	return null;
};

setup.phoneGetNpcName = function (npcId) {
	var def = setup.phoneGetNpcDef(npcId);
	if (!def) return "Unknown";
	var n = (typeof def.name === "function") ? def.name() : (def.name || "Unknown");
	return String(n || "Unknown");
};

setup.phoneMiniCleanText = function (s) {
	s = String(s || "");
	// strip HTML tags
	s = s.replace(/<[^>]*>/g, "");
	// collapse whitespace
	s = s.replace(/\s+/g, " ").trim();
	return s;
};

setup.phoneMiniShort = function (s, n) {
	s = setup.phoneMiniCleanText(s);
	n = Math.max(10, Number(n || 34));
	if (s.length <= n) return s;
	return s.slice(0, Math.max(0, n - 1)) + "…";
};

setup.phoneEnsureNotifLog = function () {
	var sv = State.variables;
	if (!Array.isArray(sv.phoneNotifs)) sv.phoneNotifs = [];
	if (typeof sv.notifsFilter !== "string") sv.notifsFilter = "all"; // all|messages|fans|match|quests|achievements|ebay|inventory
	if (!sv.notifsGroupOpen || typeof sv.notifsGroupOpen !== "object" || Array.isArray(sv.notifsGroupOpen)) sv.notifsGroupOpen = {};
	if (typeof sv.notifsGroupOpen.messages !== "boolean") sv.notifsGroupOpen.messages = true; // default: keep Messages group open
};

setup.phonePushNotifLog = function (app, npcId, title, text, meta) {
	meta = meta || {};
	setup.phoneEnsureNotifLog();
	var sv = State.variables;

	var entry = {
		id    : "n_" + Date.now() + "_" + Math.floor(Math.random() * 1e9),
		app   : String(app || "core"),
		npcId : npcId || "",
		title : String(title || ""),
		text  : String(text || ""),
		day   : (setup.phoneGetDayCounter ? setup.phoneGetDayCounter() : 0),
		stamp : (setup.phoneGetStamp ? setup.phoneGetStamp() : Date.now()),
		meta  : meta
	};

	sv.phoneNotifs.unshift(entry);

	// cap size
	if (sv.phoneNotifs.length > 60) sv.phoneNotifs.length = 60;

	return entry;
};

// Show iOS-like banner on mini-phone + store in notification log
setup.phoneMiniPushBanner = function (app, npcId, title, text, meta, durationMs) {
	meta = meta || {};
	var $b = $("#custom-ui-phone-banner");
	if ($b.length === 0) return;

	// clear old timers
	var oldHide = $b.data("hideTimer");
	if (typeof oldHide === "number") window.clearTimeout(oldHide);
	var oldClean = $b.data("cleanTimer");
	if (typeof oldClean === "number") window.clearTimeout(oldClean);

	var appCls = "app-messages";
	if (app === "fans") appCls = "app-fans";
	else if (app === "match") appCls = "app-match";
	else if (app === "achievements") appCls = "app-achievements";
	else if (app === "ebay") appCls = "app-ebay";
	else if (app === "inventory") appCls = "app-inventory";
	else if (app === "quests") appCls = "app-quests";

	var safeTitle = setup.escapeHtml ? setup.escapeHtml(String(title || "")) : String(title || "");
	var safeText  = setup.escapeHtml ? setup.escapeHtml(String(text || "")) : String(text || "");

	// data for deep-link
	$b.attr("data-mini-app", app || "");
	$b.attr("data-npc-id", npcId || "");
	$b.attr("data-mini-open", meta.open || "");

	$b.html(
		'<div class="mini-banner-inner">' +
		'  <div class="mini-banner-icon"><div class="phone-app-icon-inner ' + appCls + ' mini-app-icon"></div></div>' +
		'  <div class="mini-banner-texts">' +
		'    <div class="mini-banner-title">' + safeTitle + '</div>' +
		'    <div class="mini-banner-body">' + safeText + '</div>' +
		'  </div>' +
		'</div>'
	);

	// restart animation (in -> out)
	$b.removeClass("visible hiding");
	if ($b[0]) { void $b[0].offsetHeight; } // force reflow
	$b.addClass("visible");

	var ms = Math.max(600, Number(durationMs || 1800));
	var outMs = 220;
	var startHide = Math.max(240, ms - outMs);

	var t1 = window.setTimeout(function () {
		$b.addClass("hiding");
	}, startHide);

	var t2 = window.setTimeout(function () {
		$b.removeClass("visible hiding")
			.removeAttr("data-mini-app data-npc-id data-mini-open")
			.empty();
	}, startHide + outMs);

	$b.data("hideTimer", t1);
	$b.data("cleanTimer", t2);
};

// One unified entry point for mini notifications (log + banner unless silent)
setup.phoneMiniNotify = function (app, npcId, title, text, meta) {
	meta = meta || {};
	var entry = setup.phonePushNotifLog(app, npcId, title, text, meta);

	if (!meta.silent) {
		setup.phoneMiniPushBanner(app, npcId, title, text, meta);
	}

	return entry;
};

// Collect unread "threads" across Messages/Fans/Match for mini bubbles
setup.phoneGetUnreadThreads = function () {
	var sv = State.variables || {};
	var out = [];

	// Messages
	if (sv.messages) {
		Object.keys(sv.messages).forEach(function (npcId) {
			var st = sv.messages[npcId];
			if (!st || !(st.unread > 0)) return;
			var last = (st.thread && st.thread.length) ? st.thread[st.thread.length - 1] : null;
			var stamp = (last && typeof last.stamp === "number") ? last.stamp : 0;
			var txt = st.previewText || (last && last.text) || "New message";
			out.push({ app: "messages", npcId: npcId, stamp: stamp, text: txt });
		});
	}

	// Fans
	if (sv.fansApp && sv.fansApp.dm) {
		Object.keys(sv.fansApp.dm).forEach(function (npcId) {
			var dm = sv.fansApp.dm[npcId];
			if (!dm || !(dm.unread > 0)) return;
			var last = (dm.thread && dm.thread.length) ? dm.thread[dm.thread.length - 1] : null;
			var stamp = (typeof dm.lastStamp === "number") ? dm.lastStamp : ((last && typeof last.stamp === "number") ? last.stamp : 0);
			var txt = dm.previewText || (last && last.text) || "New message";
			out.push({ app: "fans", npcId: npcId, stamp: stamp, text: txt });
		});
	}

	// Match
	if (sv.matchApp && sv.matchApp.dm) {
		Object.keys(sv.matchApp.dm).forEach(function (npcId) {
			var dm = sv.matchApp.dm[npcId];
			if (!dm || !(dm.unread > 0)) return;
			var last = (dm.thread && dm.thread.length) ? dm.thread[dm.thread.length - 1] : null;
			var stamp = (typeof dm.lastStamp === "number") ? dm.lastStamp : ((last && typeof last.stamp === "number") ? last.stamp : 0);
			var txt = dm.previewText || (last && last.text) || "New message";
			out.push({ app: "match", npcId: npcId, stamp: stamp, text: txt });
		});
	}

	out.sort(function (a, b) { return (Number(b.stamp || 0) - Number(a.stamp || 0)); });
	return out;
};

// Deep-link open from mini-phone
setup.phoneMiniOpen = function (app, npcId) {
	app = String(app || "");
	npcId = npcId || "";

	// open phone overlay first
	setup.openPhoneDialog();

	// app routing
	if (app === "notifs") {
		setup.phoneGo("notifs");
		return;
	}

	if (app === "messages") {
		setup.phoneGo("messages");
		if (npcId) setup.phoneGo("messagesChat", { npcId: npcId });
		return;
	}

	if (app === "fans") {
		setup.phoneGo("fansInbox");
		if (npcId) setup.phoneGo("fansChat", { npcId: npcId });
		return;
	}

	if (app === "match") {
		setup.phoneGo("matchInbox");
		if (npcId) setup.phoneGo("matchChat", { npcId: npcId });
		return;
	}


	if (app === "achievements") {
		setup.phoneGo("achievements");
		return;
	}

	if (app === "quests") {
		setup.phoneGo("quests");
		return;
	}

	if (app === "ebay") {
		// delivery notifications, etc.
		setup.phoneGo("ebayOrders");
		return;
	}

	// fallback: open home
	setup.phoneGo("home");
};
;


/* Перерисовать пузырьки на мини-телефоне */
setup.phoneRefreshMiniBubbles = function () {
	// обновляем бейджи (Messages+Fans+Match)
	setup.phoneRefreshMiniNotifs();

	var $cont = $("#custom-ui-phone-bubbles");
	if ($cont.length === 0) return;

	var sv = State.variables || {};
	var prevIds = (sv._miniPrevThreadIds && typeof sv._miniPrevThreadIds === "object") ? sv._miniPrevThreadIds : {};
	var currIds = {};

	$cont.empty();

	var threads = (setup.phoneGetUnreadThreads ? setup.phoneGetUnreadThreads() : []);
	var maxIcons = 4;
	var total = threads.length;

	for (var idx = 0; idx < threads.length && idx < maxIcons; idx++) {
		var t = threads[idx] || {};
		var npcId = t.npcId || "";
		var app = t.app || "messages";

		var key = app + "|" + npcId;
		currIds[key] = 1;
		var isNew = !prevIds[key];

		var def = setup.phoneGetNpcDef ? setup.phoneGetNpcDef(npcId) : null;
		var avatar = "";
		if (def) {
			if (def.avatarMini) avatar = def.avatarMini;
			else if (def.avatar) avatar = def.avatar;
		}

		var appCls = (app === "fans") ? "app-fans" : (app === "match") ? "app-match" : "app-messages";
		var txt = setup.phoneMiniShort ? setup.phoneMiniShort(t.text || "New message", 28) : (t.text || "New message");

		var clsNew = isNew ? " is-new" : "";
		var html = '<div class="phone-bubble' + clsNew + '" data-mini-app="' + app + '" data-npc-id="' + npcId + '" role="button" tabindex="0">';
		if (avatar) {
			html += '<div class="phone-bubble-avatar" style="background-image:url(' + avatar + ');"></div>';
		} else {
			html += '<div class="phone-bubble-avatar"></div>';
		}
		html += '<div class="phone-bubble-meta">';
		html += '  <div class="phone-bubble-app"><div class="phone-app-icon-inner ' + appCls + ' mini-app-icon"></div></div>';
		html += '  <div class="phone-bubble-text">' + (setup.escapeHtml ? setup.escapeHtml(String(txt)) : String(txt)) + '</div>';
		html += '</div>';
		html += '</div>';

		$cont.append(html);
	}

	// if more unread threads exist
	if (total > maxIcons) {
		var extra = total - maxIcons;
		var moreHtml = '' +
			'<div class="phone-bubble phone-bubble-more" data-mini-open="notifs" role="button" tabindex="0">' +
			'  <div class="phone-bubble-text">+' + extra + ' more</div>' +
			'</div>';
		$cont.append(moreHtml);
	}

	$("#custom-ui-phone-wrapper").toggleClass("has-bubbles", total > 0);
	sv._miniPrevThreadIds = currIds;
};;

/* Короткая "вибрация" мини-телефона при новом пузыре */
setup.phoneMiniVibrate = function () {
	var $wrap = $("#custom-ui-phone-wrapper");
	if (!$wrap.length) return;

	$wrap.addClass("phone-vibrate");
	window.setTimeout(function () {
		$wrap.removeClass("phone-vibrate");
	}, 400);
};



/* ------------------------------------------------------------------
   НАВИГАЦИЯ ВНУТРИ ТЕЛЕФОНА
   ------------------------------------------------------------------ */

setup.phoneGo = function (screen, data) {
	var sv = State.variables;

	if (!Array.isArray(sv.phoneHistory)) {
		sv.phoneHistory = [];
	}

	// пушим текущий экран в историю
	sv.phoneHistory.push({
		screen: sv.phoneScreen,
		data  : sv.phoneScreenData || {}
	});

	sv.phoneScreen = screen;
	sv.phoneScreenData = data || {};

	setup.phoneRender();
};

setup.phoneGoHome = function () {
	var sv = State.variables;

	sv.phoneScreen = "home";
	sv.phoneScreenData = {};
	sv.phoneHistory = [];

	setup.phoneRender();
};

setup.phoneBack = function () {
	var sv = State.variables;

	if (Array.isArray(sv.phoneHistory) && sv.phoneHistory.length > 0) {
		var prev = sv.phoneHistory.pop();
		sv.phoneScreen = prev.screen;
		sv.phoneScreenData = prev.data || {};
	} else {
		sv.phoneScreen = "home";
		sv.phoneScreenData = {};
	}

	setup.phoneRender();
};

  
  
  
  /* ------------------------------------------------------------------
   РЕНДЕР ЭКРАНА ТЕЛЕФОНА
   ------------------------------------------------------------------ */

setup.phoneRender = function () {
	var sv = State.variables;
	var $content = $("#phone-overlay-screen-content");

	if ($content.length === 0) {
		return;
	}

// app/screen markers for theming
var _app = "core";
if (typeof sv.phoneScreen === "string") {
	if (sv.phoneScreen.indexOf("fans") === 0) _app = "fans";
	else if (sv.phoneScreen.indexOf("match") === 0) _app = "match";
	else if (sv.phoneScreen.indexOf("ebay") === 0) _app = "ebay";
	else if (sv.phoneScreen.indexOf("inv") === 0 || sv.phoneScreen.indexOf("inventory") === 0) _app = "inventory";
}
$content.attr("data-phone-app", _app);
$content.attr("data-phone-screen", sv.phoneScreen || "");

	// верхняя "статус-бар" + область содержимого + кнопка "Назад" (если нужно)
	var isHome = (sv.phoneScreen === "home");

	var headerHtml =
		'<div class="phone-ui-statusbar">' +
		'  <div class="phone-ui-status-left">' +
		'    <span class="phone-ui-time">09:41</span>' +
		"  </div>" +
		'  <div class="phone-ui-status-center">' +
		(isHome
			? '<span class="phone-ui-title"></span>'
			: '<button class="phone-nav-back">&lsaquo;</button><span class="phone-ui-title">' +
			  setup.phoneGetTitle(sv.phoneScreen) +
			  "</span>") +
		"  </div>" +
		'  <div class="phone-ui-status-right">' +
		'    <span class="phone-ui-signal"></span>' +
		'    <span class="phone-ui-wifi"></span>' +
		'    <span class="phone-ui-battery"></span>' +
		"  </div>" +
		"</div>";

	var bodyHtml = '<div class="phone-ui-body">';

	switch (sv.phoneScreen) {
		case "home":
			bodyHtml += setup.phoneRenderHome();
			break;
		case "gallery":
			bodyHtml += setup.phoneRenderGallery();
			break;
		case "galleryNpc":
			bodyHtml += setup.phoneRenderGalleryNpc(sv.phoneScreenData.npcId);
			break;
		case "galleryView":
			bodyHtml += setup.phoneRenderGalleryView(sv.phoneScreenData.npcId, sv.phoneScreenData.mediaId);
			break;
		case "notifs":
			bodyHtml += setup.phoneRenderNotifs();
			break;
		case "contacts":
			bodyHtml += setup.phoneRenderContacts();
			break;
		case "contactNpc":
			bodyHtml += setup.phoneRenderContactNpc(sv.phoneScreenData.npcId);
			break;
		case "messages":
			bodyHtml += setup.phoneRenderMessages();
			break;
		case "messagesChat":
			bodyHtml += setup.phoneRenderMessagesChat(sv.phoneScreenData.npcId);
			break;
		case "fansHome":
			bodyHtml += setup.phoneRenderFansHome();
			break;
		case "fansCoins":
			bodyHtml += setup.phoneRenderFansCoins();
			break;
		case "fansCreator":
			bodyHtml += setup.phoneRenderFansCreator(sv.phoneScreenData.npcId);
			break;
		case "fansPost":
			bodyHtml += setup.phoneRenderFansPost(sv.phoneScreenData.npcId, sv.phoneScreenData.postId);
			break;
		case "fansInbox":
			bodyHtml += setup.phoneRenderFansInbox();
			break;
		case "fansChat":
			bodyHtml += setup.phoneRenderFansChat(sv.phoneScreenData.npcId);
			break;
		case "matchHome":
			bodyHtml += setup.phoneRenderMatchHome();
			break;
		case "matchSwipe":
			bodyHtml += setup.phoneRenderMatchSwipe();
			break;
		case "matchInbox":
			bodyHtml += setup.phoneRenderMatchInbox();
			break;
		case "matchChat":
			bodyHtml += setup.phoneRenderMatchChat(sv.phoneScreenData.npcId);
			break;
		case "matchItsAMatch":
			bodyHtml += setup.phoneRenderMatchItsAMatch(sv.phoneScreenData.npcId);
			break;
				case "quests":
			bodyHtml += setup.phoneRenderQuests();
			break;
		case "achievements":
			bodyHtml += setup.phoneRenderAchievements();
			break;
		case "cheats":
			bodyHtml += setup.phoneRenderCheats();
			break;
		case "ebayHome":
			bodyHtml += setup.phoneRenderEbayHome();
			break;
		case "ebayItem":
			bodyHtml += setup.phoneRenderEbayItem(sv.phoneScreenData.offerId);
			break;
		case "ebayOrders":
			bodyHtml += setup.phoneRenderEbayOrders();
			break;
		case "invHome":
			bodyHtml += setup.phoneRenderInvHome();
			break;
		case "invItem":
			bodyHtml += setup.phoneRenderInvItem(sv.phoneScreenData.itemId);
			break;
		case "invGift":
			bodyHtml += setup.phoneRenderInvGift(sv.phoneScreenData.itemId);
			break;
		default:
			bodyHtml += "<div class='phone-ui-placeholder'>Неизвестный экран: " +
				setup.escapeHtml(sv.phoneScreen) + "</div>";
			break;
	}

	bodyHtml += "</div>";

	$content.html(headerHtml + bodyHtml);

	// повесим обработчики:
	// кнопка назад
	$content.find(".phone-nav-back").on("click", function () {
		setup.phoneBack();
	});

  // выбор ответа игрока в чате
$content.find(".phone-chat-choice").on("click", function () {
	var npcId    = $(this).attr("data-npc-id");
	var choiceId = $(this).attr("data-choice-id");
	setup.phoneChoosePlayerReply(npcId, choiceId);
});

// ---------------------------------------------------------
// FANS / MATCH: отдельные клики (Inbox + чат + choices)
// ---------------------------------------------------------

// Fans: open coin shop
$content.find("[data-fans-coins-shop]").off("click.fansCoinsShop").on("click.fansCoinsShop", function () {
	setup.phoneGo("fansCoins");
});

// открыть Inbox в Fans
$content.find("[data-fans-inbox]").off("click.fansInbox").on("click.fansInbox", function () {
	setup.phoneGo("fansInbox");
});

// открыть Inbox в Match
$content.find("[data-match-inbox]").off("click.matchInbox").on("click.matchInbox", function () {
	setup.phoneGo("matchInbox");
});

// открыть чат из списка Fans Inbox
$content.find(".phone-fans-chat-list-item").off("click.fansChatOpen").on("click.fansChatOpen", function () {
	var npcId = $(this).attr("data-chat-id");
	if (npcId) setup.phoneGo("fansChat", { npcId: npcId });
});

// открыть чат из списка Match Inbox
$content.find(".phone-match-chat-list-item").off("click.matchChatOpen").on("click.matchChatOpen", function () {
	var npcId = $(this).attr("data-chat-id");
	if (npcId) setup.phoneGo("matchChat", { npcId: npcId });
});

// выбор ответа игрока в Fans-чате
$content.find(".phone-fans-chat-choice").off("click.fansChoice").on("click.fansChoice", function () {
	var npcId    = $(this).attr("data-npc-id");
	var choiceId = $(this).attr("data-choice-id");
	setup.fansChoosePlayerReply(npcId, choiceId);
});

// выбор ответа игрока в Match-чате
$content.find(".phone-match-chat-choice").off("click.matchChoice").on("click.matchChoice", function () {
	var npcId    = $(this).attr("data-npc-id");
	var choiceId = $(this).attr("data-choice-id");
	setup.matchChoosePlayerReply(npcId, choiceId);
});


// quick reply templates (Fans/Match)
$content.find(".phone-chat-quick-reply").off("click.quickReply").on("click.quickReply", function (ev) {
	if (ev && ev.stopPropagation) ev.stopPropagation();
	var app   = $(this).attr("data-qr-app") || "";
	var npcId = $(this).attr("data-npc-id") || "";
	var text  = $(this).attr("data-qr-text") || "";
	if (!npcId || !text) return;

	if (app === "fans" && typeof setup.fansSendQuickReply === "function") {
		setup.fansSendQuickReply(npcId, text);
	}
	if (app === "match" && typeof setup.matchSendQuickReply === "function") {
		setup.matchSendQuickReply(npcId, text);
	}
});

// FANS PPV unlock in Fans DM
$content.find("[data-fans-ppv-unlock]").off("click.fansPPVUnlock").on("click.fansPPVUnlock", function (ev) {
	ev.preventDefault();
	ev.stopPropagation();
	var v = $(this).attr("data-fans-ppv-unlock") || "";
	var parts = v.split("::");
	if (parts.length === 2) setup.fansUnlockPPV(parts[0], parts[1]);
});

// When user opens media in Fans/Match chats -> add to NPC Gallery (wallpapers)
$content.find(".sc-media__expand").off("click.phoneAddToGallery").on("click.phoneAddToGallery", function () {
	var $card = $(this).closest(".sc-media");
	var npcId = $card.attr("data-gallery-npc-id");
	var mid   = $card.attr("data-gallery-media-id");
	if (!npcId || !mid) return;

	var thumb = $card.attr("data-gallery-thumb") || "";
	var full  = $card.attr("data-gallery-full") || "";
	var canWp = ($card.attr("data-gallery-wallpaper") === "1");

	setup.phoneAddMediaToNpcGallery(npcId, { id: mid, thumb: thumb, full: full, canWallpaper: canWp });
});

  
	// клики по иконкам главного экрана
	$content.find(".phone-app-icon:not(.disabled)").on("click", function () {
		var app = $(this).attr("data-app");
		switch (app) {
			case "gallery":
				setup.phoneGo("gallery");
				break;
			case "contacts":
				setup.phoneGo("contacts");
				break;
			case "messages":
				setup.phoneGo("messages");
				break;
			case "fans":
				setup.phoneGo("fansHome");
				break;
			case "match":
				setup.phoneGo("matchHome");
				break;
			case "ebay":
				setup.phoneGo("ebayHome");
				break;
				case "inventory":
					setup.phoneGo("invHome");
					break;
			case "quests":
				setup.phoneGo("quests");
				break;
			case "achievements":
				setup.phoneGo("achievements", { view: "list", tab: "achievements" });
				break;
			case "cheats":
				setup.phoneGo("cheats");
				break;
		}
	});


