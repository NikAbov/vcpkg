				if (of && of.id) idx.offerById[String(of.id)] = of;
			}
		} catch (e) {}

		try {
			var rules = Array.isArray(setup.giftRules) ? setup.giftRules : [];
			for (var k = 0; k < rules.length; k++) {
				var r = rules[k];
				if (r && r.id) idx.giftRuleById[String(r.id)] = r;
			}
